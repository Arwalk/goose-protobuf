// Adds an empty message to uninterpreted_option and returns it.
fn FileOptions_add_uninterpreted_option(m: FileOptions&) -> UninterpretedOption& {
    let pb_i: i64 = m.uninterpreted_option.len;
    m.uninterpreted_option = pb_resize(UninterpretedOption_links, m.uninterpreted_option, pb_i + 1);
    let pb_new .= UninterpretedOption_pool.alloc_ref(UninterpretedOption { .. });
    pb_run(UninterpretedOption_links, m.uninterpreted_option)[pb_i].m .= pb_new;
    return pb_new;
