// Frees the messages of uninterpreted_option and everything they own.
fn FileOptions_clear_uninterpreted_option(m: FileOptions&) {
    for pb_ref in pb_run(UninterpretedOption_links, m.uninterpreted_option) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        UninterpretedOption_clear(pb_l);
        UninterpretedOption_pool.free(UninterpretedOption_pool.index_of(pb_l));
