// Sets weak and marks it present:
// it is encoded even when 0.
fn FieldOptions_set_weak(m: FieldOptions&, v: bool) {
    m.weak = v;
    m.pb_has0 |= 0x00000040;
}

fn FieldOptions_has_weak(m: FieldOptions&) -> bool { return (m.pb_has0 & 0x00000040) != 0; }

fn FieldOptions_clear_weak(m: FieldOptions&) {
    m.weak = false;
    m.pb_has0 &= 0xffffffbf;
}

// Sets debug_redact and marks it present:
// it is encoded even when 0.
fn FieldOptions_set_debug_redact(m: FieldOptions&, v: bool) {
    m.debug_redact = v;
    m.pb_has0 |= 0x00000080;
}

fn FieldOptions_has_debug_redact(m: FieldOptions&) -> bool { return (m.pb_has0 & 0x00000080) != 0; }

fn FieldOptions_clear_debug_redact(m: FieldOptions&) {
    m.debug_redact = false;
    m.pb_has0 &= 0xffffff7f;
