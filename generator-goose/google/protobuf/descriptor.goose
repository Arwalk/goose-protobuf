fn FieldOptions_clear_lazy(m: FieldOptions&) {
    m.lazy = false;
    m.pb_has0 &= 0xfffffff7;
}

// Sets unverified_lazy and marks it present:
// it is encoded even when 0.
fn FieldOptions_set_unverified_lazy(m: FieldOptions&, v: bool) {
    m.unverified_lazy = v;
    m.pb_has0 |= 0x00000010;
}

fn FieldOptions_has_unverified_lazy(m: FieldOptions&) -> bool { return (m.pb_has0 & 0x00000010) != 0; }

fn FieldOptions_clear_unverified_lazy(m: FieldOptions&) {
    m.unverified_lazy = false;
    m.pb_has0 &= 0xffffffef;
}

// Sets deprecated and marks it present:
// it is encoded even when 0.
fn FieldOptions_set_deprecated(m: FieldOptions&, v: bool) {
    m.deprecated = v;
    m.pb_has0 |= 0x00000020;
}

fn FieldOptions_has_deprecated(m: FieldOptions&) -> bool { return (m.pb_has0 & 0x00000020) != 0; }

fn FieldOptions_clear_deprecated(m: FieldOptions&) {
    m.deprecated = false;
