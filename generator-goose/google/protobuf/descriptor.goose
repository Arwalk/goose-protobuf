fn MethodDescriptorProto_has_client_streaming(m: MethodDescriptorProto&) -> bool { return (m.pb_has0 & 0x00000008) != 0; }

fn MethodDescriptorProto_clear_client_streaming(m: MethodDescriptorProto&) {
