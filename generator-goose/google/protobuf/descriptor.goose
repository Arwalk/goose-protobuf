// cleared.
fn FileDescriptorProto_source_code_info(m: FileDescriptorProto&) -> SourceCodeInfo&? { return m.source_code_info.m; }

// The sub-message source_code_info, set to an empty one first if it is not set.
fn FileDescriptorProto_mutable_source_code_info(m: FileDescriptorProto&) -> SourceCodeInfo& {
