// partial message, which the caller clears.
fn GeneratedCodeInfo_Annotation_decode(buf: const u8[:], m: GeneratedCodeInfo_Annotation&) -> i32 {
    var r = pb_reader(buf);
    GeneratedCodeInfo_Annotation_decode_from(r, m);
    return r.err;
}

// Appends m's wire encoding, GeneratedCodeInfo_Annotation_size_of(m) bytes, to out.
fn GeneratedCodeInfo_Annotation_encode(m: GeneratedCodeInfo_Annotation&, out: u8[>..]&) {
    if m.path.len > 0 {
        pb_write_varint(out, 10);
        var pb_n: i64 = 0;
        for pb_v in pb_run(pb_i32s, m.path) { pb_n += pb_varint_size(pb_int32_to_u64(pb_v)); }
        pb_write_varint(out, pb_n as! u64);
        for pb_v in pb_run(pb_i32s, m.path) { pb_write_varint(out, pb_int32_to_u64(pb_v)); }
    }
    if (m.pb_has0 & 0x00000001) != 0 {
        pb_write_varint(out, 18);
        pb_write_bytes(out, m.source_file);
    }
    if (m.pb_has0 & 0x00000002) != 0 {
        pb_write_varint(out, 24);
        pb_write_varint(out, pb_int32_to_u64(m.begin));
    }
    if (m.pb_has0 & 0x00000004) != 0 {
        pb_write_varint(out, 32);
        pb_write_varint(out, pb_int32_to_u64(m.end));
    }
    if (m.pb_has0 & 0x00000008) != 0 {
        pb_write_varint(out, 40);
        pb_write_varint(out, pb_int32_to_u64(m.semantic));
    }
    out.append(pb_run(pb_bytes, m.pb_unknown));
