// The size of m's wire encoding, in bytes.
fn GeneratedCodeInfo_Annotation_size_of(m: GeneratedCodeInfo_Annotation&) -> i64 {
    var n: i64 = 0;
    if m.path.len > 0 {
        var pb_n: i64 = 0;
        for pb_v in pb_run(pb_i32s, m.path) { pb_n += pb_varint_size(pb_int32_to_u64(pb_v)); }
        n += 1 + pb_len_size(pb_n);
    }
    if (m.pb_has0 & 0x00000001) != 0 { n += 1 + pb_bytes_size(m.source_file); }
    if (m.pb_has0 & 0x00000002) != 0 { n += 1 + pb_varint_size(pb_int32_to_u64(m.begin)); }
    if (m.pb_has0 & 0x00000004) != 0 { n += 1 + pb_varint_size(pb_int32_to_u64(m.end)); }
    if (m.pb_has0 & 0x00000008) != 0 { n += 1 + pb_varint_size(pb_int32_to_u64(m.semantic)); }
    n += m.pb_unknown.len;
    return n;
}

// Frees what m owns and resets it to the empty message.
fn GeneratedCodeInfo_Annotation_clear(m: GeneratedCodeInfo_Annotation&) {
    m.path = pb_resize(pb_i32s, m.path, 0);
    m.source_file = pb_bytes_free(m.source_file);
    m.begin = 0;
    m.end = 0;
    m.semantic = 0;
    m.pb_has0 = 0;
    m.pb_unknown = pb_bytes_free(m.pb_unknown);
}

// Makes dst a deep copy of src, freeing what dst owned. The two share
// nothing afterwards. Neither may be a sub-message of the other.
fn GeneratedCodeInfo_Annotation_copy(dst: GeneratedCodeInfo_Annotation&, src: GeneratedCodeInfo_Annotation&) {
    if dst .== src { return; }
    GeneratedCodeInfo_Annotation_clear(dst);
    dst.path = pb_copy_run(pb_i32s, src.path);
    dst.source_file = pb_bytes_copy(src.source_file);
    dst.begin = src.begin;
    dst.end = src.end;
    dst.semantic = src.semantic;
    dst.pb_has0 = src.pb_has0;
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
}

// The number of values of path.
fn GeneratedCodeInfo_Annotation_path_len(m: GeneratedCodeInfo_Annotation&) -> i64 { return m.path.len; }

