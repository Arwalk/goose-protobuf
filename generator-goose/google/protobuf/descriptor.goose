fn MessageOptions_uninterpreted_option_len(m: MessageOptions&) -> i64 { return m.uninterpreted_option.len; }

// Message i of uninterpreted_option. Valid until it or m is cleared.
fn MessageOptions_uninterpreted_option_at(m: MessageOptions&, i: i64) -> UninterpretedOption& {
    let pb_l = pb_run(UninterpretedOption_links, m.uninterpreted_option)[i].m;
    assert(pb_l);
    return pb_l;
}

// Adds an empty message to uninterpreted_option and returns it.
fn MessageOptions_add_uninterpreted_option(m: MessageOptions&) -> UninterpretedOption& {
    let pb_i: i64 = m.uninterpreted_option.len;
    m.uninterpreted_option = pb_resize(UninterpretedOption_links, m.uninterpreted_option, pb_i + 1);
    let pb_new .= UninterpretedOption_pool.alloc_ref(UninterpretedOption { .. });
    pb_run(UninterpretedOption_links, m.uninterpreted_option)[pb_i].m .= pb_new;
    return pb_new;
}

// Frees the messages of uninterpreted_option and everything they own.
fn MessageOptions_clear_uninterpreted_option(m: MessageOptions&) {
    for pb_ref in pb_run(UninterpretedOption_links, m.uninterpreted_option) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        UninterpretedOption_clear(pb_l);
        UninterpretedOption_pool.free(UninterpretedOption_pool.index_of(pb_l));
    }
    m.uninterpreted_option = pb_resize(UninterpretedOption_links, m.uninterpreted_option, 0);
}

// message google.protobuf.FieldOptions
struct FieldOptions {
    ctype: i32,
    packed: bool,
    jstype: i32,
    lazy: bool,
    unverified_lazy: bool,
    deprecated: bool,
    weak: bool,
    debug_redact: bool,
    retention: i32,
    targets: pb_Span,
    edition_defaults: pb_Span,
    features: FeatureSet_Ref,
    feature_support: FieldOptions_FeatureSupport_Ref,
    uninterpreted_option: pb_Span,
    pb_has0: u32,   // has-bits of fields with presence
    pb_unknown: pb_Span,   // unknown fields: raw wire bytes in pb_bytes
}

// A link to a FieldOptions in FieldOptions_pool, for sub-message fields.
struct FieldOptions_Ref { m: FieldOptions&<u32 in FieldOptions_pool>? }
reusable var FieldOptions_pool: FieldOptions[>..] = [];
reusable[] var FieldOptions_links: FieldOptions_Ref[>..] = [];

// Merges the fields in r's window into m; on failure r.err is set.
// Fields it does not know, or with another wire type, are kept as
// unknown fields.
fn FieldOptions_decode_from(r: pb_Reader&, m: FieldOptions&) {
    var unknown_len: i64 = m.pb_unknown.len;
    let unknown_had: i64 = unknown_len;
    let pb_had19: i64 = m.targets.len;
    var pb_len19: i64 = pb_had19;
    let pb_had20: i64 = m.edition_defaults.len;
    var pb_len20: i64 = pb_had20;
    let pb_had999: i64 = m.uninterpreted_option.len;
    var pb_len999: i64 = pb_had999;
    while r.pos < r.end {
        let start = r.pos;
        let tag = pb_read_tag(r);
        if r.err != PB_OK { break; }
        if tag == 8 {
            let pb_v = pb_u64_to_int32(pb_read_varint(r));
            if r.err != PB_OK { break; }
            if (pb_v >= 0 && pb_v <= 2) {
                m.ctype = pb_v;
                m.pb_has0 |= 0x00000001;
            } else {
                pb_unknown_keep(r, start, m.pb_unknown, unknown_len, unknown_had);
            }
        } else if tag == 16 {
            m.packed = pb_read_varint(r) != 0;
            m.pb_has0 |= 0x00000002;
        } else if tag == 48 {
            let pb_v = pb_u64_to_int32(pb_read_varint(r));
            if r.err != PB_OK { break; }
            if (pb_v >= 0 && pb_v <= 2) {
                m.jstype = pb_v;
                m.pb_has0 |= 0x00000004;
            } else {
                pb_unknown_keep(r, start, m.pb_unknown, unknown_len, unknown_had);
            }
        } else if tag == 40 {
            m.lazy = pb_read_varint(r) != 0;
            m.pb_has0 |= 0x00000008;
        } else if tag == 120 {
            m.unverified_lazy = pb_read_varint(r) != 0;
            m.pb_has0 |= 0x00000010;
        } else if tag == 24 {
            m.deprecated = pb_read_varint(r) != 0;
            m.pb_has0 |= 0x00000020;
        } else if tag == 80 {
            m.weak = pb_read_varint(r) != 0;
            m.pb_has0 |= 0x00000040;
        } else if tag == 128 {
            m.debug_redact = pb_read_varint(r) != 0;
            m.pb_has0 |= 0x00000080;
        } else if tag == 136 {
            let pb_v = pb_u64_to_int32(pb_read_varint(r));
            if r.err != PB_OK { break; }
            if (pb_v >= 0 && pb_v <= 2) {
                m.retention = pb_v;
                m.pb_has0 |= 0x00000100;
            } else {
                pb_unknown_keep(r, start, m.pb_unknown, unknown_len, unknown_had);
            }
        } else if tag == 152 {
            let pb_v = pb_u64_to_int32(pb_read_varint(r));
            if r.err != PB_OK { break; }
            if (pb_v >= 0 && pb_v <= 9) {
                pb_charge(r, 4);
                pb_append(pb_i32s, m.targets, pb_len19, pb_had19, pb_v);
            } else {
                pb_unknown_keep(r, start, m.pb_unknown, unknown_len, unknown_had);
            }
        } else if tag == 154 {
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            while r.pos < r.end {
                let pb_at = r.pos;
                let pb_v = pb_u64_to_int32(pb_read_varint(r));
                if r.err != PB_OK { break; }
                if (pb_v >= 0 && pb_v <= 9) {
                    pb_charge(r, 4);
                    pb_append(pb_i32s, m.targets, pb_len19, pb_had19, pb_v);
                } else {
                    pb_unknown_element(r, 152, pb_at, m.pb_unknown, unknown_len, unknown_had);
                }
            }
            if r.err != PB_OK { break; }
            r.end = pb_outer;
        } else if tag == 162 {
            pb_charge(r, 48);
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            if r.depth >= PB_MAX_DEPTH { pb_fail(r, PB_ERR_DEPTH); break; }
            pb_reserve(FieldOptions_EditionDefault_links, m.edition_defaults, pb_len20, pb_had20);
            let pb_sub .= FieldOptions_EditionDefault_pool.alloc_ref(FieldOptions_EditionDefault { .. });
            pb_run(FieldOptions_EditionDefault_links, m.edition_defaults)[pb_len20].m .= pb_sub;
            pb_len20++;
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            r.depth++;
            FieldOptions_EditionDefault_decode_from(r, pb_sub);
            if r.err != PB_OK { break; }
            r.depth--;
            r.end = pb_outer;
        } else if tag == 170 {
            pb_charge(r, 104);
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            if r.depth >= PB_MAX_DEPTH { pb_fail(r, PB_ERR_DEPTH); break; }
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            r.depth++;
            FeatureSet_decode_from(r, FieldOptions_mutable_features(m));
            if r.err != PB_OK { break; }
            r.depth--;
            r.end = pb_outer;
        } else if tag == 178 {
            pb_charge(r, 72);
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            if r.depth >= PB_MAX_DEPTH { pb_fail(r, PB_ERR_DEPTH); break; }
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            r.depth++;
            FieldOptions_FeatureSupport_decode_from(r, FieldOptions_mutable_feature_support(m));
            if r.err != PB_OK { break; }
            r.depth--;
            r.end = pb_outer;
        } else if tag == 7994 {
            pb_charge(r, 88);
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            if r.depth >= PB_MAX_DEPTH { pb_fail(r, PB_ERR_DEPTH); break; }
            pb_reserve(UninterpretedOption_links, m.uninterpreted_option, pb_len999, pb_had999);
            let pb_sub .= UninterpretedOption_pool.alloc_ref(UninterpretedOption { .. });
            pb_run(UninterpretedOption_links, m.uninterpreted_option)[pb_len999].m .= pb_sub;
            pb_len999++;
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            r.depth++;
            UninterpretedOption_decode_from(r, pb_sub);
            if r.err != PB_OK { break; }
            r.depth--;
            r.end = pb_outer;
        } else {
            pb_unknown_append(r, start, tag, m.pb_unknown, unknown_len, unknown_had);
        }
    }
    m.targets = pb_trim(pb_i32s, m.targets, pb_len19);
    m.edition_defaults = pb_trim(FieldOptions_EditionDefault_links, m.edition_defaults, pb_len20);
    m.uninterpreted_option = pb_trim(UninterpretedOption_links, m.uninterpreted_option, pb_len999);
    m.pb_unknown = pb_bytes_trim(m.pb_unknown, unknown_len);
}

// Merges buf into m. 0 on success, else a PB_ERR_* code; m then holds a
// partial message, which the caller clears.
fn FieldOptions_decode(buf: const u8[:], m: FieldOptions&) -> i32 {
    var r = pb_reader(buf);
    FieldOptions_decode_from(r, m);
    if r.err == PB_OK && !FieldOptions_is_initialized(m) { return PB_ERR_REQUIRED; }
    return r.err;
}

// Appends m's wire encoding, FieldOptions_size_of(m) bytes, to out.
fn FieldOptions_encode(m: FieldOptions&, out: u8[>..]&) {
    if (m.pb_has0 & 0x00000001) != 0 {
        pb_write_varint(out, 8);
        pb_write_varint(out, pb_int32_to_u64(m.ctype));
    }
    if (m.pb_has0 & 0x00000002) != 0 {
        pb_write_varint(out, 16);
        pb_write_varint(out, pb_bool_to_u64(m.packed));
    }
    if (m.pb_has0 & 0x00000020) != 0 {
        pb_write_varint(out, 24);
        pb_write_varint(out, pb_bool_to_u64(m.deprecated));
    }
    if (m.pb_has0 & 0x00000008) != 0 {
        pb_write_varint(out, 40);
        pb_write_varint(out, pb_bool_to_u64(m.lazy));
    }
    if (m.pb_has0 & 0x00000004) != 0 {
        pb_write_varint(out, 48);
        pb_write_varint(out, pb_int32_to_u64(m.jstype));
    }
    if (m.pb_has0 & 0x00000040) != 0 {
        pb_write_varint(out, 80);
        pb_write_varint(out, pb_bool_to_u64(m.weak));
    }
    if (m.pb_has0 & 0x00000010) != 0 {
        pb_write_varint(out, 120);
        pb_write_varint(out, pb_bool_to_u64(m.unverified_lazy));
    }
    if (m.pb_has0 & 0x00000080) != 0 {
        pb_write_varint(out, 128);
        pb_write_varint(out, pb_bool_to_u64(m.debug_redact));
    }
    if (m.pb_has0 & 0x00000100) != 0 {
        pb_write_varint(out, 136);
        pb_write_varint(out, pb_int32_to_u64(m.retention));
    }
    if m.targets.len > 0 {
        for pb_v in pb_run(pb_i32s, m.targets) {
            pb_write_varint(out, 152);
            pb_write_varint(out, pb_int32_to_u64(pb_v));
        }
    }
    for pb_ref in pb_run(FieldOptions_EditionDefault_links, m.edition_defaults) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        pb_write_varint(out, 162);
        pb_write_varint(out, FieldOptions_EditionDefault_size_of(pb_l) as! u64);
        FieldOptions_EditionDefault_encode(pb_l, out);
    }
    let pb_f21 = m.features.m;
    if pb_f21 {
        pb_write_varint(out, 170);
        pb_write_varint(out, FeatureSet_size_of(pb_f21) as! u64);
        FeatureSet_encode(pb_f21, out);
    }
    let pb_f22 = m.feature_support.m;
    if pb_f22 {
        pb_write_varint(out, 178);
        pb_write_varint(out, FieldOptions_FeatureSupport_size_of(pb_f22) as! u64);
        FieldOptions_FeatureSupport_encode(pb_f22, out);
    }
    for pb_ref in pb_run(UninterpretedOption_links, m.uninterpreted_option) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        pb_write_varint(out, 7994);
        pb_write_varint(out, UninterpretedOption_size_of(pb_l) as! u64);
        UninterpretedOption_encode(pb_l, out);
    }
    out.append(pb_run(pb_bytes, m.pb_unknown));
}

// The size of m's wire encoding, in bytes.
fn FieldOptions_size_of(m: FieldOptions&) -> i64 {
    var n: i64 = 0;
    if (m.pb_has0 & 0x00000001) != 0 { n += 1 + pb_varint_size(pb_int32_to_u64(m.ctype)); }
    if (m.pb_has0 & 0x00000002) != 0 { n += 2; }
    if (m.pb_has0 & 0x00000020) != 0 { n += 2; }
    if (m.pb_has0 & 0x00000008) != 0 { n += 2; }
    if (m.pb_has0 & 0x00000004) != 0 { n += 1 + pb_varint_size(pb_int32_to_u64(m.jstype)); }
    if (m.pb_has0 & 0x00000040) != 0 { n += 2; }
    if (m.pb_has0 & 0x00000010) != 0 { n += 2; }
    if (m.pb_has0 & 0x00000080) != 0 { n += 3; }
    if (m.pb_has0 & 0x00000100) != 0 { n += 2 + pb_varint_size(pb_int32_to_u64(m.retention)); }
    if m.targets.len > 0 {
        var pb_n: i64 = 0;
        for pb_v in pb_run(pb_i32s, m.targets) { pb_n += pb_varint_size(pb_int32_to_u64(pb_v)); }
        n += 2 * m.targets.len + pb_n;
    }
    for pb_ref in pb_run(FieldOptions_EditionDefault_links, m.edition_defaults) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        n += 2 + pb_len_size(FieldOptions_EditionDefault_size_of(pb_l));
    }
    let pb_f21 = m.features.m;
    if pb_f21 { n += 2 + pb_len_size(FeatureSet_size_of(pb_f21)); }
    let pb_f22 = m.feature_support.m;
    if pb_f22 { n += 2 + pb_len_size(FieldOptions_FeatureSupport_size_of(pb_f22)); }
    for pb_ref in pb_run(UninterpretedOption_links, m.uninterpreted_option) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        n += 2 + pb_len_size(UninterpretedOption_size_of(pb_l));
    }
    n += m.pb_unknown.len;
    return n;
}

// Frees what m owns and resets it to the empty message.
fn FieldOptions_clear(m: FieldOptions&) {
    m.ctype = 0;
    m.packed = false;
    m.jstype = 0;
    m.lazy = false;
    m.unverified_lazy = false;
    m.deprecated = false;
    m.weak = false;
    m.debug_redact = false;
    m.retention = 0;
    m.targets = pb_resize(pb_i32s, m.targets, 0);
    FieldOptions_clear_edition_defaults(m);
    FieldOptions_clear_features(m);
    FieldOptions_clear_feature_support(m);
    FieldOptions_clear_uninterpreted_option(m);
    m.pb_has0 = 0;
    m.pb_unknown = pb_bytes_free(m.pb_unknown);
}

// Makes dst a deep copy of src, freeing what dst owned. The two share
// nothing afterwards. Neither may be a sub-message of the other.
fn FieldOptions_copy(dst: FieldOptions&, src: FieldOptions&) {
    if dst .== src { return; }
    FieldOptions_clear(dst);
    dst.ctype = src.ctype;
    dst.packed = src.packed;
    dst.jstype = src.jstype;
    dst.lazy = src.lazy;
    dst.unverified_lazy = src.unverified_lazy;
    dst.deprecated = src.deprecated;
    dst.weak = src.weak;
    dst.debug_redact = src.debug_redact;
    dst.retention = src.retention;
    dst.targets = pb_copy_run(pb_i32s, src.targets);
    dst.edition_defaults = pb_resize(FieldOptions_EditionDefault_links, dst.edition_defaults, src.edition_defaults.len);
    for pb_i in src.edition_defaults.len {
        let pb_l = pb_run(FieldOptions_EditionDefault_links, src.edition_defaults)[pb_i].m;
        guard pb_l else { continue; }
        let pb_c .= FieldOptions_EditionDefault_pool.alloc_ref(FieldOptions_EditionDefault { .. });
        pb_run(FieldOptions_EditionDefault_links, dst.edition_defaults)[pb_i].m .= pb_c;
        FieldOptions_EditionDefault_copy(pb_c, pb_l);
    }
    let pb_f21 = src.features.m;
    if pb_f21 { FeatureSet_copy(FieldOptions_mutable_features(dst), pb_f21); }
    let pb_f22 = src.feature_support.m;
    if pb_f22 { FieldOptions_FeatureSupport_copy(FieldOptions_mutable_feature_support(dst), pb_f22); }
    dst.uninterpreted_option = pb_resize(UninterpretedOption_links, dst.uninterpreted_option, src.uninterpreted_option.len);
    for pb_i in src.uninterpreted_option.len {
        let pb_l = pb_run(UninterpretedOption_links, src.uninterpreted_option)[pb_i].m;
        guard pb_l else { continue; }
        let pb_c .= UninterpretedOption_pool.alloc_ref(UninterpretedOption { .. });
        pb_run(UninterpretedOption_links, dst.uninterpreted_option)[pb_i].m .= pb_c;
        UninterpretedOption_copy(pb_c, pb_l);
    }
    dst.pb_has0 = src.pb_has0;
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
}

// True if every required field is set, in m and in the messages it holds.
fn FieldOptions_is_initialized(m: FieldOptions&) -> bool {
    for pb_ref in pb_run(UninterpretedOption_links, m.uninterpreted_option) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        if !UninterpretedOption_is_initialized(pb_l) { return false; }
    }
    return true;
}

// Sets ctype and marks it present:
// it is encoded even when 0.
fn FieldOptions_set_ctype(m: FieldOptions&, v: i32) {
    m.ctype = v;
    m.pb_has0 |= 0x00000001;
}

fn FieldOptions_has_ctype(m: FieldOptions&) -> bool { return (m.pb_has0 & 0x00000001) != 0; }

fn FieldOptions_clear_ctype(m: FieldOptions&) {
    m.ctype = 0;
    m.pb_has0 &= 0xfffffffe;
}

// Sets packed and marks it present:
// it is encoded even when 0.
fn FieldOptions_set_packed(m: FieldOptions&, v: bool) {
    m.packed = v;
    m.pb_has0 |= 0x00000002;
}

fn FieldOptions_has_packed(m: FieldOptions&) -> bool { return (m.pb_has0 & 0x00000002) != 0; }

fn FieldOptions_clear_packed(m: FieldOptions&) {
    m.packed = false;
    m.pb_has0 &= 0xfffffffd;
}

// Sets jstype and marks it present:
// it is encoded even when 0.
fn FieldOptions_set_jstype(m: FieldOptions&, v: i32) {
    m.jstype = v;
    m.pb_has0 |= 0x00000004;
}

fn FieldOptions_has_jstype(m: FieldOptions&) -> bool { return (m.pb_has0 & 0x00000004) != 0; }

fn FieldOptions_clear_jstype(m: FieldOptions&) {
