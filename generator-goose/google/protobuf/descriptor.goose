// message google.protobuf.FileOptions
struct FileOptions {
    java_package: pb_Span,
    java_outer_classname: pb_Span,
    java_multiple_files: bool,
    java_generate_equals_and_hash: bool,
    java_string_check_utf8: bool,
    optimize_for: i32 = 1,
    go_package: pb_Span,
    cc_generic_services: bool,
    java_generic_services: bool,
    py_generic_services: bool,
    deprecated: bool,
    cc_enable_arenas: bool = true,
    objc_class_prefix: pb_Span,
    csharp_namespace: pb_Span,
    swift_prefix: pb_Span,
    php_class_prefix: pb_Span,
    php_namespace: pb_Span,
    php_metadata_namespace: pb_Span,
    ruby_package: pb_Span,
    features: FeatureSet_Ref,
    uninterpreted_option: pb_Span,
    pb_has0: u32,   // has-bits of fields with presence
    pb_unknown: pb_Span,   // unknown fields: raw wire bytes in pb_bytes
}

// A link to a FileOptions in FileOptions_pool, for sub-message fields.
struct FileOptions_Ref { m: FileOptions&<u32 in FileOptions_pool>? }
reusable var FileOptions_pool: FileOptions[>..] = [];
reusable[] var FileOptions_links: FileOptions_Ref[>..] = [];

// Merges the fields in r's window into m; on failure r.err is set.
// Fields it does not know, or with another wire type, are kept as
// unknown fields.
fn FileOptions_decode_from(r: pb_Reader&, m: FileOptions&) {
    var unknown_len: i64 = m.pb_unknown.len;
    let unknown_had: i64 = unknown_len;
    let pb_had999: i64 = m.uninterpreted_option.len;
    var pb_len999: i64 = pb_had999;
    while r.pos < r.end {
        let start = r.pos;
        let tag = pb_read_tag(r);
        if r.err != PB_OK { break; }
        if tag == 10 {
            m.java_package = pb_read_bytes(r, m.java_package);
            m.pb_has0 |= 0x00000001;
        } else if tag == 66 {
            m.java_outer_classname = pb_read_bytes(r, m.java_outer_classname);
            m.pb_has0 |= 0x00000002;
        } else if tag == 80 {
            m.java_multiple_files = pb_read_varint(r) != 0;
            m.pb_has0 |= 0x00000004;
        } else if tag == 160 {
            m.java_generate_equals_and_hash = pb_read_varint(r) != 0;
            m.pb_has0 |= 0x00000008;
        } else if tag == 216 {
            m.java_string_check_utf8 = pb_read_varint(r) != 0;
            m.pb_has0 |= 0x00000010;
        } else if tag == 72 {
            let pb_v = pb_u64_to_int32(pb_read_varint(r));
            if r.err != PB_OK { break; }
            if (pb_v >= 1 && pb_v <= 3) {
                m.optimize_for = pb_v;
                m.pb_has0 |= 0x00000020;
            } else {
                pb_unknown_keep(r, start, m.pb_unknown, unknown_len, unknown_had);
            }
        } else if tag == 90 {
            m.go_package = pb_read_bytes(r, m.go_package);
            m.pb_has0 |= 0x00000040;
        } else if tag == 128 {
            m.cc_generic_services = pb_read_varint(r) != 0;
            m.pb_has0 |= 0x00000080;
        } else if tag == 136 {
            m.java_generic_services = pb_read_varint(r) != 0;
            m.pb_has0 |= 0x00000100;
        } else if tag == 144 {
            m.py_generic_services = pb_read_varint(r) != 0;
            m.pb_has0 |= 0x00000200;
        } else if tag == 184 {
            m.deprecated = pb_read_varint(r) != 0;
            m.pb_has0 |= 0x00000400;
        } else if tag == 248 {
            m.cc_enable_arenas = pb_read_varint(r) != 0;
            m.pb_has0 |= 0x00000800;
        } else if tag == 290 {
            m.objc_class_prefix = pb_read_bytes(r, m.objc_class_prefix);
            m.pb_has0 |= 0x00001000;
        } else if tag == 298 {
            m.csharp_namespace = pb_read_bytes(r, m.csharp_namespace);
            m.pb_has0 |= 0x00002000;
        } else if tag == 314 {
            m.swift_prefix = pb_read_bytes(r, m.swift_prefix);
            m.pb_has0 |= 0x00004000;
        } else if tag == 322 {
            m.php_class_prefix = pb_read_bytes(r, m.php_class_prefix);
            m.pb_has0 |= 0x00008000;
        } else if tag == 330 {
            m.php_namespace = pb_read_bytes(r, m.php_namespace);
            m.pb_has0 |= 0x00010000;
        } else if tag == 354 {
            m.php_metadata_namespace = pb_read_bytes(r, m.php_metadata_namespace);
            m.pb_has0 |= 0x00020000;
        } else if tag == 362 {
            m.ruby_package = pb_read_bytes(r, m.ruby_package);
            m.pb_has0 |= 0x00040000;
        } else if tag == 402 {
            pb_charge(r, 104);
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            if r.depth >= PB_MAX_DEPTH { pb_fail(r, PB_ERR_DEPTH); break; }
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            r.depth++;
            FeatureSet_decode_from(r, FileOptions_mutable_features(m));
            if r.err != PB_OK { break; }
            r.depth--;
            r.end = pb_outer;
        } else if tag == 7994 {
            pb_charge(r, 88);
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            if r.depth >= PB_MAX_DEPTH { pb_fail(r, PB_ERR_DEPTH); break; }
            pb_reserve(UninterpretedOption_links, m.uninterpreted_option, pb_len999, pb_had999);
            let pb_sub .= UninterpretedOption_pool.alloc_ref(UninterpretedOption { .. });
            pb_run(UninterpretedOption_links, m.uninterpreted_option)[pb_len999].m .= pb_sub;
            pb_len999++;
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            r.depth++;
            UninterpretedOption_decode_from(r, pb_sub);
            if r.err != PB_OK { break; }
            r.depth--;
            r.end = pb_outer;
        } else {
            pb_unknown_append(r, start, tag, m.pb_unknown, unknown_len, unknown_had);
        }
    }
    m.uninterpreted_option = pb_trim(UninterpretedOption_links, m.uninterpreted_option, pb_len999);
    m.pb_unknown = pb_bytes_trim(m.pb_unknown, unknown_len);
}

// Merges buf into m. 0 on success, else a PB_ERR_* code; m then holds a
// partial message, which the caller clears.
fn FileOptions_decode(buf: const u8[:], m: FileOptions&) -> i32 {
    var r = pb_reader(buf);
    FileOptions_decode_from(r, m);
    if r.err == PB_OK && !FileOptions_is_initialized(m) { return PB_ERR_REQUIRED; }
    return r.err;
}

// Appends m's wire encoding, FileOptions_size_of(m) bytes, to out.
fn FileOptions_encode(m: FileOptions&, out: u8[>..]&) {
    if (m.pb_has0 & 0x00000001) != 0 {
        pb_write_varint(out, 10);
        pb_write_bytes(out, m.java_package);
    }
    if (m.pb_has0 & 0x00000002) != 0 {
        pb_write_varint(out, 66);
        pb_write_bytes(out, m.java_outer_classname);
    }
    if (m.pb_has0 & 0x00000020) != 0 {
        pb_write_varint(out, 72);
        pb_write_varint(out, pb_int32_to_u64(m.optimize_for));
    }
    if (m.pb_has0 & 0x00000004) != 0 {
        pb_write_varint(out, 80);
        pb_write_varint(out, pb_bool_to_u64(m.java_multiple_files));
    }
    if (m.pb_has0 & 0x00000040) != 0 {
        pb_write_varint(out, 90);
        pb_write_bytes(out, m.go_package);
    }
    if (m.pb_has0 & 0x00000080) != 0 {
        pb_write_varint(out, 128);
        pb_write_varint(out, pb_bool_to_u64(m.cc_generic_services));
    }
    if (m.pb_has0 & 0x00000100) != 0 {
        pb_write_varint(out, 136);
        pb_write_varint(out, pb_bool_to_u64(m.java_generic_services));
    }
    if (m.pb_has0 & 0x00000200) != 0 {
        pb_write_varint(out, 144);
        pb_write_varint(out, pb_bool_to_u64(m.py_generic_services));
    }
    if (m.pb_has0 & 0x00000008) != 0 {
        pb_write_varint(out, 160);
        pb_write_varint(out, pb_bool_to_u64(m.java_generate_equals_and_hash));
    }
    if (m.pb_has0 & 0x00000400) != 0 {
        pb_write_varint(out, 184);
        pb_write_varint(out, pb_bool_to_u64(m.deprecated));
    }
    if (m.pb_has0 & 0x00000010) != 0 {
        pb_write_varint(out, 216);
        pb_write_varint(out, pb_bool_to_u64(m.java_string_check_utf8));
    }
    if (m.pb_has0 & 0x00000800) != 0 {
        pb_write_varint(out, 248);
        pb_write_varint(out, pb_bool_to_u64(m.cc_enable_arenas));
    }
    if (m.pb_has0 & 0x00001000) != 0 {
        pb_write_varint(out, 290);
        pb_write_bytes(out, m.objc_class_prefix);
    }
    if (m.pb_has0 & 0x00002000) != 0 {
        pb_write_varint(out, 298);
        pb_write_bytes(out, m.csharp_namespace);
    }
    if (m.pb_has0 & 0x00004000) != 0 {
        pb_write_varint(out, 314);
        pb_write_bytes(out, m.swift_prefix);
    }
    if (m.pb_has0 & 0x00008000) != 0 {
        pb_write_varint(out, 322);
        pb_write_bytes(out, m.php_class_prefix);
    }
    if (m.pb_has0 & 0x00010000) != 0 {
        pb_write_varint(out, 330);
        pb_write_bytes(out, m.php_namespace);
    }
    if (m.pb_has0 & 0x00020000) != 0 {
        pb_write_varint(out, 354);
        pb_write_bytes(out, m.php_metadata_namespace);
    }
    if (m.pb_has0 & 0x00040000) != 0 {
        pb_write_varint(out, 362);
        pb_write_bytes(out, m.ruby_package);
    }
    let pb_f50 = m.features.m;
    if pb_f50 {
        pb_write_varint(out, 402);
        pb_write_varint(out, FeatureSet_size_of(pb_f50) as! u64);
        FeatureSet_encode(pb_f50, out);
    }
    for pb_ref in pb_run(UninterpretedOption_links, m.uninterpreted_option) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        pb_write_varint(out, 7994);
        pb_write_varint(out, UninterpretedOption_size_of(pb_l) as! u64);
        UninterpretedOption_encode(pb_l, out);
    }
    out.append(pb_run(pb_bytes, m.pb_unknown));
}

// The size of m's wire encoding, in bytes.
fn FileOptions_size_of(m: FileOptions&) -> i64 {
    var n: i64 = 0;
    if (m.pb_has0 & 0x00000001) != 0 { n += 1 + pb_bytes_size(m.java_package); }
    if (m.pb_has0 & 0x00000002) != 0 { n += 1 + pb_bytes_size(m.java_outer_classname); }
    if (m.pb_has0 & 0x00000020) != 0 { n += 1 + pb_varint_size(pb_int32_to_u64(m.optimize_for)); }
    if (m.pb_has0 & 0x00000004) != 0 { n += 2; }
    if (m.pb_has0 & 0x00000040) != 0 { n += 1 + pb_bytes_size(m.go_package); }
    if (m.pb_has0 & 0x00000080) != 0 { n += 3; }
    if (m.pb_has0 & 0x00000100) != 0 { n += 3; }
    if (m.pb_has0 & 0x00000200) != 0 { n += 3; }
    if (m.pb_has0 & 0x00000008) != 0 { n += 3; }
    if (m.pb_has0 & 0x00000400) != 0 { n += 3; }
    if (m.pb_has0 & 0x00000010) != 0 { n += 3; }
    if (m.pb_has0 & 0x00000800) != 0 { n += 3; }
    if (m.pb_has0 & 0x00001000) != 0 { n += 2 + pb_bytes_size(m.objc_class_prefix); }
    if (m.pb_has0 & 0x00002000) != 0 { n += 2 + pb_bytes_size(m.csharp_namespace); }
    if (m.pb_has0 & 0x00004000) != 0 { n += 2 + pb_bytes_size(m.swift_prefix); }
    if (m.pb_has0 & 0x00008000) != 0 { n += 2 + pb_bytes_size(m.php_class_prefix); }
    if (m.pb_has0 & 0x00010000) != 0 { n += 2 + pb_bytes_size(m.php_namespace); }
    if (m.pb_has0 & 0x00020000) != 0 { n += 2 + pb_bytes_size(m.php_metadata_namespace); }
    if (m.pb_has0 & 0x00040000) != 0 { n += 2 + pb_bytes_size(m.ruby_package); }
    let pb_f50 = m.features.m;
    if pb_f50 { n += 2 + pb_len_size(FeatureSet_size_of(pb_f50)); }
    for pb_ref in pb_run(UninterpretedOption_links, m.uninterpreted_option) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        n += 2 + pb_len_size(UninterpretedOption_size_of(pb_l));
    }
    n += m.pb_unknown.len;
    return n;
}

// Frees what m owns and resets it to the empty message.
fn FileOptions_clear(m: FileOptions&) {
    m.java_package = pb_bytes_free(m.java_package);
    m.java_outer_classname = pb_bytes_free(m.java_outer_classname);
    m.java_multiple_files = false;
    m.java_generate_equals_and_hash = false;
    m.java_string_check_utf8 = false;
    m.optimize_for = 1;
    m.go_package = pb_bytes_free(m.go_package);
    m.cc_generic_services = false;
    m.java_generic_services = false;
    m.py_generic_services = false;
    m.deprecated = false;
    m.cc_enable_arenas = true;
    m.objc_class_prefix = pb_bytes_free(m.objc_class_prefix);
    m.csharp_namespace = pb_bytes_free(m.csharp_namespace);
    m.swift_prefix = pb_bytes_free(m.swift_prefix);
    m.php_class_prefix = pb_bytes_free(m.php_class_prefix);
    m.php_namespace = pb_bytes_free(m.php_namespace);
    m.php_metadata_namespace = pb_bytes_free(m.php_metadata_namespace);
    m.ruby_package = pb_bytes_free(m.ruby_package);
    FileOptions_clear_features(m);
    FileOptions_clear_uninterpreted_option(m);
    m.pb_has0 = 0;
    m.pb_unknown = pb_bytes_free(m.pb_unknown);
}

// Makes dst a deep copy of src, freeing what dst owned. The two share
// nothing afterwards. Neither may be a sub-message of the other.
fn FileOptions_copy(dst: FileOptions&, src: FileOptions&) {
    if dst .== src { return; }
    FileOptions_clear(dst);
    dst.java_package = pb_bytes_copy(src.java_package);
    dst.java_outer_classname = pb_bytes_copy(src.java_outer_classname);
    dst.java_multiple_files = src.java_multiple_files;
    dst.java_generate_equals_and_hash = src.java_generate_equals_and_hash;
    dst.java_string_check_utf8 = src.java_string_check_utf8;
    dst.optimize_for = src.optimize_for;
    dst.go_package = pb_bytes_copy(src.go_package);
    dst.cc_generic_services = src.cc_generic_services;
    dst.java_generic_services = src.java_generic_services;
    dst.py_generic_services = src.py_generic_services;
    dst.deprecated = src.deprecated;
    dst.cc_enable_arenas = src.cc_enable_arenas;
    dst.objc_class_prefix = pb_bytes_copy(src.objc_class_prefix);
    dst.csharp_namespace = pb_bytes_copy(src.csharp_namespace);
    dst.swift_prefix = pb_bytes_copy(src.swift_prefix);
    dst.php_class_prefix = pb_bytes_copy(src.php_class_prefix);
    dst.php_namespace = pb_bytes_copy(src.php_namespace);
    dst.php_metadata_namespace = pb_bytes_copy(src.php_metadata_namespace);
    dst.ruby_package = pb_bytes_copy(src.ruby_package);
    let pb_f50 = src.features.m;
    if pb_f50 { FeatureSet_copy(FileOptions_mutable_features(dst), pb_f50); }
    dst.uninterpreted_option = pb_resize(UninterpretedOption_links, dst.uninterpreted_option, src.uninterpreted_option.len);
    for pb_i in src.uninterpreted_option.len {
        let pb_l = pb_run(UninterpretedOption_links, src.uninterpreted_option)[pb_i].m;
        guard pb_l else { continue; }
        let pb_c .= UninterpretedOption_pool.alloc_ref(UninterpretedOption { .. });
        pb_run(UninterpretedOption_links, dst.uninterpreted_option)[pb_i].m .= pb_c;
        UninterpretedOption_copy(pb_c, pb_l);
    }
    dst.pb_has0 = src.pb_has0;
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
}

// True if every required field is set, in m and in the messages it holds.
fn FileOptions_is_initialized(m: FileOptions&) -> bool {
    for pb_ref in pb_run(UninterpretedOption_links, m.uninterpreted_option) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        if !UninterpretedOption_is_initialized(pb_l) { return false; }
    }
    return true;
}

