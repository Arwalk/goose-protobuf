fn MethodDescriptorProto_mutable_options(m: MethodDescriptorProto&) -> MethodOptions& {
    let pb_sub = m.options.m;
    if pb_sub { return pb_sub; }
    let pb_new .= MethodOptions_pool.alloc_ref(MethodOptions { .. });
    m.options.m .= pb_new;
    return pb_new;
