let FileOptions_OptimizeMode_SPEED: i32 = 1;
let FileOptions_OptimizeMode_CODE_SIZE: i32 = 2;
let FileOptions_OptimizeMode_LITE_RUNTIME: i32 = 3;

// message google.protobuf.MessageOptions
struct MessageOptions {
    message_set_wire_format: bool,
    no_standard_descriptor_accessor: bool,
    deprecated: bool,
    map_entry: bool,
    deprecated_legacy_json_field_conflicts: bool,
    features: FeatureSet_Ref,
    uninterpreted_option: pb_Span,
    pb_has0: u32,   // has-bits of fields with presence
    pb_unknown: pb_Span,   // unknown fields: raw wire bytes in pb_bytes
}

// A link to a MessageOptions in MessageOptions_pool, for sub-message fields.
struct MessageOptions_Ref { m: MessageOptions&<u32 in MessageOptions_pool>? }
reusable var MessageOptions_pool: MessageOptions[>..] = [];
reusable[] var MessageOptions_links: MessageOptions_Ref[>..] = [];

// Merges the fields in r's window into m; on failure r.err is set.
// Fields it does not know, or with another wire type, are kept as
// unknown fields.
fn MessageOptions_decode_from(r: pb_Reader&, m: MessageOptions&) {
    var unknown_len: i64 = m.pb_unknown.len;
    let unknown_had: i64 = unknown_len;
    let pb_had999: i64 = m.uninterpreted_option.len;
    var pb_len999: i64 = pb_had999;
    while r.pos < r.end {
        let start = r.pos;
        let tag = pb_read_tag(r);
        if r.err != PB_OK { break; }
        if tag == 8 {
            m.message_set_wire_format = pb_read_varint(r) != 0;
            m.pb_has0 |= 0x00000001;
        } else if tag == 16 {
            m.no_standard_descriptor_accessor = pb_read_varint(r) != 0;
            m.pb_has0 |= 0x00000002;
        } else if tag == 24 {
            m.deprecated = pb_read_varint(r) != 0;
            m.pb_has0 |= 0x00000004;
        } else if tag == 56 {
            m.map_entry = pb_read_varint(r) != 0;
            m.pb_has0 |= 0x00000008;
        } else if tag == 88 {
            m.deprecated_legacy_json_field_conflicts = pb_read_varint(r) != 0;
            m.pb_has0 |= 0x00000010;
        } else if tag == 98 {
            pb_charge(r, 104);
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            if r.depth >= PB_MAX_DEPTH { pb_fail(r, PB_ERR_DEPTH); break; }
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            r.depth++;
            FeatureSet_decode_from(r, MessageOptions_mutable_features(m));
            if r.err != PB_OK { break; }
            r.depth--;
            r.end = pb_outer;
        } else if tag == 7994 {
            pb_charge(r, 88);
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            if r.depth >= PB_MAX_DEPTH { pb_fail(r, PB_ERR_DEPTH); break; }
            pb_reserve(UninterpretedOption_links, m.uninterpreted_option, pb_len999, pb_had999);
            let pb_sub .= UninterpretedOption_pool.alloc_ref(UninterpretedOption { .. });
            pb_run(UninterpretedOption_links, m.uninterpreted_option)[pb_len999].m .= pb_sub;
            pb_len999++;
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            r.depth++;
            UninterpretedOption_decode_from(r, pb_sub);
            if r.err != PB_OK { break; }
            r.depth--;
            r.end = pb_outer;
        } else {
            pb_unknown_append(r, start, tag, m.pb_unknown, unknown_len, unknown_had);
        }
    }
    m.uninterpreted_option = pb_trim(UninterpretedOption_links, m.uninterpreted_option, pb_len999);
    m.pb_unknown = pb_bytes_trim(m.pb_unknown, unknown_len);
}

// Merges buf into m. 0 on success, else a PB_ERR_* code; m then holds a
// partial message, which the caller clears.
fn MessageOptions_decode(buf: const u8[:], m: MessageOptions&) -> i32 {
    var r = pb_reader(buf);
    MessageOptions_decode_from(r, m);
    if r.err == PB_OK && !MessageOptions_is_initialized(m) { return PB_ERR_REQUIRED; }
    return r.err;
}

// Appends m's wire encoding, MessageOptions_size_of(m) bytes, to out.
fn MessageOptions_encode(m: MessageOptions&, out: u8[>..]&) {
    if (m.pb_has0 & 0x00000001) != 0 {
        pb_write_varint(out, 8);
        pb_write_varint(out, pb_bool_to_u64(m.message_set_wire_format));
    }
    if (m.pb_has0 & 0x00000002) != 0 {
        pb_write_varint(out, 16);
        pb_write_varint(out, pb_bool_to_u64(m.no_standard_descriptor_accessor));
    }
    if (m.pb_has0 & 0x00000004) != 0 {
        pb_write_varint(out, 24);
        pb_write_varint(out, pb_bool_to_u64(m.deprecated));
    }
    if (m.pb_has0 & 0x00000008) != 0 {
        pb_write_varint(out, 56);
        pb_write_varint(out, pb_bool_to_u64(m.map_entry));
    }
    if (m.pb_has0 & 0x00000010) != 0 {
        pb_write_varint(out, 88);
        pb_write_varint(out, pb_bool_to_u64(m.deprecated_legacy_json_field_conflicts));
    }
    let pb_f12 = m.features.m;
    if pb_f12 {
        pb_write_varint(out, 98);
        pb_write_varint(out, FeatureSet_size_of(pb_f12) as! u64);
        FeatureSet_encode(pb_f12, out);
    }
    for pb_ref in pb_run(UninterpretedOption_links, m.uninterpreted_option) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        pb_write_varint(out, 7994);
        pb_write_varint(out, UninterpretedOption_size_of(pb_l) as! u64);
        UninterpretedOption_encode(pb_l, out);
    }
    out.append(pb_run(pb_bytes, m.pb_unknown));
}

// The size of m's wire encoding, in bytes.
fn MessageOptions_size_of(m: MessageOptions&) -> i64 {
    var n: i64 = 0;
    if (m.pb_has0 & 0x00000001) != 0 { n += 2; }
    if (m.pb_has0 & 0x00000002) != 0 { n += 2; }
    if (m.pb_has0 & 0x00000004) != 0 { n += 2; }
    if (m.pb_has0 & 0x00000008) != 0 { n += 2; }
    if (m.pb_has0 & 0x00000010) != 0 { n += 2; }
    let pb_f12 = m.features.m;
    if pb_f12 { n += 1 + pb_len_size(FeatureSet_size_of(pb_f12)); }
    for pb_ref in pb_run(UninterpretedOption_links, m.uninterpreted_option) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        n += 2 + pb_len_size(UninterpretedOption_size_of(pb_l));
    }
    n += m.pb_unknown.len;
    return n;
}

// Frees what m owns and resets it to the empty message.
fn MessageOptions_clear(m: MessageOptions&) {
    m.message_set_wire_format = false;
    m.no_standard_descriptor_accessor = false;
    m.deprecated = false;
    m.map_entry = false;
    m.deprecated_legacy_json_field_conflicts = false;
    MessageOptions_clear_features(m);
    MessageOptions_clear_uninterpreted_option(m);
    m.pb_has0 = 0;
    m.pb_unknown = pb_bytes_free(m.pb_unknown);
}

// Makes dst a deep copy of src, freeing what dst owned. The two share
// nothing afterwards. Neither may be a sub-message of the other.
fn MessageOptions_copy(dst: MessageOptions&, src: MessageOptions&) {
    if dst .== src { return; }
    MessageOptions_clear(dst);
    dst.message_set_wire_format = src.message_set_wire_format;
    dst.no_standard_descriptor_accessor = src.no_standard_descriptor_accessor;
    dst.deprecated = src.deprecated;
    dst.map_entry = src.map_entry;
    dst.deprecated_legacy_json_field_conflicts = src.deprecated_legacy_json_field_conflicts;
    let pb_f12 = src.features.m;
    if pb_f12 { FeatureSet_copy(MessageOptions_mutable_features(dst), pb_f12); }
    dst.uninterpreted_option = pb_resize(UninterpretedOption_links, dst.uninterpreted_option, src.uninterpreted_option.len);
    for pb_i in src.uninterpreted_option.len {
        let pb_l = pb_run(UninterpretedOption_links, src.uninterpreted_option)[pb_i].m;
        guard pb_l else { continue; }
        let pb_c .= UninterpretedOption_pool.alloc_ref(UninterpretedOption { .. });
        pb_run(UninterpretedOption_links, dst.uninterpreted_option)[pb_i].m .= pb_c;
        UninterpretedOption_copy(pb_c, pb_l);
    }
    dst.pb_has0 = src.pb_has0;
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
}

// True if every required field is set, in m and in the messages it holds.
fn MessageOptions_is_initialized(m: MessageOptions&) -> bool {
    for pb_ref in pb_run(UninterpretedOption_links, m.uninterpreted_option) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        if !UninterpretedOption_is_initialized(pb_l) { return false; }
    }
    return true;
}

