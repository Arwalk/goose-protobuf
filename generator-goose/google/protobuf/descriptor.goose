            pb_write_varint(out, pb_int32_to_u64(pb_v));
        }
    }
    if m.weak_dependency.len > 0 {
        for pb_v in pb_run(pb_i32s, m.weak_dependency) {
            pb_write_varint(out, 88);
            pb_write_varint(out, pb_int32_to_u64(pb_v));
        }
    }
    if (m.pb_has0 & 0x00000004) != 0 {
        pb_write_varint(out, 98);
        pb_write_bytes(out, m.syntax);
    }
    if (m.pb_has0 & 0x00000008) != 0 {
        pb_write_varint(out, 112);
        pb_write_varint(out, pb_int32_to_u64(m.edition));
    }
    for pb_v in pb_run(pb_spans, m.option_dependency) {
        pb_write_varint(out, 122);
        pb_write_bytes(out, pb_v);
    }
    out.append(pb_run(pb_bytes, m.pb_unknown));
}

// The size of m's wire encoding, in bytes.
fn FileDescriptorProto_size_of(m: FileDescriptorProto&) -> i64 {
    var n: i64 = 0;
    if (m.pb_has0 & 0x00000001) != 0 { n += 1 + pb_bytes_size(m.name); }
    if (m.pb_has0 & 0x00000002) != 0 { n += 1 + pb_bytes_size(m.package); }
    for pb_v in pb_run(pb_spans, m.dependency) { n += 1 + pb_bytes_size(pb_v); }
    for pb_ref in pb_run(DescriptorProto_links, m.message_type) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        n += 1 + pb_len_size(DescriptorProto_size_of(pb_l));
    }
    for pb_ref in pb_run(EnumDescriptorProto_links, m.enum_type) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        n += 1 + pb_len_size(EnumDescriptorProto_size_of(pb_l));
    }
    for pb_ref in pb_run(ServiceDescriptorProto_links, m.service) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        n += 1 + pb_len_size(ServiceDescriptorProto_size_of(pb_l));
    }
    for pb_ref in pb_run(FieldDescriptorProto_links, m.extension) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        n += 1 + pb_len_size(FieldDescriptorProto_size_of(pb_l));
    }
    let pb_f8 = m.options.m;
    if pb_f8 { n += 1 + pb_len_size(FileOptions_size_of(pb_f8)); }
    let pb_f9 = m.source_code_info.m;
    if pb_f9 { n += 1 + pb_len_size(SourceCodeInfo_size_of(pb_f9)); }
    if m.public_dependency.len > 0 {
        var pb_n: i64 = 0;
        for pb_v in pb_run(pb_i32s, m.public_dependency) { pb_n += pb_varint_size(pb_int32_to_u64(pb_v)); }
        n += 1 * m.public_dependency.len + pb_n;
    }
    if m.weak_dependency.len > 0 {
        var pb_n: i64 = 0;
        for pb_v in pb_run(pb_i32s, m.weak_dependency) { pb_n += pb_varint_size(pb_int32_to_u64(pb_v)); }
        n += 1 * m.weak_dependency.len + pb_n;
    }
    if (m.pb_has0 & 0x00000004) != 0 { n += 1 + pb_bytes_size(m.syntax); }
    if (m.pb_has0 & 0x00000008) != 0 { n += 1 + pb_varint_size(pb_int32_to_u64(m.edition)); }
    for pb_v in pb_run(pb_spans, m.option_dependency) { n += 1 + pb_bytes_size(pb_v); }
    n += m.pb_unknown.len;
    return n;
}

// Frees what m owns and resets it to the empty message.
fn FileDescriptorProto_clear(m: FileDescriptorProto&) {
    m.name = pb_bytes_free(m.name);
    m.package = pb_bytes_free(m.package);
    m.dependency = pb_spans_free(m.dependency);
    m.public_dependency = pb_resize(pb_i32s, m.public_dependency, 0);
    m.weak_dependency = pb_resize(pb_i32s, m.weak_dependency, 0);
    m.option_dependency = pb_spans_free(m.option_dependency);
    FileDescriptorProto_clear_message_type(m);
    FileDescriptorProto_clear_enum_type(m);
    FileDescriptorProto_clear_service(m);
    FileDescriptorProto_clear_extension(m);
    FileDescriptorProto_clear_options(m);
    FileDescriptorProto_clear_source_code_info(m);
    m.syntax = pb_bytes_free(m.syntax);
    m.edition = 0;
    m.pb_has0 = 0;
    m.pb_unknown = pb_bytes_free(m.pb_unknown);
}

// Makes dst a deep copy of src, freeing what dst owned. The two share
// nothing afterwards. Neither may be a sub-message of the other.
fn FileDescriptorProto_copy(dst: FileDescriptorProto&, src: FileDescriptorProto&) {
    if dst .== src { return; }
    FileDescriptorProto_clear(dst);
    dst.name = pb_bytes_copy(src.name);
    dst.package = pb_bytes_copy(src.package);
    dst.dependency = pb_spans_copy(src.dependency);
    dst.public_dependency = pb_copy_run(pb_i32s, src.public_dependency);
    dst.weak_dependency = pb_copy_run(pb_i32s, src.weak_dependency);
    dst.option_dependency = pb_spans_copy(src.option_dependency);
    dst.message_type = pb_resize(DescriptorProto_links, dst.message_type, src.message_type.len);
    for pb_i in src.message_type.len {
        let pb_l = pb_run(DescriptorProto_links, src.message_type)[pb_i].m;
        guard pb_l else { continue; }
        let pb_c .= DescriptorProto_pool.alloc_ref(DescriptorProto { .. });
        pb_run(DescriptorProto_links, dst.message_type)[pb_i].m .= pb_c;
        DescriptorProto_copy(pb_c, pb_l);
    }
    dst.enum_type = pb_resize(EnumDescriptorProto_links, dst.enum_type, src.enum_type.len);
    for pb_i in src.enum_type.len {
        let pb_l = pb_run(EnumDescriptorProto_links, src.enum_type)[pb_i].m;
        guard pb_l else { continue; }
        let pb_c .= EnumDescriptorProto_pool.alloc_ref(EnumDescriptorProto { .. });
        pb_run(EnumDescriptorProto_links, dst.enum_type)[pb_i].m .= pb_c;
        EnumDescriptorProto_copy(pb_c, pb_l);
    }
    dst.service = pb_resize(ServiceDescriptorProto_links, dst.service, src.service.len);
    for pb_i in src.service.len {
        let pb_l = pb_run(ServiceDescriptorProto_links, src.service)[pb_i].m;
        guard pb_l else { continue; }
        let pb_c .= ServiceDescriptorProto_pool.alloc_ref(ServiceDescriptorProto { .. });
        pb_run(ServiceDescriptorProto_links, dst.service)[pb_i].m .= pb_c;
        ServiceDescriptorProto_copy(pb_c, pb_l);
    }
    dst.extension = pb_resize(FieldDescriptorProto_links, dst.extension, src.extension.len);
    for pb_i in src.extension.len {
        let pb_l = pb_run(FieldDescriptorProto_links, src.extension)[pb_i].m;
        guard pb_l else { continue; }
        let pb_c .= FieldDescriptorProto_pool.alloc_ref(FieldDescriptorProto { .. });
        pb_run(FieldDescriptorProto_links, dst.extension)[pb_i].m .= pb_c;
        FieldDescriptorProto_copy(pb_c, pb_l);
    }
    let pb_f8 = src.options.m;
    if pb_f8 { FileOptions_copy(FileDescriptorProto_mutable_options(dst), pb_f8); }
    let pb_f9 = src.source_code_info.m;
    if pb_f9 { SourceCodeInfo_copy(FileDescriptorProto_mutable_source_code_info(dst), pb_f9); }
    dst.syntax = pb_bytes_copy(src.syntax);
    dst.edition = src.edition;
    dst.pb_has0 = src.pb_has0;
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
}

// True if every required field is set, in m and in the messages it holds.
fn FileDescriptorProto_is_initialized(m: FileDescriptorProto&) -> bool {
    for pb_ref in pb_run(DescriptorProto_links, m.message_type) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        if !DescriptorProto_is_initialized(pb_l) { return false; }
    }
    for pb_ref in pb_run(EnumDescriptorProto_links, m.enum_type) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        if !EnumDescriptorProto_is_initialized(pb_l) { return false; }
    }
    for pb_ref in pb_run(ServiceDescriptorProto_links, m.service) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        if !ServiceDescriptorProto_is_initialized(pb_l) { return false; }
    }
    for pb_ref in pb_run(FieldDescriptorProto_links, m.extension) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        if !FieldDescriptorProto_is_initialized(pb_l) { return false; }
    }
    let pb_f8 = m.options.m;
    if pb_f8 { if !FileOptions_is_initialized(pb_f8) { return false; } }
    return true;
}

// The contents of name, in pb_bytes: valid until it is next set or m
// is cleared.
fn FileDescriptorProto_name(m: FileDescriptorProto&) -> u8[:] { return pb_run(pb_bytes, m.name); }

// Sets name to a copy of v and marks it present:
// it is encoded even when empty.
fn FileDescriptorProto_set_name(m: FileDescriptorProto&, v: const u8[:]) {
    m.name = pb_bytes_set(m.name, v);
    m.pb_has0 |= 0x00000001;
}

fn FileDescriptorProto_has_name(m: FileDescriptorProto&) -> bool { return (m.pb_has0 & 0x00000001) != 0; }

fn FileDescriptorProto_clear_name(m: FileDescriptorProto&) {
    m.name = pb_bytes_free(m.name);
    m.pb_has0 &= 0xfffffffe;
}

// The contents of package, in pb_bytes: valid until it is next set or m
// is cleared.
fn FileDescriptorProto_package(m: FileDescriptorProto&) -> u8[:] { return pb_run(pb_bytes, m.package); }

// Sets package to a copy of v and marks it present:
// it is encoded even when empty.
fn FileDescriptorProto_set_package(m: FileDescriptorProto&, v: const u8[:]) {
    m.package = pb_bytes_set(m.package, v);
    m.pb_has0 |= 0x00000002;
}

fn FileDescriptorProto_has_package(m: FileDescriptorProto&) -> bool { return (m.pb_has0 & 0x00000002) != 0; }

fn FileDescriptorProto_clear_package(m: FileDescriptorProto&) {
    m.package = pb_bytes_free(m.package);
    m.pb_has0 &= 0xfffffffd;
}

// The number of values of dependency.
fn FileDescriptorProto_dependency_len(m: FileDescriptorProto&) -> i64 { return m.dependency.len; }

// The contents of value i of dependency, in pb_bytes: valid until it is next
// set or m is cleared.
fn FileDescriptorProto_dependency_at(m: FileDescriptorProto&, i: i64) -> u8[:] { return pb_run(pb_bytes, pb_run(pb_spans, m.dependency)[i]); }

// Adds a copy of v to dependency.
fn FileDescriptorProto_add_dependency(m: FileDescriptorProto&, v: const u8[:]) { m.dependency = pb_spans_add(m.dependency, v); }

// Sets value i of dependency to a copy of v.
fn FileDescriptorProto_set_dependency(m: FileDescriptorProto&, i: i64, v: const u8[:]) { pb_spans_set(m.dependency, i, v); }

fn FileDescriptorProto_clear_dependency(m: FileDescriptorProto&) { m.dependency = pb_spans_free(m.dependency); }

// The number of values of public_dependency.
fn FileDescriptorProto_public_dependency_len(m: FileDescriptorProto&) -> i64 { return m.public_dependency.len; }

// The values of public_dependency, in pb_i32s: valid until it is next changed or m is
// cleared.
fn FileDescriptorProto_public_dependency(m: FileDescriptorProto&) -> i32[:] { return pb_run(pb_i32s, m.public_dependency); }

fn FileDescriptorProto_public_dependency_at(m: FileDescriptorProto&, i: i64) -> i32 { return pb_run(pb_i32s, m.public_dependency)[i]; }

// Adds a value to public_dependency. This moves its values, so FileDescriptorProto_set_public_dependency is better for many.
fn FileDescriptorProto_add_public_dependency(m: FileDescriptorProto&, v: i32) { m.public_dependency = pb_add(pb_i32s, m.public_dependency, v); }

// Sets public_dependency to a copy of v.
fn FileDescriptorProto_set_public_dependency(m: FileDescriptorProto&, v: const i32[:]) { m.public_dependency = pb_set_run(pb_i32s, m.public_dependency, v); }

fn FileDescriptorProto_clear_public_dependency(m: FileDescriptorProto&) { m.public_dependency = pb_resize(pb_i32s, m.public_dependency, 0); }

// The number of values of weak_dependency.
fn FileDescriptorProto_weak_dependency_len(m: FileDescriptorProto&) -> i64 { return m.weak_dependency.len; }

// The values of weak_dependency, in pb_i32s: valid until it is next changed or m is
// cleared.
fn FileDescriptorProto_weak_dependency(m: FileDescriptorProto&) -> i32[:] { return pb_run(pb_i32s, m.weak_dependency); }

fn FileDescriptorProto_weak_dependency_at(m: FileDescriptorProto&, i: i64) -> i32 { return pb_run(pb_i32s, m.weak_dependency)[i]; }

// Adds a value to weak_dependency. This moves its values, so FileDescriptorProto_set_weak_dependency is better for many.
fn FileDescriptorProto_add_weak_dependency(m: FileDescriptorProto&, v: i32) { m.weak_dependency = pb_add(pb_i32s, m.weak_dependency, v); }

// Sets weak_dependency to a copy of v.
fn FileDescriptorProto_set_weak_dependency(m: FileDescriptorProto&, v: const i32[:]) { m.weak_dependency = pb_set_run(pb_i32s, m.weak_dependency, v); }

fn FileDescriptorProto_clear_weak_dependency(m: FileDescriptorProto&) { m.weak_dependency = pb_resize(pb_i32s, m.weak_dependency, 0); }

// The number of values of option_dependency.
fn FileDescriptorProto_option_dependency_len(m: FileDescriptorProto&) -> i64 { return m.option_dependency.len; }

// The contents of value i of option_dependency, in pb_bytes: valid until it is next
// set or m is cleared.
fn FileDescriptorProto_option_dependency_at(m: FileDescriptorProto&, i: i64) -> u8[:] { return pb_run(pb_bytes, pb_run(pb_spans, m.option_dependency)[i]); }

// Adds a copy of v to option_dependency.
fn FileDescriptorProto_add_option_dependency(m: FileDescriptorProto&, v: const u8[:]) { m.option_dependency = pb_spans_add(m.option_dependency, v); }

// Sets value i of option_dependency to a copy of v.
fn FileDescriptorProto_set_option_dependency(m: FileDescriptorProto&, i: i64, v: const u8[:]) { pb_spans_set(m.option_dependency, i, v); }

fn FileDescriptorProto_clear_option_dependency(m: FileDescriptorProto&) { m.option_dependency = pb_spans_free(m.option_dependency); }

// The number of messages of message_type.
fn FileDescriptorProto_message_type_len(m: FileDescriptorProto&) -> i64 { return m.message_type.len; }

// Message i of message_type. Valid until it or m is cleared.
fn FileDescriptorProto_message_type_at(m: FileDescriptorProto&, i: i64) -> DescriptorProto& {
    let pb_l = pb_run(DescriptorProto_links, m.message_type)[i].m;
    assert(pb_l);
    return pb_l;
}

// Adds an empty message to message_type and returns it.
fn FileDescriptorProto_add_message_type(m: FileDescriptorProto&) -> DescriptorProto& {
    let pb_i: i64 = m.message_type.len;
    m.message_type = pb_resize(DescriptorProto_links, m.message_type, pb_i + 1);
    let pb_new .= DescriptorProto_pool.alloc_ref(DescriptorProto { .. });
    pb_run(DescriptorProto_links, m.message_type)[pb_i].m .= pb_new;
    return pb_new;
}

// Frees the messages of message_type and everything they own.
fn FileDescriptorProto_clear_message_type(m: FileDescriptorProto&) {
    for pb_ref in pb_run(DescriptorProto_links, m.message_type) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        DescriptorProto_clear(pb_l);
        DescriptorProto_pool.free(DescriptorProto_pool.index_of(pb_l));
    }
    m.message_type = pb_resize(DescriptorProto_links, m.message_type, 0);
}

