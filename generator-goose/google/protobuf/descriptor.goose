fn FieldOptions_has_retention(m: FieldOptions&) -> bool { return (m.pb_has0 & 0x00000100) != 0; }

fn FieldOptions_clear_retention(m: FieldOptions&) {
    m.retention = 0;
    m.pb_has0 &= 0xfffffeff;
