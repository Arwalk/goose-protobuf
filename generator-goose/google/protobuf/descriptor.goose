fn MethodDescriptorProto_has_options(m: MethodDescriptorProto&) -> bool { return m.options.m != null; }

// Frees the sub-message options and everything it owns.
fn MethodDescriptorProto_clear_options(m: MethodDescriptorProto&) {
    let pb_sub = m.options.m;
    guard pb_sub else { return; }
    MethodOptions_clear(pb_sub);
    MethodOptions_pool.free(MethodOptions_pool.index_of(pb_sub));
    m.options.m .= null;
}

