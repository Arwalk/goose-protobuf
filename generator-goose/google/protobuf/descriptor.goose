// The sub-message options, or null if it is not set. Valid until it or m is
// cleared.
fn FileDescriptorProto_options(m: FileDescriptorProto&) -> FileOptions&? { return m.options.m; }

// The sub-message options, set to an empty one first if it is not set.
fn FileDescriptorProto_mutable_options(m: FileDescriptorProto&) -> FileOptions& {
    let pb_sub = m.options.m;
    if pb_sub { return pb_sub; }
    let pb_new .= FileOptions_pool.alloc_ref(FileOptions { .. });
    m.options.m .= pb_new;
    return pb_new;
}

fn FileDescriptorProto_has_options(m: FileDescriptorProto&) -> bool { return m.options.m != null; }

// Frees the sub-message options and everything it owns.
fn FileDescriptorProto_clear_options(m: FileDescriptorProto&) {
    let pb_sub = m.options.m;
    guard pb_sub else { return; }
    FileOptions_clear(pb_sub);
    FileOptions_pool.free(FileOptions_pool.index_of(pb_sub));
    m.options.m .= null;
}

