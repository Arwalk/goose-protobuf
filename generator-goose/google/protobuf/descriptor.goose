    m.source_code_info.m .= null;
}

// The contents of syntax, in pb_bytes: valid until it is next set or m
// is cleared.
fn FileDescriptorProto_syntax(m: FileDescriptorProto&) -> u8[:] { return pb_run(pb_bytes, m.syntax); }

// Sets syntax to a copy of v and marks it present:
// it is encoded even when empty.
fn FileDescriptorProto_set_syntax(m: FileDescriptorProto&, v: const u8[:]) {
    m.syntax = pb_bytes_set(m.syntax, v);
    m.pb_has0 |= 0x00000004;
}

fn FileDescriptorProto_has_syntax(m: FileDescriptorProto&) -> bool { return (m.pb_has0 & 0x00000004) != 0; }

fn FileDescriptorProto_clear_syntax(m: FileDescriptorProto&) {
    m.syntax = pb_bytes_free(m.syntax);
    m.pb_has0 &= 0xfffffffb;
}

// Sets edition and marks it present:
// it is encoded even when 0.
fn FileDescriptorProto_set_edition(m: FileDescriptorProto&, v: i32) {
    m.edition = v;
    m.pb_has0 |= 0x00000008;
}

fn FileDescriptorProto_has_edition(m: FileDescriptorProto&) -> bool { return (m.pb_has0 & 0x00000008) != 0; }

fn FileDescriptorProto_clear_edition(m: FileDescriptorProto&) {
    m.edition = 0;
    m.pb_has0 &= 0xfffffff7;
}

// message google.protobuf.DescriptorProto
struct DescriptorProto {
    name: pb_Span,
    field: pb_Span,
    extension: pb_Span,
    nested_type: pb_Span,
    enum_type: pb_Span,
    extension_range: pb_Span,
    oneof_decl: pb_Span,
    options: MessageOptions_Ref,
    reserved_range: pb_Span,
    reserved_name: pb_Span,
    visibility: i32,
    pb_has0: u32,   // has-bits of fields with presence
    pb_unknown: pb_Span,   // unknown fields: raw wire bytes in pb_bytes
}

// A link to a DescriptorProto in DescriptorProto_pool, for sub-message fields.
struct DescriptorProto_Ref { m: DescriptorProto&<u32 in DescriptorProto_pool>? }
reusable var DescriptorProto_pool: DescriptorProto[>..] = [];
reusable[] var DescriptorProto_links: DescriptorProto_Ref[>..] = [];

// Merges the fields in r's window into m; on failure r.err is set.
// Fields it does not know, or with another wire type, are kept as
// unknown fields.
recursive fn DescriptorProto_decode_from(r: pb_Reader&, m: DescriptorProto&) {
    var unknown_len: i64 = m.pb_unknown.len;
    let unknown_had: i64 = unknown_len;
    let pb_had2: i64 = m.field.len;
    var pb_len2: i64 = pb_had2;
    let pb_had6: i64 = m.extension.len;
    var pb_len6: i64 = pb_had6;
    let pb_had3: i64 = m.nested_type.len;
    var pb_len3: i64 = pb_had3;
    let pb_had4: i64 = m.enum_type.len;
    var pb_len4: i64 = pb_had4;
    let pb_had5: i64 = m.extension_range.len;
    var pb_len5: i64 = pb_had5;
    let pb_had8: i64 = m.oneof_decl.len;
    var pb_len8: i64 = pb_had8;
    let pb_had9: i64 = m.reserved_range.len;
    var pb_len9: i64 = pb_had9;
    let pb_had10: i64 = m.reserved_name.len;
    var pb_len10: i64 = pb_had10;
    while r.pos < r.end {
        let start = r.pos;
        let tag = pb_read_tag(r);
        if r.err != PB_OK { break; }
        if tag == 10 {
            m.name = pb_read_bytes(r, m.name);
            m.pb_has0 |= 0x00000001;
        } else if tag == 18 {
            pb_charge(r, 120);
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            if r.depth >= PB_MAX_DEPTH { pb_fail(r, PB_ERR_DEPTH); break; }
            pb_reserve(FieldDescriptorProto_links, m.field, pb_len2, pb_had2);
            let pb_sub .= FieldDescriptorProto_pool.alloc_ref(FieldDescriptorProto { .. });
            pb_run(FieldDescriptorProto_links, m.field)[pb_len2].m .= pb_sub;
            pb_len2++;
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            r.depth++;
            FieldDescriptorProto_decode_from(r, pb_sub);
            if r.err != PB_OK { break; }
            r.depth--;
            r.end = pb_outer;
        } else if tag == 50 {
            pb_charge(r, 120);
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            if r.depth >= PB_MAX_DEPTH { pb_fail(r, PB_ERR_DEPTH); break; }
            pb_reserve(FieldDescriptorProto_links, m.extension, pb_len6, pb_had6);
            let pb_sub .= FieldDescriptorProto_pool.alloc_ref(FieldDescriptorProto { .. });
            pb_run(FieldDescriptorProto_links, m.extension)[pb_len6].m .= pb_sub;
            pb_len6++;
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            r.depth++;
            FieldDescriptorProto_decode_from(r, pb_sub);
            if r.err != PB_OK { break; }
            r.depth--;
            r.end = pb_outer;
        } else if tag == 26 {
            pb_charge(r, 120);
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            if r.depth >= PB_MAX_DEPTH { pb_fail(r, PB_ERR_DEPTH); break; }
            pb_reserve(DescriptorProto_links, m.nested_type, pb_len3, pb_had3);
            let pb_sub .= DescriptorProto_pool.alloc_ref(DescriptorProto { .. });
            pb_run(DescriptorProto_links, m.nested_type)[pb_len3].m .= pb_sub;
            pb_len3++;
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            r.depth++;
            DescriptorProto_decode_from(r, pb_sub);
            if r.err != PB_OK { break; }
            r.depth--;
            r.end = pb_outer;
        } else if tag == 34 {
            pb_charge(r, 80);
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            if r.depth >= PB_MAX_DEPTH { pb_fail(r, PB_ERR_DEPTH); break; }
            pb_reserve(EnumDescriptorProto_links, m.enum_type, pb_len4, pb_had4);
            let pb_sub .= EnumDescriptorProto_pool.alloc_ref(EnumDescriptorProto { .. });
            pb_run(EnumDescriptorProto_links, m.enum_type)[pb_len4].m .= pb_sub;
            pb_len4++;
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            r.depth++;
            EnumDescriptorProto_decode_from(r, pb_sub);
            if r.err != PB_OK { break; }
            r.depth--;
            r.end = pb_outer;
        } else if tag == 42 {
            pb_charge(r, 56);
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            if r.depth >= PB_MAX_DEPTH { pb_fail(r, PB_ERR_DEPTH); break; }
            pb_reserve(DescriptorProto_ExtensionRange_links, m.extension_range, pb_len5, pb_had5);
            let pb_sub .= DescriptorProto_ExtensionRange_pool.alloc_ref(DescriptorProto_ExtensionRange { .. });
            pb_run(DescriptorProto_ExtensionRange_links, m.extension_range)[pb_len5].m .= pb_sub;
            pb_len5++;
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            r.depth++;
            DescriptorProto_ExtensionRange_decode_from(r, pb_sub);
            if r.err != PB_OK { break; }
            r.depth--;
            r.end = pb_outer;
        } else if tag == 66 {
            pb_charge(r, 48);
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            if r.depth >= PB_MAX_DEPTH { pb_fail(r, PB_ERR_DEPTH); break; }
            pb_reserve(OneofDescriptorProto_links, m.oneof_decl, pb_len8, pb_had8);
            let pb_sub .= OneofDescriptorProto_pool.alloc_ref(OneofDescriptorProto { .. });
            pb_run(OneofDescriptorProto_links, m.oneof_decl)[pb_len8].m .= pb_sub;
            pb_len8++;
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            r.depth++;
            OneofDescriptorProto_decode_from(r, pb_sub);
            if r.err != PB_OK { break; }
            r.depth--;
            r.end = pb_outer;
        } else if tag == 58 {
            pb_charge(r, 88);
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            if r.depth >= PB_MAX_DEPTH { pb_fail(r, PB_ERR_DEPTH); break; }
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            r.depth++;
            MessageOptions_decode_from(r, DescriptorProto_mutable_options(m));
            if r.err != PB_OK { break; }
            r.depth--;
            r.end = pb_outer;
        } else if tag == 74 {
            pb_charge(r, 48);
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            if r.depth >= PB_MAX_DEPTH { pb_fail(r, PB_ERR_DEPTH); break; }
            pb_reserve(DescriptorProto_ReservedRange_links, m.reserved_range, pb_len9, pb_had9);
            let pb_sub .= DescriptorProto_ReservedRange_pool.alloc_ref(DescriptorProto_ReservedRange { .. });
            pb_run(DescriptorProto_ReservedRange_links, m.reserved_range)[pb_len9].m .= pb_sub;
            pb_len9++;
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            r.depth++;
            DescriptorProto_ReservedRange_decode_from(r, pb_sub);
            if r.err != PB_OK { break; }
            r.depth--;
            r.end = pb_outer;
        } else if tag == 82 {
            pb_charge(r, 8);
            pb_append(pb_spans, m.reserved_name, pb_len10, pb_had10, pb_read_bytes(r, pb_Span { at: 0, len: 0 }));
        } else if tag == 88 {
            let pb_v = pb_u64_to_int32(pb_read_varint(r));
            if r.err != PB_OK { break; }
            if (pb_v >= 0 && pb_v <= 2) {
                m.visibility = pb_v;
                m.pb_has0 |= 0x00000002;
            } else {
                pb_unknown_keep(r, start, m.pb_unknown, unknown_len, unknown_had);
            }
        } else {
            pb_unknown_append(r, start, tag, m.pb_unknown, unknown_len, unknown_had);
        }
    }
    m.field = pb_trim(FieldDescriptorProto_links, m.field, pb_len2);
    m.extension = pb_trim(FieldDescriptorProto_links, m.extension, pb_len6);
    m.nested_type = pb_trim(DescriptorProto_links, m.nested_type, pb_len3);
    m.enum_type = pb_trim(EnumDescriptorProto_links, m.enum_type, pb_len4);
    m.extension_range = pb_trim(DescriptorProto_ExtensionRange_links, m.extension_range, pb_len5);
    m.oneof_decl = pb_trim(OneofDescriptorProto_links, m.oneof_decl, pb_len8);
    m.reserved_range = pb_trim(DescriptorProto_ReservedRange_links, m.reserved_range, pb_len9);
    m.reserved_name = pb_trim(pb_spans, m.reserved_name, pb_len10);
    m.pb_unknown = pb_bytes_trim(m.pb_unknown, unknown_len);
}

// Merges buf into m. 0 on success, else a PB_ERR_* code; m then holds a
// partial message, which the caller clears.
fn DescriptorProto_decode(buf: const u8[:], m: DescriptorProto&) -> i32 {
    var r = pb_reader(buf);
    DescriptorProto_decode_from(r, m);
    if r.err == PB_OK && !DescriptorProto_is_initialized(m) { return PB_ERR_REQUIRED; }
    return r.err;
}

// Appends m's wire encoding, DescriptorProto_size_of(m) bytes, to out.
recursive fn DescriptorProto_encode(m: DescriptorProto&, out: u8[>..]&) {
    if (m.pb_has0 & 0x00000001) != 0 {
        pb_write_varint(out, 10);
        pb_write_bytes(out, m.name);
    }
    for pb_ref in pb_run(FieldDescriptorProto_links, m.field) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        pb_write_varint(out, 18);
        pb_write_varint(out, FieldDescriptorProto_size_of(pb_l) as! u64);
        FieldDescriptorProto_encode(pb_l, out);
    }
    for pb_ref in pb_run(DescriptorProto_links, m.nested_type) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        pb_write_varint(out, 26);
        pb_write_varint(out, DescriptorProto_size_of(pb_l) as! u64);
        DescriptorProto_encode(pb_l, out);
    }
    for pb_ref in pb_run(EnumDescriptorProto_links, m.enum_type) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        pb_write_varint(out, 34);
        pb_write_varint(out, EnumDescriptorProto_size_of(pb_l) as! u64);
        EnumDescriptorProto_encode(pb_l, out);
    }
    for pb_ref in pb_run(DescriptorProto_ExtensionRange_links, m.extension_range) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        pb_write_varint(out, 42);
        pb_write_varint(out, DescriptorProto_ExtensionRange_size_of(pb_l) as! u64);
        DescriptorProto_ExtensionRange_encode(pb_l, out);
    }
    for pb_ref in pb_run(FieldDescriptorProto_links, m.extension) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        pb_write_varint(out, 50);
        pb_write_varint(out, FieldDescriptorProto_size_of(pb_l) as! u64);
        FieldDescriptorProto_encode(pb_l, out);
    }
    let pb_f7 = m.options.m;
    if pb_f7 {
        pb_write_varint(out, 58);
        pb_write_varint(out, MessageOptions_size_of(pb_f7) as! u64);
        MessageOptions_encode(pb_f7, out);
    }
    for pb_ref in pb_run(OneofDescriptorProto_links, m.oneof_decl) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        pb_write_varint(out, 66);
        pb_write_varint(out, OneofDescriptorProto_size_of(pb_l) as! u64);
        OneofDescriptorProto_encode(pb_l, out);
    }
    for pb_ref in pb_run(DescriptorProto_ReservedRange_links, m.reserved_range) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        pb_write_varint(out, 74);
        pb_write_varint(out, DescriptorProto_ReservedRange_size_of(pb_l) as! u64);
        DescriptorProto_ReservedRange_encode(pb_l, out);
    }
    for pb_v in pb_run(pb_spans, m.reserved_name) {
        pb_write_varint(out, 82);
        pb_write_bytes(out, pb_v);
    }
    if (m.pb_has0 & 0x00000002) != 0 {
        pb_write_varint(out, 88);
        pb_write_varint(out, pb_int32_to_u64(m.visibility));
    }
    out.append(pb_run(pb_bytes, m.pb_unknown));
}

// The size of m's wire encoding, in bytes.
recursive fn DescriptorProto_size_of(m: DescriptorProto&) -> i64 {
    var n: i64 = 0;
    if (m.pb_has0 & 0x00000001) != 0 { n += 1 + pb_bytes_size(m.name); }
    for pb_ref in pb_run(FieldDescriptorProto_links, m.field) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        n += 1 + pb_len_size(FieldDescriptorProto_size_of(pb_l));
    }
    for pb_ref in pb_run(DescriptorProto_links, m.nested_type) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        n += 1 + pb_len_size(DescriptorProto_size_of(pb_l));
    }
    for pb_ref in pb_run(EnumDescriptorProto_links, m.enum_type) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        n += 1 + pb_len_size(EnumDescriptorProto_size_of(pb_l));
    }
    for pb_ref in pb_run(DescriptorProto_ExtensionRange_links, m.extension_range) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        n += 1 + pb_len_size(DescriptorProto_ExtensionRange_size_of(pb_l));
    }
    for pb_ref in pb_run(FieldDescriptorProto_links, m.extension) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        n += 1 + pb_len_size(FieldDescriptorProto_size_of(pb_l));
    }
    let pb_f7 = m.options.m;
    if pb_f7 { n += 1 + pb_len_size(MessageOptions_size_of(pb_f7)); }
    for pb_ref in pb_run(OneofDescriptorProto_links, m.oneof_decl) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        n += 1 + pb_len_size(OneofDescriptorProto_size_of(pb_l));
    }
    for pb_ref in pb_run(DescriptorProto_ReservedRange_links, m.reserved_range) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        n += 1 + pb_len_size(DescriptorProto_ReservedRange_size_of(pb_l));
    }
    for pb_v in pb_run(pb_spans, m.reserved_name) { n += 1 + pb_bytes_size(pb_v); }
    if (m.pb_has0 & 0x00000002) != 0 { n += 1 + pb_varint_size(pb_int32_to_u64(m.visibility)); }
    n += m.pb_unknown.len;
    return n;
}

// Frees what m owns and resets it to the empty message.
recursive fn DescriptorProto_clear(m: DescriptorProto&) {
    m.name = pb_bytes_free(m.name);
    DescriptorProto_clear_field(m);
    DescriptorProto_clear_extension(m);
    DescriptorProto_clear_nested_type(m);
    DescriptorProto_clear_enum_type(m);
    DescriptorProto_clear_extension_range(m);
    DescriptorProto_clear_oneof_decl(m);
    DescriptorProto_clear_options(m);
    DescriptorProto_clear_reserved_range(m);
    m.reserved_name = pb_spans_free(m.reserved_name);
    m.visibility = 0;
    m.pb_has0 = 0;
    m.pb_unknown = pb_bytes_free(m.pb_unknown);
}

// Makes dst a deep copy of src, freeing what dst owned. The two share
// nothing afterwards. Neither may be a sub-message of the other.
recursive fn DescriptorProto_copy(dst: DescriptorProto&, src: DescriptorProto&) {
    if dst .== src { return; }
    DescriptorProto_clear(dst);
    dst.name = pb_bytes_copy(src.name);
    dst.field = pb_resize(FieldDescriptorProto_links, dst.field, src.field.len);
    for pb_i in src.field.len {
        let pb_l = pb_run(FieldDescriptorProto_links, src.field)[pb_i].m;
        guard pb_l else { continue; }
        let pb_c .= FieldDescriptorProto_pool.alloc_ref(FieldDescriptorProto { .. });
        pb_run(FieldDescriptorProto_links, dst.field)[pb_i].m .= pb_c;
        FieldDescriptorProto_copy(pb_c, pb_l);
    }
    dst.extension = pb_resize(FieldDescriptorProto_links, dst.extension, src.extension.len);
    for pb_i in src.extension.len {
        let pb_l = pb_run(FieldDescriptorProto_links, src.extension)[pb_i].m;
        guard pb_l else { continue; }
        let pb_c .= FieldDescriptorProto_pool.alloc_ref(FieldDescriptorProto { .. });
        pb_run(FieldDescriptorProto_links, dst.extension)[pb_i].m .= pb_c;
        FieldDescriptorProto_copy(pb_c, pb_l);
    }
    dst.nested_type = pb_resize(DescriptorProto_links, dst.nested_type, src.nested_type.len);
    for pb_i in src.nested_type.len {
        let pb_l = pb_run(DescriptorProto_links, src.nested_type)[pb_i].m;
        guard pb_l else { continue; }
        let pb_c .= DescriptorProto_pool.alloc_ref(DescriptorProto { .. });
        pb_run(DescriptorProto_links, dst.nested_type)[pb_i].m .= pb_c;
        DescriptorProto_copy(pb_c, pb_l);
    }
    dst.enum_type = pb_resize(EnumDescriptorProto_links, dst.enum_type, src.enum_type.len);
    for pb_i in src.enum_type.len {
        let pb_l = pb_run(EnumDescriptorProto_links, src.enum_type)[pb_i].m;
        guard pb_l else { continue; }
        let pb_c .= EnumDescriptorProto_pool.alloc_ref(EnumDescriptorProto { .. });
        pb_run(EnumDescriptorProto_links, dst.enum_type)[pb_i].m .= pb_c;
        EnumDescriptorProto_copy(pb_c, pb_l);
    }
    dst.extension_range = pb_resize(DescriptorProto_ExtensionRange_links, dst.extension_range, src.extension_range.len);
    for pb_i in src.extension_range.len {
        let pb_l = pb_run(DescriptorProto_ExtensionRange_links, src.extension_range)[pb_i].m;
        guard pb_l else { continue; }
        let pb_c .= DescriptorProto_ExtensionRange_pool.alloc_ref(DescriptorProto_ExtensionRange { .. });
        pb_run(DescriptorProto_ExtensionRange_links, dst.extension_range)[pb_i].m .= pb_c;
        DescriptorProto_ExtensionRange_copy(pb_c, pb_l);
    }
    dst.oneof_decl = pb_resize(OneofDescriptorProto_links, dst.oneof_decl, src.oneof_decl.len);
    for pb_i in src.oneof_decl.len {
        let pb_l = pb_run(OneofDescriptorProto_links, src.oneof_decl)[pb_i].m;
        guard pb_l else { continue; }
        let pb_c .= OneofDescriptorProto_pool.alloc_ref(OneofDescriptorProto { .. });
        pb_run(OneofDescriptorProto_links, dst.oneof_decl)[pb_i].m .= pb_c;
        OneofDescriptorProto_copy(pb_c, pb_l);
    }
    let pb_f7 = src.options.m;
    if pb_f7 { MessageOptions_copy(DescriptorProto_mutable_options(dst), pb_f7); }
    dst.reserved_range = pb_resize(DescriptorProto_ReservedRange_links, dst.reserved_range, src.reserved_range.len);
    for pb_i in src.reserved_range.len {
        let pb_l = pb_run(DescriptorProto_ReservedRange_links, src.reserved_range)[pb_i].m;
        guard pb_l else { continue; }
        let pb_c .= DescriptorProto_ReservedRange_pool.alloc_ref(DescriptorProto_ReservedRange { .. });
        pb_run(DescriptorProto_ReservedRange_links, dst.reserved_range)[pb_i].m .= pb_c;
        DescriptorProto_ReservedRange_copy(pb_c, pb_l);
    }
    dst.reserved_name = pb_spans_copy(src.reserved_name);
    dst.visibility = src.visibility;
    dst.pb_has0 = src.pb_has0;
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
}

// True if every required field is set, in m and in the messages it holds.
recursive fn DescriptorProto_is_initialized(m: DescriptorProto&) -> bool {
    for pb_ref in pb_run(FieldDescriptorProto_links, m.field) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        if !FieldDescriptorProto_is_initialized(pb_l) { return false; }
    }
    for pb_ref in pb_run(FieldDescriptorProto_links, m.extension) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        if !FieldDescriptorProto_is_initialized(pb_l) { return false; }
    }
    for pb_ref in pb_run(DescriptorProto_links, m.nested_type) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        if !DescriptorProto_is_initialized(pb_l) { return false; }
    }
    for pb_ref in pb_run(EnumDescriptorProto_links, m.enum_type) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        if !EnumDescriptorProto_is_initialized(pb_l) { return false; }
    }
    for pb_ref in pb_run(DescriptorProto_ExtensionRange_links, m.extension_range) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        if !DescriptorProto_ExtensionRange_is_initialized(pb_l) { return false; }
    }
    for pb_ref in pb_run(OneofDescriptorProto_links, m.oneof_decl) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        if !OneofDescriptorProto_is_initialized(pb_l) { return false; }
    }
    let pb_f7 = m.options.m;
    if pb_f7 { if !MessageOptions_is_initialized(pb_f7) { return false; } }
    return true;
}

// The contents of name, in pb_bytes: valid until it is next set or m
// is cleared.
fn DescriptorProto_name(m: DescriptorProto&) -> u8[:] { return pb_run(pb_bytes, m.name); }

// Sets name to a copy of v and marks it present:
// it is encoded even when empty.
fn DescriptorProto_set_name(m: DescriptorProto&, v: const u8[:]) {
    m.name = pb_bytes_set(m.name, v);
    m.pb_has0 |= 0x00000001;
}

fn DescriptorProto_has_name(m: DescriptorProto&) -> bool { return (m.pb_has0 & 0x00000001) != 0; }

fn DescriptorProto_clear_name(m: DescriptorProto&) {
    m.name = pb_bytes_free(m.name);
    m.pb_has0 &= 0xfffffffe;
}

// The number of messages of field.
fn DescriptorProto_field_len(m: DescriptorProto&) -> i64 { return m.field.len; }

// Message i of field. Valid until it or m is cleared.
fn DescriptorProto_field_at(m: DescriptorProto&, i: i64) -> FieldDescriptorProto& {
    let pb_l = pb_run(FieldDescriptorProto_links, m.field)[i].m;
    assert(pb_l);
    return pb_l;
}

// Adds an empty message to field and returns it.
fn DescriptorProto_add_field(m: DescriptorProto&) -> FieldDescriptorProto& {
    let pb_i: i64 = m.field.len;
    m.field = pb_resize(FieldDescriptorProto_links, m.field, pb_i + 1);
    let pb_new .= FieldDescriptorProto_pool.alloc_ref(FieldDescriptorProto { .. });
    pb_run(FieldDescriptorProto_links, m.field)[pb_i].m .= pb_new;
    return pb_new;
}

