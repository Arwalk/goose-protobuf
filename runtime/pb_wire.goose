// pb_wire.goose: shared runtime for code generated by protoc-gen-goose.
//
// Protobuf binary wire format primitives only:
//   - varint encode/decode (u64; negative int32/int64 encode as 10 bytes)
//   - zigzag for sint32/sint64, computed in u64 (signed overflow aborts
//     under --debug; use `as!` for wrapping casts)
//   - fixed32/fixed64 little-endian, float/double <-> bits
//   - tag (field number + wire type) encode/decode
//   - skip_field, including groups and a nesting depth limit (gpb-41j.2)
//   - unknown-field copy (gpb-41j.2)
//   - the pb_bytes pool and pb_Span runs (decision 0001), which hold
//     unknown fields (gpb-41j.6), strings and bytes
//
// Public: only the error codes, PB_MAX_DEPTH and pb_error_text, in the section below. Everything
// after them is internal, for generated code, and may change in any release
// (docs/decisions/0012-public-api.md).
//
// Goose `varint` is NOT the protobuf varint; do not use it here.
// Every message's encode/decode/size_of is generated per message; nothing
// message-specific belongs in this file.
//
// Errors (docs/decisions/0004-decode-errors.md): readers take a pb_Reader
// by reference. A failing read records the first error in r.err, moves
// r.pos to r.end so every field loop stops, and returns 0. Nothing here
// aborts on bad input, within the limits in SECURITY.md. Writers append to a
// u8[>..] and cannot fail.

import std;

// ----------------------------------------------------------- public: errors

let PB_OK = 0;
let PB_ERR_TRUNCATED = 1;   // input ends inside a value, or a length overruns its window
let PB_ERR_MALFORMED = 2;   // varint over 10 bytes, bad wire type, field number 0, ...
let PB_ERR_DEPTH = 3;       // nesting beyond PB_MAX_DEPTH
let PB_ERR_UTF8 = 4;        // a proto3 string field that is not valid UTF-8
let PB_ERR_REQUIRED = 5;    // decoded whole, but a required proto2 field is unset
let PB_ERR_TOO_LARGE = 6;   // needs more memory than pb_set_decode_limit allows
let PB_MAX_DEPTH = 100;     // protobuf's default recursion limit

// What one decode may allocate, about, in bytes, unless pb_set_decode_limit says
// otherwise. A run in a pool takes up to twice its size as it grows, and a data stack
// holds 2 GB, so a decode within this limit cannot end the program on an empty pool.
let PB_DEFAULT_DECODE_LIMIT: i64 = 512 << 20;

var pb_decode_limit: i64 = PB_DEFAULT_DECODE_LIMIT;

// Sets the limit for every decode from now on.
fn pb_set_decode_limit(bytes: i64) { pb_decode_limit = bytes; }

// What an error code means, for a message to a person.
fn pb_error_text(err: i32) -> const u8[:] {
    if err == PB_OK { return "no error"; }
    if err == PB_ERR_TRUNCATED { return "truncated input"; }
    if err == PB_ERR_MALFORMED { return "malformed input"; }
    if err == PB_ERR_DEPTH { return "messages nested too deeply"; }
    if err == PB_ERR_UTF8 { return "a string that is not valid UTF-8"; }
    if err == PB_ERR_REQUIRED { return "a required field is not set"; }
    if err == PB_ERR_TOO_LARGE { return "a message needing more memory than the decode limit"; }
    return "unknown error";
}

// ======================================================== internal from here

// Generated code refers to this name, and to no other number, so a plugin and a
// runtime of different versions do not build together. The name is what the user
// sees when it is missing. To change the number, see CONTRIBUTING.md.
let pb_plugin_and_runtime_versions_differ_abi_1 = true;

// A decode window: buf[pos..end] is still to be read.
struct pb_Reader { buf: const u8[:], pos: i64, end: i64, err: i32, depth: i32, budget: i64 }

fn pb_reader(buf: const u8[:]) -> pb_Reader {
    return pb_Reader { buf: buf, pos: 0, end: buf.len, err: PB_OK, depth: 0, budget: pb_decode_limit };
}

// Records code unless an error is already recorded, and ends the window.
fn pb_fail(r: pb_Reader&, code: i32) {
    if r.err == PB_OK { r.err = code; }
    r.pos = r.end;
}

// Takes n bytes from what this decode may still allocate. Past that it fails, which
// ends the window, so that the read which follows fails too and every loop stops.
fn pb_charge(r: pb_Reader&, n: i64) {
    r.budget -= n;
    if r.budget < 0 { pb_fail(r, PB_ERR_TOO_LARGE); }
}

// --------------------------------------------------------------- wire types

let PB_WT_VARINT: u32 = 0;
let PB_WT_I64: u32 = 1;
let PB_WT_LEN: u32 = 2;
let PB_WT_SGROUP: u32 = 3;
let PB_WT_EGROUP: u32 = 4;
let PB_WT_I32: u32 = 5;

let PB_MAX_FIELD: u32 = 536870911;   // 2^29 - 1

// ------------------------------------------------------------------ varints

// At most 10 bytes. Bits of a 10th byte beyond 2^64 are dropped, as in
// protobuf C++; an 11th byte is malformed.
fn pb_read_varint(r: pb_Reader&) -> u64 {
    var v: u64 = 0;
    for k in 10 {
        if r.pos >= r.end { pb_fail(r, PB_ERR_TRUNCATED); return 0; }
        let c = r.buf[r.pos];
        r.pos++;
        v |= ((c & 0x7f) as u64) << (7 * k) as u64;
        if c < 0x80 { return v; }
    }
    pb_fail(r, PB_ERR_MALFORMED);
    return 0;
}

fn pb_write_varint(out: u8[>..]&, v: u64) {
    var x = v;
    while x >= 0x80 {
        out.push((x & 0x7f | 0x80) as! u8);
        x >>= 7;
    }
    out.push(x as! u8);
}

fn pb_varint_size(v: u64) -> i64 {
    var n = 1;
    var x = v;
    while x >= 0x80 { x >>= 7; n++; }
    return n;
}

// int32/int64/enum go on the wire sign-extended to 64 bits, so a negative
// value takes 10 bytes. Decoding truncates to the field's width.
fn pb_int32_to_u64(v: i32) -> u64 { return v as! u64; }   // sign-extends
fn pb_int64_to_u64(v: i64) -> u64 { return v as! u64; }
fn pb_u64_to_int32(v: u64) -> i32 { return (v as! u32) as! i32; }
fn pb_u64_to_int64(v: u64) -> i64 { return v as! i64; }
fn pb_bool_to_u64(v: bool) -> u64 { if v { return 1; } return 0; }

// ------------------------------------------------------------------- zigzag

// sint32/sint64: (n << 1) ^ (n >> width-1), in unsigned arithmetic.
fn pb_zigzag32(v: i32) -> u32 {
    let u = v as! u32;
    let sign: u32 = if v < 0 { 0xffffffff } else { 0 };
    return (u << 1) ^ sign;
}

fn pb_unzigzag32(v: u32) -> i32 {
    let sign: u32 = if (v & 1) != 0 { 0xffffffff } else { 0 };
    return ((v >> 1) ^ sign) as! i32;
}

fn pb_zigzag64(v: i64) -> u64 {
    let u = v as! u64;
    let sign: u64 = if v < 0 { 0xffffffffffffffff } else { 0 };
    return (u << 1) ^ sign;
}

fn pb_unzigzag64(v: u64) -> i64 {
    let sign: u64 = if (v & 1) != 0 { 0xffffffffffffffff } else { 0 };
    return ((v >> 1) ^ sign) as! i64;
}

// ------------------------------------------------------------------- fixed

fn pb_read_fixed32(r: pb_Reader&) -> u32 {
    if r.end - r.pos < 4 { pb_fail(r, PB_ERR_TRUNCATED); return 0; }
    let b = r.buf;
    let p = r.pos;
    let v: u32 = b[p] | (b[p + 1] as u32) << 8 | (b[p + 2] as u32) << 16 | (b[p + 3] as u32) << 24;
    r.pos += 4;
    return v;
}

fn pb_read_fixed64(r: pb_Reader&) -> u64 {
    if r.end - r.pos < 8 { pb_fail(r, PB_ERR_TRUNCATED); return 0; }
    var v: u64 = 0;
    for i in 8 { v |= (r.buf[r.pos + i] as u64) << (8 * i) as u64; }
    r.pos += 8;
    return v;
}

fn pb_write_fixed32(out: u8[>..]&, v: u32) {
    for i in 4 { out.push((v >> (8 * i) as u32) as! u8); }
}

fn pb_write_fixed64(out: u8[>..]&, v: u64) {
    for i in 8 { out.push((v >> (8 * i) as u64) as! u8); }
}

// ---------------------------------------------------------- float, double
// Bit-exact, NaN payloads included; see docs/decisions/0002-float-bits.md.

fn pb_f32_to_bits(x: f32) -> u32 {
    let a: f32[1] = [x];
    let b = bytes_of(a);
    return b[0] | (b[1] as u32) << 8 | (b[2] as u32) << 16 | (b[3] as u32) << 24;
}

fn pb_f64_to_bits(x: f64) -> u64 {
    let a: f64[1] = [x];
    let b = bytes_of(a);
    var v: u64 = 0;
    for i in 8 { v |= (b[i] as u64) << (8 * i) as u64; }
    return v;
}

// from_bytes image of a one-element array: uleb128 byte count, then the
// little-endian payload. A 5- or 9-byte image with this prefix is always
// accepted, so the abort marks a broken invariant, not bad input.
fn pb_f32_from_bits(v: u32) -> f32 {
    let img: u8[5] = [4, v as! u8, (v >> 8) as! u8, (v >> 16) as! u8, (v >> 24) as! u8];
    let xs, ok = from_bytes<f32[>..]>(img);
    if !ok || xs.len != 1 { abort("pb_wire: f32 image rejected"); }
    return xs[0];
}

fn pb_f64_from_bits(v: u64) -> f64 {
    let img: u8[9] = [8, v as! u8, (v >> 8) as! u8, (v >> 16) as! u8, (v >> 24) as! u8,
                      (v >> 32) as! u8, (v >> 40) as! u8, (v >> 48) as! u8, (v >> 56) as! u8];
    let xs, ok = from_bytes<f64[>..]>(img);
    if !ok || xs.len != 1 { abort("pb_wire: f64 image rejected"); }
    return xs[0];
}

fn pb_read_float(r: pb_Reader&) -> f32 { return pb_f32_from_bits(pb_read_fixed32(r)); }
fn pb_read_double(r: pb_Reader&) -> f64 { return pb_f64_from_bits(pb_read_fixed64(r)); }
fn pb_write_float(out: u8[>..]&, v: f32) { pb_write_fixed32(out, pb_f32_to_bits(v)); }
fn pb_write_double(out: u8[>..]&, v: f64) { pb_write_fixed64(out, pb_f64_to_bits(v)); }

// --------------------------------------------------------------------- tags

fn pb_tag_field(tag: u32) -> u32 { return tag >> 3; }
fn pb_tag_wire(tag: u32) -> u32 { return tag & 7; }

// The next tag, or 0 after a failure. Field number 0, a field number over
// 2^29 - 1, wire types 6 and 7, and a tag over 5 bytes (padded with 0x80
// bytes; protobuf reads tags as 32-bit varints) are malformed.
fn pb_read_tag(r: pb_Reader&) -> u32 {
    let start = r.pos;
    let v = pb_read_varint(r);
    if r.err != PB_OK { return 0; }
    if r.pos - start > 5 || v > 0xffffffff || (v >> 3) == 0 || (v & 7) > 5 {
        pb_fail(r, PB_ERR_MALFORMED);
        return 0;
    }
    return v as! u32;
}

fn pb_write_tag(out: u8[>..]&, field: u32, wire: u32) {
    pb_write_varint(out, field << 3 | wire);
}

fn pb_tag_size(field: u32) -> i64 { return pb_varint_size(field << 3); }

// ------------------------------------------------------- length-delimited

// A length prefix that fits in the current window, or 0 after a failure.
fn pb_read_len(r: pb_Reader&) -> i64 {
    let n = pb_read_varint(r);
    if r.err != PB_OK { return 0; }
    if n > (r.end - r.pos) as! u64 { pb_fail(r, PB_ERR_TRUNCATED); return 0; }
    return n as! i64;
}

// ------------------------------------------------------------------- pools
// Decision 0001: records are fixed-size; their variable parts are runs in
// global reusable pools, reached through spans.

// Elements [at, at + len) of a pool. An empty span owns nothing.
struct pb_Span { at: u32, len: u32 }

// The contents of every unknown-field run and string and bytes field of
// every message.
reusable[] var pb_bytes: u8[>..] = [];

// Runs of repeated fields: one pool per scalar element type (enums are
// i32), and runs of pb_Span (into pb_bytes) for repeated strings and
// bytes. Repeated sub-messages use the generated M_links pools.
reusable[] var pb_i32s: i32[>..] = [];
reusable[] var pb_i64s: i64[>..] = [];
reusable[] var pb_u32s: u32[>..] = [];
reusable[] var pb_u64s: u64[>..] = [];
reusable[] var pb_f32s: f32[>..] = [];
reusable[] var pb_f64s: f64[>..] = [];
reusable[] var pb_bools: bool[>..] = [];
reusable[] var pb_spans: pb_Span[>..] = [];

// The elements of run s.
fn pb_run<T>(pool: T[>..]&, s: pb_Span) -> T[:] {
    let lo: i64 = s.at;
    return pool[lo..lo + s.len];
}

// Resizes run s of pool to n elements and returns it: allocates, moves
// (keeping the first min(s.len, n) elements) or, for n == 0, frees it.
// New elements hold the pool's default.
fn pb_resize<T>(pool: T[>..]&, s: pb_Span, n: i64) -> pb_Span {
    if n == 0 {
        if s.len > 0 { pool.free_slice(pb_run(pool, s)); }
        return pb_Span { at: 0, len: 0 };
    }
    if s.len == 0 {
        let r = pool.alloc_slice(n);
        return pb_span_at(pool.index_of(r[0]), n);
    }
    let r = pool.realloc_slice(pb_run(pool, s), n);
    return pb_span_at(pool.index_of(r[0]), n);
}

// A span holds 32 bits. Past that a position would wrap, and the run would overwrite
// another with no error, so this ends the program. It takes a raised --stack-reserve to
// get here, as the default ends it earlier, and a decode's limit stops one message first.
fn pb_span_at(at: i64, n: i64) -> pb_Span {
    if at >= (1 << 32) || n >= (1 << 32) { abort("pb_wire: a pool holds over 2^32 elements"); }
    return pb_Span { at: at as! u32, len: n as! u32 };
}

// Run s of pb_bytes with src appended. src must not be in pb_bytes.
fn pb_bytes_append(s: pb_Span, src: const u8[:]) -> pb_Span {
    if src.len == 0 { return s; }
    let old: i64 = s.len;
    let t = pb_resize(pb_bytes, s, old + src.len);
    pb_copy_bytes(pb_run(pb_bytes, t)[old..], src);
    return t;
}

// Copies src to the start of dst, which must not overlap it and must hold it. Goose has
// no way to copy into the middle of an array, and a C compiler at -O2 does not vectorize
// a loop over bytes that may alias. It does turn these eight reads into one load and
// these eight writes into one store, as nothing can alias between them, so this takes a
// sixth of the time of a loop over bytes on a large value.
fn pb_copy_bytes(dst: u8[:], src: const u8[:]) {
    let n = src.len;
    var i: i64 = 0;
    while i + 8 <= n {
        let from = src[i..i + 8];
        let to = dst[i..i + 8];
        let w: u64 = from[0] | ((from[1] as u64) << 8) | ((from[2] as u64) << 16) | ((from[3] as u64) << 24)
            | ((from[4] as u64) << 32) | ((from[5] as u64) << 40) | ((from[6] as u64) << 48) | ((from[7] as u64) << 56);
        to[0] = w as! u8;
        to[1] = (w >> 8) as! u8;
        to[2] = (w >> 16) as! u8;
        to[3] = (w >> 24) as! u8;
        to[4] = (w >> 32) as! u8;
        to[5] = (w >> 40) as! u8;
        to[6] = (w >> 48) as! u8;
        to[7] = (w >> 56) as! u8;
        i += 8;
    }
    while i < n {
        dst[i] = src[i];
        i += 1;
    }
}

// Frees run s of pb_bytes; returns the empty span.
fn pb_bytes_free(s: pb_Span) -> pb_Span { return pb_resize(pb_bytes, s, 0); }

// A new run of pool with the contents of run src, which it reads through the
// pool, as allocating the new run may move the pool.
fn pb_copy_run<T>(pool: T[>..]&, src: pb_Span) -> pb_Span {
    let t = pb_resize(pool, pb_Span { at: 0, len: 0 }, src.len);
    if src.len == 0 { return t; }
    let from: i64 = src.at;
    let to: i64 = t.at;
    for i in src.len { pool[to + i] = pool[from + i]; }
    return t;
}

fn pb_bytes_copy(src: pb_Span) -> pb_Span { return pb_copy_run(pb_bytes, src); }

// Appends v to run s of pool, of which the first `used` elements are in use and
// the first `had` were there when this decode loop began. A decode loop calls
// pb_trim(pool, s, used) when it ends.
fn pb_append<T>(pool: T[>..]&, s: pb_Span&, used: i64&, had: i64, v: T) {
    pb_reserve(pool, s, used, had);
    let at: i64 = s.at;
    pool[at + used] = v;
    used++;
}

// Makes room in run s of pool for an element after the first `used`. It doubles
// what this decode loop added, not the run: growing writes a default in every new
// slot, and a sub-message that repeats on the wire runs a loop per occurrence, so
// doubling the run would cost its whole length each time, and one input could
// make decoding quadratic.
fn pb_reserve<T>(pool: T[>..]&, s: pb_Span&, used: i64, had: i64) {
    if used == s.len { s = pb_resize(pool, s, used + (used - had) + 1); }
}

// Frees run s of pb_spans and every run of pb_bytes it holds; returns the
// empty span.
fn pb_spans_free(s: pb_Span) -> pb_Span {
    for i in s.len { let e = pb_run(pb_spans, s)[i]; pb_bytes_free(e); }
    return pb_resize(pb_spans, s, 0);
}

// A new run of pb_spans with copies of the runs of pb_bytes that src holds.
fn pb_spans_copy(src: pb_Span) -> pb_Span {
    let t = pb_copy_run(pb_spans, src);
    for i in t.len {
        let c = pb_bytes_copy(pb_run(pb_spans, t)[i]);
        pb_run(pb_spans, t)[i] = c;
    }
    return t;
}

// Element i of run s of pb_spans replaced by a copy of v, which may be in
// pb_bytes.
fn pb_spans_set(s: pb_Span, i: i64, v: const u8[:]) {
    let old = pb_run(pb_spans, s)[i];
    let t = pb_bytes_set(old, v);
    pb_run(pb_spans, s)[i] = t;
}

// Run s of pb_spans with a copy of v added.
fn pb_spans_add(s: pb_Span, v: const u8[:]) -> pb_Span {
    return pb_add(pb_spans, s, pb_bytes_set(pb_Span { at: 0, len: 0 }, v));
}

// Run s of pool cut to its first `used` elements.
fn pb_trim<T>(pool: T[>..]&, s: pb_Span, used: i64) -> pb_Span {
    if used == s.len { return s; }
    return pb_resize(pool, s, used);
}

// Run s of pool with v added: moves the run, so building a long field one
// element at a time is quadratic, which pb_set_run avoids.
fn pb_add<T>(pool: T[>..]&, s: pb_Span, v: T) -> pb_Span {
    let old: i64 = s.len;
    let t = pb_resize(pool, s, old + 1);
    pb_run(pool, t)[old] = v;
    return t;
}

// Run s of pool replaced by a copy of v, which may be in the pool.
fn pb_set_run<T>(pool: T[>..]&, s: pb_Span, v: const T[:]) -> pb_Span {
    var tmp: T[>..] = [];
    tmp.append(v);
    let t = pb_resize(pool, pb_resize(pool, s, 0), tmp.len);
    let dst = pb_run(pool, t);
    for i in tmp.len { dst[i] = tmp[i]; }
    return t;
}

// Run s of pb_bytes replaced by a copy of v. v may be in pb_bytes (even
// in s): it is copied out before s is freed.
fn pb_bytes_set(s: pb_Span, v: const u8[:]) -> pb_Span {
    var tmp: u8[>..] = [];
    tmp.append(v);
    let freed = pb_bytes_free(s);
    return pb_bytes_append(freed, tmp);
}

// The encoded size of a length-delimited value: its length prefix and
// its bytes.
fn pb_bytes_size(s: pb_Span) -> i64 { return pb_varint_size(s.len) + s.len; }

// The encoded size of a sub-message of n bytes: its length prefix and its
// bytes.
fn pb_len_size(n: i64) -> i64 { return pb_varint_size(n as! u64) + n; }

// Appends run s of pb_bytes as a length-delimited value (tag already
// written).
fn pb_write_bytes(out: u8[>..]&, s: pb_Span) {
    pb_write_varint(out, s.len);
    out.append(pb_run(pb_bytes, s));
}

// Reads a length-delimited value into a new run that replaces old (the
// last value wins). After a failure old is kept.
fn pb_read_bytes(r: pb_Reader&, old: pb_Span) -> pb_Span {
    let n = pb_read_len(r);
    pb_charge(r, n);
    if r.err != PB_OK { return old; }
    let s = pb_bytes_append(pb_bytes_free(old), r.buf[r.pos..r.pos + n]);
    r.pos += n;
    return s;
}

// pb_read_bytes for a proto3 string: invalid UTF-8 fails with PB_ERR_UTF8.
fn pb_read_string(r: pb_Reader&, old: pb_Span) -> pb_Span {
    let n = pb_read_len(r);
    pb_charge(r, n);
    if r.err != PB_OK { return old; }
    let v = r.buf[r.pos..r.pos + n];
    if !pb_utf8_valid(v) { pb_fail(r, PB_ERR_UTF8); return old; }
    let s = pb_bytes_append(pb_bytes_free(old), v);
    r.pos += n;
    return s;
}

// True if b is well-formed UTF-8: no overlong forms, no surrogates
// (U+D800..U+DFFF), nothing above U+10FFFF, no truncated sequence.
fn pb_utf8_valid(b: const u8[:]) -> bool {
    var i: i64 = 0;
    while i < b.len {
        let c = b[i];
        if c < 0x80 { i++; continue; }
        var n: i64 = 0;
        var cp: u32 = 0;
        var min: u32 = 0;
        if c >= 0xc2 && c <= 0xdf { n = 1; cp = (c & 0x1f); min = 0x80; }
        else if c >= 0xe0 && c <= 0xef { n = 2; cp = (c & 0x0f); min = 0x800; }
        else if c >= 0xf0 && c <= 0xf4 { n = 3; cp = (c & 0x07); min = 0x10000; }
        else { return false; }   // a continuation byte, C0, C1 or F5..FF
        if b.len - i - 1 < n { return false; }
        for k in n {
            let d = b[i + 1 + k];
            if (d & 0xc0) != 0x80 { return false; }
            cp = cp << 6 | (d & 0x3f);
        }
        if cp < min || (cp >= 0xd800 && cp <= 0xdfff) || cp > 0x10ffff { return false; }
        i += n + 1;
    }
    return true;
}

// --------------------------------------------------------------------- maps
// Decoding appends a map's entries without looking keys up, which would be
// quadratic, and M_decode folds repeated keys once, when all the input is read:
// a sub-message may repeat on the wire, so doing it when a message ends would
// repeat it. It sorts the keys with their positions, so equal ones are together
// with the first occurrence first. Only grouping matters, not what order keys take. sort has
// an O(n log n) worst case, so no input makes this slow; a hash would have to
// defend against crafted collisions.

// A key that fits a u64, and the position of its entry in the run.
struct pb_NumKey { key: u64, at: u32 }

// A string key, as a run of pb_bytes, and the position of its entry.
struct pb_StrKey { key: pb_Span, at: u32 }

fn pb_sort_num_keys(xs: pb_NumKey[:]) {
    sort(xs) { a, b => if a.key != b.key { a.key < b.key } else { a.at < b.at } }
}

// Below 0, 0 or above 0 as a sorts before, with or after b, bytewise.
fn pb_bytes_cmp(a: const u8[:], b: const u8[:]) -> i32 {
    let n = if a.len < b.len { a.len } else { b.len };
    for i in n {
        if a[i] != b[i] { return if a[i] < b[i] { -1 } else { 1 }; }
    }
    return if a.len < b.len { -1 } else if a.len > b.len { 1 } else { 0 };
}

fn pb_sort_str_keys(xs: pb_StrKey[:]) {
    sort(xs) { a, b =>
        let c = pb_bytes_cmp(pb_run(pb_bytes, a.key), pb_run(pb_bytes, b.key));
        if c != 0 { c < 0 } else { a.at < b.at }
    }
}

fn pb_same_num_key(a: pb_NumKey, b: pb_NumKey) -> bool { return a.key == b.key; }

fn pb_same_str_key(a: pb_StrKey, b: pb_StrKey) -> bool {
    return pb_run(pb_bytes, a.key) == pb_run(pb_bytes, b.key);
}

// ----------------------------------------------------- skipping, unknowns

// Skips the value of a field whose tag was just read. A start-group is
// skipped through its matching end-group; groups count against
// PB_MAX_DEPTH together with message nesting (r.depth). An end-group here
// has no start, and wire types 6 and 7 do not exist: both are malformed.
recursive fn pb_skip_field(r: pb_Reader&, tag: u32) {
    let wire = pb_tag_wire(tag);
    if wire == PB_WT_VARINT {
        pb_read_varint(r);
    } else if wire == PB_WT_I64 {
        if r.end - r.pos < 8 { pb_fail(r, PB_ERR_TRUNCATED); return; }
        r.pos += 8;
    } else if wire == PB_WT_LEN {
        let n = pb_read_len(r);
        r.pos += n;
    } else if wire == PB_WT_I32 {
        if r.end - r.pos < 4 { pb_fail(r, PB_ERR_TRUNCATED); return; }
        r.pos += 4;
    } else if wire == PB_WT_SGROUP {
        pb_skip_group(r, tag);
    } else {
        pb_fail(r, PB_ERR_MALFORMED);
    }
}

// Skips the group whose start tag was just read, up to and past its end tag.
// Returns where the end tag begins, the end of the group's contents. A
// decoder uses that as a window, as a length gives for a sub-message. Each
// level of nesting scans its contents once more, and PB_MAX_DEPTH bounds the
// levels, so the cost stays linear in the input.
recursive fn pb_skip_group(r: pb_Reader&, tag: u32) -> i64 {
    if r.depth >= PB_MAX_DEPTH { pb_fail(r, PB_ERR_DEPTH); return 0; }
    r.depth++;
    loop {
        if r.pos >= r.end { pb_fail(r, PB_ERR_TRUNCATED); return 0; }
        let at = r.pos;
        let inner = pb_read_tag(r);
        if r.err != PB_OK { return 0; }
        if pb_tag_wire(inner) == PB_WT_EGROUP {
            if pb_tag_field(inner) != pb_tag_field(tag) { pb_fail(r, PB_ERR_MALFORMED); return 0; }
            r.depth--;
            return at;
        }
        pb_skip_field(r, inner);
        if r.err != PB_OK { return 0; }
    }
    return 0;
}

// Skips the field whose tag was just read and appends its raw bytes, from
// start (where the tag began) to the end of its value, to out. Nothing is
// appended after a failure.
fn pb_append_unknown(r: pb_Reader&, start: i64, tag: u32, out: u8[>..]&) {
    pb_skip_field(r, tag);
    if r.err == PB_OK { out.append(r.buf[start..r.pos]); }
}

// Skips the field whose tag was just read (the tag began at start) and
// appends its raw bytes to run s of pb_bytes, of which the first `used`
// bytes are in use and the first `had` were there when this decode loop began.
// A decode loop calls pb_bytes_trim(s, used) when it ends. Nothing is appended
// after a failure. Recursive decoders may call this: it keeps no growable local.
fn pb_unknown_append(r: pb_Reader&, start: i64, tag: u32, s: pb_Span&, used: i64&, had: i64) {
    pb_skip_field(r, tag);
    if r.err != PB_OK { return; }
    pb_unknown_keep(r, start, s, used, had);
}

// Appends the field just read, whose tag began at start, to run s, as
// pb_unknown_append does.
fn pb_unknown_keep(r: pb_Reader&, start: i64, s: pb_Span&, used: i64&, had: i64) {
    let n = r.pos - start;
    pb_charge(r, n);
    if r.err != PB_OK { return; }
    pb_unknown_grow(s, used, had, n);
    let dst = pb_run(pb_bytes, s);
    for i in n { dst[used + i] = r.buf[start + i]; }
    used += n;
}

// Appends tag and the element of a packed run just read, which began at `at`,
// to run s: a value on its own, as a closed enum keeps one it does not declare.
fn pb_unknown_element(r: pb_Reader&, tag: u64, at: i64, s: pb_Span&, used: i64&, had: i64) {
    let t = pb_varint_size(tag);
    let n = r.pos - at;
    pb_charge(r, t + n);
    if r.err != PB_OK { return; }
    pb_unknown_grow(s, used, had, t + n);
    let dst = pb_run(pb_bytes, s);
    var v = tag;
    var w = used;
    while v >= 0x80 {
        dst[w] = (v | 0x80) as! u8;
        v >>= 7;
        w++;
    }
    dst[w] = v as! u8;
    w++;
    for i in n { dst[w + i] = r.buf[at + i]; }
    used += t + n;
}

// Run s of pb_bytes with room for n bytes after the first `used`. It doubles what
// this decode loop added, not the run, as pb_reserve does and for the same reason.
fn pb_unknown_grow(s: pb_Span&, used: i64, had: i64, n: i64) {
    if used + n <= s.len { return; }
    var more = used - had;
    if more < n { more = n; }
    s = pb_resize(pb_bytes, s, used + more);
}

// Run s of pb_bytes cut to its first `used` bytes.
fn pb_bytes_trim(s: pb_Span, used: i64) -> pb_Span {
    if used == s.len { return s; }
    return pb_resize(pb_bytes, s, used);
}
