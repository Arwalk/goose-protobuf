// pb_wire.goose: shared runtime for code generated by protoc-gen-goose.
//
// Protobuf binary wire format primitives only:
//   - varint encode/decode (u64; negative int32/int64 encode as 10 bytes)
//   - zigzag for sint32/sint64, computed in u64 (signed overflow aborts
//     under --debug; use `as!` for wrapping casts)
//   - fixed32/fixed64 little-endian, float/double <-> bits
//   - tag (field number + wire type) encode/decode
//   - skip_field, including groups and a nesting depth limit (gpb-41j.2)
//   - unknown-field copy (gpb-41j.2)
//   - the pb_bytes pool and pb_Span runs (decision 0001), which hold
//     unknown fields (gpb-41j.6), strings and bytes
//
// Goose `varint` is NOT the protobuf varint; do not use it here.
// Every message's encode/decode/size_of is generated per message; nothing
// message-specific belongs in this file.
//
// Errors (docs/decisions/0004-decode-errors.md): readers take a pb_Reader
// by reference. A failing read records the first error in r.err, moves
// r.pos to r.end so every field loop stops, and returns 0. Nothing here
// aborts on bad input. Writers append to a u8[>..] and cannot fail.

// ------------------------------------------------------------------ errors

let PB_OK = 0;
let PB_ERR_TRUNCATED = 1;   // input ends inside a value, or a length overruns its window
let PB_ERR_MALFORMED = 2;   // varint over 10 bytes, bad wire type, field number 0, ...
let PB_ERR_DEPTH = 3;       // nesting beyond PB_MAX_DEPTH
let PB_ERR_UTF8 = 4;        // a proto3 string field that is not valid UTF-8
let PB_MAX_DEPTH = 100;     // protobuf's default recursion limit

// A decode window: buf[pos..end] is still to be read.
struct pb_Reader { buf: const u8[:], pos: i64, end: i64, err: i32, depth: i32 }

fn pb_reader(buf: const u8[:]) -> pb_Reader {
    return pb_Reader { buf: buf, pos: 0, end: buf.len, err: PB_OK, depth: 0 };
}

// Records code unless an error is already recorded, and ends the window.
fn pb_fail(r: pb_Reader&, code: i32) {
    if r.err == PB_OK { r.err = code; }
    r.pos = r.end;
}

// --------------------------------------------------------------- wire types

let PB_WT_VARINT: u32 = 0;
let PB_WT_I64: u32 = 1;
let PB_WT_LEN: u32 = 2;
let PB_WT_SGROUP: u32 = 3;
let PB_WT_EGROUP: u32 = 4;
let PB_WT_I32: u32 = 5;

let PB_MAX_FIELD: u32 = 536870911;   // 2^29 - 1

// ------------------------------------------------------------------ varints

// At most 10 bytes. Bits of a 10th byte beyond 2^64 are dropped, as in
// protobuf C++; an 11th byte is malformed.
fn pb_read_varint(r: pb_Reader&) -> u64 {
    var v: u64 = 0;
    for k in 10 {
        if r.pos >= r.end { pb_fail(r, PB_ERR_TRUNCATED); return 0; }
        let c = r.buf[r.pos];
        r.pos++;
        v |= ((c & 0x7f) as u64) << (7 * k) as u64;
        if c < 0x80 { return v; }
    }
    pb_fail(r, PB_ERR_MALFORMED);
    return 0;
}

fn pb_write_varint(out: u8[>..]&, v: u64) {
    var x = v;
    while x >= 0x80 {
        out.push((x & 0x7f | 0x80) as! u8);
        x >>= 7;
    }
    out.push(x as! u8);
}

fn pb_varint_size(v: u64) -> i64 {
    var n = 1;
    var x = v;
    while x >= 0x80 { x >>= 7; n++; }
    return n;
}

// int32/int64/enum go on the wire sign-extended to 64 bits, so a negative
// value takes 10 bytes. Decoding truncates to the field's width.
fn pb_int32_to_u64(v: i32) -> u64 { return v as! u64; }   // sign-extends
fn pb_int64_to_u64(v: i64) -> u64 { return v as! u64; }
fn pb_u64_to_int32(v: u64) -> i32 { return (v as! u32) as! i32; }
fn pb_u64_to_int64(v: u64) -> i64 { return v as! i64; }
fn pb_bool_to_u64(v: bool) -> u64 { if v { return 1; } return 0; }

// ------------------------------------------------------------------- zigzag

// sint32/sint64: (n << 1) ^ (n >> width-1), in unsigned arithmetic.
fn pb_zigzag32(v: i32) -> u32 {
    let u = v as! u32;
    let sign: u32 = if v < 0 { 0xffffffff } else { 0 };
    return (u << 1) ^ sign;
}

fn pb_unzigzag32(v: u32) -> i32 {
    let sign: u32 = if (v & 1) != 0 { 0xffffffff } else { 0 };
    return ((v >> 1) ^ sign) as! i32;
}

fn pb_zigzag64(v: i64) -> u64 {
    let u = v as! u64;
    let sign: u64 = if v < 0 { 0xffffffffffffffff } else { 0 };
    return (u << 1) ^ sign;
}

fn pb_unzigzag64(v: u64) -> i64 {
    let sign: u64 = if (v & 1) != 0 { 0xffffffffffffffff } else { 0 };
    return ((v >> 1) ^ sign) as! i64;
}

// ------------------------------------------------------------------- fixed

fn pb_read_fixed32(r: pb_Reader&) -> u32 {
    if r.end - r.pos < 4 { pb_fail(r, PB_ERR_TRUNCATED); return 0; }
    let b = r.buf;
    let p = r.pos;
    let v: u32 = b[p] | (b[p + 1] as u32) << 8 | (b[p + 2] as u32) << 16 | (b[p + 3] as u32) << 24;
    r.pos += 4;
    return v;
}

fn pb_read_fixed64(r: pb_Reader&) -> u64 {
    if r.end - r.pos < 8 { pb_fail(r, PB_ERR_TRUNCATED); return 0; }
    var v: u64 = 0;
    for i in 8 { v |= (r.buf[r.pos + i] as u64) << (8 * i) as u64; }
    r.pos += 8;
    return v;
}

fn pb_write_fixed32(out: u8[>..]&, v: u32) {
    for i in 4 { out.push((v >> (8 * i) as u32) as! u8); }
}

fn pb_write_fixed64(out: u8[>..]&, v: u64) {
    for i in 8 { out.push((v >> (8 * i) as u64) as! u8); }
}

// ---------------------------------------------------------- float, double
// Bit-exact, NaN payloads included; see docs/decisions/0002-float-bits.md.

fn pb_f32_to_bits(x: f32) -> u32 {
    let a: f32[1] = [x];
    let b = bytes_of(a);
    return b[0] | (b[1] as u32) << 8 | (b[2] as u32) << 16 | (b[3] as u32) << 24;
}

fn pb_f64_to_bits(x: f64) -> u64 {
    let a: f64[1] = [x];
    let b = bytes_of(a);
    var v: u64 = 0;
    for i in 8 { v |= (b[i] as u64) << (8 * i) as u64; }
    return v;
}

// from_bytes image of a one-element array: uleb128 byte count, then the
// little-endian payload. A 5- or 9-byte image with this prefix is always
// accepted, so the abort marks a broken invariant, not bad input.
fn pb_f32_from_bits(v: u32) -> f32 {
    let img: u8[5] = [4, v as! u8, (v >> 8) as! u8, (v >> 16) as! u8, (v >> 24) as! u8];
    let xs, ok = from_bytes<f32[>..]>(img);
    if !ok || xs.len != 1 { abort("pb_wire: f32 image rejected"); }
    return xs[0];
}

fn pb_f64_from_bits(v: u64) -> f64 {
    let img: u8[9] = [8, v as! u8, (v >> 8) as! u8, (v >> 16) as! u8, (v >> 24) as! u8,
                      (v >> 32) as! u8, (v >> 40) as! u8, (v >> 48) as! u8, (v >> 56) as! u8];
    let xs, ok = from_bytes<f64[>..]>(img);
    if !ok || xs.len != 1 { abort("pb_wire: f64 image rejected"); }
    return xs[0];
}

fn pb_read_float(r: pb_Reader&) -> f32 { return pb_f32_from_bits(pb_read_fixed32(r)); }
fn pb_read_double(r: pb_Reader&) -> f64 { return pb_f64_from_bits(pb_read_fixed64(r)); }
fn pb_write_float(out: u8[>..]&, v: f32) { pb_write_fixed32(out, pb_f32_to_bits(v)); }
fn pb_write_double(out: u8[>..]&, v: f64) { pb_write_fixed64(out, pb_f64_to_bits(v)); }

// --------------------------------------------------------------------- tags

fn pb_tag_field(tag: u32) -> u32 { return tag >> 3; }
fn pb_tag_wire(tag: u32) -> u32 { return tag & 7; }

// The next tag, or 0 after a failure. Field number 0, a field number over
// 2^29 - 1, wire types 6 and 7, and a tag over 5 bytes (padded with 0x80
// bytes; protobuf reads tags as 32-bit varints) are malformed.
fn pb_read_tag(r: pb_Reader&) -> u32 {
    let start = r.pos;
    let v = pb_read_varint(r);
    if r.err != PB_OK { return 0; }
    if r.pos - start > 5 || v > 0xffffffff || (v >> 3) == 0 || (v & 7) > 5 {
        pb_fail(r, PB_ERR_MALFORMED);
        return 0;
    }
    return v as! u32;
}

fn pb_write_tag(out: u8[>..]&, field: u32, wire: u32) {
    pb_write_varint(out, field << 3 | wire);
}

fn pb_tag_size(field: u32) -> i64 { return pb_varint_size(field << 3); }

// ------------------------------------------------------- length-delimited

// A length prefix that fits in the current window, or 0 after a failure.
fn pb_read_len(r: pb_Reader&) -> i64 {
    let n = pb_read_varint(r);
    if r.err != PB_OK { return 0; }
    if n > (r.end - r.pos) as! u64 { pb_fail(r, PB_ERR_TRUNCATED); return 0; }
    return n as! i64;
}

// ------------------------------------------------------------------- pools
// Decision 0001: records are fixed-size; their variable parts are runs in
// global reusable pools, reached through spans.

// Elements [at, at + len) of a pool. An empty span owns nothing.
struct pb_Span { at: u32, len: u32 }

// The contents of every unknown-field run and string and bytes field of
// every message.
reusable[] var pb_bytes: u8[>..] = [];

// Runs of repeated fields: one pool per scalar element type (enums are
// i32), and runs of pb_Span (into pb_bytes) for repeated strings and
// bytes. Repeated sub-messages use the generated M_links pools.
reusable[] var pb_i32s: i32[>..] = [];
reusable[] var pb_i64s: i64[>..] = [];
reusable[] var pb_u32s: u32[>..] = [];
reusable[] var pb_u64s: u64[>..] = [];
reusable[] var pb_f32s: f32[>..] = [];
reusable[] var pb_f64s: f64[>..] = [];
reusable[] var pb_bools: bool[>..] = [];
reusable[] var pb_spans: pb_Span[>..] = [];

// The elements of run s.
fn pb_run<T>(pool: T[>..]&, s: pb_Span) -> T[:] {
    let lo: i64 = s.at;
    return pool[lo..lo + s.len];
}

// Resizes run s of pool to n elements and returns it: allocates, moves
// (keeping the first min(s.len, n) elements) or, for n == 0, frees it.
// New elements hold the pool's default.
fn pb_resize<T>(pool: T[>..]&, s: pb_Span, n: i64) -> pb_Span {
    if n == 0 {
        if s.len > 0 { pool.free_slice(pb_run(pool, s)); }
        return pb_Span { at: 0, len: 0 };
    }
    if s.len == 0 {
        let r = pool.alloc_slice(n);
        return pb_Span { at: pool.index_of(r[0]) as! u32, len: n as! u32 };
    }
    let r = pool.realloc_slice(pb_run(pool, s), n);
    return pb_Span { at: pool.index_of(r[0]) as! u32, len: n as! u32 };
}

// Run s of pb_bytes with src appended. src must not be in pb_bytes.
fn pb_bytes_append(s: pb_Span, src: const u8[:]) -> pb_Span {
    if src.len == 0 { return s; }
    let old: i64 = s.len;
    let t = pb_resize(pb_bytes, s, old + src.len);
    let dst = pb_run(pb_bytes, t);
    for i in src.len { dst[old + i] = src[i]; }
    return t;
}

// Frees run s of pb_bytes; returns the empty span.
fn pb_bytes_free(s: pb_Span) -> pb_Span { return pb_resize(pb_bytes, s, 0); }

// A new run of pb_bytes with the contents of run src, which it reads through
// the pool, as allocating the new run may move the pool.
fn pb_bytes_copy(src: pb_Span) -> pb_Span {
    let t = pb_resize(pb_bytes, pb_Span { at: 0, len: 0 }, src.len);
    if src.len == 0 { return t; }
    let from: i64 = src.at;
    let to: i64 = t.at;
    for i in src.len { pb_bytes[to + i] = pb_bytes[from + i]; }
    return t;
}

// Run s of pb_bytes replaced by a copy of v. v may be in pb_bytes (even
// in s): it is copied out before s is freed.
fn pb_bytes_set(s: pb_Span, v: const u8[:]) -> pb_Span {
    var tmp: u8[>..] = [];
    tmp.append(v);
    let freed = pb_bytes_free(s);
    return pb_bytes_append(freed, tmp);
}

// The encoded size of a length-delimited value: its length prefix and
// its bytes.
fn pb_bytes_size(s: pb_Span) -> i64 { return pb_varint_size(s.len) + s.len; }

// The encoded size of a sub-message of n bytes: its length prefix and its
// bytes.
fn pb_len_size(n: i64) -> i64 { return pb_varint_size(n as! u64) + n; }

// Appends run s of pb_bytes as a length-delimited value (tag already
// written).
fn pb_write_bytes(out: u8[>..]&, s: pb_Span) {
    pb_write_varint(out, s.len);
    out.append(pb_run(pb_bytes, s));
}

// Reads a length-delimited value into a new run that replaces old (the
// last value wins). After a failure old is kept.
fn pb_read_bytes(r: pb_Reader&, old: pb_Span) -> pb_Span {
    let n = pb_read_len(r);
    if r.err != PB_OK { return old; }
    let s = pb_bytes_append(pb_bytes_free(old), r.buf[r.pos..r.pos + n]);
    r.pos += n;
    return s;
}

// pb_read_bytes for a proto3 string: invalid UTF-8 fails with PB_ERR_UTF8.
fn pb_read_string(r: pb_Reader&, old: pb_Span) -> pb_Span {
    let n = pb_read_len(r);
    if r.err != PB_OK { return old; }
    let v = r.buf[r.pos..r.pos + n];
    if !pb_utf8_valid(v) { pb_fail(r, PB_ERR_UTF8); return old; }
    let s = pb_bytes_append(pb_bytes_free(old), v);
    r.pos += n;
    return s;
}

// True if b is well-formed UTF-8: no overlong forms, no surrogates
// (U+D800..U+DFFF), nothing above U+10FFFF, no truncated sequence.
fn pb_utf8_valid(b: const u8[:]) -> bool {
    var i: i64 = 0;
    while i < b.len {
        let c = b[i];
        if c < 0x80 { i++; continue; }
        var n: i64 = 0;
        var cp: u32 = 0;
        var min: u32 = 0;
        if c >= 0xc2 && c <= 0xdf { n = 1; cp = (c & 0x1f); min = 0x80; }
        else if c >= 0xe0 && c <= 0xef { n = 2; cp = (c & 0x0f); min = 0x800; }
        else if c >= 0xf0 && c <= 0xf4 { n = 3; cp = (c & 0x07); min = 0x10000; }
        else { return false; }   // a continuation byte, C0, C1 or F5..FF
        if b.len - i - 1 < n { return false; }
        for k in n {
            let d = b[i + 1 + k];
            if (d & 0xc0) != 0x80 { return false; }
            cp = cp << 6 | (d & 0x3f);
        }
        if cp < min || (cp >= 0xd800 && cp <= 0xdfff) || cp > 0x10ffff { return false; }
        i += n + 1;
    }
    return true;
}

// ----------------------------------------------------- skipping, unknowns

// Skips the value of a field whose tag was just read. A start-group is
// skipped through its matching end-group; groups count against
// PB_MAX_DEPTH together with message nesting (r.depth). An end-group here
// has no start, and wire types 6 and 7 do not exist: both are malformed.
recursive fn pb_skip_field(r: pb_Reader&, tag: u32) {
    let wire = pb_tag_wire(tag);
    if wire == PB_WT_VARINT {
        pb_read_varint(r);
    } else if wire == PB_WT_I64 {
        if r.end - r.pos < 8 { pb_fail(r, PB_ERR_TRUNCATED); return; }
        r.pos += 8;
    } else if wire == PB_WT_LEN {
        let n = pb_read_len(r);
        r.pos += n;
    } else if wire == PB_WT_I32 {
        if r.end - r.pos < 4 { pb_fail(r, PB_ERR_TRUNCATED); return; }
        r.pos += 4;
    } else if wire == PB_WT_SGROUP {
        if r.depth >= PB_MAX_DEPTH { pb_fail(r, PB_ERR_DEPTH); return; }
        r.depth++;
        loop {
            if r.pos >= r.end { pb_fail(r, PB_ERR_TRUNCATED); return; }
            let inner = pb_read_tag(r);
            if r.err != PB_OK { return; }
            if pb_tag_wire(inner) == PB_WT_EGROUP {
                if pb_tag_field(inner) != pb_tag_field(tag) { pb_fail(r, PB_ERR_MALFORMED); return; }
                break;
            }
            pb_skip_field(r, inner);
            if r.err != PB_OK { return; }
        }
        r.depth--;
    } else {
        pb_fail(r, PB_ERR_MALFORMED);
    }
}

// Skips the field whose tag was just read and appends its raw bytes, from
// start (where the tag began) to the end of its value, to out. Nothing is
// appended after a failure.
fn pb_append_unknown(r: pb_Reader&, start: i64, tag: u32, out: u8[>..]&) {
    pb_skip_field(r, tag);
    if r.err == PB_OK { out.append(r.buf[start..r.pos]); }
}

// Skips the field whose tag was just read (the tag began at start) and
// appends its raw bytes to run s of pb_bytes, of which the first `used`
// bytes are in use. The run grows by doubling, so a decode loop calls
// pb_bytes_trim(s, used) when it ends. Nothing is appended after a
// failure. Recursive decoders may call this: it keeps no growable local.
fn pb_unknown_append(r: pb_Reader&, start: i64, tag: u32, s: pb_Span&, used: i64&) {
    pb_skip_field(r, tag);
    if r.err != PB_OK { return; }
    let n = r.pos - start;
    if used + n > s.len {
        var cap: i64 = s.len * 2;
        if cap < used + n { cap = used + n; }
        s = pb_resize(pb_bytes, s, cap);
    }
    let dst = pb_run(pb_bytes, s);
    for i in n { dst[used + i] = r.buf[start + i]; }
    used += n;
}

// Run s of pb_bytes cut to its first `used` bytes.
fn pb_bytes_trim(s: pb_Span, used: i64) -> pb_Span {
    if used == s.len { return s; }
    return pb_resize(pb_bytes, s, used);
}
