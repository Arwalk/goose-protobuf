// Merges the fields in r's window into m; on failure r.err is set.
// Fields it does not know, or with another wire type, are kept as
// unknown fields.
recursive fn Rec_Node_decode_from(r: pb_Reader&, m: Rec_Node&) {
    var unknown_len: i64 = m.pb_unknown.len;
    let unknown_had: i64 = unknown_len;
    while r.pos < r.end {
        let start = r.pos;
        let tag = pb_read_tag(r);
        if r.err != PB_OK { break; }
        if tag == 10 {
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            if r.depth >= PB_MAX_DEPTH { pb_fail(r, PB_ERR_DEPTH); break; }
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            r.depth++;
            Rec_decode_from(r, Rec_Node_mutable_rec(m));
            if r.err != PB_OK { break; }
            r.depth--;
            r.end = pb_outer;
        } else if tag == 16 {
            m.v = pb_u64_to_int32(pb_read_varint(r));
            m.pb_has0 |= 0x00000001;
        } else {
            pb_unknown_append(r, start, tag, m.pb_unknown, unknown_len, unknown_had);
        }
    }
    m.pb_unknown = pb_bytes_trim(m.pb_unknown, unknown_len);
}

// Merges buf into m. 0 on success, else a PB_ERR_* code; m then holds a
// partial message, which the caller clears.
fn Rec_Node_decode(buf: const u8[:], m: Rec_Node&) -> i32 {
    var r = pb_reader(buf);
    Rec_Node_decode_from(r, m);
    return r.err;
}

// Appends m's wire encoding, Rec_Node_size_of(m) bytes, to out.
recursive fn Rec_Node_encode(m: Rec_Node&, out: u8[>..]&) {
    let pb_f1 = m.rec.m;
    if pb_f1 {
        pb_write_varint(out, 10);
        pb_write_varint(out, Rec_size_of(pb_f1) as! u64);
        Rec_encode(pb_f1, out);
    }
    if (m.pb_has0 & 0x00000001) != 0 {
        pb_write_varint(out, 16);
        pb_write_varint(out, pb_int32_to_u64(m.v));
    }
    out.append(pb_run(pb_bytes, m.pb_unknown));
}

// The size of m's wire encoding, in bytes.
recursive fn Rec_Node_size_of(m: Rec_Node&) -> i64 {
    var n: i64 = 0;
    let pb_f1 = m.rec.m;
    if pb_f1 { n += 1 + pb_len_size(Rec_size_of(pb_f1)); }
    if (m.pb_has0 & 0x00000001) != 0 { n += 1 + pb_varint_size(pb_int32_to_u64(m.v)); }
    n += m.pb_unknown.len;
    return n;
}

// Frees what m owns and resets it to the empty message.
recursive fn Rec_Node_clear(m: Rec_Node&) {
    Rec_Node_clear_rec(m);
    m.v = 0;
    m.pb_has0 = 0;
    m.pb_unknown = pb_bytes_free(m.pb_unknown);
}

// Makes dst a deep copy of src, freeing what dst owned. The two share
// nothing afterwards. Neither may be a sub-message of the other.
recursive fn Rec_Node_copy(dst: Rec_Node&, src: Rec_Node&) {
    if dst .== src { return; }
    Rec_Node_clear(dst);
    let pb_f1 = src.rec.m;
    if pb_f1 { Rec_copy(Rec_Node_mutable_rec(dst), pb_f1); }
    dst.v = src.v;
    dst.pb_has0 = src.pb_has0;
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
}

// The sub-message rec, or null if it is not set. Valid until it or m is
// cleared.
fn Rec_Node_rec(m: Rec_Node&) -> Rec&? { return m.rec.m; }

// The sub-message rec, set to an empty one first if it is not set.
fn Rec_Node_mutable_rec(m: Rec_Node&) -> Rec& {
    let pb_sub = m.rec.m;
    if pb_sub { return pb_sub; }
    let pb_new .= Rec_pool.alloc_ref(Rec { .. });
    m.rec.m .= pb_new;
    return pb_new;
}

fn Rec_Node_has_rec(m: Rec_Node&) -> bool { return m.rec.m != null; }

// Frees the sub-message rec and everything it owns.
recursive fn Rec_Node_clear_rec(m: Rec_Node&) {
    let pb_sub = m.rec.m;
    guard pb_sub else { return; }
    Rec_clear(pb_sub);
    Rec_pool.free(Rec_pool.index_of(pb_sub));
    m.rec.m .= null;
}

// Sets v and marks it present:
// it is encoded even when 0.
fn Rec_Node_set_v(m: Rec_Node&, v: i32) {
    m.v = v;
    m.pb_has0 |= 0x00000001;
}

fn Rec_Node_has_v(m: Rec_Node&) -> bool { return (m.pb_has0 & 0x00000001) != 0; }

fn Rec_Node_clear_v(m: Rec_Node&) {
    m.v = 0;
    m.pb_has0 &= 0xfffffffe;
}

// message grp.ReqG
struct ReqG {
    r: ReqG_R_Ref,
    pb_unknown: pb_Span,   // unknown fields: raw wire bytes in pb_bytes
}

// A link to a ReqG in ReqG_pool, for sub-message fields.
struct ReqG_Ref { m: ReqG&<u32 in ReqG_pool>? }
reusable var ReqG_pool: ReqG[>..] = [];
reusable[] var ReqG_links: ReqG_Ref[>..] = [];

// Merges the fields in r's window into m; on failure r.err is set.
// Fields it does not know, or with another wire type, are kept as
// unknown fields.
fn ReqG_decode_from(r: pb_Reader&, m: ReqG&) {
    var unknown_len: i64 = m.pb_unknown.len;
    let unknown_had: i64 = unknown_len;
    while r.pos < r.end {
        let start = r.pos;
        let tag = pb_read_tag(r);
        if r.err != PB_OK { break; }
        if tag == 11 {
            let pb_body = r.pos;
            let pb_stop = pb_skip_group(r, tag);
            if r.err != PB_OK { break; }
            let pb_after = r.pos;
            let pb_outer = r.end;
            r.pos = pb_body;
            r.end = pb_stop;
            r.depth++;
            ReqG_R_decode_from(r, ReqG_mutable_r(m));
            if r.err != PB_OK { break; }
            r.depth--;
            r.end = pb_outer;
            r.pos = pb_after;
        } else {
            pb_unknown_append(r, start, tag, m.pb_unknown, unknown_len, unknown_had);
        }
    }
    m.pb_unknown = pb_bytes_trim(m.pb_unknown, unknown_len);
}

// Merges buf into m. 0 on success, else a PB_ERR_* code; m then holds a
// partial message, which the caller clears.
fn ReqG_decode(buf: const u8[:], m: ReqG&) -> i32 {
    var r = pb_reader(buf);
    ReqG_decode_from(r, m);
    if r.err == PB_OK && !ReqG_is_initialized(m) { return PB_ERR_REQUIRED; }
    return r.err;
}

// Appends m's wire encoding, ReqG_size_of(m) bytes, to out.
fn ReqG_encode(m: ReqG&, out: u8[>..]&) {
    let pb_f1 = m.r.m;
    if pb_f1 {
        pb_write_varint(out, 11);
        ReqG_R_encode(pb_f1, out);
        pb_write_varint(out, 12);
    }
    out.append(pb_run(pb_bytes, m.pb_unknown));
}

// The size of m's wire encoding, in bytes.
fn ReqG_size_of(m: ReqG&) -> i64 {
    var n: i64 = 0;
    let pb_f1 = m.r.m;
    if pb_f1 { n += 2 + ReqG_R_size_of(pb_f1); }
    n += m.pb_unknown.len;
    return n;
}

// Frees what m owns and resets it to the empty message.
fn ReqG_clear(m: ReqG&) {
    ReqG_clear_r(m);
    m.pb_unknown = pb_bytes_free(m.pb_unknown);
}

// Makes dst a deep copy of src, freeing what dst owned. The two share
// nothing afterwards. Neither may be a sub-message of the other.
fn ReqG_copy(dst: ReqG&, src: ReqG&) {
    if dst .== src { return; }
    ReqG_clear(dst);
    let pb_f1 = src.r.m;
    if pb_f1 { ReqG_R_copy(ReqG_mutable_r(dst), pb_f1); }
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
}

// True if every required field is set, in m and in the messages it holds.
fn ReqG_is_initialized(m: ReqG&) -> bool {
    if m.r.m == null { return false; }
    let pb_f1 = m.r.m;
    if pb_f1 { if !ReqG_R_is_initialized(pb_f1) { return false; } }
    return true;
}

// The sub-message r, or null if it is not set. Valid until it or m is
// cleared.
fn ReqG_r(m: ReqG&) -> ReqG_R&? { return m.r.m; }

// The sub-message r, set to an empty one first if it is not set.
fn ReqG_mutable_r(m: ReqG&) -> ReqG_R& {
    let pb_sub = m.r.m;
    if pb_sub { return pb_sub; }
    let pb_new .= ReqG_R_pool.alloc_ref(ReqG_R { .. });
    m.r.m .= pb_new;
    return pb_new;
}

fn ReqG_has_r(m: ReqG&) -> bool { return m.r.m != null; }

// Frees the sub-message r and everything it owns.
fn ReqG_clear_r(m: ReqG&) {
    let pb_sub = m.r.m;
    guard pb_sub else { return; }
    ReqG_R_clear(pb_sub);
    ReqG_R_pool.free(ReqG_R_pool.index_of(pb_sub));
    m.r.m .= null;
}

// message grp.ReqG.R
struct ReqG_R {
    x: i32,
    pb_has0: u32,   // has-bits of fields with presence
    pb_unknown: pb_Span,   // unknown fields: raw wire bytes in pb_bytes
}

// A link to a ReqG_R in ReqG_R_pool, for sub-message fields.
struct ReqG_R_Ref { m: ReqG_R&<u32 in ReqG_R_pool>? }
reusable var ReqG_R_pool: ReqG_R[>..] = [];
reusable[] var ReqG_R_links: ReqG_R_Ref[>..] = [];

// Merges the fields in r's window into m; on failure r.err is set.
// Fields it does not know, or with another wire type, are kept as
// unknown fields.
fn ReqG_R_decode_from(r: pb_Reader&, m: ReqG_R&) {
    var unknown_len: i64 = m.pb_unknown.len;
    let unknown_had: i64 = unknown_len;
    while r.pos < r.end {
        let start = r.pos;
        let tag = pb_read_tag(r);
        if r.err != PB_OK { break; }
        if tag == 8 {
            m.x = pb_u64_to_int32(pb_read_varint(r));
            m.pb_has0 |= 0x00000001;
        } else {
            pb_unknown_append(r, start, tag, m.pb_unknown, unknown_len, unknown_had);
        }
    }
    m.pb_unknown = pb_bytes_trim(m.pb_unknown, unknown_len);
}

// Merges buf into m. 0 on success, else a PB_ERR_* code; m then holds a
// partial message, which the caller clears.
fn ReqG_R_decode(buf: const u8[:], m: ReqG_R&) -> i32 {
    var r = pb_reader(buf);
    ReqG_R_decode_from(r, m);
    if r.err == PB_OK && !ReqG_R_is_initialized(m) { return PB_ERR_REQUIRED; }
    return r.err;
}

// Appends m's wire encoding, ReqG_R_size_of(m) bytes, to out.
fn ReqG_R_encode(m: ReqG_R&, out: u8[>..]&) {
    if (m.pb_has0 & 0x00000001) != 0 {
        pb_write_varint(out, 8);
        pb_write_varint(out, pb_int32_to_u64(m.x));
    }
    out.append(pb_run(pb_bytes, m.pb_unknown));
}

// The size of m's wire encoding, in bytes.
fn ReqG_R_size_of(m: ReqG_R&) -> i64 {
    var n: i64 = 0;
    if (m.pb_has0 & 0x00000001) != 0 { n += 1 + pb_varint_size(pb_int32_to_u64(m.x)); }
    n += m.pb_unknown.len;
    return n;
}

// Frees what m owns and resets it to the empty message.
fn ReqG_R_clear(m: ReqG_R&) {
    m.x = 0;
    m.pb_has0 = 0;
    m.pb_unknown = pb_bytes_free(m.pb_unknown);
}

// Makes dst a deep copy of src, freeing what dst owned. The two share
// nothing afterwards. Neither may be a sub-message of the other.
fn ReqG_R_copy(dst: ReqG_R&, src: ReqG_R&) {
    if dst .== src { return; }
    ReqG_R_clear(dst);
    dst.x = src.x;
    dst.pb_has0 = src.pb_has0;
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
}

// True if every required field is set, in m and in the messages it holds.
fn ReqG_R_is_initialized(m: ReqG_R&) -> bool {
    if (m.pb_has0 & 0x00000001) != 0x00000001 { return false; }
    return true;
}

// Sets x and marks it present:
// it is encoded even when 0.
fn ReqG_R_set_x(m: ReqG_R&, v: i32) {
    m.x = v;
    m.pb_has0 |= 0x00000001;
}

fn ReqG_R_has_x(m: ReqG_R&) -> bool { return (m.pb_has0 & 0x00000001) != 0; }

fn ReqG_R_clear_x(m: ReqG_R&) {
    m.x = 0;
    m.pb_has0 &= 0xfffffffe;
}

