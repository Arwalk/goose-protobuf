// message grp.Holder.H
struct Holder_H {
    req: ReqG_Ref,
    pb_unknown: pb_Span,   // unknown fields: raw wire bytes in pb_bytes
}

// A link to a Holder_H in Holder_H_pool, for sub-message fields.
struct Holder_H_Ref { m: Holder_H&<u32 in Holder_H_pool>? }
reusable var Holder_H_pool: Holder_H[>..] = [];
reusable[] var Holder_H_links: Holder_H_Ref[>..] = [];

// Merges the fields in r's window into m; on failure r.err is set.
// Fields it does not know, or with another wire type, are kept as
// unknown fields.
fn Holder_H_decode_from(r: pb_Reader&, m: Holder_H&) {
    var unknown_len: i64 = m.pb_unknown.len;
    let unknown_had: i64 = unknown_len;
    while r.pos < r.end {
        let start = r.pos;
        let tag = pb_read_tag(r);
        if r.err != PB_OK { break; }
        if tag == 10 {
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            if r.depth >= PB_MAX_DEPTH { pb_fail(r, PB_ERR_DEPTH); break; }
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            r.depth++;
            ReqG_decode_from(r, Holder_H_mutable_req(m));
            if r.err != PB_OK { break; }
            r.depth--;
            r.end = pb_outer;
        } else {
            pb_unknown_append(r, start, tag, m.pb_unknown, unknown_len, unknown_had);
        }
    }
    m.pb_unknown = pb_bytes_trim(m.pb_unknown, unknown_len);
}

// Merges buf into m. 0 on success, else a PB_ERR_* code; m then holds a
// partial message, which the caller clears.
fn Holder_H_decode(buf: const u8[:], m: Holder_H&) -> i32 {
    var r = pb_reader(buf);
    Holder_H_decode_from(r, m);
    if r.err == PB_OK && !Holder_H_is_initialized(m) { return PB_ERR_REQUIRED; }
    return r.err;
}

// Appends m's wire encoding, Holder_H_size_of(m) bytes, to out.
fn Holder_H_encode(m: Holder_H&, out: u8[>..]&) {
    let pb_f1 = m.req.m;
    if pb_f1 {
        pb_write_varint(out, 10);
        pb_write_varint(out, ReqG_size_of(pb_f1) as! u64);
        ReqG_encode(pb_f1, out);
    }
    out.append(pb_run(pb_bytes, m.pb_unknown));
}

// The size of m's wire encoding, in bytes.
fn Holder_H_size_of(m: Holder_H&) -> i64 {
    var n: i64 = 0;
    let pb_f1 = m.req.m;
    if pb_f1 { n += 1 + pb_len_size(ReqG_size_of(pb_f1)); }
    n += m.pb_unknown.len;
    return n;
}

// Frees what m owns and resets it to the empty message.
fn Holder_H_clear(m: Holder_H&) {
    Holder_H_clear_req(m);
    m.pb_unknown = pb_bytes_free(m.pb_unknown);
}

// Makes dst a deep copy of src, freeing what dst owned. The two share
// nothing afterwards. Neither may be a sub-message of the other.
fn Holder_H_copy(dst: Holder_H&, src: Holder_H&) {
    if dst .== src { return; }
    Holder_H_clear(dst);
    let pb_f1 = src.req.m;
    if pb_f1 { ReqG_copy(Holder_H_mutable_req(dst), pb_f1); }
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
}

// True if every required field is set, in m and in the messages it holds.
fn Holder_H_is_initialized(m: Holder_H&) -> bool {
    let pb_f1 = m.req.m;
    if pb_f1 { if !ReqG_is_initialized(pb_f1) { return false; } }
    return true;
}

// The sub-message req, or null if it is not set. Valid until it or m is
// cleared.
fn Holder_H_req(m: Holder_H&) -> ReqG&? { return m.req.m; }

// The sub-message req, set to an empty one first if it is not set.
fn Holder_H_mutable_req(m: Holder_H&) -> ReqG& {
    let pb_sub = m.req.m;
    if pb_sub { return pb_sub; }
    let pb_new .= ReqG_pool.alloc_ref(ReqG { .. });
    m.req.m .= pb_new;
    return pb_new;
}

fn Holder_H_has_req(m: Holder_H&) -> bool { return m.req.m != null; }

// Frees the sub-message req and everything it owns.
fn Holder_H_clear_req(m: Holder_H&) {
    let pb_sub = m.req.m;
    guard pb_sub else { return; }
    ReqG_clear(pb_sub);
    ReqG_pool.free(ReqG_pool.index_of(pb_sub));
    m.req.m .= null;
