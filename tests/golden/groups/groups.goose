// message grp.Rec
struct Rec {
    node: Rec_Node_Ref,
    pb_unknown: pb_Span,   // unknown fields: raw wire bytes in pb_bytes
}

// A link to a Rec in Rec_pool, for sub-message fields.
struct Rec_Ref { m: Rec&<u32 in Rec_pool>? }
reusable var Rec_pool: Rec[>..] = [];
reusable[] var Rec_links: Rec_Ref[>..] = [];

// Merges the fields in r's window into m; on failure r.err is set.
// Fields it does not know, or with another wire type, are kept as
// unknown fields.
recursive fn Rec_decode_from(r: pb_Reader&, m: Rec&) {
    var unknown_len: i64 = m.pb_unknown.len;
    let unknown_had: i64 = unknown_len;
    while r.pos < r.end {
        let start = r.pos;
        let tag = pb_read_tag(r);
        if r.err != PB_OK { break; }
        if tag == 11 {
            let pb_body = r.pos;
            let pb_stop = pb_skip_group(r, tag);
            if r.err != PB_OK { break; }
            let pb_after = r.pos;
            let pb_outer = r.end;
            r.pos = pb_body;
            r.end = pb_stop;
            r.depth++;
            Rec_Node_decode_from(r, Rec_mutable_node(m));
            if r.err != PB_OK { break; }
            r.depth--;
            r.end = pb_outer;
            r.pos = pb_after;
        } else {
            pb_unknown_append(r, start, tag, m.pb_unknown, unknown_len, unknown_had);
        }
    }
    m.pb_unknown = pb_bytes_trim(m.pb_unknown, unknown_len);
}

// Merges buf into m. 0 on success, else a PB_ERR_* code; m then holds a
// partial message, which the caller clears.
fn Rec_decode(buf: const u8[:], m: Rec&) -> i32 {
    var r = pb_reader(buf);
    Rec_decode_from(r, m);
    return r.err;
}

// Appends m's wire encoding, Rec_size_of(m) bytes, to out.
recursive fn Rec_encode(m: Rec&, out: u8[>..]&) {
    let pb_f1 = m.node.m;
    if pb_f1 {
        pb_write_varint(out, 11);
        Rec_Node_encode(pb_f1, out);
        pb_write_varint(out, 12);
    }
    out.append(pb_run(pb_bytes, m.pb_unknown));
}

// The size of m's wire encoding, in bytes.
recursive fn Rec_size_of(m: Rec&) -> i64 {
    var n: i64 = 0;
    let pb_f1 = m.node.m;
    if pb_f1 { n += 2 + Rec_Node_size_of(pb_f1); }
    n += m.pb_unknown.len;
    return n;
}

// Frees what m owns and resets it to the empty message.
recursive fn Rec_clear(m: Rec&) {
    Rec_clear_node(m);
    m.pb_unknown = pb_bytes_free(m.pb_unknown);
}

// Makes dst a deep copy of src, freeing what dst owned. The two share
// nothing afterwards. Neither may be a sub-message of the other.
recursive fn Rec_copy(dst: Rec&, src: Rec&) {
    if dst .== src { return; }
    Rec_clear(dst);
    let pb_f1 = src.node.m;
    if pb_f1 { Rec_Node_copy(Rec_mutable_node(dst), pb_f1); }
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
}

// The sub-message node, or null if it is not set. Valid until it or m is
// cleared.
fn Rec_node(m: Rec&) -> Rec_Node&? { return m.node.m; }

// The sub-message node, set to an empty one first if it is not set.
fn Rec_mutable_node(m: Rec&) -> Rec_Node& {
    let pb_sub = m.node.m;
    if pb_sub { return pb_sub; }
    let pb_new .= Rec_Node_pool.alloc_ref(Rec_Node { .. });
    m.node.m .= pb_new;
    return pb_new;
}

fn Rec_has_node(m: Rec&) -> bool { return m.node.m != null; }

// Frees the sub-message node and everything it owns.
recursive fn Rec_clear_node(m: Rec&) {
    let pb_sub = m.node.m;
    guard pb_sub else { return; }
    Rec_Node_clear(pb_sub);
    Rec_Node_pool.free(Rec_Node_pool.index_of(pb_sub));
    m.node.m .= null;
}

