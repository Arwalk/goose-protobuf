    prefixed: Sub_Ref,
    packed_f: pb_Span,
    checked: pb_Span,
    open: i32,
    pb_has0: u32,   // has-bits of fields with presence
    pb_unknown: pb_Span,   // unknown fields: raw wire bytes in pb_bytes
}

// A link to a All in All_pool, for sub-message fields.
struct All_Ref { m: All&<u32 in All_pool>? }
reusable var All_pool: All[>..] = [];
reusable[] var All_links: All_Ref[>..] = [];

// Merges the fields in r's window into m; on failure r.err is set.
// Fields it does not know, or with another wire type, are kept as
// unknown fields.
fn All_decode_from(r: pb_Reader&, m: All&) {
    var unknown_len: i64 = m.pb_unknown.len;
    let unknown_had: i64 = unknown_len;
    let pb_had3: i64 = m.expanded.len;
    var pb_len3: i64 = pb_had3;
    let pb_had6: i64 = m.subs.len;
    var pb_len6: i64 = pb_had6;
    let pb_had9: i64 = m.packed_f.len;
    var pb_len9: i64 = pb_had9;
    while r.pos < r.end {
        let start = r.pos;
        let tag = pb_read_tag(r);
        if r.err != PB_OK { break; }
        if tag == 8 {
            m.implicit_f = pb_u64_to_int32(pb_read_varint(r));
        } else if tag == 16 {
            let pb_v = pb_u64_to_int32(pb_read_varint(r));
            if r.err != PB_OK { break; }
            if (pb_v >= 0 && pb_v <= 1) {
                m.closed = pb_v;
                m.pb_has0 |= 0x00000001;
            } else {
                pb_unknown_keep(r, start, m.pb_unknown, unknown_len, unknown_had);
            }
        } else if tag == 24 {
            pb_charge(r, 4);
            pb_append(pb_i32s, m.expanded, pb_len3, pb_had3, pb_u64_to_int32(pb_read_varint(r)));
        } else if tag == 26 {
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            while r.pos < r.end {
                pb_charge(r, 4);
                pb_append(pb_i32s, m.expanded, pb_len3, pb_had3, pb_u64_to_int32(pb_read_varint(r)));
            }
            if r.err != PB_OK { break; }
            r.end = pb_outer;
        } else if tag == 34 {
            m.unchecked = pb_read_bytes(r, m.unchecked);
        } else if tag == 43 {
            pb_charge(r, 40);
            let pb_body = r.pos;
            let pb_stop = pb_skip_group(r, tag);
            if r.err != PB_OK { break; }
            let pb_after = r.pos;
            let pb_outer = r.end;
            r.pos = pb_body;
            r.end = pb_stop;
            r.depth++;
            Sub_decode_from(r, All_mutable_delimited(m));
            if r.err != PB_OK { break; }
            r.depth--;
            r.end = pb_outer;
            r.pos = pb_after;
        } else if tag == 50 {
            pb_charge(r, 48);
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            if r.depth >= PB_MAX_DEPTH { pb_fail(r, PB_ERR_DEPTH); break; }
            pb_reserve(All_SubsEntry_entries, m.subs, pb_len6, pb_had6);
            let pb_e .= pb_run(All_SubsEntry_entries, m.subs)[pb_len6];
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            r.depth++;
            All_SubsEntry_decode_from(r, pb_e);
            if r.err != PB_OK { All_SubsEntry_clear(pb_e); break; }
            r.depth--;
            r.end = pb_outer;
            All_SubsEntry_place(pb_e);
            pb_len6++;
        } else if tag == 56 {
            m.explicit_f = pb_u64_to_int32(pb_read_varint(r));
            m.pb_has0 |= 0x00000002;
        } else if tag == 66 {
            pb_charge(r, 40);
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            if r.depth >= PB_MAX_DEPTH { pb_fail(r, PB_ERR_DEPTH); break; }
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            r.depth++;
            Sub_decode_from(r, All_mutable_prefixed(m));
            if r.err != PB_OK { break; }
            r.depth--;
            r.end = pb_outer;
        } else if tag == 72 {
            pb_charge(r, 4);
            pb_append(pb_i32s, m.packed_f, pb_len9, pb_had9, pb_u64_to_int32(pb_read_varint(r)));
        } else if tag == 74 {
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            while r.pos < r.end {
                pb_charge(r, 4);
                pb_append(pb_i32s, m.packed_f, pb_len9, pb_had9, pb_u64_to_int32(pb_read_varint(r)));
            }
            if r.err != PB_OK { break; }
            r.end = pb_outer;
        } else if tag == 82 {
            m.checked = pb_read_string(r, m.checked);
        } else if tag == 88 {
            m.open = pb_u64_to_int32(pb_read_varint(r));
            m.pb_has0 |= 0x00000004;
        } else {
            pb_unknown_append(r, start, tag, m.pb_unknown, unknown_len, unknown_had);
        }
    }
    m.expanded = pb_trim(pb_i32s, m.expanded, pb_len3);
    m.subs = pb_trim(All_SubsEntry_entries, m.subs, pb_len6);
    m.packed_f = pb_trim(pb_i32s, m.packed_f, pb_len9);
    m.pb_unknown = pb_bytes_trim(m.pb_unknown, unknown_len);
}

// Merges buf into m. 0 on success, else a PB_ERR_* code; m then holds a
// partial message, which the caller clears.
fn All_decode(buf: const u8[:], m: All&) -> i32 {
    var r = pb_reader(buf);
    All_decode_from(r, m);
    if r.err == PB_OK { All_fold_maps(m); }
    return r.err;
}

// Appends m's wire encoding, All_size_of(m) bytes, to out.
fn All_encode(m: All&, out: u8[>..]&) {
    if m.implicit_f != 0 {
        pb_write_varint(out, 8);
        pb_write_varint(out, pb_int32_to_u64(m.implicit_f));
    }
    if (m.pb_has0 & 0x00000001) != 0 {
        pb_write_varint(out, 16);
        pb_write_varint(out, pb_int32_to_u64(m.closed));
    }
    if m.expanded.len > 0 {
        for pb_v in pb_run(pb_i32s, m.expanded) {
            pb_write_varint(out, 24);
            pb_write_varint(out, pb_int32_to_u64(pb_v));
        }
    }
    if m.unchecked.len > 0 {
        pb_write_varint(out, 34);
        pb_write_bytes(out, m.unchecked);
    }
    let pb_f5 = m.delimited.m;
    if pb_f5 {
        pb_write_varint(out, 43);
        Sub_encode(pb_f5, out);
        pb_write_varint(out, 44);
    }
    for pb_i in m.subs.len {
        let pb_e .= pb_run(All_SubsEntry_entries, m.subs)[pb_i];
        pb_write_varint(out, 50);
        pb_write_varint(out, All_SubsEntry_size_of(pb_e) as! u64);
        All_SubsEntry_encode(pb_e, out);
    }
    if (m.pb_has0 & 0x00000002) != 0 {
        pb_write_varint(out, 56);
        pb_write_varint(out, pb_int32_to_u64(m.explicit_f));
    }
    let pb_f8 = m.prefixed.m;
    if pb_f8 {
        pb_write_varint(out, 66);
        pb_write_varint(out, Sub_size_of(pb_f8) as! u64);
        Sub_encode(pb_f8, out);
    }
    if m.packed_f.len > 0 {
        pb_write_varint(out, 74);
        var pb_n: i64 = 0;
        for pb_v in pb_run(pb_i32s, m.packed_f) { pb_n += pb_varint_size(pb_int32_to_u64(pb_v)); }
        pb_write_varint(out, pb_n as! u64);
        for pb_v in pb_run(pb_i32s, m.packed_f) { pb_write_varint(out, pb_int32_to_u64(pb_v)); }
    }
    if m.checked.len > 0 {
        pb_write_varint(out, 82);
        pb_write_bytes(out, m.checked);
    }
    if (m.pb_has0 & 0x00000004) != 0 {
        pb_write_varint(out, 88);
        pb_write_varint(out, pb_int32_to_u64(m.open));
    }
    out.append(pb_run(pb_bytes, m.pb_unknown));
}

// The size of m's wire encoding, in bytes.
fn All_size_of(m: All&) -> i64 {
    var n: i64 = 0;
    if m.implicit_f != 0 { n += 1 + pb_varint_size(pb_int32_to_u64(m.implicit_f)); }
    if (m.pb_has0 & 0x00000001) != 0 { n += 1 + pb_varint_size(pb_int32_to_u64(m.closed)); }
    if m.expanded.len > 0 {
        var pb_n: i64 = 0;
        for pb_v in pb_run(pb_i32s, m.expanded) { pb_n += pb_varint_size(pb_int32_to_u64(pb_v)); }
        n += 1 * m.expanded.len + pb_n;
    }
    if m.unchecked.len > 0 { n += 1 + pb_bytes_size(m.unchecked); }
    let pb_f5 = m.delimited.m;
    if pb_f5 { n += 2 + Sub_size_of(pb_f5); }
    for pb_i in m.subs.len {
        n += 1 + pb_len_size(All_SubsEntry_size_of(pb_run(All_SubsEntry_entries, m.subs)[pb_i]));
    }
    if (m.pb_has0 & 0x00000002) != 0 { n += 1 + pb_varint_size(pb_int32_to_u64(m.explicit_f)); }
    let pb_f8 = m.prefixed.m;
    if pb_f8 { n += 1 + pb_len_size(Sub_size_of(pb_f8)); }
    if m.packed_f.len > 0 {
        var pb_n: i64 = 0;
        for pb_v in pb_run(pb_i32s, m.packed_f) { pb_n += pb_varint_size(pb_int32_to_u64(pb_v)); }
        n += 1 + pb_len_size(pb_n);
    }
    if m.checked.len > 0 { n += 1 + pb_bytes_size(m.checked); }
    if (m.pb_has0 & 0x00000004) != 0 { n += 1 + pb_varint_size(pb_int32_to_u64(m.open)); }
    n += m.pb_unknown.len;
    return n;
}

// Frees what m owns and resets it to the empty message.
fn All_clear(m: All&) {
    m.implicit_f = 0;
    m.closed = 0;
    m.expanded = pb_resize(pb_i32s, m.expanded, 0);
    m.unchecked = pb_bytes_free(m.unchecked);
    All_clear_delimited(m);
    All_clear_subs(m);
    m.explicit_f = 0;
    All_clear_prefixed(m);
    m.packed_f = pb_resize(pb_i32s, m.packed_f, 0);
    m.checked = pb_bytes_free(m.checked);
    m.open = 0;
    m.pb_has0 = 0;
    m.pb_unknown = pb_bytes_free(m.pb_unknown);
}

// Makes dst a deep copy of src, freeing what dst owned. The two share
// nothing afterwards. Neither may be a sub-message of the other.
fn All_copy(dst: All&, src: All&) {
    if dst .== src { return; }
    All_clear(dst);
    dst.implicit_f = src.implicit_f;
    dst.closed = src.closed;
    dst.expanded = pb_copy_run(pb_i32s, src.expanded);
    dst.unchecked = pb_bytes_copy(src.unchecked);
    let pb_f5 = src.delimited.m;
    if pb_f5 { Sub_copy(All_mutable_delimited(dst), pb_f5); }
    dst.subs = pb_resize(All_SubsEntry_entries, dst.subs, src.subs.len);
    for pb_i in src.subs.len {
        All_SubsEntry_copy(pb_run(All_SubsEntry_entries, dst.subs)[pb_i], pb_run(All_SubsEntry_entries, src.subs)[pb_i]);
    }
    dst.explicit_f = src.explicit_f;
    let pb_f8 = src.prefixed.m;
    if pb_f8 { Sub_copy(All_mutable_prefixed(dst), pb_f8); }
    dst.packed_f = pb_copy_run(pb_i32s, src.packed_f);
    dst.checked = pb_bytes_copy(src.checked);
    dst.open = src.open;
    dst.pb_has0 = src.pb_has0;
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
}

// Folds repeated keys in the maps of m and of the messages it holds, which
// decoding appends without looking them up: the last value wins, in the
// place of the first occurrence.
fn All_fold_maps(m: All&) {
    m.subs = All_SubsEntry_fold(m.subs);
}

// Sets closed and marks it present:
// it is encoded even when 0.
fn All_set_closed(m: All&, v: i32) {
    m.closed = v;
    m.pb_has0 |= 0x00000001;
}

fn All_has_closed(m: All&) -> bool { return (m.pb_has0 & 0x00000001) != 0; }

fn All_clear_closed(m: All&) {
    m.closed = 0;
    m.pb_has0 &= 0xfffffffe;
}

// The number of values of expanded.
fn All_expanded_len(m: All&) -> i64 { return m.expanded.len; }

// The values of expanded, in pb_i32s: valid until it is next changed or m is
// cleared.
fn All_expanded(m: All&) -> i32[:] { return pb_run(pb_i32s, m.expanded); }

fn All_expanded_at(m: All&, i: i64) -> i32 { return pb_run(pb_i32s, m.expanded)[i]; }

// Adds a value to expanded. This moves its values, so All_set_expanded is better for many.
fn All_add_expanded(m: All&, v: i32) { m.expanded = pb_add(pb_i32s, m.expanded, v); }

// Sets expanded to a copy of v.
fn All_set_expanded(m: All&, v: const i32[:]) { m.expanded = pb_set_run(pb_i32s, m.expanded, v); }

fn All_clear_expanded(m: All&) { m.expanded = pb_resize(pb_i32s, m.expanded, 0); }

// The contents of unchecked, in pb_bytes: valid until it is next set or m
// is cleared.
fn All_unchecked(m: All&) -> u8[:] { return pb_run(pb_bytes, m.unchecked); }

// Sets unchecked to a copy of v.
fn All_set_unchecked(m: All&, v: const u8[:]) {
    m.unchecked = pb_bytes_set(m.unchecked, v);
}

// The sub-message delimited, or null if it is not set. Valid until it or m is
// cleared.
fn All_delimited(m: All&) -> Sub&? { return m.delimited.m; }

// The sub-message delimited, set to an empty one first if it is not set.
fn All_mutable_delimited(m: All&) -> Sub& {
    let pb_sub = m.delimited.m;
    if pb_sub { return pb_sub; }
    let pb_new .= Sub_pool.alloc_ref(Sub { .. });
    m.delimited.m .= pb_new;
    return pb_new;
}

fn All_has_delimited(m: All&) -> bool { return m.delimited.m != null; }

// Frees the sub-message delimited and everything it owns.
fn All_clear_delimited(m: All&) {
    let pb_sub = m.delimited.m;
    guard pb_sub else { return; }
    Sub_clear(pb_sub);
    Sub_pool.free(Sub_pool.index_of(pb_sub));
    m.delimited.m .= null;
}

// The number of entries of subs.
fn All_subs_len(m: All&) -> i64 { return m.subs.len; }

// The key of entry i of subs, in insertion order.
fn All_subs_key_at(m: All&, i: i64) -> i32 { return pb_run(All_SubsEntry_entries, m.subs)[i].key; }

// The value of entry i of subs. Valid until its entry is removed or m is
// cleared.
fn All_subs_value_at(m: All&, i: i64) -> Sub& {
    let pb_l = pb_run(All_SubsEntry_entries, m.subs)[i].value.m;
    assert(pb_l);
    return pb_l;
}

// The value with key k, or null if there is none. Valid until its entry
// is removed or m is cleared.
fn All_subs_get(m: All&, k: i32) -> Sub&? {
    let pb_i = All_SubsEntry_find(m.subs, m.subs.len, k);
    if pb_i < 0 { return null; }
    return pb_run(All_SubsEntry_entries, m.subs)[pb_i].value.m;
}

// The value with key k, added empty if there is none.
fn All_subs_put(m: All&, k: i32) -> Sub& {
    return All_SubsEntry_mutable_value(All_SubsEntry_slot(m.subs, k));
}

// Adds an entry without looking for key k, much faster than All_subs_put for many.
// Call All_fold_maps(m) before reading the map: until then, a repeated key is
// there twice. There, the last value wins, in the place of the first occurrence.
fn All_subs_append(m: All&, k: i32) -> Sub& {
    let pb_i: i64 = m.subs.len;
    m.subs = pb_resize(All_SubsEntry_entries, m.subs, pb_i + 1);
    let pb_e .= pb_run(All_SubsEntry_entries, m.subs)[pb_i];
    pb_e.key = k;
    return All_SubsEntry_mutable_value(pb_e);
}

// Removes the entry with key k and frees what it owns. False if there is
// none. Later entries keep their order.
fn All_subs_remove(m: All&, k: i32) -> bool {
    let pb_i = All_SubsEntry_find(m.subs, m.subs.len, k);
    if pb_i < 0 { return false; }
    let pb_r = pb_run(All_SubsEntry_entries, m.subs);
    All_SubsEntry_clear(pb_r[pb_i]);
    var pb_j = pb_i;
    while pb_j + 1 < pb_r.len { pb_r[pb_j] = pb_r[pb_j + 1]; pb_j++; }
    pb_r[pb_j] = All_SubsEntry { .. };
    m.subs = pb_resize(All_SubsEntry_entries, m.subs, pb_j);
    return true;
}

// Frees the entries of subs and everything they own.
fn All_clear_subs(m: All&) {
    for pb_i in m.subs.len { All_SubsEntry_clear(pb_run(All_SubsEntry_entries, m.subs)[pb_i]); }
    m.subs = pb_resize(All_SubsEntry_entries, m.subs, 0);
}

// Sets explicit_f and marks it present:
// it is encoded even when 0.
fn All_set_explicit_f(m: All&, v: i32) {
    m.explicit_f = v;
    m.pb_has0 |= 0x00000002;
}

fn All_has_explicit_f(m: All&) -> bool { return (m.pb_has0 & 0x00000002) != 0; }

fn All_clear_explicit_f(m: All&) {
    m.explicit_f = 0;
    m.pb_has0 &= 0xfffffffd;
}

// The sub-message prefixed, or null if it is not set. Valid until it or m is
// cleared.
fn All_prefixed(m: All&) -> Sub&? { return m.prefixed.m; }

// The sub-message prefixed, set to an empty one first if it is not set.
fn All_mutable_prefixed(m: All&) -> Sub& {
    let pb_sub = m.prefixed.m;
    if pb_sub { return pb_sub; }
    let pb_new .= Sub_pool.alloc_ref(Sub { .. });
    m.prefixed.m .= pb_new;
    return pb_new;
}

fn All_has_prefixed(m: All&) -> bool { return m.prefixed.m != null; }

// Frees the sub-message prefixed and everything it owns.
fn All_clear_prefixed(m: All&) {
    let pb_sub = m.prefixed.m;
    guard pb_sub else { return; }
    Sub_clear(pb_sub);
    Sub_pool.free(Sub_pool.index_of(pb_sub));
    m.prefixed.m .= null;
}

// The number of values of packed_f.
fn All_packed_f_len(m: All&) -> i64 { return m.packed_f.len; }

// The values of packed_f, in pb_i32s: valid until it is next changed or m is
// cleared.
fn All_packed_f(m: All&) -> i32[:] { return pb_run(pb_i32s, m.packed_f); }

fn All_packed_f_at(m: All&, i: i64) -> i32 { return pb_run(pb_i32s, m.packed_f)[i]; }

// Adds a value to packed_f. This moves its values, so All_set_packed_f is better for many.
fn All_add_packed_f(m: All&, v: i32) { m.packed_f = pb_add(pb_i32s, m.packed_f, v); }

// Sets packed_f to a copy of v.
fn All_set_packed_f(m: All&, v: const i32[:]) { m.packed_f = pb_set_run(pb_i32s, m.packed_f, v); }

fn All_clear_packed_f(m: All&) { m.packed_f = pb_resize(pb_i32s, m.packed_f, 0); }

// The contents of checked, in pb_bytes: valid until it is next set or m
// is cleared.
fn All_checked(m: All&) -> u8[:] { return pb_run(pb_bytes, m.checked); }

// Sets checked to a copy of v.
fn All_set_checked(m: All&, v: const u8[:]) {
    m.checked = pb_bytes_set(m.checked, v);
}

// Sets open and marks it present:
// it is encoded even when 0.
fn All_set_open(m: All&, v: i32) {
    m.open = v;
    m.pb_has0 |= 0x00000004;
}

fn All_has_open(m: All&) -> bool { return (m.pb_has0 & 0x00000004) != 0; }

fn All_clear_open(m: All&) {
    m.open = 0;
    m.pb_has0 &= 0xfffffffb;
}

// message edf.All.SubsEntry
struct All_SubsEntry {
    key: i32,
    value: Sub_Ref,
    pb_unknown: pb_Span,   // unknown fields: raw wire bytes in pb_bytes
}

// A link to a All_SubsEntry in All_SubsEntry_pool, for sub-message fields.
struct All_SubsEntry_Ref { m: All_SubsEntry&<u32 in All_SubsEntry_pool>? }
reusable var All_SubsEntry_pool: All_SubsEntry[>..] = [];
reusable[] var All_SubsEntry_links: All_SubsEntry_Ref[>..] = [];

// Merges the fields in r's window into m; on failure r.err is set.
// Fields it does not know, or with another wire type, are kept as
// unknown fields.
fn All_SubsEntry_decode_from(r: pb_Reader&, m: All_SubsEntry&) {
    var unknown_len: i64 = m.pb_unknown.len;
    let unknown_had: i64 = unknown_len;
    while r.pos < r.end {
        let start = r.pos;
        let tag = pb_read_tag(r);
        if r.err != PB_OK { break; }
        if tag == 8 {
            m.key = pb_u64_to_int32(pb_read_varint(r));
        } else if tag == 18 {
            pb_charge(r, 40);
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            if r.depth >= PB_MAX_DEPTH { pb_fail(r, PB_ERR_DEPTH); break; }
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            r.depth++;
            Sub_decode_from(r, All_SubsEntry_mutable_value(m));
            if r.err != PB_OK { break; }
            r.depth--;
            r.end = pb_outer;
        } else {
            pb_unknown_append(r, start, tag, m.pb_unknown, unknown_len, unknown_had);
        }
    }
    m.pb_unknown = pb_bytes_trim(m.pb_unknown, unknown_len);
}

// Merges buf into m. 0 on success, else a PB_ERR_* code; m then holds a
// partial message, which the caller clears.
fn All_SubsEntry_decode(buf: const u8[:], m: All_SubsEntry&) -> i32 {
    var r = pb_reader(buf);
    All_SubsEntry_decode_from(r, m);
    return r.err;
}

// Appends m's wire encoding, All_SubsEntry_size_of(m) bytes, to out.
fn All_SubsEntry_encode(m: All_SubsEntry&, out: u8[>..]&) {
    pb_write_varint(out, 8);
    pb_write_varint(out, pb_int32_to_u64(m.key));
    let pb_f2 = m.value.m;
    if pb_f2 {
        pb_write_varint(out, 18);
        pb_write_varint(out, Sub_size_of(pb_f2) as! u64);
        Sub_encode(pb_f2, out);
    }
    out.append(pb_run(pb_bytes, m.pb_unknown));
}

// The size of m's wire encoding, in bytes.
fn All_SubsEntry_size_of(m: All_SubsEntry&) -> i64 {
    var n: i64 = 0;
    n += 1 + pb_varint_size(pb_int32_to_u64(m.key));
    let pb_f2 = m.value.m;
    if pb_f2 { n += 1 + pb_len_size(Sub_size_of(pb_f2)); }
    n += m.pb_unknown.len;
    return n;
}

// Frees what m owns and resets it to the empty message.
fn All_SubsEntry_clear(m: All_SubsEntry&) {
    m.key = 0;
    All_SubsEntry_clear_value(m);
    m.pb_unknown = pb_bytes_free(m.pb_unknown);
}

// Makes dst a deep copy of src, freeing what dst owned. The two share
// nothing afterwards. Neither may be a sub-message of the other.
fn All_SubsEntry_copy(dst: All_SubsEntry&, src: All_SubsEntry&) {
    if dst .== src { return; }
    All_SubsEntry_clear(dst);
    dst.key = src.key;
    let pb_f2 = src.value.m;
    if pb_f2 { Sub_copy(All_SubsEntry_mutable_value(dst), pb_f2); }
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
}

// The sub-message value, or null if it is not set. Valid until it or m is
// cleared.
fn All_SubsEntry_value(m: All_SubsEntry&) -> Sub&? { return m.value.m; }

// The sub-message value, set to an empty one first if it is not set.
fn All_SubsEntry_mutable_value(m: All_SubsEntry&) -> Sub& {
    let pb_sub = m.value.m;
    if pb_sub { return pb_sub; }
    let pb_new .= Sub_pool.alloc_ref(Sub { .. });
    m.value.m .= pb_new;
    return pb_new;
}

fn All_SubsEntry_has_value(m: All_SubsEntry&) -> bool { return m.value.m != null; }

// Frees the sub-message value and everything it owns.
fn All_SubsEntry_clear_value(m: All_SubsEntry&) {
    let pb_sub = m.value.m;
    guard pb_sub else { return; }
    Sub_clear(pb_sub);
    Sub_pool.free(Sub_pool.index_of(pb_sub));
    m.value.m .= null;
}

// Runs of entries: one per map field of this type.
reusable[] var All_SubsEntry_entries: All_SubsEntry[>..] = [];

// The index of the entry with key k among the first `used` of run s, or -1.
fn All_SubsEntry_find(s: pb_Span, used: i64, k: i32) -> i64 {
    let pb_run_s = pb_run(All_SubsEntry_entries, s);
    for pb_i in used {
        if pb_run_s[pb_i].key == k { return pb_i; }
    }
    return -1;
}

// The entry with key k in run s, added with the default value if there is none.
fn All_SubsEntry_slot(s: pb_Span&, k: i32) -> All_SubsEntry& {
    var pb_i = All_SubsEntry_find(s, s.len, k);
    if pb_i < 0 {
        pb_i = s.len;
        s = pb_resize(All_SubsEntry_entries, s, pb_i + 1);
        pb_run(All_SubsEntry_entries, s)[pb_i].key = k;
        All_SubsEntry_mutable_value(pb_run(All_SubsEntry_entries, s)[pb_i]);
    }
    return pb_run(All_SubsEntry_entries, s)[pb_i];
}

// Settles an entry just decoded: a missing message value is an empty one,
// and unknown fields are dropped.
fn All_SubsEntry_place(pb_e: All_SubsEntry&) {
    All_SubsEntry_mutable_value(pb_e);
    pb_e.pb_unknown = pb_bytes_free(pb_e.pb_unknown);
}

// Run s with each repeated key folded: the last value wins, in the place of
// the first occurrence, and what the others held is freed. O(n log n).
// fold_maps calls it; decoding leaves repeated keys for it.
fn All_SubsEntry_fold(s: pb_Span) -> pb_Span {
    if s.len < 2 { return s; }
    let pb_r = pb_run(All_SubsEntry_entries, s);
    var pb_keys: pb_NumKey[>..] = [];
    for pb_i in pb_r.len { pb_keys.push(pb_NumKey { key: pb_r[pb_i].key as! u64, at: pb_i as! u32 }); }
    pb_sort_num_keys(pb_keys);
    var pb_gone: bool[>..] = [];
    var pb_i: i64 = 0;
    while pb_i < pb_keys.len {
        var pb_j = pb_i + 1;
        while pb_j < pb_keys.len && pb_same_num_key(pb_keys[pb_i], pb_keys[pb_j]) { pb_j++; }
        if pb_j - pb_i > 1 {
            if pb_gone.len == 0 { for pb_k in pb_r.len { pb_gone.push(false); } }
            let pb_first: i64 = pb_keys[pb_i].at;
            let pb_last: i64 = pb_keys[pb_j - 1].at;
            for pb_k in pb_j - pb_i - 1 {
                let pb_at: i64 = pb_keys[pb_i + pb_k].at;
                All_SubsEntry_clear(pb_r[pb_at]);
                pb_gone[pb_at] = true;
            }
            pb_gone[pb_first] = false;
            pb_gone[pb_last] = true;
            pb_r[pb_first] = pb_r[pb_last];
            pb_r[pb_last] = All_SubsEntry { .. };
        }
        pb_i = pb_j;
    }
    if pb_gone.len == 0 { return s; }
    var pb_kept: i64 = 0;
    for pb_k in pb_r.len {
        if pb_gone[pb_k] { continue; }
        if pb_kept != pb_k { pb_r[pb_kept] = pb_r[pb_k]; pb_r[pb_k] = All_SubsEntry { .. }; }
        pb_kept++;
    }
    return pb_resize(All_SubsEntry_entries, s, pb_kept);
}
