            r.end = r.pos + pb_n;
            r.depth++;
            Maps_SfEntry_decode_from(r, pb_e);
            if r.err != PB_OK { Maps_SfEntry_clear(pb_e); break; }
            r.depth--;
            r.end = pb_outer;
            Maps_SfEntry_place(pb_e);
            pb_len15++;
        } else if tag == 130 {
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            if r.depth >= PB_MAX_DEPTH { pb_fail(r, PB_ERR_DEPTH); break; }
            pb_reserve(Maps_SdEntry_entries, m.sd, pb_len16, pb_had16);
            let pb_e .= pb_run(Maps_SdEntry_entries, m.sd)[pb_len16];
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            r.depth++;
            Maps_SdEntry_decode_from(r, pb_e);
            if r.err != PB_OK { Maps_SdEntry_clear(pb_e); break; }
            r.depth--;
            r.end = pb_outer;
            Maps_SdEntry_place(pb_e);
            pb_len16++;
        } else if tag == 138 {
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            if r.depth >= PB_MAX_DEPTH { pb_fail(r, PB_ERR_DEPTH); break; }
            pb_reserve(Maps_SeEntry_entries, m.se, pb_len17, pb_had17);
            let pb_e .= pb_run(Maps_SeEntry_entries, m.se)[pb_len17];
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            r.depth++;
            Maps_SeEntry_decode_from(r, pb_e);
            if r.err != PB_OK { Maps_SeEntry_clear(pb_e); break; }
            r.depth--;
            r.end = pb_outer;
            Maps_SeEntry_place(pb_e);
            pb_len17++;
        } else if tag == 146 {
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            if r.depth >= PB_MAX_DEPTH { pb_fail(r, PB_ERR_DEPTH); break; }
            pb_reserve(Maps_SmEntry_entries, m.sm, pb_len18, pb_had18);
            let pb_e .= pb_run(Maps_SmEntry_entries, m.sm)[pb_len18];
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            r.depth++;
            Maps_SmEntry_decode_from(r, pb_e);
            if r.err != PB_OK { Maps_SmEntry_clear(pb_e); break; }
            r.depth--;
            r.end = pb_outer;
            Maps_SmEntry_place(pb_e);
            pb_len18++;
        } else if tag == 154 {
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            if r.depth >= PB_MAX_DEPTH { pb_fail(r, PB_ERR_DEPTH); break; }
            pb_reserve(Maps_DurEntry_entries, m.dur, pb_len19, pb_had19);
            let pb_e .= pb_run(Maps_DurEntry_entries, m.dur)[pb_len19];
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            r.depth++;
            Maps_DurEntry_decode_from(r, pb_e);
            if r.err != PB_OK { Maps_DurEntry_clear(pb_e); break; }
            r.depth--;
            r.end = pb_outer;
            Maps_DurEntry_place(pb_e);
            pb_len19++;
        } else if tag == 162 {
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            if r.depth >= PB_MAX_DEPTH { pb_fail(r, PB_ERR_DEPTH); break; }
            pb_reserve(Maps_SelfEntry_entries, m.self_, pb_len20, pb_had20);
            let pb_e .= pb_run(Maps_SelfEntry_entries, m.self_)[pb_len20];
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            r.depth++;
            Maps_SelfEntry_decode_from(r, pb_e);
            if r.err != PB_OK { Maps_SelfEntry_clear(pb_e); break; }
            r.depth--;
            r.end = pb_outer;
            Maps_SelfEntry_place(pb_e);
            pb_len20++;
        } else if tag == 168 {
            m.after = pb_u64_to_int32(pb_read_varint(r));
        } else {
            pb_unknown_append(r, start, tag, m.pb_unknown, unknown_len);
        }
    }
    m.ss = pb_trim(Maps_SsEntry_entries, m.ss, pb_len1);
    m.sb = pb_trim(Maps_SbEntry_entries, m.sb, pb_len2);
    m.si = pb_trim(Maps_SiEntry_entries, m.si, pb_len3);
    m.is = pb_trim(Maps_IsEntry_entries, m.is, pb_len4);
    m.ll = pb_trim(Maps_LlEntry_entries, m.ll, pb_len5);
    m.uu = pb_trim(Maps_UuEntry_entries, m.uu, pb_len6);
    m.vv = pb_trim(Maps_VvEntry_entries, m.vv, pb_len7);
    m.zz = pb_trim(Maps_ZzEntry_entries, m.zz, pb_len8);
    m.yy = pb_trim(Maps_YyEntry_entries, m.yy, pb_len9);
    m.ff = pb_trim(Maps_FfEntry_entries, m.ff, pb_len10);
    m.gg = pb_trim(Maps_GgEntry_entries, m.gg, pb_len11);
    m.hh = pb_trim(Maps_HhEntry_entries, m.hh, pb_len12);
    m.jj = pb_trim(Maps_JjEntry_entries, m.jj, pb_len13);
    m.bb = pb_trim(Maps_BbEntry_entries, m.bb, pb_len14);
    m.sf = pb_trim(Maps_SfEntry_entries, m.sf, pb_len15);
    m.sd = pb_trim(Maps_SdEntry_entries, m.sd, pb_len16);
    m.se = pb_trim(Maps_SeEntry_entries, m.se, pb_len17);
    m.sm = pb_trim(Maps_SmEntry_entries, m.sm, pb_len18);
    m.dur = pb_trim(Maps_DurEntry_entries, m.dur, pb_len19);
    m.self_ = pb_trim(Maps_SelfEntry_entries, m.self_, pb_len20);
    m.pb_unknown = pb_bytes_trim(m.pb_unknown, unknown_len);
}

// Merges buf into m. 0 on success, else a PB_ERR_* code; m then holds a
// partial message, which the caller clears.
fn Maps_decode(buf: const u8[:], m: Maps&) -> i32 {
    var r = pb_reader(buf);
    Maps_decode_from(r, m);
    if r.err == PB_OK { Maps_fold_maps(m); }
    return r.err;
}

// Appends m's wire encoding, Maps_size_of(m) bytes, to out.
recursive fn Maps_encode(m: Maps&, out: u8[>..]&) {
    for pb_i in m.ss.len {
        let pb_e .= pb_run(Maps_SsEntry_entries, m.ss)[pb_i];
        pb_write_varint(out, 10);
        pb_write_varint(out, Maps_SsEntry_size_of(pb_e) as! u64);
        Maps_SsEntry_encode(pb_e, out);
    }
    for pb_i in m.sb.len {
        let pb_e .= pb_run(Maps_SbEntry_entries, m.sb)[pb_i];
        pb_write_varint(out, 18);
        pb_write_varint(out, Maps_SbEntry_size_of(pb_e) as! u64);
        Maps_SbEntry_encode(pb_e, out);
    }
    for pb_i in m.si.len {
        let pb_e .= pb_run(Maps_SiEntry_entries, m.si)[pb_i];
        pb_write_varint(out, 26);
        pb_write_varint(out, Maps_SiEntry_size_of(pb_e) as! u64);
        Maps_SiEntry_encode(pb_e, out);
    }
    for pb_i in m.is.len {
        let pb_e .= pb_run(Maps_IsEntry_entries, m.is)[pb_i];
        pb_write_varint(out, 34);
        pb_write_varint(out, Maps_IsEntry_size_of(pb_e) as! u64);
        Maps_IsEntry_encode(pb_e, out);
    }
    for pb_i in m.ll.len {
        let pb_e .= pb_run(Maps_LlEntry_entries, m.ll)[pb_i];
        pb_write_varint(out, 42);
        pb_write_varint(out, Maps_LlEntry_size_of(pb_e) as! u64);
        Maps_LlEntry_encode(pb_e, out);
    }
    for pb_i in m.uu.len {
        let pb_e .= pb_run(Maps_UuEntry_entries, m.uu)[pb_i];
        pb_write_varint(out, 50);
        pb_write_varint(out, Maps_UuEntry_size_of(pb_e) as! u64);
        Maps_UuEntry_encode(pb_e, out);
    }
    for pb_i in m.vv.len {
        let pb_e .= pb_run(Maps_VvEntry_entries, m.vv)[pb_i];
        pb_write_varint(out, 58);
        pb_write_varint(out, Maps_VvEntry_size_of(pb_e) as! u64);
        Maps_VvEntry_encode(pb_e, out);
    }
    for pb_i in m.zz.len {
        let pb_e .= pb_run(Maps_ZzEntry_entries, m.zz)[pb_i];
        pb_write_varint(out, 66);
        pb_write_varint(out, Maps_ZzEntry_size_of(pb_e) as! u64);
        Maps_ZzEntry_encode(pb_e, out);
    }
    for pb_i in m.yy.len {
        let pb_e .= pb_run(Maps_YyEntry_entries, m.yy)[pb_i];
        pb_write_varint(out, 74);
        pb_write_varint(out, Maps_YyEntry_size_of(pb_e) as! u64);
        Maps_YyEntry_encode(pb_e, out);
    }
    for pb_i in m.ff.len {
        let pb_e .= pb_run(Maps_FfEntry_entries, m.ff)[pb_i];
        pb_write_varint(out, 82);
        pb_write_varint(out, Maps_FfEntry_size_of(pb_e) as! u64);
        Maps_FfEntry_encode(pb_e, out);
    }
    for pb_i in m.gg.len {
        let pb_e .= pb_run(Maps_GgEntry_entries, m.gg)[pb_i];
        pb_write_varint(out, 90);
        pb_write_varint(out, Maps_GgEntry_size_of(pb_e) as! u64);
        Maps_GgEntry_encode(pb_e, out);
    }
    for pb_i in m.hh.len {
        let pb_e .= pb_run(Maps_HhEntry_entries, m.hh)[pb_i];
        pb_write_varint(out, 98);
        pb_write_varint(out, Maps_HhEntry_size_of(pb_e) as! u64);
        Maps_HhEntry_encode(pb_e, out);
    }
    for pb_i in m.jj.len {
        let pb_e .= pb_run(Maps_JjEntry_entries, m.jj)[pb_i];
        pb_write_varint(out, 106);
        pb_write_varint(out, Maps_JjEntry_size_of(pb_e) as! u64);
        Maps_JjEntry_encode(pb_e, out);
    }
    for pb_i in m.bb.len {
        let pb_e .= pb_run(Maps_BbEntry_entries, m.bb)[pb_i];
        pb_write_varint(out, 114);
        pb_write_varint(out, Maps_BbEntry_size_of(pb_e) as! u64);
        Maps_BbEntry_encode(pb_e, out);
    }
    for pb_i in m.sf.len {
        let pb_e .= pb_run(Maps_SfEntry_entries, m.sf)[pb_i];
        pb_write_varint(out, 122);
        pb_write_varint(out, Maps_SfEntry_size_of(pb_e) as! u64);
        Maps_SfEntry_encode(pb_e, out);
    }
    for pb_i in m.sd.len {
        let pb_e .= pb_run(Maps_SdEntry_entries, m.sd)[pb_i];
        pb_write_varint(out, 130);
        pb_write_varint(out, Maps_SdEntry_size_of(pb_e) as! u64);
        Maps_SdEntry_encode(pb_e, out);
    }
    for pb_i in m.se.len {
        let pb_e .= pb_run(Maps_SeEntry_entries, m.se)[pb_i];
        pb_write_varint(out, 138);
        pb_write_varint(out, Maps_SeEntry_size_of(pb_e) as! u64);
        Maps_SeEntry_encode(pb_e, out);
    }
    for pb_i in m.sm.len {
        let pb_e .= pb_run(Maps_SmEntry_entries, m.sm)[pb_i];
        pb_write_varint(out, 146);
        pb_write_varint(out, Maps_SmEntry_size_of(pb_e) as! u64);
        Maps_SmEntry_encode(pb_e, out);
    }
    for pb_i in m.dur.len {
        let pb_e .= pb_run(Maps_DurEntry_entries, m.dur)[pb_i];
        pb_write_varint(out, 154);
        pb_write_varint(out, Maps_DurEntry_size_of(pb_e) as! u64);
        Maps_DurEntry_encode(pb_e, out);
    }
    for pb_i in m.self_.len {
        let pb_e .= pb_run(Maps_SelfEntry_entries, m.self_)[pb_i];
        pb_write_varint(out, 162);
        pb_write_varint(out, Maps_SelfEntry_size_of(pb_e) as! u64);
        Maps_SelfEntry_encode(pb_e, out);
    }
    if m.after != 0 {
        pb_write_varint(out, 168);
        pb_write_varint(out, pb_int32_to_u64(m.after));
    }
    out.append(pb_run(pb_bytes, m.pb_unknown));
}

// The size of m's wire encoding, in bytes.
recursive fn Maps_size_of(m: Maps&) -> i64 {
    var n: i64 = 0;
    for pb_i in m.ss.len {
        n += 1 + pb_len_size(Maps_SsEntry_size_of(pb_run(Maps_SsEntry_entries, m.ss)[pb_i]));
    }
    for pb_i in m.sb.len {
        n += 1 + pb_len_size(Maps_SbEntry_size_of(pb_run(Maps_SbEntry_entries, m.sb)[pb_i]));
    }
    for pb_i in m.si.len {
        n += 1 + pb_len_size(Maps_SiEntry_size_of(pb_run(Maps_SiEntry_entries, m.si)[pb_i]));
    }
    for pb_i in m.is.len {
        n += 1 + pb_len_size(Maps_IsEntry_size_of(pb_run(Maps_IsEntry_entries, m.is)[pb_i]));
    }
    for pb_i in m.ll.len {
        n += 1 + pb_len_size(Maps_LlEntry_size_of(pb_run(Maps_LlEntry_entries, m.ll)[pb_i]));
    }
    for pb_i in m.uu.len {
        n += 1 + pb_len_size(Maps_UuEntry_size_of(pb_run(Maps_UuEntry_entries, m.uu)[pb_i]));
    }
    for pb_i in m.vv.len {
        n += 1 + pb_len_size(Maps_VvEntry_size_of(pb_run(Maps_VvEntry_entries, m.vv)[pb_i]));
    }
    for pb_i in m.zz.len {
        n += 1 + pb_len_size(Maps_ZzEntry_size_of(pb_run(Maps_ZzEntry_entries, m.zz)[pb_i]));
    }
    for pb_i in m.yy.len {
        n += 1 + pb_len_size(Maps_YyEntry_size_of(pb_run(Maps_YyEntry_entries, m.yy)[pb_i]));
    }
    for pb_i in m.ff.len {
        n += 1 + pb_len_size(Maps_FfEntry_size_of(pb_run(Maps_FfEntry_entries, m.ff)[pb_i]));
    }
    for pb_i in m.gg.len {
        n += 1 + pb_len_size(Maps_GgEntry_size_of(pb_run(Maps_GgEntry_entries, m.gg)[pb_i]));
    }
    for pb_i in m.hh.len {
        n += 1 + pb_len_size(Maps_HhEntry_size_of(pb_run(Maps_HhEntry_entries, m.hh)[pb_i]));
    }
    for pb_i in m.jj.len {
        n += 1 + pb_len_size(Maps_JjEntry_size_of(pb_run(Maps_JjEntry_entries, m.jj)[pb_i]));
    }
    for pb_i in m.bb.len {
        n += 1 + pb_len_size(Maps_BbEntry_size_of(pb_run(Maps_BbEntry_entries, m.bb)[pb_i]));
    }
    for pb_i in m.sf.len {
        n += 1 + pb_len_size(Maps_SfEntry_size_of(pb_run(Maps_SfEntry_entries, m.sf)[pb_i]));
    }
    for pb_i in m.sd.len {
        n += 2 + pb_len_size(Maps_SdEntry_size_of(pb_run(Maps_SdEntry_entries, m.sd)[pb_i]));
    }
    for pb_i in m.se.len {
        n += 2 + pb_len_size(Maps_SeEntry_size_of(pb_run(Maps_SeEntry_entries, m.se)[pb_i]));
    }
    for pb_i in m.sm.len {
        n += 2 + pb_len_size(Maps_SmEntry_size_of(pb_run(Maps_SmEntry_entries, m.sm)[pb_i]));
    }
    for pb_i in m.dur.len {
        n += 2 + pb_len_size(Maps_DurEntry_size_of(pb_run(Maps_DurEntry_entries, m.dur)[pb_i]));
    }
    for pb_i in m.self_.len {
        n += 2 + pb_len_size(Maps_SelfEntry_size_of(pb_run(Maps_SelfEntry_entries, m.self_)[pb_i]));
    }
    if m.after != 0 { n += 2 + pb_varint_size(pb_int32_to_u64(m.after)); }
    n += m.pb_unknown.len;
    return n;
}

// Frees what m owns and resets it to the empty message.
recursive fn Maps_clear(m: Maps&) {
    Maps_clear_ss(m);
    Maps_clear_sb(m);
    Maps_clear_si(m);
    Maps_clear_is(m);
    Maps_clear_ll(m);
    Maps_clear_uu(m);
    Maps_clear_vv(m);
    Maps_clear_zz(m);
    Maps_clear_yy(m);
    Maps_clear_ff(m);
    Maps_clear_gg(m);
    Maps_clear_hh(m);
    Maps_clear_jj(m);
    Maps_clear_bb(m);
    Maps_clear_sf(m);
    Maps_clear_sd(m);
    Maps_clear_se(m);
    Maps_clear_sm(m);
    Maps_clear_dur(m);
    Maps_clear_self(m);
    m.after = 0;
    m.pb_unknown = pb_bytes_free(m.pb_unknown);
}

// Makes dst a deep copy of src, freeing what dst owned. The two share
// nothing afterwards. Neither may be a sub-message of the other.
recursive fn Maps_copy(dst: Maps&, src: Maps&) {
    if dst .== src { return; }
    Maps_clear(dst);
    dst.ss = pb_resize(Maps_SsEntry_entries, dst.ss, src.ss.len);
    for pb_i in src.ss.len {
        Maps_SsEntry_copy(pb_run(Maps_SsEntry_entries, dst.ss)[pb_i], pb_run(Maps_SsEntry_entries, src.ss)[pb_i]);
    }
    dst.sb = pb_resize(Maps_SbEntry_entries, dst.sb, src.sb.len);
    for pb_i in src.sb.len {
        Maps_SbEntry_copy(pb_run(Maps_SbEntry_entries, dst.sb)[pb_i], pb_run(Maps_SbEntry_entries, src.sb)[pb_i]);
    }
    dst.si = pb_resize(Maps_SiEntry_entries, dst.si, src.si.len);
    for pb_i in src.si.len {
        Maps_SiEntry_copy(pb_run(Maps_SiEntry_entries, dst.si)[pb_i], pb_run(Maps_SiEntry_entries, src.si)[pb_i]);
    }
    dst.is = pb_resize(Maps_IsEntry_entries, dst.is, src.is.len);
    for pb_i in src.is.len {
        Maps_IsEntry_copy(pb_run(Maps_IsEntry_entries, dst.is)[pb_i], pb_run(Maps_IsEntry_entries, src.is)[pb_i]);
    }
    dst.ll = pb_resize(Maps_LlEntry_entries, dst.ll, src.ll.len);
    for pb_i in src.ll.len {
        Maps_LlEntry_copy(pb_run(Maps_LlEntry_entries, dst.ll)[pb_i], pb_run(Maps_LlEntry_entries, src.ll)[pb_i]);
    }
    dst.uu = pb_resize(Maps_UuEntry_entries, dst.uu, src.uu.len);
    for pb_i in src.uu.len {
        Maps_UuEntry_copy(pb_run(Maps_UuEntry_entries, dst.uu)[pb_i], pb_run(Maps_UuEntry_entries, src.uu)[pb_i]);
    }
    dst.vv = pb_resize(Maps_VvEntry_entries, dst.vv, src.vv.len);
    for pb_i in src.vv.len {
        Maps_VvEntry_copy(pb_run(Maps_VvEntry_entries, dst.vv)[pb_i], pb_run(Maps_VvEntry_entries, src.vv)[pb_i]);
    }
    dst.zz = pb_resize(Maps_ZzEntry_entries, dst.zz, src.zz.len);
    for pb_i in src.zz.len {
        Maps_ZzEntry_copy(pb_run(Maps_ZzEntry_entries, dst.zz)[pb_i], pb_run(Maps_ZzEntry_entries, src.zz)[pb_i]);
    }
    dst.yy = pb_resize(Maps_YyEntry_entries, dst.yy, src.yy.len);
    for pb_i in src.yy.len {
        Maps_YyEntry_copy(pb_run(Maps_YyEntry_entries, dst.yy)[pb_i], pb_run(Maps_YyEntry_entries, src.yy)[pb_i]);
    }
    dst.ff = pb_resize(Maps_FfEntry_entries, dst.ff, src.ff.len);
    for pb_i in src.ff.len {
        Maps_FfEntry_copy(pb_run(Maps_FfEntry_entries, dst.ff)[pb_i], pb_run(Maps_FfEntry_entries, src.ff)[pb_i]);
    }
    dst.gg = pb_resize(Maps_GgEntry_entries, dst.gg, src.gg.len);
    for pb_i in src.gg.len {
        Maps_GgEntry_copy(pb_run(Maps_GgEntry_entries, dst.gg)[pb_i], pb_run(Maps_GgEntry_entries, src.gg)[pb_i]);
    }
    dst.hh = pb_resize(Maps_HhEntry_entries, dst.hh, src.hh.len);
    for pb_i in src.hh.len {
        Maps_HhEntry_copy(pb_run(Maps_HhEntry_entries, dst.hh)[pb_i], pb_run(Maps_HhEntry_entries, src.hh)[pb_i]);
    }
    dst.jj = pb_resize(Maps_JjEntry_entries, dst.jj, src.jj.len);
    for pb_i in src.jj.len {
        Maps_JjEntry_copy(pb_run(Maps_JjEntry_entries, dst.jj)[pb_i], pb_run(Maps_JjEntry_entries, src.jj)[pb_i]);
    }
    dst.bb = pb_resize(Maps_BbEntry_entries, dst.bb, src.bb.len);
    for pb_i in src.bb.len {
        Maps_BbEntry_copy(pb_run(Maps_BbEntry_entries, dst.bb)[pb_i], pb_run(Maps_BbEntry_entries, src.bb)[pb_i]);
    }
    dst.sf = pb_resize(Maps_SfEntry_entries, dst.sf, src.sf.len);
    for pb_i in src.sf.len {
        Maps_SfEntry_copy(pb_run(Maps_SfEntry_entries, dst.sf)[pb_i], pb_run(Maps_SfEntry_entries, src.sf)[pb_i]);
    }
    dst.sd = pb_resize(Maps_SdEntry_entries, dst.sd, src.sd.len);
    for pb_i in src.sd.len {
        Maps_SdEntry_copy(pb_run(Maps_SdEntry_entries, dst.sd)[pb_i], pb_run(Maps_SdEntry_entries, src.sd)[pb_i]);
    }
    dst.se = pb_resize(Maps_SeEntry_entries, dst.se, src.se.len);
    for pb_i in src.se.len {
        Maps_SeEntry_copy(pb_run(Maps_SeEntry_entries, dst.se)[pb_i], pb_run(Maps_SeEntry_entries, src.se)[pb_i]);
    }
    dst.sm = pb_resize(Maps_SmEntry_entries, dst.sm, src.sm.len);
    for pb_i in src.sm.len {
        Maps_SmEntry_copy(pb_run(Maps_SmEntry_entries, dst.sm)[pb_i], pb_run(Maps_SmEntry_entries, src.sm)[pb_i]);
    }
    dst.dur = pb_resize(Maps_DurEntry_entries, dst.dur, src.dur.len);
    for pb_i in src.dur.len {
        Maps_DurEntry_copy(pb_run(Maps_DurEntry_entries, dst.dur)[pb_i], pb_run(Maps_DurEntry_entries, src.dur)[pb_i]);
    }
    dst.self_ = pb_resize(Maps_SelfEntry_entries, dst.self_, src.self_.len);
    for pb_i in src.self_.len {
        Maps_SelfEntry_copy(pb_run(Maps_SelfEntry_entries, dst.self_)[pb_i], pb_run(Maps_SelfEntry_entries, src.self_)[pb_i]);
    }
    dst.after = src.after;
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
}

// Folds repeated keys in the maps of m and of the messages it holds, which
// decoding appends without looking them up: the last value wins, in the
// place of the first occurrence.
recursive fn Maps_fold_maps(m: Maps&) {
    m.ss = Maps_SsEntry_fold(m.ss);
    m.sb = Maps_SbEntry_fold(m.sb);
    m.si = Maps_SiEntry_fold(m.si);
    m.is = Maps_IsEntry_fold(m.is);
    m.ll = Maps_LlEntry_fold(m.ll);
    m.uu = Maps_UuEntry_fold(m.uu);
    m.vv = Maps_VvEntry_fold(m.vv);
    m.zz = Maps_ZzEntry_fold(m.zz);
    m.yy = Maps_YyEntry_fold(m.yy);
    m.ff = Maps_FfEntry_fold(m.ff);
    m.gg = Maps_GgEntry_fold(m.gg);
    m.hh = Maps_HhEntry_fold(m.hh);
    m.jj = Maps_JjEntry_fold(m.jj);
    m.bb = Maps_BbEntry_fold(m.bb);
    m.sf = Maps_SfEntry_fold(m.sf);
    m.sd = Maps_SdEntry_fold(m.sd);
    m.se = Maps_SeEntry_fold(m.se);
    m.sm = Maps_SmEntry_fold(m.sm);
    m.dur = Maps_DurEntry_fold(m.dur);
    m.self_ = Maps_SelfEntry_fold(m.self_);
    for pb_i in m.self_.len { Maps_SelfEntry_fold_maps(pb_run(Maps_SelfEntry_entries, m.self_)[pb_i]); }
}

// The entries of ss, in insertion order: its .len is their number, and
// each has .key and .value, or the entry type's accessors for what is in a
// pool. Valid until the map next changes or m is cleared.
fn Maps_ss(m: Maps&) -> Maps_SsEntry[:] { return pb_run(Maps_SsEntry_entries, m.ss); }

// The value with key k and true, or the default and false. Valid until the
// map next changes or m is cleared.
fn Maps_ss_get(m: Maps&, k: const u8[:]) -> u8[:], bool {
    let pb_i = Maps_SsEntry_find(m.ss, m.ss.len, k);
    if pb_i < 0 { return pb_run(pb_bytes, pb_Span { at: 0, len: 0 }), false; }
    return pb_run(pb_bytes, pb_run(Maps_SsEntry_entries, m.ss)[pb_i].value), true;
}

// Sets the value with key k to a copy of v, adding an entry if there is none.
fn Maps_ss_put(m: Maps&, k: const u8[:], v: const u8[:]) {
    Maps_SsEntry_set_value(Maps_SsEntry_slot(m.ss, k), v);
}

// Removes the entry with key k and frees what it owns. False if there is
// none. Later entries keep their order.
fn Maps_ss_remove(m: Maps&, k: const u8[:]) -> bool {
    let pb_i = Maps_SsEntry_find(m.ss, m.ss.len, k);
    if pb_i < 0 { return false; }
    let pb_r = pb_run(Maps_SsEntry_entries, m.ss);
    Maps_SsEntry_clear(pb_r[pb_i]);
    var pb_j = pb_i;
    while pb_j + 1 < pb_r.len { pb_r[pb_j] = pb_r[pb_j + 1]; pb_j++; }
    pb_r[pb_j] = Maps_SsEntry { .. };
    m.ss = pb_resize(Maps_SsEntry_entries, m.ss, pb_j);
    return true;
}

// Frees the entries of ss and everything they own.
recursive fn Maps_clear_ss(m: Maps&) {
    for pb_i in m.ss.len { Maps_SsEntry_clear(pb_run(Maps_SsEntry_entries, m.ss)[pb_i]); }
    m.ss = pb_resize(Maps_SsEntry_entries, m.ss, 0);
}

