// Runs of entries: one per map field of this type.
reusable[] var Maps_HhEntry_entries: Maps_HhEntry[>..] = [];

// The index of the entry with key k among the first `used` of run s, or -1.
fn Maps_HhEntry_find(s: pb_Span, used: i64, k: i32) -> i64 {
    let pb_run_s = pb_run(Maps_HhEntry_entries, s);
