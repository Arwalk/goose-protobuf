fn Maps_SmEntry_size_of(m: Maps_SmEntry&) -> i64 {
    var n: i64 = 0;
    n += 1 + pb_bytes_size(m.key);
    let pb_f2 = m.value.m;
    if pb_f2 { n += 1 + pb_len_size(Sub_size_of(pb_f2)); }
    n += m.pb_unknown.len;
    return n;
