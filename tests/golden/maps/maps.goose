fn Maps_SmEntry_decode_from(r: pb_Reader&, m: Maps_SmEntry&) {
    var unknown_len: i64 = m.pb_unknown.len;
    while r.pos < r.end {
        let start = r.pos;
        let tag = pb_read_tag(r);
