// message maps.Maps.SsEntry
struct Maps_SsEntry {
    key: pb_Span,
    value: pb_Span,
    pb_unknown: pb_Span,   // unknown fields: raw wire bytes in pb_bytes
}

// A link to a Maps_SsEntry in Maps_SsEntry_pool, for sub-message fields.
struct Maps_SsEntry_Ref { m: Maps_SsEntry&<u32 in Maps_SsEntry_pool>? }
reusable var Maps_SsEntry_pool: Maps_SsEntry[>..] = [];
reusable[] var Maps_SsEntry_links: Maps_SsEntry_Ref[>..] = [];

// Merges the fields in r's window into m; on failure r.err is set.
// Fields it does not know, or with another wire type, are kept as
// unknown fields.
fn Maps_SsEntry_decode_from(r: pb_Reader&, m: Maps_SsEntry&) {
    var unknown_len: i64 = m.pb_unknown.len;
    while r.pos < r.end {
        let start = r.pos;
        let tag = pb_read_tag(r);
        if r.err != PB_OK { break; }
        if tag == 10 {
            m.key = pb_read_string(r, m.key);
        } else if tag == 18 {
            m.value = pb_read_string(r, m.value);
        } else {
            pb_unknown_append(r, start, tag, m.pb_unknown, unknown_len);
        }
    }
    m.pb_unknown = pb_bytes_trim(m.pb_unknown, unknown_len);
}

// Merges buf into m. 0 on success, else a PB_ERR_* code; m then holds a
// partial message, which the caller clears.
fn Maps_SsEntry_decode(buf: const u8[:], m: Maps_SsEntry&) -> i32 {
    var r = pb_reader(buf);
    Maps_SsEntry_decode_from(r, m);
    return r.err;
}

// Appends m's wire encoding, Maps_SsEntry_size_of(m) bytes, to out.
fn Maps_SsEntry_encode(m: Maps_SsEntry&, out: u8[>..]&) {
    pb_write_varint(out, 10);
    pb_write_bytes(out, m.key);
    pb_write_varint(out, 18);
    pb_write_bytes(out, m.value);
    out.append(pb_run(pb_bytes, m.pb_unknown));
}

// The size of m's wire encoding, in bytes.
fn Maps_SsEntry_size_of(m: Maps_SsEntry&) -> i64 {
    var n: i64 = 0;
    n += 1 + pb_bytes_size(m.key);
    n += 1 + pb_bytes_size(m.value);
    n += m.pb_unknown.len;
    return n;
}

// Frees what m owns and resets it to the empty message.
fn Maps_SsEntry_clear(m: Maps_SsEntry&) {
    m.key = pb_bytes_free(m.key);
    m.value = pb_bytes_free(m.value);
    m.pb_unknown = pb_bytes_free(m.pb_unknown);
}

// Makes dst a deep copy of src, freeing what dst owned. The two share
// nothing afterwards. Neither may be a sub-message of the other.
fn Maps_SsEntry_copy(dst: Maps_SsEntry&, src: Maps_SsEntry&) {
    if dst .== src { return; }
    Maps_SsEntry_clear(dst);
    dst.key = pb_bytes_copy(src.key);
    dst.value = pb_bytes_copy(src.value);
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
}

// The contents of key, in pb_bytes: valid until it is next set or m
// is cleared.
fn Maps_SsEntry_key(m: Maps_SsEntry&) -> u8[:] { return pb_run(pb_bytes, m.key); }

// Sets key to a copy of v.
fn Maps_SsEntry_set_key(m: Maps_SsEntry&, v: const u8[:]) {
    m.key = pb_bytes_set(m.key, v);
}

// The contents of value, in pb_bytes: valid until it is next set or m
// is cleared.
fn Maps_SsEntry_value(m: Maps_SsEntry&) -> u8[:] { return pb_run(pb_bytes, m.value); }

// Sets value to a copy of v.
fn Maps_SsEntry_set_value(m: Maps_SsEntry&, v: const u8[:]) {
    m.value = pb_bytes_set(m.value, v);
}

// Runs of entries: one per map field of this type.
reusable[] var Maps_SsEntry_entries: Maps_SsEntry[>..] = [];

// The index of the entry with key k among the first `used` of run s, or -1.
fn Maps_SsEntry_find(s: pb_Span, used: i64, k: const u8[:]) -> i64 {
    let pb_run_s = pb_run(Maps_SsEntry_entries, s);
    for pb_i in used {
        if pb_run(pb_bytes, pb_run_s[pb_i].key) == k { return pb_i; }
    }
    return -1;
}

// The entry with key k in run s, added with the default value if there is none.
fn Maps_SsEntry_slot(s: pb_Span&, k: const u8[:]) -> Maps_SsEntry& {
    var pb_i = Maps_SsEntry_find(s, s.len, k);
    if pb_i < 0 {
        pb_i = s.len;
        s = pb_resize(Maps_SsEntry_entries, s, pb_i + 1);
        Maps_SsEntry_set_key(pb_run(Maps_SsEntry_entries, s)[pb_i], k);
    }
    return pb_run(Maps_SsEntry_entries, s)[pb_i];
}

// Settles an entry just decoded: a missing message value is an empty one,
// and unknown fields are dropped.
fn Maps_SsEntry_place(pb_e: Maps_SsEntry&) {
    pb_e.pb_unknown = pb_bytes_free(pb_e.pb_unknown);
}

// Run s with each repeated key folded: the last value wins, in the place of
// the first occurrence, and what the others held is freed. O(n log n).
// fold_maps calls it; decoding leaves repeated keys for it.
fn Maps_SsEntry_fold(s: pb_Span) -> pb_Span {
    if s.len < 2 { return s; }
    let pb_r = pb_run(Maps_SsEntry_entries, s);
    var pb_keys: pb_StrKey[>..] = [];
    for pb_i in pb_r.len { pb_keys.push(pb_StrKey { key: pb_r[pb_i].key, at: pb_i as! u32 }); }
    pb_sort_str_keys(pb_keys);
    var pb_gone: bool[>..] = [];
    var pb_i: i64 = 0;
    while pb_i < pb_keys.len {
        var pb_j = pb_i + 1;
        while pb_j < pb_keys.len && pb_same_str_key(pb_keys[pb_i], pb_keys[pb_j]) { pb_j++; }
        if pb_j - pb_i > 1 {
            if pb_gone.len == 0 { for pb_k in pb_r.len { pb_gone.push(false); } }
            let pb_first: i64 = pb_keys[pb_i].at;
            let pb_last: i64 = pb_keys[pb_j - 1].at;
            for pb_k in pb_j - pb_i - 1 {
                let pb_at: i64 = pb_keys[pb_i + pb_k].at;
                Maps_SsEntry_clear(pb_r[pb_at]);
                pb_gone[pb_at] = true;
            }
            pb_gone[pb_first] = false;
            pb_gone[pb_last] = true;
            pb_r[pb_first] = pb_r[pb_last];
            pb_r[pb_last] = Maps_SsEntry { .. };
        }
        pb_i = pb_j;
    }
    if pb_gone.len == 0 { return s; }
    var pb_kept: i64 = 0;
    for pb_k in pb_r.len {
        if pb_gone[pb_k] { continue; }
        if pb_kept != pb_k { pb_r[pb_kept] = pb_r[pb_k]; pb_r[pb_k] = Maps_SsEntry { .. }; }
        pb_kept++;
    }
    return pb_resize(Maps_SsEntry_entries, s, pb_kept);
