// Appends m's wire encoding, Free_size_of(m) bytes, to out.
recursive fn Free_encode(m: Free&, out: u8[>..]&) {
    if (m.pb_has0 & 0x00000001) != 0 {
        pb_write_varint(out, 8);
        pb_write_varint(out, pb_int32_to_u64(m.a));
    }
    let pb_f2 = m.next.m;
    if pb_f2 {
        pb_write_varint(out, 18);
        pb_write_varint(out, Free_size_of(pb_f2) as! u64);
        Free_encode(pb_f2, out);
    }
    out.append(pb_run(pb_bytes, m.pb_unknown));
}

// The size of m's wire encoding, in bytes.
recursive fn Free_size_of(m: Free&) -> i64 {
    var n: i64 = 0;
    if (m.pb_has0 & 0x00000001) != 0 { n += 1 + pb_varint_size(pb_int32_to_u64(m.a)); }
    let pb_f2 = m.next.m;
    if pb_f2 { n += 1 + pb_len_size(Free_size_of(pb_f2)); }
    n += m.pb_unknown.len;
    return n;
}

// Frees what m owns and resets it to the empty message.
recursive fn Free_clear(m: Free&) {
    m.a = 0;
    Free_clear_next(m);
    m.pb_has0 = 0;
    m.pb_unknown = pb_bytes_free(m.pb_unknown);
}

// Makes dst a deep copy of src, freeing what dst owned. The two share
// nothing afterwards. Neither may be a sub-message of the other.
recursive fn Free_copy(dst: Free&, src: Free&) {
    if dst .== src { return; }
    Free_clear(dst);
    dst.a = src.a;
    let pb_f2 = src.next.m;
    if pb_f2 { Free_copy(Free_mutable_next(dst), pb_f2); }
    dst.pb_has0 = src.pb_has0;
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
}

// Sets a and marks it present:
// it is encoded even when 0.
fn Free_set_a(m: Free&, v: i32) {
    m.a = v;
    m.pb_has0 |= 0x00000001;
}

fn Free_has_a(m: Free&) -> bool { return (m.pb_has0 & 0x00000001) != 0; }

fn Free_clear_a(m: Free&) {
    m.a = 0;
    m.pb_has0 &= 0xfffffffe;
}

// The sub-message next, or null if it is not set. Valid until it or m is
// cleared.
fn Free_next(m: Free&) -> Free&? { return m.next.m; }

// The sub-message next, set to an empty one first if it is not set.
fn Free_mutable_next(m: Free&) -> Free& {
    let pb_sub = m.next.m;
    if pb_sub { return pb_sub; }
    let pb_new .= Free_pool.alloc_ref(Free { .. });
    m.next.m .= pb_new;
    return pb_new;
}

fn Free_has_next(m: Free&) -> bool { return m.next.m != null; }

// Frees the sub-message next and everything it owns.
recursive fn Free_clear_next(m: Free&) {
    let pb_sub = m.next.m;
    guard pb_sub else { return; }
    Free_clear(pb_sub);
    Free_pool.free(Free_pool.index_of(pb_sub));
    m.next.m .= null;
}
