    dst.list_verified = pb_spans_copy(src.list_verified);
    dst.list_unchecked = pb_spans_copy(src.list_unchecked);
    dst.map_verified = pb_resize(Utf8_MapVerifiedEntry_entries, dst.map_verified, src.map_verified.len);
    for pb_i in src.map_verified.len {
        Utf8_MapVerifiedEntry_copy(pb_run(Utf8_MapVerifiedEntry_entries, dst.map_verified)[pb_i], pb_run(Utf8_MapVerifiedEntry_entries, src.map_verified)[pb_i]);
    }
