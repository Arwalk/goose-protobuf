// Makes dst a deep copy of src, freeing what dst owned. The two share
// nothing afterwards. Neither may be a sub-message of the other.
fn Utf8_MapVerifiedEntry_copy(dst: Utf8_MapVerifiedEntry&, src: Utf8_MapVerifiedEntry&) {
    if dst .== src { return; }
    Utf8_MapVerifiedEntry_clear(dst);
