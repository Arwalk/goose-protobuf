// message ed2.Repeats
struct Repeats {
    packed_f: pb_Span,
    expanded: pb_Span,
    pb_unknown: pb_Span,   // unknown fields: raw wire bytes in pb_bytes
}

// A link to a Repeats in Repeats_pool, for sub-message fields.
struct Repeats_Ref { m: Repeats&<u32 in Repeats_pool>? }
reusable var Repeats_pool: Repeats[>..] = [];
reusable[] var Repeats_links: Repeats_Ref[>..] = [];

// Merges the fields in r's window into m; on failure r.err is set.
// Fields it does not know, or with another wire type, are kept as
// unknown fields.
fn Repeats_decode_from(r: pb_Reader&, m: Repeats&) {
    var unknown_len: i64 = m.pb_unknown.len;
    let unknown_had: i64 = unknown_len;
    let pb_had1: i64 = m.packed_f.len;
    var pb_len1: i64 = pb_had1;
    let pb_had2: i64 = m.expanded.len;
    var pb_len2: i64 = pb_had2;
    while r.pos < r.end {
        let start = r.pos;
        let tag = pb_read_tag(r);
        if r.err != PB_OK { break; }
        if tag == 8 {
            pb_append(pb_i32s, m.packed_f, pb_len1, pb_had1, pb_u64_to_int32(pb_read_varint(r)));
        } else if tag == 10 {
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            while r.pos < r.end { pb_append(pb_i32s, m.packed_f, pb_len1, pb_had1, pb_u64_to_int32(pb_read_varint(r))); }
            if r.err != PB_OK { break; }
            r.end = pb_outer;
        } else if tag == 16 {
            pb_append(pb_i32s, m.expanded, pb_len2, pb_had2, pb_u64_to_int32(pb_read_varint(r)));
        } else if tag == 18 {
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            while r.pos < r.end { pb_append(pb_i32s, m.expanded, pb_len2, pb_had2, pb_u64_to_int32(pb_read_varint(r))); }
            if r.err != PB_OK { break; }
            r.end = pb_outer;
        } else {
            pb_unknown_append(r, start, tag, m.pb_unknown, unknown_len, unknown_had);
        }
    }
    m.packed_f = pb_trim(pb_i32s, m.packed_f, pb_len1);
    m.expanded = pb_trim(pb_i32s, m.expanded, pb_len2);
    m.pb_unknown = pb_bytes_trim(m.pb_unknown, unknown_len);
}

// Merges buf into m. 0 on success, else a PB_ERR_* code; m then holds a
// partial message, which the caller clears.
fn Repeats_decode(buf: const u8[:], m: Repeats&) -> i32 {
    var r = pb_reader(buf);
    Repeats_decode_from(r, m);
    return r.err;
}

// Appends m's wire encoding, Repeats_size_of(m) bytes, to out.
fn Repeats_encode(m: Repeats&, out: u8[>..]&) {
    if m.packed_f.len > 0 {
        pb_write_varint(out, 10);
        var pb_n: i64 = 0;
        for pb_v in pb_run(pb_i32s, m.packed_f) { pb_n += pb_varint_size(pb_int32_to_u64(pb_v)); }
        pb_write_varint(out, pb_n as! u64);
        for pb_v in pb_run(pb_i32s, m.packed_f) { pb_write_varint(out, pb_int32_to_u64(pb_v)); }
    }
    if m.expanded.len > 0 {
        for pb_v in pb_run(pb_i32s, m.expanded) {
            pb_write_varint(out, 16);
            pb_write_varint(out, pb_int32_to_u64(pb_v));
        }
    }
    out.append(pb_run(pb_bytes, m.pb_unknown));
}

// The size of m's wire encoding, in bytes.
fn Repeats_size_of(m: Repeats&) -> i64 {
    var n: i64 = 0;
    if m.packed_f.len > 0 {
        var pb_n: i64 = 0;
        for pb_v in pb_run(pb_i32s, m.packed_f) { pb_n += pb_varint_size(pb_int32_to_u64(pb_v)); }
        n += 1 + pb_len_size(pb_n);
    }
    if m.expanded.len > 0 {
        var pb_n: i64 = 0;
        for pb_v in pb_run(pb_i32s, m.expanded) { pb_n += pb_varint_size(pb_int32_to_u64(pb_v)); }
        n += 1 * m.expanded.len + pb_n;
    }
    n += m.pb_unknown.len;
    return n;
}

// Frees what m owns and resets it to the empty message.
fn Repeats_clear(m: Repeats&) {
    m.packed_f = pb_resize(pb_i32s, m.packed_f, 0);
    m.expanded = pb_resize(pb_i32s, m.expanded, 0);
    m.pb_unknown = pb_bytes_free(m.pb_unknown);
}

// Makes dst a deep copy of src, freeing what dst owned. The two share
// nothing afterwards. Neither may be a sub-message of the other.
fn Repeats_copy(dst: Repeats&, src: Repeats&) {
    if dst .== src { return; }
    Repeats_clear(dst);
    dst.packed_f = pb_copy_run(pb_i32s, src.packed_f);
    dst.expanded = pb_copy_run(pb_i32s, src.expanded);
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
}

// The values of packed_f, in pb_i32s: valid until it is next changed or m is
// cleared.
fn Repeats_packed_f(m: Repeats&) -> i32[:] { return pb_run(pb_i32s, m.packed_f); }

fn Repeats_packed_f_at(m: Repeats&, i: i64) -> i32 { return pb_run(pb_i32s, m.packed_f)[i]; }

// Adds a value to packed_f. This moves its values, so Repeats_set_packed_f is better for many.
fn Repeats_add_packed_f(m: Repeats&, v: i32) { m.packed_f = pb_add(pb_i32s, m.packed_f, v); }

// Sets packed_f to a copy of v.
fn Repeats_set_packed_f(m: Repeats&, v: const i32[:]) { m.packed_f = pb_set_run(pb_i32s, m.packed_f, v); }

fn Repeats_clear_packed_f(m: Repeats&) { m.packed_f = pb_resize(pb_i32s, m.packed_f, 0); }

// The values of expanded, in pb_i32s: valid until it is next changed or m is
// cleared.
fn Repeats_expanded(m: Repeats&) -> i32[:] { return pb_run(pb_i32s, m.expanded); }

fn Repeats_expanded_at(m: Repeats&, i: i64) -> i32 { return pb_run(pb_i32s, m.expanded)[i]; }

// Adds a value to expanded. This moves its values, so Repeats_set_expanded is better for many.
fn Repeats_add_expanded(m: Repeats&, v: i32) { m.expanded = pb_add(pb_i32s, m.expanded, v); }

// Sets expanded to a copy of v.
fn Repeats_set_expanded(m: Repeats&, v: const i32[:]) { m.expanded = pb_set_run(pb_i32s, m.expanded, v); }

fn Repeats_clear_expanded(m: Repeats&) { m.expanded = pb_resize(pb_i32s, m.expanded, 0); }

// message ed2.Utf8
enum Utf8_pick {
    pb_none,
    member_verified { v: pb_Span },
    member_unchecked { v: pb_Span },
}

struct Utf8 {
    verified: pb_Span,
    unchecked: pb_Span,
    list_verified: pb_Span,
    list_unchecked: pb_Span,
    map_verified: pb_Span,
    map_unchecked: pb_Span,
    pick: Utf8_pick = Utf8_pick.pb_none,
    pb_has0: u32,   // has-bits of fields with presence
    pb_unknown: pb_Span,   // unknown fields: raw wire bytes in pb_bytes
}

// A link to a Utf8 in Utf8_pool, for sub-message fields.
struct Utf8_Ref { m: Utf8&<u32 in Utf8_pool>? }
reusable var Utf8_pool: Utf8[>..] = [];
reusable[] var Utf8_links: Utf8_Ref[>..] = [];

// Merges the fields in r's window into m; on failure r.err is set.
// Fields it does not know, or with another wire type, are kept as
// unknown fields.
fn Utf8_decode_from(r: pb_Reader&, m: Utf8&) {
    var unknown_len: i64 = m.pb_unknown.len;
    let unknown_had: i64 = unknown_len;
    let pb_had3: i64 = m.list_verified.len;
    var pb_len3: i64 = pb_had3;
    let pb_had4: i64 = m.list_unchecked.len;
    var pb_len4: i64 = pb_had4;
    let pb_had5: i64 = m.map_verified.len;
    var pb_len5: i64 = pb_had5;
    let pb_had6: i64 = m.map_unchecked.len;
    var pb_len6: i64 = pb_had6;
    while r.pos < r.end {
        let start = r.pos;
        let tag = pb_read_tag(r);
        if r.err != PB_OK { break; }
        if tag == 10 {
            m.verified = pb_read_string(r, m.verified);
            m.pb_has0 |= 0x00000001;
        } else if tag == 18 {
            m.unchecked = pb_read_bytes(r, m.unchecked);
            m.pb_has0 |= 0x00000002;
        } else if tag == 26 {
            pb_append(pb_spans, m.list_verified, pb_len3, pb_had3, pb_read_string(r, pb_Span { at: 0, len: 0 }));
        } else if tag == 34 {
            pb_append(pb_spans, m.list_unchecked, pb_len4, pb_had4, pb_read_bytes(r, pb_Span { at: 0, len: 0 }));
        } else if tag == 42 {
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            if r.depth >= PB_MAX_DEPTH { pb_fail(r, PB_ERR_DEPTH); break; }
            pb_reserve(Utf8_MapVerifiedEntry_entries, m.map_verified, pb_len5, pb_had5);
            let pb_e .= pb_run(Utf8_MapVerifiedEntry_entries, m.map_verified)[pb_len5];
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            r.depth++;
            Utf8_MapVerifiedEntry_decode_from(r, pb_e);
            if r.err != PB_OK { Utf8_MapVerifiedEntry_clear(pb_e); break; }
            r.depth--;
            r.end = pb_outer;
            Utf8_MapVerifiedEntry_place(pb_e);
            pb_len5++;
        } else if tag == 50 {
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            if r.depth >= PB_MAX_DEPTH { pb_fail(r, PB_ERR_DEPTH); break; }
            pb_reserve(Utf8_MapUncheckedEntry_entries, m.map_unchecked, pb_len6, pb_had6);
            let pb_e .= pb_run(Utf8_MapUncheckedEntry_entries, m.map_unchecked)[pb_len6];
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            r.depth++;
            Utf8_MapUncheckedEntry_decode_from(r, pb_e);
            if r.err != PB_OK { Utf8_MapUncheckedEntry_clear(pb_e); break; }
            r.depth--;
            r.end = pb_outer;
            Utf8_MapUncheckedEntry_place(pb_e);
            pb_len6++;
        } else if tag == 58 {
            let pb_v = pb_read_string(r, pb_Span { at: 0, len: 0 });
            if r.err != PB_OK { break; }
            Utf8_clear_pick(m);
            m.pick = Utf8_pick.member_verified { v: pb_v };
        } else if tag == 66 {
            let pb_v = pb_read_bytes(r, pb_Span { at: 0, len: 0 });
            if r.err != PB_OK { break; }
            Utf8_clear_pick(m);
            m.pick = Utf8_pick.member_unchecked { v: pb_v };
        } else {
            pb_unknown_append(r, start, tag, m.pb_unknown, unknown_len, unknown_had);
        }
    }
    m.list_verified = pb_trim(pb_spans, m.list_verified, pb_len3);
    m.list_unchecked = pb_trim(pb_spans, m.list_unchecked, pb_len4);
    m.map_verified = pb_trim(Utf8_MapVerifiedEntry_entries, m.map_verified, pb_len5);
    m.map_unchecked = pb_trim(Utf8_MapUncheckedEntry_entries, m.map_unchecked, pb_len6);
    m.pb_unknown = pb_bytes_trim(m.pb_unknown, unknown_len);
