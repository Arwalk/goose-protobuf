struct Enums {
    open: i32,
    closed: i32 = 1,
    closed_packed: pb_Span,
    closed_expanded: pb_Span,
    closed_map: pb_Span,
    open_map: pb_Span,
    pick: Enums_pick = Enums_pick.pb_none,
    pb_has0: u32,   // has-bits of fields with presence
    pb_unknown: pb_Span,   // unknown fields: raw wire bytes in pb_bytes
}

// A link to a Enums in Enums_pool, for sub-message fields.
struct Enums_Ref { m: Enums&<u32 in Enums_pool>? }
reusable var Enums_pool: Enums[>..] = [];
reusable[] var Enums_links: Enums_Ref[>..] = [];

// Merges the fields in r's window into m; on failure r.err is set.
// Fields it does not know, or with another wire type, are kept as
// unknown fields.
fn Enums_decode_from(r: pb_Reader&, m: Enums&) {
    var unknown_len: i64 = m.pb_unknown.len;
    let unknown_had: i64 = unknown_len;
    let pb_had3: i64 = m.closed_packed.len;
    var pb_len3: i64 = pb_had3;
    let pb_had4: i64 = m.closed_expanded.len;
    var pb_len4: i64 = pb_had4;
    let pb_had5: i64 = m.closed_map.len;
    var pb_len5: i64 = pb_had5;
    let pb_had6: i64 = m.open_map.len;
    var pb_len6: i64 = pb_had6;
    while r.pos < r.end {
        let start = r.pos;
        let tag = pb_read_tag(r);
        if r.err != PB_OK { break; }
        if tag == 8 {
            m.open = pb_u64_to_int32(pb_read_varint(r));
            m.pb_has0 |= 0x00000001;
        } else if tag == 16 {
            let pb_v = pb_u64_to_int32(pb_read_varint(r));
            if r.err != PB_OK { break; }
            if pb_v == 1 || pb_v == 5 {
                m.closed = pb_v;
                m.pb_has0 |= 0x00000002;
            } else {
                pb_unknown_keep(r, start, m.pb_unknown, unknown_len, unknown_had);
            }
        } else if tag == 24 {
            let pb_v = pb_u64_to_int32(pb_read_varint(r));
            if r.err != PB_OK { break; }
            if pb_v == 1 || pb_v == 5 {
                pb_append(pb_i32s, m.closed_packed, pb_len3, pb_had3, pb_v);
            } else {
                pb_unknown_keep(r, start, m.pb_unknown, unknown_len, unknown_had);
            }
        } else if tag == 26 {
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            while r.pos < r.end {
                let pb_at = r.pos;
                let pb_v = pb_u64_to_int32(pb_read_varint(r));
                if r.err != PB_OK { break; }
                if pb_v == 1 || pb_v == 5 {
                    pb_append(pb_i32s, m.closed_packed, pb_len3, pb_had3, pb_v);
                } else {
                    pb_unknown_element(r, 24, pb_at, m.pb_unknown, unknown_len, unknown_had);
                }
            }
            if r.err != PB_OK { break; }
            r.end = pb_outer;
        } else if tag == 32 {
            let pb_v = pb_u64_to_int32(pb_read_varint(r));
            if r.err != PB_OK { break; }
            if pb_v == 1 || pb_v == 5 {
                pb_append(pb_i32s, m.closed_expanded, pb_len4, pb_had4, pb_v);
            } else {
                pb_unknown_keep(r, start, m.pb_unknown, unknown_len, unknown_had);
            }
        } else if tag == 34 {
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            while r.pos < r.end {
                let pb_at = r.pos;
                let pb_v = pb_u64_to_int32(pb_read_varint(r));
                if r.err != PB_OK { break; }
                if pb_v == 1 || pb_v == 5 {
                    pb_append(pb_i32s, m.closed_expanded, pb_len4, pb_had4, pb_v);
                } else {
                    pb_unknown_element(r, 32, pb_at, m.pb_unknown, unknown_len, unknown_had);
                }
            }
            if r.err != PB_OK { break; }
            r.end = pb_outer;
        } else if tag == 42 {
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            if r.depth >= PB_MAX_DEPTH { pb_fail(r, PB_ERR_DEPTH); break; }
            pb_reserve(Enums_ClosedMapEntry_entries, m.closed_map, pb_len5, pb_had5);
            let pb_e .= pb_run(Enums_ClosedMapEntry_entries, m.closed_map)[pb_len5];
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            r.depth++;
            Enums_ClosedMapEntry_decode_from(r, pb_e);
            if r.err != PB_OK { Enums_ClosedMapEntry_clear(pb_e); break; }
            r.depth--;
            r.end = pb_outer;
            let pb_v = pb_e.value;
            if !((pb_v >= 0 && pb_v <= 1)) {
                Enums_ClosedMapEntry_clear(pb_e);
                pb_unknown_keep(r, start, m.pb_unknown, unknown_len, unknown_had);
                continue;
            }
            Enums_ClosedMapEntry_place(pb_e);
            pb_len5++;
        } else if tag == 50 {
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            if r.depth >= PB_MAX_DEPTH { pb_fail(r, PB_ERR_DEPTH); break; }
            pb_reserve(Enums_OpenMapEntry_entries, m.open_map, pb_len6, pb_had6);
            let pb_e .= pb_run(Enums_OpenMapEntry_entries, m.open_map)[pb_len6];
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            r.depth++;
            Enums_OpenMapEntry_decode_from(r, pb_e);
            if r.err != PB_OK { Enums_OpenMapEntry_clear(pb_e); break; }
            r.depth--;
            r.end = pb_outer;
            Enums_OpenMapEntry_place(pb_e);
            pb_len6++;
        } else if tag == 56 {
            let pb_v = pb_u64_to_int32(pb_read_varint(r));
            if r.err != PB_OK { break; }
            if !(pb_v == 1 || pb_v == 5) {
                pb_unknown_keep(r, start, m.pb_unknown, unknown_len, unknown_had);
                continue;
            }
            Enums_clear_pick(m);
            m.pick = Enums_pick.closed_member { v: pb_v };
        } else if tag == 64 {
            let pb_v = pb_u64_to_int32(pb_read_varint(r));
            if r.err != PB_OK { break; }
            Enums_clear_pick(m);
            m.pick = Enums_pick.other { v: pb_v };
        } else {
            pb_unknown_append(r, start, tag, m.pb_unknown, unknown_len, unknown_had);
        }
    }
    m.closed_packed = pb_trim(pb_i32s, m.closed_packed, pb_len3);
    m.closed_expanded = pb_trim(pb_i32s, m.closed_expanded, pb_len4);
    m.closed_map = pb_trim(Enums_ClosedMapEntry_entries, m.closed_map, pb_len5);
    m.open_map = pb_trim(Enums_OpenMapEntry_entries, m.open_map, pb_len6);
    m.pb_unknown = pb_bytes_trim(m.pb_unknown, unknown_len);
}

// Merges buf into m. 0 on success, else a PB_ERR_* code; m then holds a
// partial message, which the caller clears.
fn Enums_decode(buf: const u8[:], m: Enums&) -> i32 {
    var r = pb_reader(buf);
    Enums_decode_from(r, m);
    if r.err == PB_OK { Enums_fold_maps(m); }
    return r.err;
}

// Appends m's wire encoding, Enums_size_of(m) bytes, to out.
fn Enums_encode(m: Enums&, out: u8[>..]&) {
    if (m.pb_has0 & 0x00000001) != 0 {
        pb_write_varint(out, 8);
        pb_write_varint(out, pb_int32_to_u64(m.open));
    }
    if (m.pb_has0 & 0x00000002) != 0 {
        pb_write_varint(out, 16);
        pb_write_varint(out, pb_int32_to_u64(m.closed));
    }
    if m.closed_packed.len > 0 {
        pb_write_varint(out, 26);
        var pb_n: i64 = 0;
        for pb_v in pb_run(pb_i32s, m.closed_packed) { pb_n += pb_varint_size(pb_int32_to_u64(pb_v)); }
        pb_write_varint(out, pb_n as! u64);
        for pb_v in pb_run(pb_i32s, m.closed_packed) { pb_write_varint(out, pb_int32_to_u64(pb_v)); }
    }
    if m.closed_expanded.len > 0 {
        for pb_v in pb_run(pb_i32s, m.closed_expanded) {
            pb_write_varint(out, 32);
            pb_write_varint(out, pb_int32_to_u64(pb_v));
        }
    }
    for pb_i in m.closed_map.len {
        let pb_e .= pb_run(Enums_ClosedMapEntry_entries, m.closed_map)[pb_i];
        pb_write_varint(out, 42);
        pb_write_varint(out, Enums_ClosedMapEntry_size_of(pb_e) as! u64);
        Enums_ClosedMapEntry_encode(pb_e, out);
    }
    for pb_i in m.open_map.len {
        let pb_e .= pb_run(Enums_OpenMapEntry_entries, m.open_map)[pb_i];
        pb_write_varint(out, 50);
        pb_write_varint(out, Enums_OpenMapEntry_size_of(pb_e) as! u64);
        Enums_OpenMapEntry_encode(pb_e, out);
    }
    match m.pick {
        closed_member pb_p => {
            pb_write_varint(out, 56);
            pb_write_varint(out, pb_int32_to_u64(pb_p.v));
        },
        _ => {},
    }
    match m.pick {
        other pb_p => {
            pb_write_varint(out, 64);
            pb_write_varint(out, pb_int32_to_u64(pb_p.v));
        },
        _ => {},
    }
    out.append(pb_run(pb_bytes, m.pb_unknown));
}

// The size of m's wire encoding, in bytes.
fn Enums_size_of(m: Enums&) -> i64 {
    var n: i64 = 0;
    if (m.pb_has0 & 0x00000001) != 0 { n += 1 + pb_varint_size(pb_int32_to_u64(m.open)); }
    if (m.pb_has0 & 0x00000002) != 0 { n += 1 + pb_varint_size(pb_int32_to_u64(m.closed)); }
    if m.closed_packed.len > 0 {
        var pb_n: i64 = 0;
        for pb_v in pb_run(pb_i32s, m.closed_packed) { pb_n += pb_varint_size(pb_int32_to_u64(pb_v)); }
        n += 1 + pb_len_size(pb_n);
    }
    if m.closed_expanded.len > 0 {
        var pb_n: i64 = 0;
        for pb_v in pb_run(pb_i32s, m.closed_expanded) { pb_n += pb_varint_size(pb_int32_to_u64(pb_v)); }
        n += 1 * m.closed_expanded.len + pb_n;
    }
    for pb_i in m.closed_map.len {
        n += 1 + pb_len_size(Enums_ClosedMapEntry_size_of(pb_run(Enums_ClosedMapEntry_entries, m.closed_map)[pb_i]));
    }
    for pb_i in m.open_map.len {
        n += 1 + pb_len_size(Enums_OpenMapEntry_size_of(pb_run(Enums_OpenMapEntry_entries, m.open_map)[pb_i]));
    }
    match m.pick {
        closed_member pb_p => { n += 1 + pb_varint_size(pb_int32_to_u64(pb_p.v)); },
        _ => {},
    }
    match m.pick {
        other pb_p => { n += 1 + pb_varint_size(pb_int32_to_u64(pb_p.v)); },
        _ => {},
    }
    n += m.pb_unknown.len;
    return n;
}

// Frees what m owns and resets it to the empty message.
fn Enums_clear(m: Enums&) {
    m.open = 0;
    m.closed = 1;
    m.closed_packed = pb_resize(pb_i32s, m.closed_packed, 0);
    m.closed_expanded = pb_resize(pb_i32s, m.closed_expanded, 0);
    Enums_clear_closed_map(m);
    Enums_clear_open_map(m);
    Enums_clear_pick(m);
    m.pb_has0 = 0;
    m.pb_unknown = pb_bytes_free(m.pb_unknown);
}

// Makes dst a deep copy of src, freeing what dst owned. The two share
// nothing afterwards. Neither may be a sub-message of the other.
fn Enums_copy(dst: Enums&, src: Enums&) {
    if dst .== src { return; }
    Enums_clear(dst);
    dst.open = src.open;
    dst.closed = src.closed;
    dst.closed_packed = pb_copy_run(pb_i32s, src.closed_packed);
    dst.closed_expanded = pb_copy_run(pb_i32s, src.closed_expanded);
    dst.closed_map = pb_resize(Enums_ClosedMapEntry_entries, dst.closed_map, src.closed_map.len);
    for pb_i in src.closed_map.len {
        Enums_ClosedMapEntry_copy(pb_run(Enums_ClosedMapEntry_entries, dst.closed_map)[pb_i], pb_run(Enums_ClosedMapEntry_entries, src.closed_map)[pb_i]);
    }
    dst.open_map = pb_resize(Enums_OpenMapEntry_entries, dst.open_map, src.open_map.len);
    for pb_i in src.open_map.len {
        Enums_OpenMapEntry_copy(pb_run(Enums_OpenMapEntry_entries, dst.open_map)[pb_i], pb_run(Enums_OpenMapEntry_entries, src.open_map)[pb_i]);
    }
    match src.pick {
        closed_member pb_p => { dst.pick = Enums_pick.closed_member { v: pb_p.v }; },
        other pb_p => { dst.pick = Enums_pick.other { v: pb_p.v }; },
        _ => {},
    }
    dst.pb_has0 = src.pb_has0;
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
}

// Folds repeated keys in the maps of m and of the messages it holds, which
// decoding appends without looking them up: the last value wins, in the
// place of the first occurrence.
fn Enums_fold_maps(m: Enums&) {
    m.closed_map = Enums_ClosedMapEntry_fold(m.closed_map);
    m.open_map = Enums_OpenMapEntry_fold(m.open_map);
}

// Frees what oneof pick holds, and sets no member.
fn Enums_clear_pick(m: Enums&) {
    match m.pick {
        _ => {},
    }
    m.pick = Enums_pick.pb_none;
}

// Sets open and marks it present:
// it is encoded even when 0.
fn Enums_set_open(m: Enums&, v: i32) {
    m.open = v;
    m.pb_has0 |= 0x00000001;
}

fn Enums_has_open(m: Enums&) -> bool { return (m.pb_has0 & 0x00000001) != 0; }

fn Enums_clear_open(m: Enums&) {
    m.open = 0;
    m.pb_has0 &= 0xfffffffe;
}

// Sets closed and marks it present:
// it is encoded even when 0.
fn Enums_set_closed(m: Enums&, v: i32) {
    m.closed = v;
    m.pb_has0 |= 0x00000002;
}

fn Enums_has_closed(m: Enums&) -> bool { return (m.pb_has0 & 0x00000002) != 0; }

fn Enums_clear_closed(m: Enums&) {
    m.closed = 1;
    m.pb_has0 &= 0xfffffffd;
}

// The values of closed_packed, in pb_i32s: valid until it is next changed or m is
// cleared.
fn Enums_closed_packed(m: Enums&) -> i32[:] { return pb_run(pb_i32s, m.closed_packed); }

fn Enums_closed_packed_at(m: Enums&, i: i64) -> i32 { return pb_run(pb_i32s, m.closed_packed)[i]; }

// Adds a value to closed_packed. This moves its values, so Enums_set_closed_packed is better for many.
fn Enums_add_closed_packed(m: Enums&, v: i32) { m.closed_packed = pb_add(pb_i32s, m.closed_packed, v); }

// Sets closed_packed to a copy of v.
fn Enums_set_closed_packed(m: Enums&, v: const i32[:]) { m.closed_packed = pb_set_run(pb_i32s, m.closed_packed, v); }

fn Enums_clear_closed_packed(m: Enums&) { m.closed_packed = pb_resize(pb_i32s, m.closed_packed, 0); }

// The values of closed_expanded, in pb_i32s: valid until it is next changed or m is
// cleared.
fn Enums_closed_expanded(m: Enums&) -> i32[:] { return pb_run(pb_i32s, m.closed_expanded); }

fn Enums_closed_expanded_at(m: Enums&, i: i64) -> i32 { return pb_run(pb_i32s, m.closed_expanded)[i]; }

// Adds a value to closed_expanded. This moves its values, so Enums_set_closed_expanded is better for many.
fn Enums_add_closed_expanded(m: Enums&, v: i32) { m.closed_expanded = pb_add(pb_i32s, m.closed_expanded, v); }

// Sets closed_expanded to a copy of v.
fn Enums_set_closed_expanded(m: Enums&, v: const i32[:]) { m.closed_expanded = pb_set_run(pb_i32s, m.closed_expanded, v); }

fn Enums_clear_closed_expanded(m: Enums&) { m.closed_expanded = pb_resize(pb_i32s, m.closed_expanded, 0); }

// The entries of closed_map, in insertion order: its .len is their number, and
// each has .key and .value, or the entry type's accessors for what is in a
// pool. Valid until the map next changes or m is cleared.
fn Enums_closed_map(m: Enums&) -> Enums_ClosedMapEntry[:] { return pb_run(Enums_ClosedMapEntry_entries, m.closed_map); }

// The value with key k and true, or the default and false.
fn Enums_closed_map_get(m: Enums&, k: i32) -> i32, bool {
    let pb_i = Enums_ClosedMapEntry_find(m.closed_map, m.closed_map.len, k);
    if pb_i < 0 { return 0, false; }
    return pb_run(Enums_ClosedMapEntry_entries, m.closed_map)[pb_i].value, true;
}

// Sets the value with key k to v, adding an entry if there is none.
fn Enums_closed_map_put(m: Enums&, k: i32, v: i32) {
    Enums_ClosedMapEntry_slot(m.closed_map, k).value = v;
}

// Removes the entry with key k and frees what it owns. False if there is
// none. Later entries keep their order.
fn Enums_closed_map_remove(m: Enums&, k: i32) -> bool {
    let pb_i = Enums_ClosedMapEntry_find(m.closed_map, m.closed_map.len, k);
    if pb_i < 0 { return false; }
    let pb_r = pb_run(Enums_ClosedMapEntry_entries, m.closed_map);
    Enums_ClosedMapEntry_clear(pb_r[pb_i]);
    var pb_j = pb_i;
    while pb_j + 1 < pb_r.len { pb_r[pb_j] = pb_r[pb_j + 1]; pb_j++; }
    pb_r[pb_j] = Enums_ClosedMapEntry { .. };
    m.closed_map = pb_resize(Enums_ClosedMapEntry_entries, m.closed_map, pb_j);
    return true;
}

// Frees the entries of closed_map and everything they own.
fn Enums_clear_closed_map(m: Enums&) {
    for pb_i in m.closed_map.len { Enums_ClosedMapEntry_clear(pb_run(Enums_ClosedMapEntry_entries, m.closed_map)[pb_i]); }
    m.closed_map = pb_resize(Enums_ClosedMapEntry_entries, m.closed_map, 0);
}

// The entries of open_map, in insertion order: its .len is their number, and
// each has .key and .value, or the entry type's accessors for what is in a
// pool. Valid until the map next changes or m is cleared.
fn Enums_open_map(m: Enums&) -> Enums_OpenMapEntry[:] { return pb_run(Enums_OpenMapEntry_entries, m.open_map); }

// The value with key k and true, or the default and false.
fn Enums_open_map_get(m: Enums&, k: i32) -> i32, bool {
    let pb_i = Enums_OpenMapEntry_find(m.open_map, m.open_map.len, k);
    if pb_i < 0 { return 0, false; }
    return pb_run(Enums_OpenMapEntry_entries, m.open_map)[pb_i].value, true;
}

// Sets the value with key k to v, adding an entry if there is none.
fn Enums_open_map_put(m: Enums&, k: i32, v: i32) {
    Enums_OpenMapEntry_slot(m.open_map, k).value = v;
}

// Removes the entry with key k and frees what it owns. False if there is
// none. Later entries keep their order.
fn Enums_open_map_remove(m: Enums&, k: i32) -> bool {
    let pb_i = Enums_OpenMapEntry_find(m.open_map, m.open_map.len, k);
    if pb_i < 0 { return false; }
    let pb_r = pb_run(Enums_OpenMapEntry_entries, m.open_map);
    Enums_OpenMapEntry_clear(pb_r[pb_i]);
    var pb_j = pb_i;
    while pb_j + 1 < pb_r.len { pb_r[pb_j] = pb_r[pb_j + 1]; pb_j++; }
    pb_r[pb_j] = Enums_OpenMapEntry { .. };
    m.open_map = pb_resize(Enums_OpenMapEntry_entries, m.open_map, pb_j);
    return true;
}

// Frees the entries of open_map and everything they own.
fn Enums_clear_open_map(m: Enums&) {
    for pb_i in m.open_map.len { Enums_OpenMapEntry_clear(pb_run(Enums_OpenMapEntry_entries, m.open_map)[pb_i]); }
    m.open_map = pb_resize(Enums_OpenMapEntry_entries, m.open_map, 0);
}

// The value of closed_member, the default if it is not the member set.
fn Enums_closed_member(m: Enums&) -> i32 {
    match m.pick {
        closed_member pb_p => { return pb_p.v; },
        _ => {},
    }
    return 1;
}

// Makes closed_member the member set, with value v: it is encoded even when 0.
fn Enums_set_closed_member(m: Enums&, v: i32) {
    Enums_clear_pick(m);
    m.pick = Enums_pick.closed_member { v: v };
}

fn Enums_has_closed_member(m: Enums&) -> bool { return match m.pick { closed_member => true, _ => false }; }

// Clears oneof pick if closed_member is the member set.
fn Enums_clear_closed_member(m: Enums&) { if Enums_has_closed_member(m) { Enums_clear_pick(m); } }

// The value of other, the default if it is not the member set.
fn Enums_other(m: Enums&) -> i32 {
    match m.pick {
        other pb_p => { return pb_p.v; },
        _ => {},
    }
    return 0;
}

// Makes other the member set, with value v: it is encoded even when 0.
fn Enums_set_other(m: Enums&, v: i32) {
    Enums_clear_pick(m);
    m.pick = Enums_pick.other { v: v };
}

fn Enums_has_other(m: Enums&) -> bool { return match m.pick { other => true, _ => false }; }

// Clears oneof pick if other is the member set.
fn Enums_clear_other(m: Enums&) { if Enums_has_other(m) { Enums_clear_pick(m); } }

// message ed2.Enums.ClosedMapEntry
struct Enums_ClosedMapEntry {
    key: i32,
    value: i32,
    pb_unknown: pb_Span,   // unknown fields: raw wire bytes in pb_bytes
}

// A link to a Enums_ClosedMapEntry in Enums_ClosedMapEntry_pool, for sub-message fields.
struct Enums_ClosedMapEntry_Ref { m: Enums_ClosedMapEntry&<u32 in Enums_ClosedMapEntry_pool>? }
reusable var Enums_ClosedMapEntry_pool: Enums_ClosedMapEntry[>..] = [];
reusable[] var Enums_ClosedMapEntry_links: Enums_ClosedMapEntry_Ref[>..] = [];

// Merges the fields in r's window into m; on failure r.err is set.
// Fields it does not know, or with another wire type, are kept as
// unknown fields.
fn Enums_ClosedMapEntry_decode_from(r: pb_Reader&, m: Enums_ClosedMapEntry&) {
    var unknown_len: i64 = m.pb_unknown.len;
    let unknown_had: i64 = unknown_len;
    while r.pos < r.end {
        let start = r.pos;
        let tag = pb_read_tag(r);
        if r.err != PB_OK { break; }
        if tag == 8 {
            m.key = pb_u64_to_int32(pb_read_varint(r));
        } else if tag == 16 {
            m.value = pb_u64_to_int32(pb_read_varint(r));
        } else {
            pb_unknown_append(r, start, tag, m.pb_unknown, unknown_len, unknown_had);
        }
    }
    m.pb_unknown = pb_bytes_trim(m.pb_unknown, unknown_len);
}

// Merges buf into m. 0 on success, else a PB_ERR_* code; m then holds a
// partial message, which the caller clears.
fn Enums_ClosedMapEntry_decode(buf: const u8[:], m: Enums_ClosedMapEntry&) -> i32 {
    var r = pb_reader(buf);
    Enums_ClosedMapEntry_decode_from(r, m);
    return r.err;
}

// Appends m's wire encoding, Enums_ClosedMapEntry_size_of(m) bytes, to out.
fn Enums_ClosedMapEntry_encode(m: Enums_ClosedMapEntry&, out: u8[>..]&) {
    pb_write_varint(out, 8);
    pb_write_varint(out, pb_int32_to_u64(m.key));
    pb_write_varint(out, 16);
    pb_write_varint(out, pb_int32_to_u64(m.value));
    out.append(pb_run(pb_bytes, m.pb_unknown));
}

// The size of m's wire encoding, in bytes.
fn Enums_ClosedMapEntry_size_of(m: Enums_ClosedMapEntry&) -> i64 {
    var n: i64 = 0;
    n += 1 + pb_varint_size(pb_int32_to_u64(m.key));
    n += 1 + pb_varint_size(pb_int32_to_u64(m.value));
    n += m.pb_unknown.len;
    return n;
}

// Frees what m owns and resets it to the empty message.
fn Enums_ClosedMapEntry_clear(m: Enums_ClosedMapEntry&) {
    m.key = 0;
    m.value = 0;
    m.pb_unknown = pb_bytes_free(m.pb_unknown);
}

// Makes dst a deep copy of src, freeing what dst owned. The two share
// nothing afterwards. Neither may be a sub-message of the other.
fn Enums_ClosedMapEntry_copy(dst: Enums_ClosedMapEntry&, src: Enums_ClosedMapEntry&) {
    if dst .== src { return; }
    Enums_ClosedMapEntry_clear(dst);
    dst.key = src.key;
    dst.value = src.value;
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
}

// Runs of entries: one per map field of this type.
reusable[] var Enums_ClosedMapEntry_entries: Enums_ClosedMapEntry[>..] = [];

// The index of the entry with key k among the first `used` of run s, or -1.
fn Enums_ClosedMapEntry_find(s: pb_Span, used: i64, k: i32) -> i64 {
    let pb_run_s = pb_run(Enums_ClosedMapEntry_entries, s);
    for pb_i in used {
        if pb_run_s[pb_i].key == k { return pb_i; }
    }
    return -1;
}

// The entry with key k in run s, added with the default value if there is none.
fn Enums_ClosedMapEntry_slot(s: pb_Span&, k: i32) -> Enums_ClosedMapEntry& {
    var pb_i = Enums_ClosedMapEntry_find(s, s.len, k);
    if pb_i < 0 {
        pb_i = s.len;
        s = pb_resize(Enums_ClosedMapEntry_entries, s, pb_i + 1);
        pb_run(Enums_ClosedMapEntry_entries, s)[pb_i].key = k;
    }
    return pb_run(Enums_ClosedMapEntry_entries, s)[pb_i];
}

// Settles an entry just decoded: a missing message value is an empty one,
// and unknown fields are dropped.
fn Enums_ClosedMapEntry_place(pb_e: Enums_ClosedMapEntry&) {
    pb_e.pb_unknown = pb_bytes_free(pb_e.pb_unknown);
}

// Run s with each repeated key folded: the last value wins, in the place of
// the first occurrence, and what the others held is freed. O(n log n).
// fold_maps calls it; decoding leaves repeated keys for it.
fn Enums_ClosedMapEntry_fold(s: pb_Span) -> pb_Span {
    if s.len < 2 { return s; }
    let pb_r = pb_run(Enums_ClosedMapEntry_entries, s);
    var pb_keys: pb_NumKey[>..] = [];
    for pb_i in pb_r.len { pb_keys.push(pb_NumKey { key: pb_r[pb_i].key as! u64, at: pb_i as! u32 }); }
    pb_sort_num_keys(pb_keys);
    var pb_gone: bool[>..] = [];
    var pb_i: i64 = 0;
    while pb_i < pb_keys.len {
        var pb_j = pb_i + 1;
        while pb_j < pb_keys.len && pb_same_num_key(pb_keys[pb_i], pb_keys[pb_j]) { pb_j++; }
        if pb_j - pb_i > 1 {
            if pb_gone.len == 0 { for pb_k in pb_r.len { pb_gone.push(false); } }
            let pb_first: i64 = pb_keys[pb_i].at;
            let pb_last: i64 = pb_keys[pb_j - 1].at;
            for pb_k in pb_j - pb_i - 1 {
                let pb_at: i64 = pb_keys[pb_i + pb_k].at;
                Enums_ClosedMapEntry_clear(pb_r[pb_at]);
                pb_gone[pb_at] = true;
            }
            pb_gone[pb_first] = false;
            pb_gone[pb_last] = true;
            pb_r[pb_first] = pb_r[pb_last];
            pb_r[pb_last] = Enums_ClosedMapEntry { .. };
        }
        pb_i = pb_j;
    }
    if pb_gone.len == 0 { return s; }
    var pb_kept: i64 = 0;
    for pb_k in pb_r.len {
        if pb_gone[pb_k] { continue; }
        if pb_kept != pb_k { pb_r[pb_kept] = pb_r[pb_k]; pb_r[pb_k] = Enums_ClosedMapEntry { .. }; }
        pb_kept++;
    }
    return pb_resize(Enums_ClosedMapEntry_entries, s, pb_kept);
}

