// The size of m's wire encoding, in bytes.
fn Utf8_size_of(m: Utf8&) -> i64 {
    var n: i64 = 0;
    if (m.pb_has0 & 0x00000001) != 0 { n += 1 + pb_bytes_size(m.verified); }
    if (m.pb_has0 & 0x00000002) != 0 { n += 1 + pb_bytes_size(m.unchecked); }
    for pb_v in pb_run(pb_spans, m.list_verified) { n += 1 + pb_bytes_size(pb_v); }
    for pb_v in pb_run(pb_spans, m.list_unchecked) { n += 1 + pb_bytes_size(pb_v); }
    for pb_i in m.map_verified.len {
        n += 1 + pb_len_size(Utf8_MapVerifiedEntry_size_of(pb_run(Utf8_MapVerifiedEntry_entries, m.map_verified)[pb_i]));
    }
    for pb_i in m.map_unchecked.len {
        n += 1 + pb_len_size(Utf8_MapUncheckedEntry_size_of(pb_run(Utf8_MapUncheckedEntry_entries, m.map_unchecked)[pb_i]));
    }
    match m.pick {
        member_verified pb_p => { n += 1 + pb_bytes_size(pb_p.v); },
        _ => {},
    }
    match m.pick {
        member_unchecked pb_p => { n += 1 + pb_bytes_size(pb_p.v); },
        _ => {},
    }
    n += m.pb_unknown.len;
    return n;
