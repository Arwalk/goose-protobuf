// Merges buf into m. 0 on success, else a PB_ERR_* code; m then holds a
// partial message, which the caller clears.
fn Utf8_MapVerifiedEntry_decode(buf: const u8[:], m: Utf8_MapVerifiedEntry&) -> i32 {
    var r = pb_reader(buf);
    Utf8_MapVerifiedEntry_decode_from(r, m);
    return r.err;
}

// Appends m's wire encoding, Utf8_MapVerifiedEntry_size_of(m) bytes, to out.
fn Utf8_MapVerifiedEntry_encode(m: Utf8_MapVerifiedEntry&, out: u8[>..]&) {
    pb_write_varint(out, 10);
    pb_write_bytes(out, m.key);
    pb_write_varint(out, 18);
    pb_write_bytes(out, m.value);
    out.append(pb_run(pb_bytes, m.pb_unknown));
}

// The size of m's wire encoding, in bytes.
fn Utf8_MapVerifiedEntry_size_of(m: Utf8_MapVerifiedEntry&) -> i64 {
    var n: i64 = 0;
    n += 1 + pb_bytes_size(m.key);
    n += 1 + pb_bytes_size(m.value);
    n += m.pb_unknown.len;
    return n;
