// Merges buf into m. 0 on success, else a PB_ERR_* code; m then holds a
// partial message, which the caller clears.
fn Utf8_decode(buf: const u8[:], m: Utf8&) -> i32 {
    var r = pb_reader(buf);
    Utf8_decode_from(r, m);
    if r.err == PB_OK { Utf8_fold_maps(m); }
    return r.err;
}

// Appends m's wire encoding, Utf8_size_of(m) bytes, to out.
fn Utf8_encode(m: Utf8&, out: u8[>..]&) {
    if (m.pb_has0 & 0x00000001) != 0 {
        pb_write_varint(out, 10);
        pb_write_bytes(out, m.verified);
    }
    if (m.pb_has0 & 0x00000002) != 0 {
        pb_write_varint(out, 18);
        pb_write_bytes(out, m.unchecked);
    }
    for pb_v in pb_run(pb_spans, m.list_verified) {
        pb_write_varint(out, 26);
        pb_write_bytes(out, pb_v);
    }
    for pb_v in pb_run(pb_spans, m.list_unchecked) {
        pb_write_varint(out, 34);
        pb_write_bytes(out, pb_v);
    }
    for pb_i in m.map_verified.len {
        let pb_e .= pb_run(Utf8_MapVerifiedEntry_entries, m.map_verified)[pb_i];
        pb_write_varint(out, 42);
        pb_write_varint(out, Utf8_MapVerifiedEntry_size_of(pb_e) as! u64);
        Utf8_MapVerifiedEntry_encode(pb_e, out);
    }
    for pb_i in m.map_unchecked.len {
        let pb_e .= pb_run(Utf8_MapUncheckedEntry_entries, m.map_unchecked)[pb_i];
        pb_write_varint(out, 50);
        pb_write_varint(out, Utf8_MapUncheckedEntry_size_of(pb_e) as! u64);
        Utf8_MapUncheckedEntry_encode(pb_e, out);
    }
    match m.pick {
        member_verified pb_p => {
            pb_write_varint(out, 58);
            pb_write_bytes(out, pb_p.v);
        },
        _ => {},
    }
    match m.pick {
        member_unchecked pb_p => {
            pb_write_varint(out, 66);
            pb_write_bytes(out, pb_p.v);
        },
        _ => {},
    }
    out.append(pb_run(pb_bytes, m.pb_unknown));
