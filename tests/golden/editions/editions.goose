        member_verified pb_p => { dst.pick = Utf8_pick.member_verified { v: pb_bytes_copy(pb_p.v) }; },
        member_unchecked pb_p => { dst.pick = Utf8_pick.member_unchecked { v: pb_bytes_copy(pb_p.v) }; },
        _ => {},
