fn Utf8_MapVerifiedEntry_key(m: Utf8_MapVerifiedEntry&) -> u8[:] { return pb_run(pb_bytes, m.key); }

// Sets key to a copy of v.
fn Utf8_MapVerifiedEntry_set_key(m: Utf8_MapVerifiedEntry&, v: const u8[:]) {
    m.key = pb_bytes_set(m.key, v);
}

// The contents of value, in pb_bytes: valid until it is next set or m
// is cleared.
fn Utf8_MapVerifiedEntry_value(m: Utf8_MapVerifiedEntry&) -> u8[:] { return pb_run(pb_bytes, m.value); }

// Sets value to a copy of v.
fn Utf8_MapVerifiedEntry_set_value(m: Utf8_MapVerifiedEntry&, v: const u8[:]) {
    m.value = pb_bytes_set(m.value, v);
}

// Runs of entries: one per map field of this type.
reusable[] var Utf8_MapVerifiedEntry_entries: Utf8_MapVerifiedEntry[>..] = [];

// The index of the entry with key k among the first `used` of run s, or -1.
fn Utf8_MapVerifiedEntry_find(s: pb_Span, used: i64, k: const u8[:]) -> i64 {
    let pb_run_s = pb_run(Utf8_MapVerifiedEntry_entries, s);
    for pb_i in used {
        if pb_run(pb_bytes, pb_run_s[pb_i].key) == k { return pb_i; }
    }
    return -1;
}

// The entry with key k in run s, added with the default value if there is none.
fn Utf8_MapVerifiedEntry_slot(s: pb_Span&, k: const u8[:]) -> Utf8_MapVerifiedEntry& {
    var pb_i = Utf8_MapVerifiedEntry_find(s, s.len, k);
    if pb_i < 0 {
        pb_i = s.len;
        s = pb_resize(Utf8_MapVerifiedEntry_entries, s, pb_i + 1);
        Utf8_MapVerifiedEntry_set_key(pb_run(Utf8_MapVerifiedEntry_entries, s)[pb_i], k);
    }
    return pb_run(Utf8_MapVerifiedEntry_entries, s)[pb_i];
}

// Settles an entry just decoded: a missing message value is an empty one,
// and unknown fields are dropped.
fn Utf8_MapVerifiedEntry_place(pb_e: Utf8_MapVerifiedEntry&) {
    pb_e.pb_unknown = pb_bytes_free(pb_e.pb_unknown);
}

// Run s with each repeated key folded: the last value wins, in the place of
// the first occurrence, and what the others held is freed. O(n log n).
// fold_maps calls it; decoding leaves repeated keys for it.
fn Utf8_MapVerifiedEntry_fold(s: pb_Span) -> pb_Span {
    if s.len < 2 { return s; }
    let pb_r = pb_run(Utf8_MapVerifiedEntry_entries, s);
    var pb_keys: pb_StrKey[>..] = [];
    for pb_i in pb_r.len { pb_keys.push(pb_StrKey { key: pb_r[pb_i].key, at: pb_i as! u32 }); }
    pb_sort_str_keys(pb_keys);
    var pb_gone: bool[>..] = [];
    var pb_i: i64 = 0;
    while pb_i < pb_keys.len {
        var pb_j = pb_i + 1;
        while pb_j < pb_keys.len && pb_same_str_key(pb_keys[pb_i], pb_keys[pb_j]) { pb_j++; }
        if pb_j - pb_i > 1 {
            if pb_gone.len == 0 { for pb_k in pb_r.len { pb_gone.push(false); } }
            let pb_first: i64 = pb_keys[pb_i].at;
            let pb_last: i64 = pb_keys[pb_j - 1].at;
            for pb_k in pb_j - pb_i - 1 {
                let pb_at: i64 = pb_keys[pb_i + pb_k].at;
                Utf8_MapVerifiedEntry_clear(pb_r[pb_at]);
                pb_gone[pb_at] = true;
            }
            pb_gone[pb_first] = false;
            pb_gone[pb_last] = true;
            pb_r[pb_first] = pb_r[pb_last];
            pb_r[pb_last] = Utf8_MapVerifiedEntry { .. };
        }
        pb_i = pb_j;
    }
    if pb_gone.len == 0 { return s; }
    var pb_kept: i64 = 0;
    for pb_k in pb_r.len {
        if pb_gone[pb_k] { continue; }
        if pb_kept != pb_k { pb_r[pb_kept] = pb_r[pb_k]; pb_r[pb_k] = Utf8_MapVerifiedEntry { .. }; }
        pb_kept++;
    }
    return pb_resize(Utf8_MapVerifiedEntry_entries, s, pb_kept);
}

// message ed2.Utf8.MapUncheckedEntry
struct Utf8_MapUncheckedEntry {
    key: pb_Span,
    value: pb_Span,
