    for pb_i in src.map_unchecked.len {
        Utf8_MapUncheckedEntry_copy(pb_run(Utf8_MapUncheckedEntry_entries, dst.map_unchecked)[pb_i], pb_run(Utf8_MapUncheckedEntry_entries, src.map_unchecked)[pb_i]);
    }
