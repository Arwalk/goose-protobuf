// Merges buf into m. 0 on success, else a PB_ERR_* code; m then holds a
// partial message, which the caller clears.
fn Utf8_MapUncheckedEntry_decode(buf: const u8[:], m: Utf8_MapUncheckedEntry&) -> i32 {
    var r = pb_reader(buf);
    Utf8_MapUncheckedEntry_decode_from(r, m);
    return r.err;
}

// Appends m's wire encoding, Utf8_MapUncheckedEntry_size_of(m) bytes, to out.
fn Utf8_MapUncheckedEntry_encode(m: Utf8_MapUncheckedEntry&, out: u8[>..]&) {
    pb_write_varint(out, 10);
    pb_write_bytes(out, m.key);
    pb_write_varint(out, 18);
    pb_write_bytes(out, m.value);
    out.append(pb_run(pb_bytes, m.pb_unknown));
}

// The size of m's wire encoding, in bytes.
fn Utf8_MapUncheckedEntry_size_of(m: Utf8_MapUncheckedEntry&) -> i64 {
    var n: i64 = 0;
    n += 1 + pb_bytes_size(m.key);
    n += 1 + pb_bytes_size(m.value);
    n += m.pb_unknown.len;
    return n;
}

// Frees what m owns and resets it to the empty message.
fn Utf8_MapUncheckedEntry_clear(m: Utf8_MapUncheckedEntry&) {
    m.key = pb_bytes_free(m.key);
    m.value = pb_bytes_free(m.value);
    m.pb_unknown = pb_bytes_free(m.pb_unknown);
}

// Makes dst a deep copy of src, freeing what dst owned. The two share
// nothing afterwards. Neither may be a sub-message of the other.
fn Utf8_MapUncheckedEntry_copy(dst: Utf8_MapUncheckedEntry&, src: Utf8_MapUncheckedEntry&) {
    if dst .== src { return; }
    Utf8_MapUncheckedEntry_clear(dst);
    dst.key = pb_bytes_copy(src.key);
    dst.value = pb_bytes_copy(src.value);
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
}

// The contents of key, in pb_bytes: valid until it is next set or m
// is cleared.
fn Utf8_MapUncheckedEntry_key(m: Utf8_MapUncheckedEntry&) -> u8[:] { return pb_run(pb_bytes, m.key); }

// Sets key to a copy of v.
