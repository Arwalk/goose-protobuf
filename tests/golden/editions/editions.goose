// message ed2.Delimited
enum Delimited_pick {
    pb_none,
    member_delimited { v: Sub_Ref },
    member_prefixed { v: Sub_Ref },
}

struct Delimited {
    prefixed: Sub_Ref,
    delimited: Sub_Ref,
    list_delimited: pb_Span,
    held: ReqSub_Ref,
    pick: Delimited_pick = Delimited_pick.pb_none,
    pb_unknown: pb_Span,   // unknown fields: raw wire bytes in pb_bytes
}

// A link to a Delimited in Delimited_pool, for sub-message fields.
struct Delimited_Ref { m: Delimited&<u32 in Delimited_pool>? }
reusable var Delimited_pool: Delimited[>..] = [];
reusable[] var Delimited_links: Delimited_Ref[>..] = [];

// Merges the fields in r's window into m; on failure r.err is set.
// Fields it does not know, or with another wire type, are kept as
// unknown fields.
fn Delimited_decode_from(r: pb_Reader&, m: Delimited&) {
    var unknown_len: i64 = m.pb_unknown.len;
    let unknown_had: i64 = unknown_len;
    let pb_had3: i64 = m.list_delimited.len;
    var pb_len3: i64 = pb_had3;
    while r.pos < r.end {
        let start = r.pos;
        let tag = pb_read_tag(r);
        if r.err != PB_OK { break; }
        if tag == 10 {
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            if r.depth >= PB_MAX_DEPTH { pb_fail(r, PB_ERR_DEPTH); break; }
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            r.depth++;
            Sub_decode_from(r, Delimited_mutable_prefixed(m));
            if r.err != PB_OK { break; }
            r.depth--;
            r.end = pb_outer;
        } else if tag == 19 {
            let pb_body = r.pos;
            let pb_stop = pb_skip_group(r, tag);
            if r.err != PB_OK { break; }
            let pb_after = r.pos;
            let pb_outer = r.end;
            r.pos = pb_body;
            r.end = pb_stop;
            r.depth++;
            Sub_decode_from(r, Delimited_mutable_delimited(m));
            if r.err != PB_OK { break; }
            r.depth--;
            r.end = pb_outer;
            r.pos = pb_after;
        } else if tag == 27 {
            let pb_body = r.pos;
            let pb_stop = pb_skip_group(r, tag);
            if r.err != PB_OK { break; }
            let pb_after = r.pos;
            pb_reserve(Sub_links, m.list_delimited, pb_len3, pb_had3);
            let pb_sub .= Sub_pool.alloc_ref(Sub { .. });
            pb_run(Sub_links, m.list_delimited)[pb_len3].m .= pb_sub;
            pb_len3++;
            let pb_outer = r.end;
            r.pos = pb_body;
            r.end = pb_stop;
            r.depth++;
            Sub_decode_from(r, pb_sub);
            if r.err != PB_OK { break; }
            r.depth--;
            r.end = pb_outer;
            r.pos = pb_after;
        } else if tag == 35 {
            let pb_body = r.pos;
            let pb_stop = pb_skip_group(r, tag);
            if r.err != PB_OK { break; }
            let pb_after = r.pos;
            let pb_outer = r.end;
            r.pos = pb_body;
            r.end = pb_stop;
            r.depth++;
            Sub_decode_from(r, Delimited_mutable_member_delimited(m));
            if r.err != PB_OK { break; }
            r.depth--;
            r.end = pb_outer;
            r.pos = pb_after;
        } else if tag == 42 {
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            if r.depth >= PB_MAX_DEPTH { pb_fail(r, PB_ERR_DEPTH); break; }
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            r.depth++;
            Sub_decode_from(r, Delimited_mutable_member_prefixed(m));
            if r.err != PB_OK { break; }
            r.depth--;
            r.end = pb_outer;
        } else if tag == 51 {
            let pb_body = r.pos;
            let pb_stop = pb_skip_group(r, tag);
            if r.err != PB_OK { break; }
            let pb_after = r.pos;
            let pb_outer = r.end;
            r.pos = pb_body;
            r.end = pb_stop;
            r.depth++;
            ReqSub_decode_from(r, Delimited_mutable_held(m));
            if r.err != PB_OK { break; }
            r.depth--;
            r.end = pb_outer;
            r.pos = pb_after;
        } else {
            pb_unknown_append(r, start, tag, m.pb_unknown, unknown_len, unknown_had);
        }
    }
    m.list_delimited = pb_trim(Sub_links, m.list_delimited, pb_len3);
    m.pb_unknown = pb_bytes_trim(m.pb_unknown, unknown_len);
}

// Merges buf into m. 0 on success, else a PB_ERR_* code; m then holds a
// partial message, which the caller clears.
fn Delimited_decode(buf: const u8[:], m: Delimited&) -> i32 {
    var r = pb_reader(buf);
    Delimited_decode_from(r, m);
    if r.err == PB_OK && !Delimited_is_initialized(m) { return PB_ERR_REQUIRED; }
    return r.err;
}

// Appends m's wire encoding, Delimited_size_of(m) bytes, to out.
fn Delimited_encode(m: Delimited&, out: u8[>..]&) {
    let pb_f1 = m.prefixed.m;
    if pb_f1 {
        pb_write_varint(out, 10);
        pb_write_varint(out, Sub_size_of(pb_f1) as! u64);
        Sub_encode(pb_f1, out);
    }
    let pb_f2 = m.delimited.m;
    if pb_f2 {
        pb_write_varint(out, 19);
        Sub_encode(pb_f2, out);
        pb_write_varint(out, 20);
    }
    for pb_ref in pb_run(Sub_links, m.list_delimited) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        pb_write_varint(out, 27);
        Sub_encode(pb_l, out);
        pb_write_varint(out, 28);
    }
    match m.pick {
        member_delimited pb_p => {
            let pb_l = pb_p.v.m;
            if pb_l {
                pb_write_varint(out, 35);
                Sub_encode(pb_l, out);
                pb_write_varint(out, 36);
            }
        },
        _ => {},
    }
    match m.pick {
        member_prefixed pb_p => {
            let pb_l = pb_p.v.m;
            if pb_l {
                pb_write_varint(out, 42);
                pb_write_varint(out, Sub_size_of(pb_l) as! u64);
                Sub_encode(pb_l, out);
            }
        },
        _ => {},
    }
    let pb_f6 = m.held.m;
    if pb_f6 {
        pb_write_varint(out, 51);
        ReqSub_encode(pb_f6, out);
        pb_write_varint(out, 52);
    }
    out.append(pb_run(pb_bytes, m.pb_unknown));
}

// The size of m's wire encoding, in bytes.
fn Delimited_size_of(m: Delimited&) -> i64 {
    var n: i64 = 0;
    let pb_f1 = m.prefixed.m;
    if pb_f1 { n += 1 + pb_len_size(Sub_size_of(pb_f1)); }
    let pb_f2 = m.delimited.m;
    if pb_f2 { n += 2 + Sub_size_of(pb_f2); }
    for pb_ref in pb_run(Sub_links, m.list_delimited) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        n += 2 + Sub_size_of(pb_l);
    }
    match m.pick {
        member_delimited pb_p => {
            let pb_l = pb_p.v.m;
            if pb_l { n += 2 + Sub_size_of(pb_l); }
        },
        _ => {},
    }
    match m.pick {
        member_prefixed pb_p => {
            let pb_l = pb_p.v.m;
            if pb_l { n += 1 + pb_len_size(Sub_size_of(pb_l)); }
        },
        _ => {},
    }
    let pb_f6 = m.held.m;
    if pb_f6 { n += 2 + ReqSub_size_of(pb_f6); }
    n += m.pb_unknown.len;
    return n;
}

// Frees what m owns and resets it to the empty message.
fn Delimited_clear(m: Delimited&) {
    Delimited_clear_prefixed(m);
    Delimited_clear_delimited(m);
    Delimited_clear_list_delimited(m);
    Delimited_clear_held(m);
    Delimited_clear_pick(m);
    m.pb_unknown = pb_bytes_free(m.pb_unknown);
}

// Makes dst a deep copy of src, freeing what dst owned. The two share
// nothing afterwards. Neither may be a sub-message of the other.
fn Delimited_copy(dst: Delimited&, src: Delimited&) {
    if dst .== src { return; }
    Delimited_clear(dst);
    let pb_f1 = src.prefixed.m;
    if pb_f1 { Sub_copy(Delimited_mutable_prefixed(dst), pb_f1); }
    let pb_f2 = src.delimited.m;
    if pb_f2 { Sub_copy(Delimited_mutable_delimited(dst), pb_f2); }
    dst.list_delimited = pb_resize(Sub_links, dst.list_delimited, src.list_delimited.len);
    for pb_i in src.list_delimited.len {
        let pb_l = pb_run(Sub_links, src.list_delimited)[pb_i].m;
        guard pb_l else { continue; }
        let pb_c .= Sub_pool.alloc_ref(Sub { .. });
        pb_run(Sub_links, dst.list_delimited)[pb_i].m .= pb_c;
        Sub_copy(pb_c, pb_l);
    }
    let pb_f6 = src.held.m;
    if pb_f6 { ReqSub_copy(Delimited_mutable_held(dst), pb_f6); }
    match src.pick {
        member_delimited pb_p => {
            let pb_l = pb_p.v.m;
            if pb_l { Sub_copy(Delimited_mutable_member_delimited(dst), pb_l); }
        },
        member_prefixed pb_p => {
            let pb_l = pb_p.v.m;
            if pb_l { Sub_copy(Delimited_mutable_member_prefixed(dst), pb_l); }
        },
        _ => {},
    }
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
}

// True if every required field is set, in m and in the messages it holds.
fn Delimited_is_initialized(m: Delimited&) -> bool {
    let pb_f6 = m.held.m;
    if pb_f6 { if !ReqSub_is_initialized(pb_f6) { return false; } }
    return true;
}

// Frees what oneof pick holds, and sets no member.
fn Delimited_clear_pick(m: Delimited&) {
    match m.pick {
        member_delimited pb_p => {
            let pb_sub = pb_p.v.m;
            if pb_sub {
                Sub_clear(pb_sub);
                Sub_pool.free(Sub_pool.index_of(pb_sub));
            }
        },
        member_prefixed pb_p => {
            let pb_sub = pb_p.v.m;
            if pb_sub {
                Sub_clear(pb_sub);
                Sub_pool.free(Sub_pool.index_of(pb_sub));
            }
        },
        _ => {},
    }
    m.pick = Delimited_pick.pb_none;
}

// The sub-message prefixed, or null if it is not set. Valid until it or m is
// cleared.
fn Delimited_prefixed(m: Delimited&) -> Sub&? { return m.prefixed.m; }

// The sub-message prefixed, set to an empty one first if it is not set.
fn Delimited_mutable_prefixed(m: Delimited&) -> Sub& {
    let pb_sub = m.prefixed.m;
    if pb_sub { return pb_sub; }
    let pb_new .= Sub_pool.alloc_ref(Sub { .. });
    m.prefixed.m .= pb_new;
    return pb_new;
}

fn Delimited_has_prefixed(m: Delimited&) -> bool { return m.prefixed.m != null; }

// Frees the sub-message prefixed and everything it owns.
fn Delimited_clear_prefixed(m: Delimited&) {
    let pb_sub = m.prefixed.m;
    guard pb_sub else { return; }
    Sub_clear(pb_sub);
    Sub_pool.free(Sub_pool.index_of(pb_sub));
    m.prefixed.m .= null;
}

// The sub-message delimited, or null if it is not set. Valid until it or m is
// cleared.
fn Delimited_delimited(m: Delimited&) -> Sub&? { return m.delimited.m; }

// The sub-message delimited, set to an empty one first if it is not set.
fn Delimited_mutable_delimited(m: Delimited&) -> Sub& {
    let pb_sub = m.delimited.m;
    if pb_sub { return pb_sub; }
    let pb_new .= Sub_pool.alloc_ref(Sub { .. });
    m.delimited.m .= pb_new;
    return pb_new;
}

fn Delimited_has_delimited(m: Delimited&) -> bool { return m.delimited.m != null; }

// Frees the sub-message delimited and everything it owns.
fn Delimited_clear_delimited(m: Delimited&) {
    let pb_sub = m.delimited.m;
    guard pb_sub else { return; }
    Sub_clear(pb_sub);
    Sub_pool.free(Sub_pool.index_of(pb_sub));
    m.delimited.m .= null;
}

// The links of list_delimited, in Sub_links: its .len is the number of messages.
fn Delimited_list_delimited(m: Delimited&) -> Sub_Ref[:] { return pb_run(Sub_links, m.list_delimited); }

// Message i of list_delimited. Valid until it or m is cleared.
fn Delimited_list_delimited_at(m: Delimited&, i: i64) -> Sub& {
    let pb_l = pb_run(Sub_links, m.list_delimited)[i].m;
    assert(pb_l);
    return pb_l;
}

// Adds an empty message to list_delimited and returns it.
fn Delimited_add_list_delimited(m: Delimited&) -> Sub& {
    let pb_i: i64 = m.list_delimited.len;
    m.list_delimited = pb_resize(Sub_links, m.list_delimited, pb_i + 1);
    let pb_new .= Sub_pool.alloc_ref(Sub { .. });
    pb_run(Sub_links, m.list_delimited)[pb_i].m .= pb_new;
    return pb_new;
}

// Frees the messages of list_delimited and everything they own.
fn Delimited_clear_list_delimited(m: Delimited&) {
    for pb_ref in pb_run(Sub_links, m.list_delimited) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        Sub_clear(pb_l);
        Sub_pool.free(Sub_pool.index_of(pb_l));
    }
    m.list_delimited = pb_resize(Sub_links, m.list_delimited, 0);
}

// The sub-message member_delimited, or null if it is not the member set. Valid until
// oneof pick changes or m is cleared.
fn Delimited_member_delimited(m: Delimited&) -> Sub&? {
    match m.pick {
        member_delimited pb_p => { return pb_p.v.m; },
        _ => {},
    }
    return null;
}

// The sub-message member_delimited, first made the member set, and empty, if it is not.
fn Delimited_mutable_member_delimited(m: Delimited&) -> Sub& {
    match m.pick {
        member_delimited pb_p => {
            let pb_l = pb_p.v.m;
            if pb_l { return pb_l; }
        },
        _ => {},
    }
    Delimited_clear_pick(m);
    let pb_new .= Sub_pool.alloc_ref(Sub { .. });
    m.pick = Delimited_pick.member_delimited { v: Sub_Ref { m: pb_new } };
    return pb_new;
}

fn Delimited_has_member_delimited(m: Delimited&) -> bool { return match m.pick { member_delimited => true, _ => false }; }

// Clears oneof pick if member_delimited is the member set.
fn Delimited_clear_member_delimited(m: Delimited&) { if Delimited_has_member_delimited(m) { Delimited_clear_pick(m); } }

// The sub-message member_prefixed, or null if it is not the member set. Valid until
// oneof pick changes or m is cleared.
fn Delimited_member_prefixed(m: Delimited&) -> Sub&? {
    match m.pick {
        member_prefixed pb_p => { return pb_p.v.m; },
        _ => {},
    }
    return null;
}

// The sub-message member_prefixed, first made the member set, and empty, if it is not.
fn Delimited_mutable_member_prefixed(m: Delimited&) -> Sub& {
    match m.pick {
        member_prefixed pb_p => {
            let pb_l = pb_p.v.m;
            if pb_l { return pb_l; }
        },
        _ => {},
    }
    Delimited_clear_pick(m);
    let pb_new .= Sub_pool.alloc_ref(Sub { .. });
    m.pick = Delimited_pick.member_prefixed { v: Sub_Ref { m: pb_new } };
    return pb_new;
}

fn Delimited_has_member_prefixed(m: Delimited&) -> bool { return match m.pick { member_prefixed => true, _ => false }; }

// Clears oneof pick if member_prefixed is the member set.
fn Delimited_clear_member_prefixed(m: Delimited&) { if Delimited_has_member_prefixed(m) { Delimited_clear_pick(m); } }

// The sub-message held, or null if it is not set. Valid until it or m is
// cleared.
fn Delimited_held(m: Delimited&) -> ReqSub&? { return m.held.m; }

// The sub-message held, set to an empty one first if it is not set.
fn Delimited_mutable_held(m: Delimited&) -> ReqSub& {
    let pb_sub = m.held.m;
    if pb_sub { return pb_sub; }
    let pb_new .= ReqSub_pool.alloc_ref(ReqSub { .. });
    m.held.m .= pb_new;
    return pb_new;
}

fn Delimited_has_held(m: Delimited&) -> bool { return m.held.m != null; }

// Frees the sub-message held and everything it owns.
fn Delimited_clear_held(m: Delimited&) {
    let pb_sub = m.held.m;
    guard pb_sub else { return; }
    ReqSub_clear(pb_sub);
    ReqSub_pool.free(ReqSub_pool.index_of(pb_sub));
    m.held.m .= null;
}

// message ed2.Imported
struct Imported {
    all: edf::All_Ref,
    closed: i32,
    pb_has0: u32,   // has-bits of fields with presence
    pb_unknown: pb_Span,   // unknown fields: raw wire bytes in pb_bytes
}

// A link to a Imported in Imported_pool, for sub-message fields.
struct Imported_Ref { m: Imported&<u32 in Imported_pool>? }
reusable var Imported_pool: Imported[>..] = [];
reusable[] var Imported_links: Imported_Ref[>..] = [];

// Merges the fields in r's window into m; on failure r.err is set.
// Fields it does not know, or with another wire type, are kept as
// unknown fields.
fn Imported_decode_from(r: pb_Reader&, m: Imported&) {
    var unknown_len: i64 = m.pb_unknown.len;
    let unknown_had: i64 = unknown_len;
    while r.pos < r.end {
        let start = r.pos;
        let tag = pb_read_tag(r);
        if r.err != PB_OK { break; }
        if tag == 10 {
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            if r.depth >= PB_MAX_DEPTH { pb_fail(r, PB_ERR_DEPTH); break; }
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            r.depth++;
            edf::All_decode_from(r, Imported_mutable_all(m));
            if r.err != PB_OK { break; }
            r.depth--;
            r.end = pb_outer;
        } else if tag == 16 {
            let pb_v = pb_u64_to_int32(pb_read_varint(r));
            if r.err != PB_OK { break; }
            if (pb_v >= 0 && pb_v <= 1) {
                m.closed = pb_v;
                m.pb_has0 |= 0x00000001;
            } else {
                pb_unknown_keep(r, start, m.pb_unknown, unknown_len, unknown_had);
            }
        } else {
            pb_unknown_append(r, start, tag, m.pb_unknown, unknown_len, unknown_had);
        }
    }
    m.pb_unknown = pb_bytes_trim(m.pb_unknown, unknown_len);
}

// Merges buf into m. 0 on success, else a PB_ERR_* code; m then holds a
// partial message, which the caller clears.
fn Imported_decode(buf: const u8[:], m: Imported&) -> i32 {
    var r = pb_reader(buf);
    Imported_decode_from(r, m);
    if r.err == PB_OK { Imported_fold_maps(m); }
    return r.err;
}

// Appends m's wire encoding, Imported_size_of(m) bytes, to out.
fn Imported_encode(m: Imported&, out: u8[>..]&) {
    let pb_f1 = m.all.m;
    if pb_f1 {
        pb_write_varint(out, 10);
        pb_write_varint(out, edf::All_size_of(pb_f1) as! u64);
        edf::All_encode(pb_f1, out);
    }
    if (m.pb_has0 & 0x00000001) != 0 {
        pb_write_varint(out, 16);
        pb_write_varint(out, pb_int32_to_u64(m.closed));
    }
    out.append(pb_run(pb_bytes, m.pb_unknown));
}

// The size of m's wire encoding, in bytes.
fn Imported_size_of(m: Imported&) -> i64 {
    var n: i64 = 0;
    let pb_f1 = m.all.m;
    if pb_f1 { n += 1 + pb_len_size(edf::All_size_of(pb_f1)); }
    if (m.pb_has0 & 0x00000001) != 0 { n += 1 + pb_varint_size(pb_int32_to_u64(m.closed)); }
    n += m.pb_unknown.len;
    return n;
}

// Frees what m owns and resets it to the empty message.
fn Imported_clear(m: Imported&) {
    Imported_clear_all(m);
    m.closed = 0;
    m.pb_has0 = 0;
    m.pb_unknown = pb_bytes_free(m.pb_unknown);
}

// Makes dst a deep copy of src, freeing what dst owned. The two share
// nothing afterwards. Neither may be a sub-message of the other.
fn Imported_copy(dst: Imported&, src: Imported&) {
    if dst .== src { return; }
    Imported_clear(dst);
    let pb_f1 = src.all.m;
    if pb_f1 { edf::All_copy(Imported_mutable_all(dst), pb_f1); }
    dst.closed = src.closed;
    dst.pb_has0 = src.pb_has0;
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
}

// Folds repeated keys in the maps of m and of the messages it holds, which
// decoding appends without looking them up: the last value wins, in the
// place of the first occurrence.
fn Imported_fold_maps(m: Imported&) {
    let pb_f1 = m.all.m;
    if pb_f1 { edf::All_fold_maps(pb_f1); }
}

// The sub-message all, or null if it is not set. Valid until it or m is
// cleared.
fn Imported_all(m: Imported&) -> edf::All&? { return m.all.m; }

// The sub-message all, set to an empty one first if it is not set.
fn Imported_mutable_all(m: Imported&) -> edf::All& {
    let pb_sub = m.all.m;
    if pb_sub { return pb_sub; }
    let pb_new .= edf::All_pool.alloc_ref(edf::All { .. });
    m.all.m .= pb_new;
    return pb_new;
}

fn Imported_has_all(m: Imported&) -> bool { return m.all.m != null; }

// Frees the sub-message all and everything it owns.
fn Imported_clear_all(m: Imported&) {
    let pb_sub = m.all.m;
    guard pb_sub else { return; }
    edf::All_clear(pb_sub);
    edf::All_pool.free(edf::All_pool.index_of(pb_sub));
    m.all.m .= null;
}

// Sets closed and marks it present:
// it is encoded even when 0.
fn Imported_set_closed(m: Imported&, v: i32) {
    m.closed = v;
    m.pb_has0 |= 0x00000001;
}

fn Imported_has_closed(m: Imported&) -> bool { return (m.pb_has0 & 0x00000001) != 0; }

fn Imported_clear_closed(m: Imported&) {
    m.closed = 0;
    m.pb_has0 &= 0xfffffffe;
}
