    let pb_sub = m.later.m;
    if pb_sub { return pb_sub; }
    let pb_new .= google_protobuf::Duration_pool.alloc_ref(google_protobuf::Duration { .. });
    m.later.m .= pb_new;
    return pb_new;
}

fn Holder_Nested_has_later(m: Holder_Nested&) -> bool { return m.later.m != null; }

// Frees the sub-message later and everything it owns.
fn Holder_Nested_clear_later(m: Holder_Nested&) {
    let pb_sub = m.later.m;
    guard pb_sub else { return; }
    google_protobuf::Duration_clear(pb_sub);
    google_protobuf::Duration_pool.free(google_protobuf::Duration_pool.index_of(pb_sub));
    m.later.m .= null;
}
