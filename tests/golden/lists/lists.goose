    return n;
}

// Frees what m owns and resets it to the empty message.
fn Lists_CountsEntry_clear(m: Lists_CountsEntry&) {
    m.key = pb_bytes_free(m.key);
    m.value = 0;
    m.pb_unknown = pb_bytes_free(m.pb_unknown);
}

// Makes dst a deep copy of src, freeing what dst owned. The two share
// nothing afterwards. Neither may be a sub-message of the other.
fn Lists_CountsEntry_copy(dst: Lists_CountsEntry&, src: Lists_CountsEntry&) {
    if dst .== src { return; }
    Lists_CountsEntry_clear(dst);
    dst.key = pb_bytes_copy(src.key);
    dst.value = src.value;
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
}

// The contents of key, in pb_bytes: valid until it is next set or m
// is cleared.
fn Lists_CountsEntry_key(m: Lists_CountsEntry&) -> u8[:] { return pb_run(pb_bytes, m.key); }

// Sets key to a copy of v.
fn Lists_CountsEntry_set_key(m: Lists_CountsEntry&, v: const u8[:]) {
    m.key = pb_bytes_set(m.key, v);
}

// Runs of entries: one per map field of this type.
reusable[] var Lists_CountsEntry_entries: Lists_CountsEntry[>..] = [];

// The index of the entry with key k among the first `used` of run s, or -1.
fn Lists_CountsEntry_find(s: pb_Span, used: i64, k: const u8[:]) -> i64 {
    let pb_run_s = pb_run(Lists_CountsEntry_entries, s);
    for pb_i in used {
        if pb_run(pb_bytes, pb_run_s[pb_i].key) == k { return pb_i; }
    }
    return -1;
}

// The entry with key k in run s, added with the default value if there is none.
fn Lists_CountsEntry_slot(s: pb_Span&, k: const u8[:]) -> Lists_CountsEntry& {
    var pb_i = Lists_CountsEntry_find(s, s.len, k);
    if pb_i < 0 {
        pb_i = s.len;
        s = pb_resize(Lists_CountsEntry_entries, s, pb_i + 1);
        Lists_CountsEntry_set_key(pb_run(Lists_CountsEntry_entries, s)[pb_i], k);
    }
    return pb_run(Lists_CountsEntry_entries, s)[pb_i];
}

// Settles an entry just decoded: a missing message value is an empty one,
// and unknown fields are dropped.
fn Lists_CountsEntry_place(pb_e: Lists_CountsEntry&) {
    pb_e.pb_unknown = pb_bytes_free(pb_e.pb_unknown);
}

// Run s with each repeated key folded: the last value wins, in the place of
// the first occurrence, and what the others held is freed. O(n log n).
// fold_maps calls it; decoding leaves repeated keys for it.
fn Lists_CountsEntry_fold(s: pb_Span) -> pb_Span {
    if s.len < 2 { return s; }
    let pb_r = pb_run(Lists_CountsEntry_entries, s);
    var pb_keys: pb_StrKey[>..] = [];
    for pb_i in pb_r.len { pb_keys.push(pb_StrKey { key: pb_r[pb_i].key, at: pb_i as! u32 }); }
    pb_sort_str_keys(pb_keys);
    var pb_gone: bool[>..] = [];
    var pb_i: i64 = 0;
    while pb_i < pb_keys.len {
        var pb_j = pb_i + 1;
        while pb_j < pb_keys.len && pb_same_str_key(pb_keys[pb_i], pb_keys[pb_j]) { pb_j++; }
        if pb_j - pb_i > 1 {
            if pb_gone.len == 0 { for pb_k in pb_r.len { pb_gone.push(false); } }
            let pb_first: i64 = pb_keys[pb_i].at;
            let pb_last: i64 = pb_keys[pb_j - 1].at;
            for pb_k in pb_j - pb_i - 1 {
                let pb_at: i64 = pb_keys[pb_i + pb_k].at;
                Lists_CountsEntry_clear(pb_r[pb_at]);
                pb_gone[pb_at] = true;
            }
            pb_gone[pb_first] = false;
            pb_gone[pb_last] = true;
            pb_r[pb_first] = pb_r[pb_last];
            pb_r[pb_last] = Lists_CountsEntry { .. };
        }
        pb_i = pb_j;
    }
    if pb_gone.len == 0 { return s; }
    var pb_kept: i64 = 0;
    for pb_k in pb_r.len {
        if pb_gone[pb_k] { continue; }
        if pb_kept != pb_k { pb_r[pb_kept] = pb_r[pb_k]; pb_r[pb_k] = Lists_CountsEntry { .. }; }
        pb_kept++;
    }
    return pb_resize(Lists_CountsEntry_entries, s, pb_kept);
}

// message lists.Item
struct Item {
    id: i32,
    label: pb_Span,
    tags: pb_Span,
    pb_unknown: pb_Span,   // unknown fields: raw wire bytes in pb_bytes
}

// A link to a Item in Item_pool, for sub-message fields.
struct Item_Ref { m: Item&<u32 in Item_pool>? }
reusable var Item_pool: Item[>..] = [];
reusable[] var Item_links: Item_Ref[>..] = [];

// Merges the fields in r's window into m; on failure r.err is set.
// Fields it does not know, or with another wire type, are kept as
// unknown fields.
fn Item_decode_from(r: pb_Reader&, m: Item&) {
    var unknown_len: i64 = m.pb_unknown.len;
    let unknown_had: i64 = unknown_len;
    let pb_had3: i64 = m.tags.len;
    var pb_len3: i64 = pb_had3;
    while r.pos < r.end {
        let start = r.pos;
        let tag = pb_read_tag(r);
        if r.err != PB_OK { break; }
        if tag == 8 {
            m.id = pb_u64_to_int32(pb_read_varint(r));
        } else if tag == 18 {
            m.label = pb_read_string(r, m.label);
        } else if tag == 26 {
            pb_charge(r, 8);
            pb_append(pb_spans, m.tags, pb_len3, pb_had3, pb_read_string(r, pb_Span { at: 0, len: 0 }));
        } else {
            pb_unknown_append(r, start, tag, m.pb_unknown, unknown_len, unknown_had);
        }
    }
    m.tags = pb_trim(pb_spans, m.tags, pb_len3);
    m.pb_unknown = pb_bytes_trim(m.pb_unknown, unknown_len);
}

// Merges buf into m. 0 on success, else a PB_ERR_* code; m then holds a
// partial message, which the caller clears.
fn Item_decode(buf: const u8[:], m: Item&) -> i32 {
    var r = pb_reader(buf);
    Item_decode_from(r, m);
    return r.err;
}

// Appends m's wire encoding, Item_size_of(m) bytes, to out.
fn Item_encode(m: Item&, out: u8[>..]&) {
    if m.id != 0 {
        pb_write_varint(out, 8);
        pb_write_varint(out, pb_int32_to_u64(m.id));
    }
    if m.label.len > 0 {
        pb_write_varint(out, 18);
        pb_write_bytes(out, m.label);
    }
    for pb_v in pb_run(pb_spans, m.tags) {
        pb_write_varint(out, 26);
        pb_write_bytes(out, pb_v);
    }
    out.append(pb_run(pb_bytes, m.pb_unknown));
}

// The size of m's wire encoding, in bytes.
fn Item_size_of(m: Item&) -> i64 {
    var n: i64 = 0;
    if m.id != 0 { n += 1 + pb_varint_size(pb_int32_to_u64(m.id)); }
    if m.label.len > 0 { n += 1 + pb_bytes_size(m.label); }
    for pb_v in pb_run(pb_spans, m.tags) { n += 1 + pb_bytes_size(pb_v); }
    n += m.pb_unknown.len;
    return n;
}

// Frees what m owns and resets it to the empty message.
fn Item_clear(m: Item&) {
    m.id = 0;
    m.label = pb_bytes_free(m.label);
    m.tags = pb_spans_free(m.tags);
    m.pb_unknown = pb_bytes_free(m.pb_unknown);
}

// Makes dst a deep copy of src, freeing what dst owned. The two share
// nothing afterwards. Neither may be a sub-message of the other.
fn Item_copy(dst: Item&, src: Item&) {
    if dst .== src { return; }
    Item_clear(dst);
    dst.id = src.id;
    dst.label = pb_bytes_copy(src.label);
    dst.tags = pb_spans_copy(src.tags);
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
}

// The contents of label, in pb_bytes: valid until it is next set or m
// is cleared.
fn Item_label(m: Item&) -> u8[:] { return pb_run(pb_bytes, m.label); }

// Sets label to a copy of v.
fn Item_set_label(m: Item&, v: const u8[:]) {
    m.label = pb_bytes_set(m.label, v);
}

// The number of values of tags.
fn Item_tags_len(m: Item&) -> i64 { return m.tags.len; }

// The contents of value i of tags, in pb_bytes: valid until it is next
// set or m is cleared.
fn Item_tags_at(m: Item&, i: i64) -> u8[:] { return pb_run(pb_bytes, pb_run(pb_spans, m.tags)[i]); }

// Adds a copy of v to tags.
fn Item_add_tags(m: Item&, v: const u8[:]) { m.tags = pb_spans_add(m.tags, v); }

// Sets value i of tags to a copy of v.
fn Item_set_tags(m: Item&, i: i64, v: const u8[:]) { pb_spans_set(m.tags, i, v); }

fn Item_clear_tags(m: Item&) { m.tags = pb_spans_free(m.tags); }

// message lists.Tree
struct Tree {
    name: pb_Span,
    children: pb_Span,
    pb_unknown: pb_Span,   // unknown fields: raw wire bytes in pb_bytes
}

// A link to a Tree in Tree_pool, for sub-message fields.
struct Tree_Ref { m: Tree&<u32 in Tree_pool>? }
reusable var Tree_pool: Tree[>..] = [];
reusable[] var Tree_links: Tree_Ref[>..] = [];

// Merges the fields in r's window into m; on failure r.err is set.
// Fields it does not know, or with another wire type, are kept as
// unknown fields.
recursive fn Tree_decode_from(r: pb_Reader&, m: Tree&) {
    var unknown_len: i64 = m.pb_unknown.len;
    let unknown_had: i64 = unknown_len;
    let pb_had2: i64 = m.children.len;
    var pb_len2: i64 = pb_had2;
    while r.pos < r.end {
        let start = r.pos;
        let tag = pb_read_tag(r);
        if r.err != PB_OK { break; }
        if tag == 10 {
            m.name = pb_read_string(r, m.name);
        } else if tag == 18 {
            pb_charge(r, 48);
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            if r.depth >= PB_MAX_DEPTH { pb_fail(r, PB_ERR_DEPTH); break; }
            pb_reserve(Tree_links, m.children, pb_len2, pb_had2);
            let pb_sub .= Tree_pool.alloc_ref(Tree { .. });
            pb_run(Tree_links, m.children)[pb_len2].m .= pb_sub;
            pb_len2++;
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            r.depth++;
            Tree_decode_from(r, pb_sub);
            if r.err != PB_OK { break; }
            r.depth--;
            r.end = pb_outer;
        } else {
            pb_unknown_append(r, start, tag, m.pb_unknown, unknown_len, unknown_had);
        }
    }
    m.children = pb_trim(Tree_links, m.children, pb_len2);
    m.pb_unknown = pb_bytes_trim(m.pb_unknown, unknown_len);
}

// Merges buf into m. 0 on success, else a PB_ERR_* code; m then holds a
// partial message, which the caller clears.
fn Tree_decode(buf: const u8[:], m: Tree&) -> i32 {
    var r = pb_reader(buf);
    Tree_decode_from(r, m);
    return r.err;
}

// Appends m's wire encoding, Tree_size_of(m) bytes, to out.
recursive fn Tree_encode(m: Tree&, out: u8[>..]&) {
    if m.name.len > 0 {
        pb_write_varint(out, 10);
        pb_write_bytes(out, m.name);
    }
    for pb_ref in pb_run(Tree_links, m.children) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        pb_write_varint(out, 18);
        pb_write_varint(out, Tree_size_of(pb_l) as! u64);
        Tree_encode(pb_l, out);
    }
    out.append(pb_run(pb_bytes, m.pb_unknown));
}

// The size of m's wire encoding, in bytes.
recursive fn Tree_size_of(m: Tree&) -> i64 {
    var n: i64 = 0;
    if m.name.len > 0 { n += 1 + pb_bytes_size(m.name); }
    for pb_ref in pb_run(Tree_links, m.children) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        n += 1 + pb_len_size(Tree_size_of(pb_l));
    }
    n += m.pb_unknown.len;
    return n;
}

// Frees what m owns and resets it to the empty message.
recursive fn Tree_clear(m: Tree&) {
    m.name = pb_bytes_free(m.name);
    Tree_clear_children(m);
    m.pb_unknown = pb_bytes_free(m.pb_unknown);
}

// Makes dst a deep copy of src, freeing what dst owned. The two share
// nothing afterwards. Neither may be a sub-message of the other.
recursive fn Tree_copy(dst: Tree&, src: Tree&) {
    if dst .== src { return; }
    Tree_clear(dst);
    dst.name = pb_bytes_copy(src.name);
    dst.children = pb_resize(Tree_links, dst.children, src.children.len);
    for pb_i in src.children.len {
        let pb_l = pb_run(Tree_links, src.children)[pb_i].m;
        guard pb_l else { continue; }
        let pb_c .= Tree_pool.alloc_ref(Tree { .. });
        pb_run(Tree_links, dst.children)[pb_i].m .= pb_c;
        Tree_copy(pb_c, pb_l);
    }
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
}

// The contents of name, in pb_bytes: valid until it is next set or m
// is cleared.
fn Tree_name(m: Tree&) -> u8[:] { return pb_run(pb_bytes, m.name); }

// Sets name to a copy of v.
fn Tree_set_name(m: Tree&, v: const u8[:]) {
    m.name = pb_bytes_set(m.name, v);
}

// The number of messages of children.
fn Tree_children_len(m: Tree&) -> i64 { return m.children.len; }

// Message i of children. Valid until it or m is cleared.
fn Tree_children_at(m: Tree&, i: i64) -> Tree& {
    let pb_l = pb_run(Tree_links, m.children)[i].m;
    assert(pb_l);
    return pb_l;
}

// Adds an empty message to children and returns it.
fn Tree_add_children(m: Tree&) -> Tree& {
    let pb_i: i64 = m.children.len;
    m.children = pb_resize(Tree_links, m.children, pb_i + 1);
    let pb_new .= Tree_pool.alloc_ref(Tree { .. });
    pb_run(Tree_links, m.children)[pb_i].m .= pb_new;
    return pb_new;
}

// Frees the messages of children and everything they own.
recursive fn Tree_clear_children(m: Tree&) {
    for pb_ref in pb_run(Tree_links, m.children) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        Tree_clear(pb_l);
        Tree_pool.free(Tree_pool.index_of(pb_l));
    }
    m.children = pb_resize(Tree_links, m.children, 0);
}

// message lists.Forest
struct Forest {
    groves: pb_Span,
    pb_unknown: pb_Span,   // unknown fields: raw wire bytes in pb_bytes
}

// A link to a Forest in Forest_pool, for sub-message fields.
struct Forest_Ref { m: Forest&<u32 in Forest_pool>? }
reusable var Forest_pool: Forest[>..] = [];
reusable[] var Forest_links: Forest_Ref[>..] = [];

// Merges the fields in r's window into m; on failure r.err is set.
// Fields it does not know, or with another wire type, are kept as
// unknown fields.
recursive fn Forest_decode_from(r: pb_Reader&, m: Forest&) {
    var unknown_len: i64 = m.pb_unknown.len;
    let unknown_had: i64 = unknown_len;
    let pb_had1: i64 = m.groves.len;
    var pb_len1: i64 = pb_had1;
    while r.pos < r.end {
        let start = r.pos;
        let tag = pb_read_tag(r);
        if r.err != PB_OK { break; }
        if tag == 10 {
            pb_charge(r, 40);
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            if r.depth >= PB_MAX_DEPTH { pb_fail(r, PB_ERR_DEPTH); break; }
            pb_reserve(Grove_links, m.groves, pb_len1, pb_had1);
            let pb_sub .= Grove_pool.alloc_ref(Grove { .. });
            pb_run(Grove_links, m.groves)[pb_len1].m .= pb_sub;
            pb_len1++;
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            r.depth++;
            Grove_decode_from(r, pb_sub);
            if r.err != PB_OK { break; }
            r.depth--;
            r.end = pb_outer;
        } else {
            pb_unknown_append(r, start, tag, m.pb_unknown, unknown_len, unknown_had);
        }
    }
    m.groves = pb_trim(Grove_links, m.groves, pb_len1);
    m.pb_unknown = pb_bytes_trim(m.pb_unknown, unknown_len);
}

// Merges buf into m. 0 on success, else a PB_ERR_* code; m then holds a
// partial message, which the caller clears.
fn Forest_decode(buf: const u8[:], m: Forest&) -> i32 {
    var r = pb_reader(buf);
    Forest_decode_from(r, m);
    return r.err;
}

// Appends m's wire encoding, Forest_size_of(m) bytes, to out.
recursive fn Forest_encode(m: Forest&, out: u8[>..]&) {
    for pb_ref in pb_run(Grove_links, m.groves) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        pb_write_varint(out, 10);
        pb_write_varint(out, Grove_size_of(pb_l) as! u64);
        Grove_encode(pb_l, out);
    }
    out.append(pb_run(pb_bytes, m.pb_unknown));
}

// The size of m's wire encoding, in bytes.
recursive fn Forest_size_of(m: Forest&) -> i64 {
    var n: i64 = 0;
    for pb_ref in pb_run(Grove_links, m.groves) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        n += 1 + pb_len_size(Grove_size_of(pb_l));
    }
    n += m.pb_unknown.len;
    return n;
}

// Frees what m owns and resets it to the empty message.
recursive fn Forest_clear(m: Forest&) {
    Forest_clear_groves(m);
    m.pb_unknown = pb_bytes_free(m.pb_unknown);
}

// Makes dst a deep copy of src, freeing what dst owned. The two share
// nothing afterwards. Neither may be a sub-message of the other.
recursive fn Forest_copy(dst: Forest&, src: Forest&) {
    if dst .== src { return; }
    Forest_clear(dst);
    dst.groves = pb_resize(Grove_links, dst.groves, src.groves.len);
    for pb_i in src.groves.len {
        let pb_l = pb_run(Grove_links, src.groves)[pb_i].m;
        guard pb_l else { continue; }
        let pb_c .= Grove_pool.alloc_ref(Grove { .. });
        pb_run(Grove_links, dst.groves)[pb_i].m .= pb_c;
        Grove_copy(pb_c, pb_l);
    }
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
}

// The number of messages of groves.
fn Forest_groves_len(m: Forest&) -> i64 { return m.groves.len; }

// Message i of groves. Valid until it or m is cleared.
fn Forest_groves_at(m: Forest&, i: i64) -> Grove& {
    let pb_l = pb_run(Grove_links, m.groves)[i].m;
    assert(pb_l);
    return pb_l;
}

// Adds an empty message to groves and returns it.
fn Forest_add_groves(m: Forest&) -> Grove& {
    let pb_i: i64 = m.groves.len;
    m.groves = pb_resize(Grove_links, m.groves, pb_i + 1);
    let pb_new .= Grove_pool.alloc_ref(Grove { .. });
    pb_run(Grove_links, m.groves)[pb_i].m .= pb_new;
    return pb_new;
}

// Frees the messages of groves and everything they own.
recursive fn Forest_clear_groves(m: Forest&) {
    for pb_ref in pb_run(Grove_links, m.groves) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        Grove_clear(pb_l);
        Grove_pool.free(Grove_pool.index_of(pb_l));
    }
    m.groves = pb_resize(Grove_links, m.groves, 0);
}

// message lists.Grove
struct Grove {
    forest: Forest_Ref,
    pb_unknown: pb_Span,   // unknown fields: raw wire bytes in pb_bytes
}

// A link to a Grove in Grove_pool, for sub-message fields.
struct Grove_Ref { m: Grove&<u32 in Grove_pool>? }
reusable var Grove_pool: Grove[>..] = [];
reusable[] var Grove_links: Grove_Ref[>..] = [];

// Merges the fields in r's window into m; on failure r.err is set.
// Fields it does not know, or with another wire type, are kept as
// unknown fields.
recursive fn Grove_decode_from(r: pb_Reader&, m: Grove&) {
    var unknown_len: i64 = m.pb_unknown.len;
    let unknown_had: i64 = unknown_len;
    while r.pos < r.end {
        let start = r.pos;
        let tag = pb_read_tag(r);
        if r.err != PB_OK { break; }
        if tag == 10 {
            pb_charge(r, 40);
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            if r.depth >= PB_MAX_DEPTH { pb_fail(r, PB_ERR_DEPTH); break; }
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            r.depth++;
            Forest_decode_from(r, Grove_mutable_forest(m));
            if r.err != PB_OK { break; }
            r.depth--;
            r.end = pb_outer;
        } else {
            pb_unknown_append(r, start, tag, m.pb_unknown, unknown_len, unknown_had);
        }
    }
    m.pb_unknown = pb_bytes_trim(m.pb_unknown, unknown_len);
}

// Merges buf into m. 0 on success, else a PB_ERR_* code; m then holds a
// partial message, which the caller clears.
fn Grove_decode(buf: const u8[:], m: Grove&) -> i32 {
    var r = pb_reader(buf);
    Grove_decode_from(r, m);
    return r.err;
}

// Appends m's wire encoding, Grove_size_of(m) bytes, to out.
recursive fn Grove_encode(m: Grove&, out: u8[>..]&) {
    let pb_f1 = m.forest.m;
    if pb_f1 {
        pb_write_varint(out, 10);
        pb_write_varint(out, Forest_size_of(pb_f1) as! u64);
        Forest_encode(pb_f1, out);
    }
    out.append(pb_run(pb_bytes, m.pb_unknown));
}

// The size of m's wire encoding, in bytes.
recursive fn Grove_size_of(m: Grove&) -> i64 {
    var n: i64 = 0;
    let pb_f1 = m.forest.m;
    if pb_f1 { n += 1 + pb_len_size(Forest_size_of(pb_f1)); }
    n += m.pb_unknown.len;
    return n;
}

// Frees what m owns and resets it to the empty message.
recursive fn Grove_clear(m: Grove&) {
    Grove_clear_forest(m);
    m.pb_unknown = pb_bytes_free(m.pb_unknown);
}

// Makes dst a deep copy of src, freeing what dst owned. The two share
// nothing afterwards. Neither may be a sub-message of the other.
recursive fn Grove_copy(dst: Grove&, src: Grove&) {
    if dst .== src { return; }
    Grove_clear(dst);
    let pb_f1 = src.forest.m;
    if pb_f1 { Forest_copy(Grove_mutable_forest(dst), pb_f1); }
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
}

// The sub-message forest, or null if it is not set. Valid until it or m is
// cleared.
fn Grove_forest(m: Grove&) -> Forest&? { return m.forest.m; }

// The sub-message forest, set to an empty one first if it is not set.
fn Grove_mutable_forest(m: Grove&) -> Forest& {
    let pb_sub = m.forest.m;
    if pb_sub { return pb_sub; }
    let pb_new .= Forest_pool.alloc_ref(Forest { .. });
    m.forest.m .= pb_new;
    return pb_new;
}

fn Grove_has_forest(m: Grove&) -> bool { return m.forest.m != null; }

// Frees the sub-message forest and everything it owns.
recursive fn Grove_clear_forest(m: Grove&) {
    let pb_sub = m.forest.m;
    guard pb_sub else { return; }
    Forest_clear(pb_sub);
    Forest_pool.free(Forest_pool.index_of(pb_sub));
    m.forest.m .= null;
}
