    m.o_fixed64 = v;
    m.pb_has0 |= 0x00000080;
}

fn Pres_has_o_fixed64(m: Pres&) -> bool { return (m.pb_has0 & 0x00000080) != 0; }

fn Pres_clear_o_fixed64(m: Pres&) {
    m.o_fixed64 = 0;
    m.pb_has0 &= 0xffffff7f;
}

// Sets o_sfixed32 and marks it present:
// it is encoded even when 0.
fn Pres_set_o_sfixed32(m: Pres&, v: i32) {
    m.o_sfixed32 = v;
    m.pb_has0 |= 0x00000100;
}

fn Pres_has_o_sfixed32(m: Pres&) -> bool { return (m.pb_has0 & 0x00000100) != 0; }

fn Pres_clear_o_sfixed32(m: Pres&) {
    m.o_sfixed32 = 0;
    m.pb_has0 &= 0xfffffeff;
}

// Sets o_sfixed64 and marks it present:
// it is encoded even when 0.
fn Pres_set_o_sfixed64(m: Pres&, v: i64) {
    m.o_sfixed64 = v;
    m.pb_has0 |= 0x00000200;
}

fn Pres_has_o_sfixed64(m: Pres&) -> bool { return (m.pb_has0 & 0x00000200) != 0; }

fn Pres_clear_o_sfixed64(m: Pres&) {
    m.o_sfixed64 = 0;
    m.pb_has0 &= 0xfffffdff;
}

// Sets o_float and marks it present:
// it is encoded even when 0.
fn Pres_set_o_float(m: Pres&, v: f32) {
    m.o_float = v;
    m.pb_has0 |= 0x00000400;
}

fn Pres_has_o_float(m: Pres&) -> bool { return (m.pb_has0 & 0x00000400) != 0; }

fn Pres_clear_o_float(m: Pres&) {
    m.o_float = 0.0;
    m.pb_has0 &= 0xfffffbff;
}

// Sets o_double and marks it present:
// it is encoded even when 0.
fn Pres_set_o_double(m: Pres&, v: f64) {
    m.o_double = v;
    m.pb_has0 |= 0x00000800;
}

fn Pres_has_o_double(m: Pres&) -> bool { return (m.pb_has0 & 0x00000800) != 0; }

fn Pres_clear_o_double(m: Pres&) {
    m.o_double = 0.0;
    m.pb_has0 &= 0xfffff7ff;
}

// Sets o_bool and marks it present:
// it is encoded even when 0.
fn Pres_set_o_bool(m: Pres&, v: bool) {
    m.o_bool = v;
    m.pb_has0 |= 0x00001000;
}

fn Pres_has_o_bool(m: Pres&) -> bool { return (m.pb_has0 & 0x00001000) != 0; }

fn Pres_clear_o_bool(m: Pres&) {
    m.o_bool = false;
    m.pb_has0 &= 0xffffefff;
}

// The contents of o_string, in pb_bytes: valid until it is next set or m
// is cleared.
fn Pres_o_string(m: Pres&) -> u8[:] { return pb_run(pb_bytes, m.o_string); }

// Sets o_string to a copy of v and marks it present:
// it is encoded even when empty.
fn Pres_set_o_string(m: Pres&, v: const u8[:]) {
    m.o_string = pb_bytes_set(m.o_string, v);
    m.pb_has0 |= 0x00002000;
}

fn Pres_has_o_string(m: Pres&) -> bool { return (m.pb_has0 & 0x00002000) != 0; }

fn Pres_clear_o_string(m: Pres&) {
    m.o_string = pb_bytes_free(m.o_string);
    m.pb_has0 &= 0xffffdfff;
}

// The contents of o_bytes, in pb_bytes: valid until it is next set or m
// is cleared.
fn Pres_o_bytes(m: Pres&) -> u8[:] { return pb_run(pb_bytes, m.o_bytes); }

// Sets o_bytes to a copy of v and marks it present:
// it is encoded even when empty.
fn Pres_set_o_bytes(m: Pres&, v: const u8[:]) {
    m.o_bytes = pb_bytes_set(m.o_bytes, v);
    m.pb_has0 |= 0x00004000;
}

fn Pres_has_o_bytes(m: Pres&) -> bool { return (m.pb_has0 & 0x00004000) != 0; }

fn Pres_clear_o_bytes(m: Pres&) {
    m.o_bytes = pb_bytes_free(m.o_bytes);
    m.pb_has0 &= 0xffffbfff;
}

// The sub-message o_sub, or null if it is not set. Valid until it or m is
// cleared.
fn Pres_o_sub(m: Pres&) -> Sub&? { return m.o_sub.m; }

// The sub-message o_sub, set to an empty one first if it is not set.
fn Pres_mutable_o_sub(m: Pres&) -> Sub& {
    let pb_sub = m.o_sub.m;
    if pb_sub { return pb_sub; }
    let pb_new .= Sub_pool.alloc_ref(Sub { .. });
    m.o_sub.m .= pb_new;
    return pb_new;
}

fn Pres_has_o_sub(m: Pres&) -> bool { return m.o_sub.m != null; }

// Frees the sub-message o_sub and everything it owns.
fn Pres_clear_o_sub(m: Pres&) {
    let pb_sub = m.o_sub.m;
    guard pb_sub else { return; }
    Sub_clear(pb_sub);
    Sub_pool.free(Sub_pool.index_of(pb_sub));
    m.o_sub.m .= null;
}

// message p2.Req
struct Req {
    r_int32: i32,
    r_string: pb_Span,
    pb_has0: u32,   // has-bits of fields with presence
    pb_unknown: pb_Span,   // unknown fields: raw wire bytes in pb_bytes
}

// A link to a Req in Req_pool, for sub-message fields.
struct Req_Ref { m: Req&<u32 in Req_pool>? }
reusable var Req_pool: Req[>..] = [];
reusable[] var Req_links: Req_Ref[>..] = [];

// Merges the fields in r's window into m; on failure r.err is set.
// Fields it does not know, or with another wire type, are kept as
// unknown fields.
fn Req_decode_from(r: pb_Reader&, m: Req&) {
    var unknown_len: i64 = m.pb_unknown.len;
    let unknown_had: i64 = unknown_len;
    while r.pos < r.end {
        let start = r.pos;
        let tag = pb_read_tag(r);
        if r.err != PB_OK { break; }
        if tag == 8 {
            m.r_int32 = pb_u64_to_int32(pb_read_varint(r));
            m.pb_has0 |= 0x00000001;
        } else if tag == 18 {
            m.r_string = pb_read_bytes(r, m.r_string);
            m.pb_has0 |= 0x00000002;
        } else {
            pb_unknown_append(r, start, tag, m.pb_unknown, unknown_len, unknown_had);
        }
    }
    m.pb_unknown = pb_bytes_trim(m.pb_unknown, unknown_len);
}

// Merges buf into m. 0 on success, else a PB_ERR_* code; m then holds a
// partial message, which the caller clears.
fn Req_decode(buf: const u8[:], m: Req&) -> i32 {
    var r = pb_reader(buf);
    Req_decode_from(r, m);
    if r.err == PB_OK && !Req_is_initialized(m) { return PB_ERR_REQUIRED; }
    return r.err;
}

// Appends m's wire encoding, Req_size_of(m) bytes, to out.
fn Req_encode(m: Req&, out: u8[>..]&) {
    if (m.pb_has0 & 0x00000001) != 0 {
        pb_write_varint(out, 8);
        pb_write_varint(out, pb_int32_to_u64(m.r_int32));
    }
    if (m.pb_has0 & 0x00000002) != 0 {
        pb_write_varint(out, 18);
        pb_write_bytes(out, m.r_string);
    }
    out.append(pb_run(pb_bytes, m.pb_unknown));
}

// The size of m's wire encoding, in bytes.
fn Req_size_of(m: Req&) -> i64 {
    var n: i64 = 0;
    if (m.pb_has0 & 0x00000001) != 0 { n += 1 + pb_varint_size(pb_int32_to_u64(m.r_int32)); }
    if (m.pb_has0 & 0x00000002) != 0 { n += 1 + pb_bytes_size(m.r_string); }
    n += m.pb_unknown.len;
    return n;
}

// Frees what m owns and resets it to the empty message.
fn Req_clear(m: Req&) {
    m.r_int32 = 0;
    m.r_string = pb_bytes_free(m.r_string);
    m.pb_has0 = 0;
    m.pb_unknown = pb_bytes_free(m.pb_unknown);
}

// Makes dst a deep copy of src, freeing what dst owned. The two share
// nothing afterwards. Neither may be a sub-message of the other.
fn Req_copy(dst: Req&, src: Req&) {
    if dst .== src { return; }
    Req_clear(dst);
    dst.r_int32 = src.r_int32;
    dst.r_string = pb_bytes_copy(src.r_string);
    dst.pb_has0 = src.pb_has0;
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
}

// True if every required field is set, in m and in the messages it holds.
fn Req_is_initialized(m: Req&) -> bool {
    if (m.pb_has0 & 0x00000003) != 0x00000003 { return false; }
    return true;
}

// Sets r_int32 and marks it present:
// it is encoded even when 0.
fn Req_set_r_int32(m: Req&, v: i32) {
    m.r_int32 = v;
    m.pb_has0 |= 0x00000001;
}

fn Req_has_r_int32(m: Req&) -> bool { return (m.pb_has0 & 0x00000001) != 0; }

fn Req_clear_r_int32(m: Req&) {
    m.r_int32 = 0;
    m.pb_has0 &= 0xfffffffe;
}

// The contents of r_string, in pb_bytes: valid until it is next set or m
// is cleared.
fn Req_r_string(m: Req&) -> u8[:] { return pb_run(pb_bytes, m.r_string); }

// Sets r_string to a copy of v and marks it present:
// it is encoded even when empty.
fn Req_set_r_string(m: Req&, v: const u8[:]) {
    m.r_string = pb_bytes_set(m.r_string, v);
    m.pb_has0 |= 0x00000002;
}

fn Req_has_r_string(m: Req&) -> bool { return (m.pb_has0 & 0x00000002) != 0; }

fn Req_clear_r_string(m: Req&) {
    m.r_string = pb_bytes_free(m.r_string);
    m.pb_has0 &= 0xfffffffd;
}

// message p2.Later
enum Later_pick {
    pb_none,
    member { v: i32 },
}

struct Later {
    stored: i32,
    mode: i32,
    list: pb_Span,
    counts: pb_Span,
    grp: Later_Grp_Ref,
    pick: Later_pick = Later_pick.pb_none,
    pb_has0: u32,   // has-bits of fields with presence
    pb_unknown: pb_Span,   // unknown fields: raw wire bytes in pb_bytes
}

// A link to a Later in Later_pool, for sub-message fields.
struct Later_Ref { m: Later&<u32 in Later_pool>? }
reusable var Later_pool: Later[>..] = [];
reusable[] var Later_links: Later_Ref[>..] = [];

// Merges the fields in r's window into m; on failure r.err is set.
// Fields it does not know, or with another wire type, are kept as
// unknown fields.
fn Later_decode_from(r: pb_Reader&, m: Later&) {
    var unknown_len: i64 = m.pb_unknown.len;
    let unknown_had: i64 = unknown_len;
    let pb_had3: i64 = m.list.len;
    var pb_len3: i64 = pb_had3;
    let pb_had5: i64 = m.counts.len;
    var pb_len5: i64 = pb_had5;
    while r.pos < r.end {
        let start = r.pos;
        let tag = pb_read_tag(r);
        if r.err != PB_OK { break; }
        if tag == 8 {
            m.stored = pb_u64_to_int32(pb_read_varint(r));
            m.pb_has0 |= 0x00000001;
        } else if tag == 16 {
            let pb_v = pb_u64_to_int32(pb_read_varint(r));
            if r.err != PB_OK { break; }
            if (pb_v >= 0 && pb_v <= 1) {
                m.mode = pb_v;
                m.pb_has0 |= 0x00000002;
            } else {
                pb_unknown_keep(r, start, m.pb_unknown, unknown_len, unknown_had);
            }
        } else if tag == 24 {
            pb_charge(r, 4);
            pb_append(pb_i32s, m.list, pb_len3, pb_had3, pb_u64_to_int32(pb_read_varint(r)));
        } else if tag == 26 {
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            while r.pos < r.end {
                pb_charge(r, 4);
                pb_append(pb_i32s, m.list, pb_len3, pb_had3, pb_u64_to_int32(pb_read_varint(r)));
            }
            if r.err != PB_OK { break; }
            r.end = pb_outer;
        } else if tag == 32 {
            let pb_v = pb_u64_to_int32(pb_read_varint(r));
            if r.err != PB_OK { break; }
            Later_clear_pick(m);
            m.pick = Later_pick.member { v: pb_v };
        } else if tag == 42 {
            pb_charge(r, 48);
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            if r.depth >= PB_MAX_DEPTH { pb_fail(r, PB_ERR_DEPTH); break; }
            pb_reserve(Later_CountsEntry_entries, m.counts, pb_len5, pb_had5);
            let pb_e .= pb_run(Later_CountsEntry_entries, m.counts)[pb_len5];
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            r.depth++;
            Later_CountsEntry_decode_from(r, pb_e);
            if r.err != PB_OK { Later_CountsEntry_clear(pb_e); break; }
            r.depth--;
            r.end = pb_outer;
            Later_CountsEntry_place(pb_e);
            pb_len5++;
        } else if tag == 51 {
            pb_charge(r, 40);
            let pb_body = r.pos;
            let pb_stop = pb_skip_group(r, tag);
            if r.err != PB_OK { break; }
            let pb_after = r.pos;
            let pb_outer = r.end;
            r.pos = pb_body;
            r.end = pb_stop;
            r.depth++;
            Later_Grp_decode_from(r, Later_mutable_grp(m));
            if r.err != PB_OK { break; }
            r.depth--;
            r.end = pb_outer;
            r.pos = pb_after;
        } else {
            pb_unknown_append(r, start, tag, m.pb_unknown, unknown_len, unknown_had);
        }
    }
    m.list = pb_trim(pb_i32s, m.list, pb_len3);
    m.counts = pb_trim(Later_CountsEntry_entries, m.counts, pb_len5);
    m.pb_unknown = pb_bytes_trim(m.pb_unknown, unknown_len);
}

// Merges buf into m. 0 on success, else a PB_ERR_* code; m then holds a
// partial message, which the caller clears.
fn Later_decode(buf: const u8[:], m: Later&) -> i32 {
    var r = pb_reader(buf);
    Later_decode_from(r, m);
    if r.err == PB_OK { Later_fold_maps(m); }
    return r.err;
}

// Appends m's wire encoding, Later_size_of(m) bytes, to out.
fn Later_encode(m: Later&, out: u8[>..]&) {
    if (m.pb_has0 & 0x00000001) != 0 {
        pb_write_varint(out, 8);
        pb_write_varint(out, pb_int32_to_u64(m.stored));
    }
    if (m.pb_has0 & 0x00000002) != 0 {
        pb_write_varint(out, 16);
        pb_write_varint(out, pb_int32_to_u64(m.mode));
    }
    if m.list.len > 0 {
        for pb_v in pb_run(pb_i32s, m.list) {
            pb_write_varint(out, 24);
            pb_write_varint(out, pb_int32_to_u64(pb_v));
        }
    }
    match m.pick {
        member pb_p => {
            pb_write_varint(out, 32);
            pb_write_varint(out, pb_int32_to_u64(pb_p.v));
        },
        _ => {},
    }
    for pb_i in m.counts.len {
        let pb_e .= pb_run(Later_CountsEntry_entries, m.counts)[pb_i];
        pb_write_varint(out, 42);
        pb_write_varint(out, Later_CountsEntry_size_of(pb_e) as! u64);
        Later_CountsEntry_encode(pb_e, out);
    }
    let pb_f6 = m.grp.m;
    if pb_f6 {
        pb_write_varint(out, 51);
        Later_Grp_encode(pb_f6, out);
        pb_write_varint(out, 52);
    }
    out.append(pb_run(pb_bytes, m.pb_unknown));
}

// The size of m's wire encoding, in bytes.
fn Later_size_of(m: Later&) -> i64 {
    var n: i64 = 0;
    if (m.pb_has0 & 0x00000001) != 0 { n += 1 + pb_varint_size(pb_int32_to_u64(m.stored)); }
    if (m.pb_has0 & 0x00000002) != 0 { n += 1 + pb_varint_size(pb_int32_to_u64(m.mode)); }
    if m.list.len > 0 {
        var pb_n: i64 = 0;
        for pb_v in pb_run(pb_i32s, m.list) { pb_n += pb_varint_size(pb_int32_to_u64(pb_v)); }
        n += 1 * m.list.len + pb_n;
    }
    match m.pick {
        member pb_p => { n += 1 + pb_varint_size(pb_int32_to_u64(pb_p.v)); },
        _ => {},
    }
    for pb_i in m.counts.len {
        n += 1 + pb_len_size(Later_CountsEntry_size_of(pb_run(Later_CountsEntry_entries, m.counts)[pb_i]));
    }
    let pb_f6 = m.grp.m;
    if pb_f6 { n += 2 + Later_Grp_size_of(pb_f6); }
    n += m.pb_unknown.len;
    return n;
}

// Frees what m owns and resets it to the empty message.
fn Later_clear(m: Later&) {
    m.stored = 0;
    m.mode = 0;
    m.list = pb_resize(pb_i32s, m.list, 0);
    Later_clear_counts(m);
    Later_clear_grp(m);
    Later_clear_pick(m);
    m.pb_has0 = 0;
    m.pb_unknown = pb_bytes_free(m.pb_unknown);
}

// Makes dst a deep copy of src, freeing what dst owned. The two share
// nothing afterwards. Neither may be a sub-message of the other.
fn Later_copy(dst: Later&, src: Later&) {
    if dst .== src { return; }
    Later_clear(dst);
    dst.stored = src.stored;
    dst.mode = src.mode;
    dst.list = pb_copy_run(pb_i32s, src.list);
    dst.counts = pb_resize(Later_CountsEntry_entries, dst.counts, src.counts.len);
    for pb_i in src.counts.len {
        Later_CountsEntry_copy(pb_run(Later_CountsEntry_entries, dst.counts)[pb_i], pb_run(Later_CountsEntry_entries, src.counts)[pb_i]);
    }
    let pb_f6 = src.grp.m;
    if pb_f6 { Later_Grp_copy(Later_mutable_grp(dst), pb_f6); }
    match src.pick {
        member pb_p => { dst.pick = Later_pick.member { v: pb_p.v }; },
        _ => {},
    }
    dst.pb_has0 = src.pb_has0;
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
}

// Folds repeated keys in the maps of m and of the messages it holds, which
// decoding appends without looking them up: the last value wins, in the
// place of the first occurrence.
fn Later_fold_maps(m: Later&) {
    m.counts = Later_CountsEntry_fold(m.counts);
}

// Frees what oneof pick holds, and sets no member.
fn Later_clear_pick(m: Later&) {
    match m.pick {
        _ => {},
    }
    m.pick = Later_pick.pb_none;
}

// Sets stored and marks it present:
// it is encoded even when 0.
fn Later_set_stored(m: Later&, v: i32) {
    m.stored = v;
    m.pb_has0 |= 0x00000001;
}

fn Later_has_stored(m: Later&) -> bool { return (m.pb_has0 & 0x00000001) != 0; }

fn Later_clear_stored(m: Later&) {
    m.stored = 0;
    m.pb_has0 &= 0xfffffffe;
}

// Sets mode and marks it present:
// it is encoded even when 0.
fn Later_set_mode(m: Later&, v: i32) {
    m.mode = v;
    m.pb_has0 |= 0x00000002;
}

fn Later_has_mode(m: Later&) -> bool { return (m.pb_has0 & 0x00000002) != 0; }

fn Later_clear_mode(m: Later&) {
    m.mode = 0;
    m.pb_has0 &= 0xfffffffd;
}

// The number of values of list.
fn Later_list_len(m: Later&) -> i64 { return m.list.len; }

// The values of list, in pb_i32s: valid until it is next changed or m is
// cleared.
fn Later_list(m: Later&) -> i32[:] { return pb_run(pb_i32s, m.list); }

fn Later_list_at(m: Later&, i: i64) -> i32 { return pb_run(pb_i32s, m.list)[i]; }

// Adds a value to list. This moves its values, so Later_set_list is better for many.
fn Later_add_list(m: Later&, v: i32) { m.list = pb_add(pb_i32s, m.list, v); }

// Sets list to a copy of v.
fn Later_set_list(m: Later&, v: const i32[:]) { m.list = pb_set_run(pb_i32s, m.list, v); }

fn Later_clear_list(m: Later&) { m.list = pb_resize(pb_i32s, m.list, 0); }

// The value of member, the default if it is not the member set.
fn Later_member(m: Later&) -> i32 {
    match m.pick {
        member pb_p => { return pb_p.v; },
        _ => {},
    }
    return 0;
}

// Makes member the member set, with value v: it is encoded even when 0.
fn Later_set_member(m: Later&, v: i32) {
    Later_clear_pick(m);
    m.pick = Later_pick.member { v: v };
}

fn Later_has_member(m: Later&) -> bool { return match m.pick { member => true, _ => false }; }

// Clears oneof pick if member is the member set.
fn Later_clear_member(m: Later&) { if Later_has_member(m) { Later_clear_pick(m); } }

// The number of entries of counts.
fn Later_counts_len(m: Later&) -> i64 { return m.counts.len; }

// The key of entry i of counts, in insertion order. Valid until the map next
// changes or m is cleared.
fn Later_counts_key_at(m: Later&, i: i64) -> u8[:] { return pb_run(pb_bytes, pb_run(Later_CountsEntry_entries, m.counts)[i].key); }

// The value of entry i of counts.
fn Later_counts_value_at(m: Later&, i: i64) -> i32 { return pb_run(Later_CountsEntry_entries, m.counts)[i].value; }

// The value with key k and true, or the default and false.
fn Later_counts_get(m: Later&, k: const u8[:]) -> i32, bool {
    let pb_i = Later_CountsEntry_find(m.counts, m.counts.len, k);
    if pb_i < 0 { return 0, false; }
    return pb_run(Later_CountsEntry_entries, m.counts)[pb_i].value, true;
}

// Sets the value with key k to v, adding an entry if there is none.
fn Later_counts_put(m: Later&, k: const u8[:], v: i32) {
    Later_CountsEntry_slot(m.counts, k).value = v;
}

// Adds an entry without looking for key k, much faster than Later_counts_put for many.
// Call Later_fold_maps(m) before reading the map: until then, a repeated key is
// there twice. There, the last value wins, in the place of the first occurrence.
fn Later_counts_append(m: Later&, k: const u8[:], v: i32) {
    let pb_i: i64 = m.counts.len;
    m.counts = pb_resize(Later_CountsEntry_entries, m.counts, pb_i + 1);
    let pb_e .= pb_run(Later_CountsEntry_entries, m.counts)[pb_i];
    Later_CountsEntry_set_key(pb_e, k);
    pb_e.value = v;
}

// Removes the entry with key k and frees what it owns. False if there is
// none. Later entries keep their order.
fn Later_counts_remove(m: Later&, k: const u8[:]) -> bool {
    let pb_i = Later_CountsEntry_find(m.counts, m.counts.len, k);
    if pb_i < 0 { return false; }
    let pb_r = pb_run(Later_CountsEntry_entries, m.counts);
    Later_CountsEntry_clear(pb_r[pb_i]);
    var pb_j = pb_i;
    while pb_j + 1 < pb_r.len { pb_r[pb_j] = pb_r[pb_j + 1]; pb_j++; }
    pb_r[pb_j] = Later_CountsEntry { .. };
    m.counts = pb_resize(Later_CountsEntry_entries, m.counts, pb_j);
    return true;
}

// Frees the entries of counts and everything they own.
fn Later_clear_counts(m: Later&) {
    for pb_i in m.counts.len { Later_CountsEntry_clear(pb_run(Later_CountsEntry_entries, m.counts)[pb_i]); }
    m.counts = pb_resize(Later_CountsEntry_entries, m.counts, 0);
}

// The sub-message grp, or null if it is not set. Valid until it or m is
// cleared.
fn Later_grp(m: Later&) -> Later_Grp&? { return m.grp.m; }

// The sub-message grp, set to an empty one first if it is not set.
fn Later_mutable_grp(m: Later&) -> Later_Grp& {
    let pb_sub = m.grp.m;
    if pb_sub { return pb_sub; }
    let pb_new .= Later_Grp_pool.alloc_ref(Later_Grp { .. });
    m.grp.m .= pb_new;
    return pb_new;
}

fn Later_has_grp(m: Later&) -> bool { return m.grp.m != null; }

// Frees the sub-message grp and everything it owns.
fn Later_clear_grp(m: Later&) {
    let pb_sub = m.grp.m;
    guard pb_sub else { return; }
    Later_Grp_clear(pb_sub);
    Later_Grp_pool.free(Later_Grp_pool.index_of(pb_sub));
    m.grp.m .= null;
}

// message p2.Later.CountsEntry
struct Later_CountsEntry {
    key: pb_Span,
    value: i32,
    pb_unknown: pb_Span,   // unknown fields: raw wire bytes in pb_bytes
}

// A link to a Later_CountsEntry in Later_CountsEntry_pool, for sub-message fields.
struct Later_CountsEntry_Ref { m: Later_CountsEntry&<u32 in Later_CountsEntry_pool>? }
reusable var Later_CountsEntry_pool: Later_CountsEntry[>..] = [];
reusable[] var Later_CountsEntry_links: Later_CountsEntry_Ref[>..] = [];

// Merges the fields in r's window into m; on failure r.err is set.
// Fields it does not know, or with another wire type, are kept as
// unknown fields.
fn Later_CountsEntry_decode_from(r: pb_Reader&, m: Later_CountsEntry&) {
    var unknown_len: i64 = m.pb_unknown.len;
    let unknown_had: i64 = unknown_len;
    while r.pos < r.end {
        let start = r.pos;
        let tag = pb_read_tag(r);
        if r.err != PB_OK { break; }
        if tag == 10 {
            m.key = pb_read_bytes(r, m.key);
        } else if tag == 16 {
            m.value = pb_u64_to_int32(pb_read_varint(r));
        } else {
            pb_unknown_append(r, start, tag, m.pb_unknown, unknown_len, unknown_had);
        }
    }
    m.pb_unknown = pb_bytes_trim(m.pb_unknown, unknown_len);
}

// Merges buf into m. 0 on success, else a PB_ERR_* code; m then holds a
// partial message, which the caller clears.
fn Later_CountsEntry_decode(buf: const u8[:], m: Later_CountsEntry&) -> i32 {
    var r = pb_reader(buf);
    Later_CountsEntry_decode_from(r, m);
    return r.err;
}

// Appends m's wire encoding, Later_CountsEntry_size_of(m) bytes, to out.
fn Later_CountsEntry_encode(m: Later_CountsEntry&, out: u8[>..]&) {
    pb_write_varint(out, 10);
    pb_write_bytes(out, m.key);
    pb_write_varint(out, 16);
    pb_write_varint(out, pb_int32_to_u64(m.value));
    out.append(pb_run(pb_bytes, m.pb_unknown));
}

// The size of m's wire encoding, in bytes.
fn Later_CountsEntry_size_of(m: Later_CountsEntry&) -> i64 {
    var n: i64 = 0;
    n += 1 + pb_bytes_size(m.key);
    n += 1 + pb_varint_size(pb_int32_to_u64(m.value));
    n += m.pb_unknown.len;
    return n;
}

// Frees what m owns and resets it to the empty message.
fn Later_CountsEntry_clear(m: Later_CountsEntry&) {
    m.key = pb_bytes_free(m.key);
    m.value = 0;
    m.pb_unknown = pb_bytes_free(m.pb_unknown);
}

// Makes dst a deep copy of src, freeing what dst owned. The two share
// nothing afterwards. Neither may be a sub-message of the other.
fn Later_CountsEntry_copy(dst: Later_CountsEntry&, src: Later_CountsEntry&) {
    if dst .== src { return; }
    Later_CountsEntry_clear(dst);
    dst.key = pb_bytes_copy(src.key);
    dst.value = src.value;
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
}

// The contents of key, in pb_bytes: valid until it is next set or m
// is cleared.
fn Later_CountsEntry_key(m: Later_CountsEntry&) -> u8[:] { return pb_run(pb_bytes, m.key); }

// Sets key to a copy of v.
fn Later_CountsEntry_set_key(m: Later_CountsEntry&, v: const u8[:]) {
    m.key = pb_bytes_set(m.key, v);
}

// Runs of entries: one per map field of this type.
reusable[] var Later_CountsEntry_entries: Later_CountsEntry[>..] = [];

// The index of the entry with key k among the first `used` of run s, or -1.
fn Later_CountsEntry_find(s: pb_Span, used: i64, k: const u8[:]) -> i64 {
    let pb_run_s = pb_run(Later_CountsEntry_entries, s);
    for pb_i in used {
        if pb_run(pb_bytes, pb_run_s[pb_i].key) == k { return pb_i; }
    }
    return -1;
}

// The entry with key k in run s, added with the default value if there is none.
fn Later_CountsEntry_slot(s: pb_Span&, k: const u8[:]) -> Later_CountsEntry& {
    var pb_i = Later_CountsEntry_find(s, s.len, k);
    if pb_i < 0 {
        pb_i = s.len;
        s = pb_resize(Later_CountsEntry_entries, s, pb_i + 1);
        Later_CountsEntry_set_key(pb_run(Later_CountsEntry_entries, s)[pb_i], k);
    }
    return pb_run(Later_CountsEntry_entries, s)[pb_i];
}

// Settles an entry just decoded: a missing message value is an empty one,
// and unknown fields are dropped.
fn Later_CountsEntry_place(pb_e: Later_CountsEntry&) {
    pb_e.pb_unknown = pb_bytes_free(pb_e.pb_unknown);
}

// Run s with each repeated key folded: the last value wins, in the place of
// the first occurrence, and what the others held is freed. O(n log n).
// fold_maps calls it; decoding leaves repeated keys for it.
fn Later_CountsEntry_fold(s: pb_Span) -> pb_Span {
    if s.len < 2 { return s; }
    let pb_r = pb_run(Later_CountsEntry_entries, s);
    var pb_keys: pb_StrKey[>..] = [];
    for pb_i in pb_r.len { pb_keys.push(pb_StrKey { key: pb_r[pb_i].key, at: pb_i as! u32 }); }
    pb_sort_str_keys(pb_keys);
    var pb_gone: bool[>..] = [];
    var pb_i: i64 = 0;
    while pb_i < pb_keys.len {
        var pb_j = pb_i + 1;
        while pb_j < pb_keys.len && pb_same_str_key(pb_keys[pb_i], pb_keys[pb_j]) { pb_j++; }
        if pb_j - pb_i > 1 {
            if pb_gone.len == 0 { for pb_k in pb_r.len { pb_gone.push(false); } }
            let pb_first: i64 = pb_keys[pb_i].at;
            let pb_last: i64 = pb_keys[pb_j - 1].at;
            for pb_k in pb_j - pb_i - 1 {
                let pb_at: i64 = pb_keys[pb_i + pb_k].at;
                Later_CountsEntry_clear(pb_r[pb_at]);
                pb_gone[pb_at] = true;
            }
            pb_gone[pb_first] = false;
            pb_gone[pb_last] = true;
            pb_r[pb_first] = pb_r[pb_last];
            pb_r[pb_last] = Later_CountsEntry { .. };
        }
        pb_i = pb_j;
    }
    if pb_gone.len == 0 { return s; }
    var pb_kept: i64 = 0;
    for pb_k in pb_r.len {
        if pb_gone[pb_k] { continue; }
        if pb_kept != pb_k { pb_r[pb_kept] = pb_r[pb_k]; pb_r[pb_k] = Later_CountsEntry { .. }; }
        pb_kept++;
    }
    return pb_resize(Later_CountsEntry_entries, s, pb_kept);
}

// message p2.Later.Grp
struct Later_Grp {
    g: i32,
    pb_has0: u32,   // has-bits of fields with presence
    pb_unknown: pb_Span,   // unknown fields: raw wire bytes in pb_bytes
}

// A link to a Later_Grp in Later_Grp_pool, for sub-message fields.
struct Later_Grp_Ref { m: Later_Grp&<u32 in Later_Grp_pool>? }
reusable var Later_Grp_pool: Later_Grp[>..] = [];
reusable[] var Later_Grp_links: Later_Grp_Ref[>..] = [];

// Merges the fields in r's window into m; on failure r.err is set.
// Fields it does not know, or with another wire type, are kept as
// unknown fields.
fn Later_Grp_decode_from(r: pb_Reader&, m: Later_Grp&) {
    var unknown_len: i64 = m.pb_unknown.len;
    let unknown_had: i64 = unknown_len;
    while r.pos < r.end {
        let start = r.pos;
        let tag = pb_read_tag(r);
        if r.err != PB_OK { break; }
        if tag == 8 {
            m.g = pb_u64_to_int32(pb_read_varint(r));
            m.pb_has0 |= 0x00000001;
        } else {
            pb_unknown_append(r, start, tag, m.pb_unknown, unknown_len, unknown_had);
        }
    }
    m.pb_unknown = pb_bytes_trim(m.pb_unknown, unknown_len);
}

// Merges buf into m. 0 on success, else a PB_ERR_* code; m then holds a
// partial message, which the caller clears.
fn Later_Grp_decode(buf: const u8[:], m: Later_Grp&) -> i32 {
    var r = pb_reader(buf);
    Later_Grp_decode_from(r, m);
    return r.err;
}

// Appends m's wire encoding, Later_Grp_size_of(m) bytes, to out.
fn Later_Grp_encode(m: Later_Grp&, out: u8[>..]&) {
    if (m.pb_has0 & 0x00000001) != 0 {
        pb_write_varint(out, 8);
        pb_write_varint(out, pb_int32_to_u64(m.g));
    }
    out.append(pb_run(pb_bytes, m.pb_unknown));
}

// The size of m's wire encoding, in bytes.
fn Later_Grp_size_of(m: Later_Grp&) -> i64 {
    var n: i64 = 0;
    if (m.pb_has0 & 0x00000001) != 0 { n += 1 + pb_varint_size(pb_int32_to_u64(m.g)); }
    n += m.pb_unknown.len;
    return n;
}

// Frees what m owns and resets it to the empty message.
fn Later_Grp_clear(m: Later_Grp&) {
    m.g = 0;
    m.pb_has0 = 0;
    m.pb_unknown = pb_bytes_free(m.pb_unknown);
}

// Makes dst a deep copy of src, freeing what dst owned. The two share
// nothing afterwards. Neither may be a sub-message of the other.
fn Later_Grp_copy(dst: Later_Grp&, src: Later_Grp&) {
    if dst .== src { return; }
    Later_Grp_clear(dst);
    dst.g = src.g;
    dst.pb_has0 = src.pb_has0;
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
}

// Sets g and marks it present:
// it is encoded even when 0.
fn Later_Grp_set_g(m: Later_Grp&, v: i32) {
    m.g = v;
    m.pb_has0 |= 0x00000001;
}

fn Later_Grp_has_g(m: Later_Grp&) -> bool { return (m.pb_has0 & 0x00000001) != 0; }

fn Later_Grp_clear_g(m: Later_Grp&) {
    m.g = 0;
    m.pb_has0 &= 0xfffffffe;
}
