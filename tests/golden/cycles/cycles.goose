            r.end = r.pos + pb_n;
            r.depth++;
            B_decode_from(r, A_mutable_b(m));
            if r.err != PB_OK { break; }
            r.depth--;
            r.end = pb_outer;
        } else {
            pb_unknown_append(r, start, tag, m.pb_unknown, unknown_len, unknown_had);
        }
    }
    m.pb_unknown = pb_bytes_trim(m.pb_unknown, unknown_len);
}

// Merges buf into m. 0 on success, else a PB_ERR_* code; m then holds a
// partial message, which the caller clears.
fn A_decode(buf: const u8[:], m: A&) -> i32 {
    var r = pb_reader(buf);
    A_decode_from(r, m);
    return r.err;
}

// Appends m's wire encoding, A_size_of(m) bytes, to out.
recursive fn A_encode(m: A&, out: u8[>..]&) {
    let pb_f1 = m.b.m;
    if pb_f1 {
        pb_write_varint(out, 10);
        pb_write_varint(out, B_size_of(pb_f1) as! u64);
        B_encode(pb_f1, out);
    }
    out.append(pb_run(pb_bytes, m.pb_unknown));
}

// The size of m's wire encoding, in bytes.
recursive fn A_size_of(m: A&) -> i64 {
    var n: i64 = 0;
    let pb_f1 = m.b.m;
    if pb_f1 { n += 1 + pb_len_size(B_size_of(pb_f1)); }
    n += m.pb_unknown.len;
    return n;
}

// Frees what m owns and resets it to the empty message.
recursive fn A_clear(m: A&) {
    A_clear_b(m);
    m.pb_unknown = pb_bytes_free(m.pb_unknown);
}

// Makes dst a deep copy of src, freeing what dst owned. The two share
// nothing afterwards. Neither may be a sub-message of the other.
recursive fn A_copy(dst: A&, src: A&) {
    if dst .== src { return; }
    A_clear(dst);
    let pb_f1 = src.b.m;
    if pb_f1 { B_copy(A_mutable_b(dst), pb_f1); }
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
}

// The sub-message b, or null if it is not set. Valid until it or m is
// cleared.
fn A_b(m: A&) -> B&? { return m.b.m; }

// The sub-message b, set to an empty one first if it is not set.
fn A_mutable_b(m: A&) -> B& {
    let pb_sub = m.b.m;
    if pb_sub { return pb_sub; }
    let pb_new .= B_pool.alloc_ref(B { .. });
    m.b.m .= pb_new;
    return pb_new;
}

fn A_has_b(m: A&) -> bool { return m.b.m != null; }

// Frees the sub-message b and everything it owns.
recursive fn A_clear_b(m: A&) {
    let pb_sub = m.b.m;
    guard pb_sub else { return; }
    B_clear(pb_sub);
    B_pool.free(B_pool.index_of(pb_sub));
    m.b.m .= null;
}

// message cycles.B
