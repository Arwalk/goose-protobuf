    if dst .== src { return; }
    Holder_clear(dst);
    let pb_f1 = src.node.m;
    if pb_f1 { Node_copy(Holder_mutable_node(dst), pb_f1); }
    let pb_f2 = src.ping.m;
    if pb_f2 { Ping_copy(Holder_mutable_ping(dst), pb_f2); }
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
