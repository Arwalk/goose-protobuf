    let pb_f1 = src.a.m;
    if pb_f1 { A_copy(C_mutable_a(dst), pb_f1); }
    let pb_f2 = src.b.m;
    if pb_f2 { B_copy(C_mutable_b(dst), pb_f2); }
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
