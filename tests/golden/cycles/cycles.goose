    var r = pb_reader(buf);
    Holder_decode_from(r, m);
    return r.err;
}

// Appends m's wire encoding, Holder_size_of(m) bytes, to out.
fn Holder_encode(m: Holder&, out: u8[>..]&) {
    let pb_f1 = m.node.m;
    if pb_f1 {
        pb_write_varint(out, 10);
        pb_write_varint(out, Node_size_of(pb_f1) as! u64);
        Node_encode(pb_f1, out);
    }
    let pb_f2 = m.ping.m;
    if pb_f2 {
        pb_write_varint(out, 18);
        pb_write_varint(out, Ping_size_of(pb_f2) as! u64);
        Ping_encode(pb_f2, out);
