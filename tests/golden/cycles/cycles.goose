    var n: i64 = 0;
    let pb_f1 = m.node.m;
    if pb_f1 { n += 1 + pb_len_size(Node_size_of(pb_f1)); }
    let pb_f2 = m.ping.m;
    if pb_f2 { n += 1 + pb_len_size(Ping_size_of(pb_f2)); }
    n += m.pb_unknown.len;
