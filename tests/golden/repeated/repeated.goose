// message repeated.Tree
struct Tree {
    values: pb_Span,
    next: Tree_Ref,
    pb_unknown: pb_Span,   // unknown fields: raw wire bytes in pb_bytes
}

// A link to a Tree in Tree_pool, for sub-message fields.
struct Tree_Ref { m: Tree&<u32 in Tree_pool>? }
reusable var Tree_pool: Tree[>..] = [];
reusable[] var Tree_links: Tree_Ref[>..] = [];

// Merges the fields in r's window into m; on failure r.err is set.
// Fields it does not know, or with another wire type, are kept as
// unknown fields.
recursive fn Tree_decode_from(r: pb_Reader&, m: Tree&) {
    var unknown_len: i64 = m.pb_unknown.len;
    let pb_had1: i64 = m.values.len;
    var pb_len1: i64 = pb_had1;
    while r.pos < r.end {
        let start = r.pos;
        let tag = pb_read_tag(r);
        if r.err != PB_OK { break; }
        if tag == 8 {
            pb_append(pb_i32s, m.values, pb_len1, pb_had1, pb_u64_to_int32(pb_read_varint(r)));
        } else if tag == 10 {
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            while r.pos < r.end { pb_append(pb_i32s, m.values, pb_len1, pb_had1, pb_u64_to_int32(pb_read_varint(r))); }
            if r.err != PB_OK { break; }
            r.end = pb_outer;
        } else if tag == 18 {
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            if r.depth >= PB_MAX_DEPTH { pb_fail(r, PB_ERR_DEPTH); break; }
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            r.depth++;
            Tree_decode_from(r, Tree_mutable_next(m));
            if r.err != PB_OK { break; }
            r.depth--;
            r.end = pb_outer;
        } else {
            pb_unknown_append(r, start, tag, m.pb_unknown, unknown_len);
        }
    }
    m.values = pb_trim(pb_i32s, m.values, pb_len1);
    m.pb_unknown = pb_bytes_trim(m.pb_unknown, unknown_len);
}

// Merges buf into m. 0 on success, else a PB_ERR_* code; m then holds a
// partial message, which the caller clears.
fn Tree_decode(buf: const u8[:], m: Tree&) -> i32 {
    var r = pb_reader(buf);
    Tree_decode_from(r, m);
    return r.err;
}

// Appends m's wire encoding, Tree_size_of(m) bytes, to out.
recursive fn Tree_encode(m: Tree&, out: u8[>..]&) {
    if m.values.len > 0 {
        pb_write_varint(out, 10);
        var pb_n: i64 = 0;
        for pb_v in pb_run(pb_i32s, m.values) { pb_n += pb_varint_size(pb_int32_to_u64(pb_v)); }
        pb_write_varint(out, pb_n as! u64);
        for pb_v in pb_run(pb_i32s, m.values) { pb_write_varint(out, pb_int32_to_u64(pb_v)); }
    }
    let pb_f2 = m.next.m;
    if pb_f2 {
        pb_write_varint(out, 18);
        pb_write_varint(out, Tree_size_of(pb_f2) as! u64);
        Tree_encode(pb_f2, out);
    }
    out.append(pb_run(pb_bytes, m.pb_unknown));
}

// The size of m's wire encoding, in bytes.
recursive fn Tree_size_of(m: Tree&) -> i64 {
    var n: i64 = 0;
    if m.values.len > 0 {
        var pb_n: i64 = 0;
        for pb_v in pb_run(pb_i32s, m.values) { pb_n += pb_varint_size(pb_int32_to_u64(pb_v)); }
        n += 1 + pb_len_size(pb_n);
    }
    let pb_f2 = m.next.m;
    if pb_f2 { n += 1 + pb_len_size(Tree_size_of(pb_f2)); }
    n += m.pb_unknown.len;
    return n;
}

// Frees what m owns and resets it to the empty message.
recursive fn Tree_clear(m: Tree&) {
    m.values = pb_resize(pb_i32s, m.values, 0);
    Tree_clear_next(m);
    m.pb_unknown = pb_bytes_free(m.pb_unknown);
}

// Makes dst a deep copy of src, freeing what dst owned. The two share
// nothing afterwards. Neither may be a sub-message of the other.
recursive fn Tree_copy(dst: Tree&, src: Tree&) {
    if dst .== src { return; }
    Tree_clear(dst);
    dst.values = pb_copy_run(pb_i32s, src.values);
    let pb_f2 = src.next.m;
    if pb_f2 { Tree_copy(Tree_mutable_next(dst), pb_f2); }
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
}

// The values of values, in pb_i32s: valid until it is next changed or m is
// cleared.
fn Tree_values(m: Tree&) -> i32[:] { return pb_run(pb_i32s, m.values); }

fn Tree_values_at(m: Tree&, i: i64) -> i32 { return pb_run(pb_i32s, m.values)[i]; }

// Adds a value to values. This moves its values, so Tree_set_values is better for many.
fn Tree_add_values(m: Tree&, v: i32) { m.values = pb_add(pb_i32s, m.values, v); }

// Sets values to a copy of v.
fn Tree_set_values(m: Tree&, v: const i32[:]) { m.values = pb_set_run(pb_i32s, m.values, v); }

fn Tree_clear_values(m: Tree&) { m.values = pb_resize(pb_i32s, m.values, 0); }

// The sub-message next, or null if it is not set. Valid until it or m is
// cleared.
fn Tree_next(m: Tree&) -> Tree&? { return m.next.m; }

// The sub-message next, set to an empty one first if it is not set.
fn Tree_mutable_next(m: Tree&) -> Tree& {
    let pb_sub = m.next.m;
    if pb_sub { return pb_sub; }
    let pb_new .= Tree_pool.alloc_ref(Tree { .. });
    m.next.m .= pb_new;
    return pb_new;
}

fn Tree_has_next(m: Tree&) -> bool { return m.next.m != null; }

// Frees the sub-message next and everything it owns.
recursive fn Tree_clear_next(m: Tree&) {
    let pb_sub = m.next.m;
    guard pb_sub else { return; }
    Tree_clear(pb_sub);
    Tree_pool.free(Tree_pool.index_of(pb_sub));
    m.next.m .= null;
}
