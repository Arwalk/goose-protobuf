        pb_write_varint(out, 16002);
        var pb_n: i64 = 0;
        for pb_v in pb_run(pb_i32s, m.far) { pb_n += pb_varint_size(pb_int32_to_u64(pb_v)); }
        pb_write_varint(out, pb_n as! u64);
        for pb_v in pb_run(pb_i32s, m.far) { pb_write_varint(out, pb_int32_to_u64(pb_v)); }
    }
    out.append(pb_run(pb_bytes, m.pb_unknown));
}

// The size of m's wire encoding, in bytes.
fn Packed_size_of(m: Packed&) -> i64 {
    var n: i64 = 0;
    if m.f_int32.len > 0 {
        var pb_n: i64 = 0;
        for pb_v in pb_run(pb_i32s, m.f_int32) { pb_n += pb_varint_size(pb_int32_to_u64(pb_v)); }
        n += 1 + pb_len_size(pb_n);
    }
    if m.f_int64.len > 0 {
        var pb_n: i64 = 0;
        for pb_v in pb_run(pb_i64s, m.f_int64) { pb_n += pb_varint_size(pb_int64_to_u64(pb_v)); }
        n += 1 + pb_len_size(pb_n);
    }
    if m.f_uint32.len > 0 {
        var pb_n: i64 = 0;
        for pb_v in pb_run(pb_u32s, m.f_uint32) { pb_n += pb_varint_size(pb_v); }
        n += 1 + pb_len_size(pb_n);
    }
    if m.f_uint64.len > 0 {
        var pb_n: i64 = 0;
        for pb_v in pb_run(pb_u64s, m.f_uint64) { pb_n += pb_varint_size(pb_v); }
        n += 1 + pb_len_size(pb_n);
    }
    if m.f_sint32.len > 0 {
        var pb_n: i64 = 0;
        for pb_v in pb_run(pb_i32s, m.f_sint32) { pb_n += pb_varint_size(pb_zigzag32(pb_v)); }
        n += 1 + pb_len_size(pb_n);
    }
    if m.f_sint64.len > 0 {
        var pb_n: i64 = 0;
        for pb_v in pb_run(pb_i64s, m.f_sint64) { pb_n += pb_varint_size(pb_zigzag64(pb_v)); }
        n += 1 + pb_len_size(pb_n);
    }
    if m.f_fixed32.len > 0 {
        let pb_n: i64 = 4 * m.f_fixed32.len;
        n += 1 + pb_len_size(pb_n);
    }
    if m.f_fixed64.len > 0 {
        let pb_n: i64 = 8 * m.f_fixed64.len;
        n += 1 + pb_len_size(pb_n);
    }
    if m.f_sfixed32.len > 0 {
        let pb_n: i64 = 4 * m.f_sfixed32.len;
        n += 1 + pb_len_size(pb_n);
    }
    if m.f_sfixed64.len > 0 {
        let pb_n: i64 = 8 * m.f_sfixed64.len;
        n += 1 + pb_len_size(pb_n);
    }
    if m.f_float.len > 0 {
        let pb_n: i64 = 4 * m.f_float.len;
        n += 1 + pb_len_size(pb_n);
    }
    if m.f_double.len > 0 {
        let pb_n: i64 = 8 * m.f_double.len;
        n += 1 + pb_len_size(pb_n);
    }
    if m.f_bool.len > 0 {
        let pb_n: i64 = 1 * m.f_bool.len;
        n += 1 + pb_len_size(pb_n);
    }
    if m.f_enum.len > 0 {
        var pb_n: i64 = 0;
        for pb_v in pb_run(pb_i32s, m.f_enum) { pb_n += pb_varint_size(pb_int32_to_u64(pb_v)); }
        n += 1 + pb_len_size(pb_n);
    }
    if m.single != 0 { n += 1 + pb_varint_size(pb_int32_to_u64(m.single)); }
    if m.far.len > 0 {
        var pb_n: i64 = 0;
        for pb_v in pb_run(pb_i32s, m.far) { pb_n += pb_varint_size(pb_int32_to_u64(pb_v)); }
        n += 2 + pb_len_size(pb_n);
    }
    n += m.pb_unknown.len;
    return n;
}

// Frees what m owns and resets it to the empty message.
fn Packed_clear(m: Packed&) {
    m.f_int32 = pb_resize(pb_i32s, m.f_int32, 0);
    m.f_int64 = pb_resize(pb_i64s, m.f_int64, 0);
    m.f_uint32 = pb_resize(pb_u32s, m.f_uint32, 0);
    m.f_uint64 = pb_resize(pb_u64s, m.f_uint64, 0);
    m.f_sint32 = pb_resize(pb_i32s, m.f_sint32, 0);
    m.f_sint64 = pb_resize(pb_i64s, m.f_sint64, 0);
    m.f_fixed32 = pb_resize(pb_u32s, m.f_fixed32, 0);
    m.f_fixed64 = pb_resize(pb_u64s, m.f_fixed64, 0);
    m.f_sfixed32 = pb_resize(pb_i32s, m.f_sfixed32, 0);
    m.f_sfixed64 = pb_resize(pb_i64s, m.f_sfixed64, 0);
    m.f_float = pb_resize(pb_f32s, m.f_float, 0);
    m.f_double = pb_resize(pb_f64s, m.f_double, 0);
    m.f_bool = pb_resize(pb_bools, m.f_bool, 0);
    m.f_enum = pb_resize(pb_i32s, m.f_enum, 0);
    m.single = 0;
    m.far = pb_resize(pb_i32s, m.far, 0);
    m.pb_unknown = pb_bytes_free(m.pb_unknown);
}

// Makes dst a deep copy of src, freeing what dst owned. The two share
// nothing afterwards. Neither may be a sub-message of the other.
fn Packed_copy(dst: Packed&, src: Packed&) {
    if dst .== src { return; }
    Packed_clear(dst);
    dst.f_int32 = pb_copy_run(pb_i32s, src.f_int32);
    dst.f_int64 = pb_copy_run(pb_i64s, src.f_int64);
    dst.f_uint32 = pb_copy_run(pb_u32s, src.f_uint32);
    dst.f_uint64 = pb_copy_run(pb_u64s, src.f_uint64);
    dst.f_sint32 = pb_copy_run(pb_i32s, src.f_sint32);
    dst.f_sint64 = pb_copy_run(pb_i64s, src.f_sint64);
    dst.f_fixed32 = pb_copy_run(pb_u32s, src.f_fixed32);
    dst.f_fixed64 = pb_copy_run(pb_u64s, src.f_fixed64);
    dst.f_sfixed32 = pb_copy_run(pb_i32s, src.f_sfixed32);
    dst.f_sfixed64 = pb_copy_run(pb_i64s, src.f_sfixed64);
    dst.f_float = pb_copy_run(pb_f32s, src.f_float);
    dst.f_double = pb_copy_run(pb_f64s, src.f_double);
    dst.f_bool = pb_copy_run(pb_bools, src.f_bool);
    dst.f_enum = pb_copy_run(pb_i32s, src.f_enum);
    dst.single = src.single;
    dst.far = pb_copy_run(pb_i32s, src.far);
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
}

// The values of f_int32, in pb_i32s: valid until it is next changed or m is
// cleared.
fn Packed_f_int32(m: Packed&) -> i32[:] { return pb_run(pb_i32s, m.f_int32); }

fn Packed_f_int32_at(m: Packed&, i: i64) -> i32 { return pb_run(pb_i32s, m.f_int32)[i]; }

// Adds a value to f_int32. This moves its values, so Packed_set_f_int32 is better for many.
fn Packed_add_f_int32(m: Packed&, v: i32) { m.f_int32 = pb_add(pb_i32s, m.f_int32, v); }

// Sets f_int32 to a copy of v.
fn Packed_set_f_int32(m: Packed&, v: const i32[:]) { m.f_int32 = pb_set_run(pb_i32s, m.f_int32, v); }

fn Packed_clear_f_int32(m: Packed&) { m.f_int32 = pb_resize(pb_i32s, m.f_int32, 0); }

