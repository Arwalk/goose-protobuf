// message repeated.Unpacked
struct Unpacked {
    f_int32: pb_Span,
    f_int64: pb_Span,
    f_uint32: pb_Span,
    f_uint64: pb_Span,
    f_sint32: pb_Span,
    f_sint64: pb_Span,
    f_fixed32: pb_Span,
    f_fixed64: pb_Span,
    f_sfixed32: pb_Span,
    f_sfixed64: pb_Span,
    f_float: pb_Span,
    f_double: pb_Span,
    f_bool: pb_Span,
    f_enum: pb_Span,
    single: i32,
    far: pb_Span,
    pb_unknown: pb_Span,   // unknown fields: raw wire bytes in pb_bytes
}

// A link to a Unpacked in Unpacked_pool, for sub-message fields.
struct Unpacked_Ref { m: Unpacked&<u32 in Unpacked_pool>? }
reusable var Unpacked_pool: Unpacked[>..] = [];
reusable[] var Unpacked_links: Unpacked_Ref[>..] = [];

// Merges the fields in r's window into m; on failure r.err is set.
// Fields it does not know, or with another wire type, are kept as
// unknown fields.
fn Unpacked_decode_from(r: pb_Reader&, m: Unpacked&) {
    var unknown_len: i64 = m.pb_unknown.len;
    let pb_had1: i64 = m.f_int32.len;
    var pb_len1: i64 = pb_had1;
    let pb_had2: i64 = m.f_int64.len;
    var pb_len2: i64 = pb_had2;
    let pb_had3: i64 = m.f_uint32.len;
    var pb_len3: i64 = pb_had3;
    let pb_had4: i64 = m.f_uint64.len;
    var pb_len4: i64 = pb_had4;
    let pb_had5: i64 = m.f_sint32.len;
    var pb_len5: i64 = pb_had5;
    let pb_had6: i64 = m.f_sint64.len;
    var pb_len6: i64 = pb_had6;
    let pb_had7: i64 = m.f_fixed32.len;
    var pb_len7: i64 = pb_had7;
    let pb_had8: i64 = m.f_fixed64.len;
    var pb_len8: i64 = pb_had8;
    let pb_had9: i64 = m.f_sfixed32.len;
    var pb_len9: i64 = pb_had9;
    let pb_had10: i64 = m.f_sfixed64.len;
    var pb_len10: i64 = pb_had10;
    let pb_had11: i64 = m.f_float.len;
    var pb_len11: i64 = pb_had11;
    let pb_had12: i64 = m.f_double.len;
    var pb_len12: i64 = pb_had12;
    let pb_had13: i64 = m.f_bool.len;
    var pb_len13: i64 = pb_had13;
    let pb_had14: i64 = m.f_enum.len;
    var pb_len14: i64 = pb_had14;
    let pb_had2000: i64 = m.far.len;
    var pb_len2000: i64 = pb_had2000;
    while r.pos < r.end {
        let start = r.pos;
        let tag = pb_read_tag(r);
        if r.err != PB_OK { break; }
        if tag == 8 {
            pb_append(pb_i32s, m.f_int32, pb_len1, pb_had1, pb_u64_to_int32(pb_read_varint(r)));
        } else if tag == 10 {
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            while r.pos < r.end { pb_append(pb_i32s, m.f_int32, pb_len1, pb_had1, pb_u64_to_int32(pb_read_varint(r))); }
            if r.err != PB_OK { break; }
            r.end = pb_outer;
        } else if tag == 16 {
            pb_append(pb_i64s, m.f_int64, pb_len2, pb_had2, pb_u64_to_int64(pb_read_varint(r)));
        } else if tag == 18 {
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            while r.pos < r.end { pb_append(pb_i64s, m.f_int64, pb_len2, pb_had2, pb_u64_to_int64(pb_read_varint(r))); }
            if r.err != PB_OK { break; }
            r.end = pb_outer;
        } else if tag == 24 {
            pb_append(pb_u32s, m.f_uint32, pb_len3, pb_had3, pb_read_varint(r) as! u32);
        } else if tag == 26 {
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            while r.pos < r.end { pb_append(pb_u32s, m.f_uint32, pb_len3, pb_had3, pb_read_varint(r) as! u32); }
            if r.err != PB_OK { break; }
            r.end = pb_outer;
        } else if tag == 32 {
            pb_append(pb_u64s, m.f_uint64, pb_len4, pb_had4, pb_read_varint(r));
        } else if tag == 34 {
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            while r.pos < r.end { pb_append(pb_u64s, m.f_uint64, pb_len4, pb_had4, pb_read_varint(r)); }
            if r.err != PB_OK { break; }
            r.end = pb_outer;
        } else if tag == 40 {
            pb_append(pb_i32s, m.f_sint32, pb_len5, pb_had5, pb_unzigzag32(pb_read_varint(r) as! u32));
        } else if tag == 42 {
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            while r.pos < r.end { pb_append(pb_i32s, m.f_sint32, pb_len5, pb_had5, pb_unzigzag32(pb_read_varint(r) as! u32)); }
            if r.err != PB_OK { break; }
            r.end = pb_outer;
        } else if tag == 48 {
            pb_append(pb_i64s, m.f_sint64, pb_len6, pb_had6, pb_unzigzag64(pb_read_varint(r)));
        } else if tag == 50 {
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            while r.pos < r.end { pb_append(pb_i64s, m.f_sint64, pb_len6, pb_had6, pb_unzigzag64(pb_read_varint(r))); }
            if r.err != PB_OK { break; }
            r.end = pb_outer;
        } else if tag == 61 {
            pb_append(pb_u32s, m.f_fixed32, pb_len7, pb_had7, pb_read_fixed32(r));
        } else if tag == 58 {
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            while r.pos < r.end { pb_append(pb_u32s, m.f_fixed32, pb_len7, pb_had7, pb_read_fixed32(r)); }
            if r.err != PB_OK { break; }
            r.end = pb_outer;
        } else if tag == 65 {
            pb_append(pb_u64s, m.f_fixed64, pb_len8, pb_had8, pb_read_fixed64(r));
        } else if tag == 66 {
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            while r.pos < r.end { pb_append(pb_u64s, m.f_fixed64, pb_len8, pb_had8, pb_read_fixed64(r)); }
            if r.err != PB_OK { break; }
            r.end = pb_outer;
        } else if tag == 77 {
            pb_append(pb_i32s, m.f_sfixed32, pb_len9, pb_had9, pb_read_fixed32(r) as! i32);
        } else if tag == 74 {
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            while r.pos < r.end { pb_append(pb_i32s, m.f_sfixed32, pb_len9, pb_had9, pb_read_fixed32(r) as! i32); }
            if r.err != PB_OK { break; }
            r.end = pb_outer;
        } else if tag == 81 {
            pb_append(pb_i64s, m.f_sfixed64, pb_len10, pb_had10, pb_read_fixed64(r) as! i64);
        } else if tag == 82 {
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            while r.pos < r.end { pb_append(pb_i64s, m.f_sfixed64, pb_len10, pb_had10, pb_read_fixed64(r) as! i64); }
            if r.err != PB_OK { break; }
            r.end = pb_outer;
        } else if tag == 93 {
            pb_append(pb_f32s, m.f_float, pb_len11, pb_had11, pb_read_float(r));
        } else if tag == 90 {
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            while r.pos < r.end { pb_append(pb_f32s, m.f_float, pb_len11, pb_had11, pb_read_float(r)); }
            if r.err != PB_OK { break; }
            r.end = pb_outer;
        } else if tag == 97 {
            pb_append(pb_f64s, m.f_double, pb_len12, pb_had12, pb_read_double(r));
        } else if tag == 98 {
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            while r.pos < r.end { pb_append(pb_f64s, m.f_double, pb_len12, pb_had12, pb_read_double(r)); }
            if r.err != PB_OK { break; }
            r.end = pb_outer;
        } else if tag == 104 {
            pb_append(pb_bools, m.f_bool, pb_len13, pb_had13, pb_read_varint(r) != 0);
        } else if tag == 106 {
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            while r.pos < r.end { pb_append(pb_bools, m.f_bool, pb_len13, pb_had13, pb_read_varint(r) != 0); }
            if r.err != PB_OK { break; }
            r.end = pb_outer;
        } else if tag == 112 {
            pb_append(pb_i32s, m.f_enum, pb_len14, pb_had14, pb_u64_to_int32(pb_read_varint(r)));
        } else if tag == 114 {
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            while r.pos < r.end { pb_append(pb_i32s, m.f_enum, pb_len14, pb_had14, pb_u64_to_int32(pb_read_varint(r))); }
            if r.err != PB_OK { break; }
            r.end = pb_outer;
        } else if tag == 120 {
            m.single = pb_u64_to_int32(pb_read_varint(r));
        } else if tag == 16000 {
            pb_append(pb_i32s, m.far, pb_len2000, pb_had2000, pb_u64_to_int32(pb_read_varint(r)));
        } else if tag == 16002 {
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            while r.pos < r.end { pb_append(pb_i32s, m.far, pb_len2000, pb_had2000, pb_u64_to_int32(pb_read_varint(r))); }
            if r.err != PB_OK { break; }
            r.end = pb_outer;
        } else {
            pb_unknown_append(r, start, tag, m.pb_unknown, unknown_len);
        }
    }
    m.f_int32 = pb_trim(pb_i32s, m.f_int32, pb_len1);
    m.f_int64 = pb_trim(pb_i64s, m.f_int64, pb_len2);
    m.f_uint32 = pb_trim(pb_u32s, m.f_uint32, pb_len3);
    m.f_uint64 = pb_trim(pb_u64s, m.f_uint64, pb_len4);
    m.f_sint32 = pb_trim(pb_i32s, m.f_sint32, pb_len5);
    m.f_sint64 = pb_trim(pb_i64s, m.f_sint64, pb_len6);
    m.f_fixed32 = pb_trim(pb_u32s, m.f_fixed32, pb_len7);
    m.f_fixed64 = pb_trim(pb_u64s, m.f_fixed64, pb_len8);
    m.f_sfixed32 = pb_trim(pb_i32s, m.f_sfixed32, pb_len9);
    m.f_sfixed64 = pb_trim(pb_i64s, m.f_sfixed64, pb_len10);
    m.f_float = pb_trim(pb_f32s, m.f_float, pb_len11);
    m.f_double = pb_trim(pb_f64s, m.f_double, pb_len12);
    m.f_bool = pb_trim(pb_bools, m.f_bool, pb_len13);
    m.f_enum = pb_trim(pb_i32s, m.f_enum, pb_len14);
    m.far = pb_trim(pb_i32s, m.far, pb_len2000);
    m.pb_unknown = pb_bytes_trim(m.pb_unknown, unknown_len);
}

// Merges buf into m. 0 on success, else a PB_ERR_* code; m then holds a
// partial message, which the caller clears.
fn Unpacked_decode(buf: const u8[:], m: Unpacked&) -> i32 {
    var r = pb_reader(buf);
    Unpacked_decode_from(r, m);
    return r.err;
}

// Appends m's wire encoding, Unpacked_size_of(m) bytes, to out.
fn Unpacked_encode(m: Unpacked&, out: u8[>..]&) {
    if m.f_int32.len > 0 {
        for pb_v in pb_run(pb_i32s, m.f_int32) {
            pb_write_varint(out, 8);
            pb_write_varint(out, pb_int32_to_u64(pb_v));
        }
    }
    if m.f_int64.len > 0 {
        for pb_v in pb_run(pb_i64s, m.f_int64) {
            pb_write_varint(out, 16);
            pb_write_varint(out, pb_int64_to_u64(pb_v));
        }
    }
    if m.f_uint32.len > 0 {
        for pb_v in pb_run(pb_u32s, m.f_uint32) {
            pb_write_varint(out, 24);
            pb_write_varint(out, pb_v);
        }
    }
    if m.f_uint64.len > 0 {
        for pb_v in pb_run(pb_u64s, m.f_uint64) {
            pb_write_varint(out, 32);
            pb_write_varint(out, pb_v);
        }
    }
    if m.f_sint32.len > 0 {
        for pb_v in pb_run(pb_i32s, m.f_sint32) {
            pb_write_varint(out, 40);
            pb_write_varint(out, pb_zigzag32(pb_v));
        }
    }
    if m.f_sint64.len > 0 {
        for pb_v in pb_run(pb_i64s, m.f_sint64) {
            pb_write_varint(out, 48);
            pb_write_varint(out, pb_zigzag64(pb_v));
        }
    }
    if m.f_fixed32.len > 0 {
        for pb_v in pb_run(pb_u32s, m.f_fixed32) {
            pb_write_varint(out, 61);
            pb_write_fixed32(out, pb_v);
        }
    }
    if m.f_fixed64.len > 0 {
        for pb_v in pb_run(pb_u64s, m.f_fixed64) {
            pb_write_varint(out, 65);
            pb_write_fixed64(out, pb_v);
        }
    }
    if m.f_sfixed32.len > 0 {
        for pb_v in pb_run(pb_i32s, m.f_sfixed32) {
            pb_write_varint(out, 77);
            pb_write_fixed32(out, pb_v as! u32);
        }
    }
    if m.f_sfixed64.len > 0 {
        for pb_v in pb_run(pb_i64s, m.f_sfixed64) {
            pb_write_varint(out, 81);
            pb_write_fixed64(out, pb_v as! u64);
        }
    }
    if m.f_float.len > 0 {
        for pb_v in pb_run(pb_f32s, m.f_float) {
            pb_write_varint(out, 93);
            pb_write_float(out, pb_v);
        }
    }
    if m.f_double.len > 0 {
        for pb_v in pb_run(pb_f64s, m.f_double) {
            pb_write_varint(out, 97);
            pb_write_double(out, pb_v);
        }
    }
    if m.f_bool.len > 0 {
        for pb_v in pb_run(pb_bools, m.f_bool) {
            pb_write_varint(out, 104);
            pb_write_varint(out, pb_bool_to_u64(pb_v));
        }
    }
    if m.f_enum.len > 0 {
        for pb_v in pb_run(pb_i32s, m.f_enum) {
            pb_write_varint(out, 112);
            pb_write_varint(out, pb_int32_to_u64(pb_v));
        }
    }
    if m.single != 0 {
        pb_write_varint(out, 120);
        pb_write_varint(out, pb_int32_to_u64(m.single));
    }
    if m.far.len > 0 {
        for pb_v in pb_run(pb_i32s, m.far) {
            pb_write_varint(out, 16000);
            pb_write_varint(out, pb_int32_to_u64(pb_v));
        }
    }
    out.append(pb_run(pb_bytes, m.pb_unknown));
}

// The size of m's wire encoding, in bytes.
fn Unpacked_size_of(m: Unpacked&) -> i64 {
    var n: i64 = 0;
    if m.f_int32.len > 0 {
        var pb_n: i64 = 0;
        for pb_v in pb_run(pb_i32s, m.f_int32) { pb_n += pb_varint_size(pb_int32_to_u64(pb_v)); }
        n += 1 * m.f_int32.len + pb_n;
    }
    if m.f_int64.len > 0 {
        var pb_n: i64 = 0;
        for pb_v in pb_run(pb_i64s, m.f_int64) { pb_n += pb_varint_size(pb_int64_to_u64(pb_v)); }
        n += 1 * m.f_int64.len + pb_n;
    }
    if m.f_uint32.len > 0 {
        var pb_n: i64 = 0;
        for pb_v in pb_run(pb_u32s, m.f_uint32) { pb_n += pb_varint_size(pb_v); }
        n += 1 * m.f_uint32.len + pb_n;
    }
    if m.f_uint64.len > 0 {
        var pb_n: i64 = 0;
        for pb_v in pb_run(pb_u64s, m.f_uint64) { pb_n += pb_varint_size(pb_v); }
        n += 1 * m.f_uint64.len + pb_n;
    }
    if m.f_sint32.len > 0 {
        var pb_n: i64 = 0;
        for pb_v in pb_run(pb_i32s, m.f_sint32) { pb_n += pb_varint_size(pb_zigzag32(pb_v)); }
        n += 1 * m.f_sint32.len + pb_n;
    }
    if m.f_sint64.len > 0 {
        var pb_n: i64 = 0;
        for pb_v in pb_run(pb_i64s, m.f_sint64) { pb_n += pb_varint_size(pb_zigzag64(pb_v)); }
        n += 1 * m.f_sint64.len + pb_n;
    }
    if m.f_fixed32.len > 0 {
        let pb_n: i64 = 4 * m.f_fixed32.len;
        n += 1 * m.f_fixed32.len + pb_n;
    }
    if m.f_fixed64.len > 0 {
        let pb_n: i64 = 8 * m.f_fixed64.len;
        n += 1 * m.f_fixed64.len + pb_n;
    }
    if m.f_sfixed32.len > 0 {
        let pb_n: i64 = 4 * m.f_sfixed32.len;
        n += 1 * m.f_sfixed32.len + pb_n;
    }
    if m.f_sfixed64.len > 0 {
        let pb_n: i64 = 8 * m.f_sfixed64.len;
        n += 1 * m.f_sfixed64.len + pb_n;
    }
    if m.f_float.len > 0 {
        let pb_n: i64 = 4 * m.f_float.len;
        n += 1 * m.f_float.len + pb_n;
    }
    if m.f_double.len > 0 {
        let pb_n: i64 = 8 * m.f_double.len;
        n += 1 * m.f_double.len + pb_n;
    }
    if m.f_bool.len > 0 {
        let pb_n: i64 = 1 * m.f_bool.len;
        n += 1 * m.f_bool.len + pb_n;
    }
    if m.f_enum.len > 0 {
        var pb_n: i64 = 0;
        for pb_v in pb_run(pb_i32s, m.f_enum) { pb_n += pb_varint_size(pb_int32_to_u64(pb_v)); }
        n += 1 * m.f_enum.len + pb_n;
    }
    if m.single != 0 { n += 1 + pb_varint_size(pb_int32_to_u64(m.single)); }
    if m.far.len > 0 {
        var pb_n: i64 = 0;
        for pb_v in pb_run(pb_i32s, m.far) { pb_n += pb_varint_size(pb_int32_to_u64(pb_v)); }
        n += 2 * m.far.len + pb_n;
    }
    n += m.pb_unknown.len;
    return n;
}

// Frees what m owns and resets it to the empty message.
fn Unpacked_clear(m: Unpacked&) {
    m.f_int32 = pb_resize(pb_i32s, m.f_int32, 0);
    m.f_int64 = pb_resize(pb_i64s, m.f_int64, 0);
    m.f_uint32 = pb_resize(pb_u32s, m.f_uint32, 0);
    m.f_uint64 = pb_resize(pb_u64s, m.f_uint64, 0);
    m.f_sint32 = pb_resize(pb_i32s, m.f_sint32, 0);
    m.f_sint64 = pb_resize(pb_i64s, m.f_sint64, 0);
    m.f_fixed32 = pb_resize(pb_u32s, m.f_fixed32, 0);
    m.f_fixed64 = pb_resize(pb_u64s, m.f_fixed64, 0);
    m.f_sfixed32 = pb_resize(pb_i32s, m.f_sfixed32, 0);
    m.f_sfixed64 = pb_resize(pb_i64s, m.f_sfixed64, 0);
    m.f_float = pb_resize(pb_f32s, m.f_float, 0);
    m.f_double = pb_resize(pb_f64s, m.f_double, 0);
    m.f_bool = pb_resize(pb_bools, m.f_bool, 0);
    m.f_enum = pb_resize(pb_i32s, m.f_enum, 0);
    m.single = 0;
    m.far = pb_resize(pb_i32s, m.far, 0);
    m.pb_unknown = pb_bytes_free(m.pb_unknown);
}

// Makes dst a deep copy of src, freeing what dst owned. The two share
// nothing afterwards. Neither may be a sub-message of the other.
fn Unpacked_copy(dst: Unpacked&, src: Unpacked&) {
    if dst .== src { return; }
    Unpacked_clear(dst);
    dst.f_int32 = pb_copy_run(pb_i32s, src.f_int32);
    dst.f_int64 = pb_copy_run(pb_i64s, src.f_int64);
    dst.f_uint32 = pb_copy_run(pb_u32s, src.f_uint32);
    dst.f_uint64 = pb_copy_run(pb_u64s, src.f_uint64);
    dst.f_sint32 = pb_copy_run(pb_i32s, src.f_sint32);
    dst.f_sint64 = pb_copy_run(pb_i64s, src.f_sint64);
    dst.f_fixed32 = pb_copy_run(pb_u32s, src.f_fixed32);
    dst.f_fixed64 = pb_copy_run(pb_u64s, src.f_fixed64);
    dst.f_sfixed32 = pb_copy_run(pb_i32s, src.f_sfixed32);
    dst.f_sfixed64 = pb_copy_run(pb_i64s, src.f_sfixed64);
    dst.f_float = pb_copy_run(pb_f32s, src.f_float);
    dst.f_double = pb_copy_run(pb_f64s, src.f_double);
    dst.f_bool = pb_copy_run(pb_bools, src.f_bool);
    dst.f_enum = pb_copy_run(pb_i32s, src.f_enum);
    dst.single = src.single;
    dst.far = pb_copy_run(pb_i32s, src.far);
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
}

