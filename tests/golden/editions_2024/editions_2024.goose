fn Book_copy(dst: Book&, src: Book&) {
    if dst .== src { return; }
    Book_clear(dst);
    dst.title = pb_bytes_copy(src.title);
    dst.explicit_field = src.explicit_field;
    dst.implicit_field = src.implicit_field;
    dst.color = src.color;
    dst.closed = src.closed;
    dst.packed_values = pb_copy_run(pb_i32s, src.packed_values);
    dst.expanded_values = pb_copy_run(pb_i32s, src.expanded_values);
    dst.counts = pb_resize(Book_CountsEntry_entries, dst.counts, src.counts.len);
    for pb_i in src.counts.len {
        Book_CountsEntry_copy(pb_run(Book_CountsEntry_entries, dst.counts)[pb_i], pb_run(Book_CountsEntry_entries, src.counts)[pb_i]);
    }
    let pb_f9 = src.shared.m;
    if pb_f9 { ed24dep::Shared_copy(Book_mutable_shared(dst), pb_f9); }
    let pb_f10 = src.hidden.m;
    if pb_f10 { Hidden_copy(Book_mutable_hidden(dst), pb_f10); }
    let pb_f11 = src.nested.m;
    if pb_f11 { Book_Nested_copy(Book_mutable_nested(dst), pb_f11); }
    let pb_f12 = src.inner.m;
    if pb_f12 { Book_Inner_copy(Book_mutable_inner(dst), pb_f12); }
    let pb_f13 = src.delimited_inner.m;
    if pb_f13 { Book_Inner_copy(Book_mutable_delimited_inner(dst), pb_f13); }
    dst.unchecked = pb_bytes_copy(src.unchecked);
    match src.choice {
        number pb_p => { dst.choice = Book_choice.number { v: pb_p.v }; },
        word pb_p => { dst.choice = Book_choice.word { v: pb_bytes_copy(pb_p.v) }; },
        _ => {},
    }
    dst.pb_has0 = src.pb_has0;
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
}

// Folds repeated keys in the maps of m and of the messages it holds, which
// decoding appends without looking them up: the last value wins, in the
// place of the first occurrence.
fn Book_fold_maps(m: Book&) {
    m.counts = Book_CountsEntry_fold(m.counts);
}

// Frees what oneof choice holds, and sets no member.
fn Book_clear_choice(m: Book&) {
    match m.choice {
        word pb_p => { pb_bytes_free(pb_p.v); },
        _ => {},
    }
    m.choice = Book_choice.pb_none;
}

