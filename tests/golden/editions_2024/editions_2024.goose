fn Book_mutable_shared(m: Book&) -> ed24dep::Shared& {
    let pb_sub = m.shared.m;
    if pb_sub { return pb_sub; }
    let pb_new .= ed24dep::Shared_pool.alloc_ref(ed24dep::Shared { .. });
    m.shared.m .= pb_new;
