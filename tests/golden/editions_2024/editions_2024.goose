fn Book_packed_values(m: Book&) -> i32[:] { return pb_run(pb_i32s, m.packed_values); }

fn Book_packed_values_at(m: Book&, i: i64) -> i32 { return pb_run(pb_i32s, m.packed_values)[i]; }

