fn Book_add_packed_values(m: Book&, v: i32) { m.packed_values = pb_add(pb_i32s, m.packed_values, v); }

// Sets packed_values to a copy of v.
fn Book_set_packed_values(m: Book&, v: const i32[:]) { m.packed_values = pb_set_run(pb_i32s, m.packed_values, v); }

fn Book_clear_packed_values(m: Book&) { m.packed_values = pb_resize(pb_i32s, m.packed_values, 0); }

