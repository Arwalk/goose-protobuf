fn Book_expanded_values(m: Book&) -> i32[:] { return pb_run(pb_i32s, m.expanded_values); }

fn Book_expanded_values_at(m: Book&, i: i64) -> i32 { return pb_run(pb_i32s, m.expanded_values)[i]; }

// Adds a value to expanded_values. This moves its values, so Book_set_expanded_values is better for many.
fn Book_add_expanded_values(m: Book&, v: i32) { m.expanded_values = pb_add(pb_i32s, m.expanded_values, v); }

// Sets expanded_values to a copy of v.
fn Book_set_expanded_values(m: Book&, v: const i32[:]) { m.expanded_values = pb_set_run(pb_i32s, m.expanded_values, v); }

fn Book_clear_expanded_values(m: Book&) { m.expanded_values = pb_resize(pb_i32s, m.expanded_values, 0); }

// The number of entries of counts.
fn Book_counts_len(m: Book&) -> i64 { return m.counts.len; }

// The key of entry i of counts, in insertion order. Valid until the map next
// changes or m is cleared.
fn Book_counts_key_at(m: Book&, i: i64) -> u8[:] { return pb_run(pb_bytes, pb_run(Book_CountsEntry_entries, m.counts)[i].key); }

// The value of entry i of counts.
fn Book_counts_value_at(m: Book&, i: i64) -> i32 { return pb_run(Book_CountsEntry_entries, m.counts)[i].value; }

// The value with key k and true, or the default and false.
fn Book_counts_get(m: Book&, k: const u8[:]) -> i32, bool {
    let pb_i = Book_CountsEntry_find(m.counts, m.counts.len, k);
    if pb_i < 0 { return 0, false; }
    return pb_run(Book_CountsEntry_entries, m.counts)[pb_i].value, true;
}

// Sets the value with key k to v, adding an entry if there is none.
fn Book_counts_put(m: Book&, k: const u8[:], v: i32) {
    Book_CountsEntry_slot(m.counts, k).value = v;
}

// Adds an entry without looking for key k, much faster than Book_counts_put for many.
// Call Book_fold_maps(m) before reading the map: until then, a repeated key is
// there twice. There, the last value wins, in the place of the first occurrence.
fn Book_counts_append(m: Book&, k: const u8[:], v: i32) {
    let pb_i: i64 = m.counts.len;
    m.counts = pb_resize(Book_CountsEntry_entries, m.counts, pb_i + 1);
    let pb_e .= pb_run(Book_CountsEntry_entries, m.counts)[pb_i];
    Book_CountsEntry_set_key(pb_e, k);
    pb_e.value = v;
}

// Removes the entry with key k and frees what it owns. False if there is
// none. Later entries keep their order.
fn Book_counts_remove(m: Book&, k: const u8[:]) -> bool {
    let pb_i = Book_CountsEntry_find(m.counts, m.counts.len, k);
    if pb_i < 0 { return false; }
    let pb_r = pb_run(Book_CountsEntry_entries, m.counts);
    Book_CountsEntry_clear(pb_r[pb_i]);
    var pb_j = pb_i;
    while pb_j + 1 < pb_r.len { pb_r[pb_j] = pb_r[pb_j + 1]; pb_j++; }
    pb_r[pb_j] = Book_CountsEntry { .. };
    m.counts = pb_resize(Book_CountsEntry_entries, m.counts, pb_j);
    return true;
}

// Frees the entries of counts and everything they own.
fn Book_clear_counts(m: Book&) {
    for pb_i in m.counts.len { Book_CountsEntry_clear(pb_run(Book_CountsEntry_entries, m.counts)[pb_i]); }
    m.counts = pb_resize(Book_CountsEntry_entries, m.counts, 0);
}

