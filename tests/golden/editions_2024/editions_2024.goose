// message ed24.Book.Nested
struct Book_Nested {
    n: i32,
    pb_has0: u32,   // has-bits of fields with presence
    pb_unknown: pb_Span,   // unknown fields: raw wire bytes in pb_bytes
}

// A link to a Book_Nested in Book_Nested_pool, for sub-message fields.
struct Book_Nested_Ref { m: Book_Nested&<u32 in Book_Nested_pool>? }
reusable var Book_Nested_pool: Book_Nested[>..] = [];
reusable[] var Book_Nested_links: Book_Nested_Ref[>..] = [];

// Merges the fields in r's window into m; on failure r.err is set.
// Fields it does not know, or with another wire type, are kept as
// unknown fields.
fn Book_Nested_decode_from(r: pb_Reader&, m: Book_Nested&) {
    var unknown_len: i64 = m.pb_unknown.len;
    let unknown_had: i64 = unknown_len;
    while r.pos < r.end {
        let start = r.pos;
        let tag = pb_read_tag(r);
        if r.err != PB_OK { break; }
        if tag == 8 {
            m.n = pb_u64_to_int32(pb_read_varint(r));
            m.pb_has0 |= 0x00000001;
        } else {
            pb_unknown_append(r, start, tag, m.pb_unknown, unknown_len, unknown_had);
        }
    }
    m.pb_unknown = pb_bytes_trim(m.pb_unknown, unknown_len);
}

// Merges buf into m. 0 on success, else a PB_ERR_* code; m then holds a
// partial message, which the caller clears.
fn Book_Nested_decode(buf: const u8[:], m: Book_Nested&) -> i32 {
    var r = pb_reader(buf);
    Book_Nested_decode_from(r, m);
    return r.err;
}

// Appends m's wire encoding, Book_Nested_size_of(m) bytes, to out.
fn Book_Nested_encode(m: Book_Nested&, out: u8[>..]&) {
    if (m.pb_has0 & 0x00000001) != 0 {
        pb_write_varint(out, 8);
        pb_write_varint(out, pb_int32_to_u64(m.n));
    }
    out.append(pb_run(pb_bytes, m.pb_unknown));
}

// The size of m's wire encoding, in bytes.
fn Book_Nested_size_of(m: Book_Nested&) -> i64 {
    var n: i64 = 0;
    if (m.pb_has0 & 0x00000001) != 0 { n += 1 + pb_varint_size(pb_int32_to_u64(m.n)); }
    n += m.pb_unknown.len;
    return n;
}

// Frees what m owns and resets it to the empty message.
fn Book_Nested_clear(m: Book_Nested&) {
    m.n = 0;
    m.pb_has0 = 0;
    m.pb_unknown = pb_bytes_free(m.pb_unknown);
}

// Makes dst a deep copy of src, freeing what dst owned. The two share
// nothing afterwards. Neither may be a sub-message of the other.
fn Book_Nested_copy(dst: Book_Nested&, src: Book_Nested&) {
    if dst .== src { return; }
    Book_Nested_clear(dst);
    dst.n = src.n;
    dst.pb_has0 = src.pb_has0;
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
}

// Sets n and marks it present:
// it is encoded even when 0.
fn Book_Nested_set_n(m: Book_Nested&, v: i32) {
    m.n = v;
    m.pb_has0 |= 0x00000001;
}

fn Book_Nested_has_n(m: Book_Nested&) -> bool { return (m.pb_has0 & 0x00000001) != 0; }

fn Book_Nested_clear_n(m: Book_Nested&) {
    m.n = 0;
    m.pb_has0 &= 0xfffffffe;
