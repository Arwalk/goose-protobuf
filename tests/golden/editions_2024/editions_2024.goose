// A link to a Book_CountsEntry in Book_CountsEntry_pool, for sub-message fields.
struct Book_CountsEntry_Ref { m: Book_CountsEntry&<u32 in Book_CountsEntry_pool>? }
reusable var Book_CountsEntry_pool: Book_CountsEntry[>..] = [];
reusable[] var Book_CountsEntry_links: Book_CountsEntry_Ref[>..] = [];

// Merges the fields in r's window into m; on failure r.err is set.
// Fields it does not know, or with another wire type, are kept as
// unknown fields.
fn Book_CountsEntry_decode_from(r: pb_Reader&, m: Book_CountsEntry&) {
    var unknown_len: i64 = m.pb_unknown.len;
    let unknown_had: i64 = unknown_len;
    while r.pos < r.end {
        let start = r.pos;
        let tag = pb_read_tag(r);
        if r.err != PB_OK { break; }
        if tag == 10 {
            m.key = pb_read_string(r, m.key);
        } else if tag == 16 {
            m.value = pb_u64_to_int32(pb_read_varint(r));
        } else {
            pb_unknown_append(r, start, tag, m.pb_unknown, unknown_len, unknown_had);
        }
    }
    m.pb_unknown = pb_bytes_trim(m.pb_unknown, unknown_len);
}

// Merges buf into m. 0 on success, else a PB_ERR_* code; m then holds a
// partial message, which the caller clears.
fn Book_CountsEntry_decode(buf: const u8[:], m: Book_CountsEntry&) -> i32 {
    var r = pb_reader(buf);
    Book_CountsEntry_decode_from(r, m);
    return r.err;
}

// Appends m's wire encoding, Book_CountsEntry_size_of(m) bytes, to out.
fn Book_CountsEntry_encode(m: Book_CountsEntry&, out: u8[>..]&) {
    pb_write_varint(out, 10);
    pb_write_bytes(out, m.key);
    pb_write_varint(out, 16);
    pb_write_varint(out, pb_int32_to_u64(m.value));
    out.append(pb_run(pb_bytes, m.pb_unknown));
}

// The size of m's wire encoding, in bytes.
fn Book_CountsEntry_size_of(m: Book_CountsEntry&) -> i64 {
    var n: i64 = 0;
    n += 1 + pb_bytes_size(m.key);
    n += 1 + pb_varint_size(pb_int32_to_u64(m.value));
    n += m.pb_unknown.len;
    return n;
}

// Frees what m owns and resets it to the empty message.
fn Book_CountsEntry_clear(m: Book_CountsEntry&) {
    m.key = pb_bytes_free(m.key);
    m.value = 0;
    m.pb_unknown = pb_bytes_free(m.pb_unknown);
}

// Makes dst a deep copy of src, freeing what dst owned. The two share
// nothing afterwards. Neither may be a sub-message of the other.
fn Book_CountsEntry_copy(dst: Book_CountsEntry&, src: Book_CountsEntry&) {
    if dst .== src { return; }
    Book_CountsEntry_clear(dst);
    dst.key = pb_bytes_copy(src.key);
    dst.value = src.value;
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
}

// The contents of key, in pb_bytes: valid until it is next set or m
// is cleared.
fn Book_CountsEntry_key(m: Book_CountsEntry&) -> u8[:] { return pb_run(pb_bytes, m.key); }

// Sets key to a copy of v.
fn Book_CountsEntry_set_key(m: Book_CountsEntry&, v: const u8[:]) {
    m.key = pb_bytes_set(m.key, v);
}

// Runs of entries: one per map field of this type.
reusable[] var Book_CountsEntry_entries: Book_CountsEntry[>..] = [];

// The index of the entry with key k among the first `used` of run s, or -1.
fn Book_CountsEntry_find(s: pb_Span, used: i64, k: const u8[:]) -> i64 {
    let pb_run_s = pb_run(Book_CountsEntry_entries, s);
    for pb_i in used {
        if pb_run(pb_bytes, pb_run_s[pb_i].key) == k { return pb_i; }
    }
    return -1;
}

// The entry with key k in run s, added with the default value if there is none.
fn Book_CountsEntry_slot(s: pb_Span&, k: const u8[:]) -> Book_CountsEntry& {
    var pb_i = Book_CountsEntry_find(s, s.len, k);
    if pb_i < 0 {
        pb_i = s.len;
        s = pb_resize(Book_CountsEntry_entries, s, pb_i + 1);
        Book_CountsEntry_set_key(pb_run(Book_CountsEntry_entries, s)[pb_i], k);
    }
    return pb_run(Book_CountsEntry_entries, s)[pb_i];
}

// Settles an entry just decoded: a missing message value is an empty one,
// and unknown fields are dropped.
fn Book_CountsEntry_place(pb_e: Book_CountsEntry&) {
    pb_e.pb_unknown = pb_bytes_free(pb_e.pb_unknown);
}

// Run s with each repeated key folded: the last value wins, in the place of
// the first occurrence, and what the others held is freed. O(n log n).
// fold_maps calls it; decoding leaves repeated keys for it.
fn Book_CountsEntry_fold(s: pb_Span) -> pb_Span {
    if s.len < 2 { return s; }
    let pb_r = pb_run(Book_CountsEntry_entries, s);
    var pb_keys: pb_StrKey[>..] = [];
    for pb_i in pb_r.len { pb_keys.push(pb_StrKey { key: pb_r[pb_i].key, at: pb_i as! u32 }); }
    pb_sort_str_keys(pb_keys);
    var pb_gone: bool[>..] = [];
    var pb_i: i64 = 0;
    while pb_i < pb_keys.len {
        var pb_j = pb_i + 1;
        while pb_j < pb_keys.len && pb_same_str_key(pb_keys[pb_i], pb_keys[pb_j]) { pb_j++; }
        if pb_j - pb_i > 1 {
            if pb_gone.len == 0 { for pb_k in pb_r.len { pb_gone.push(false); } }
            let pb_first: i64 = pb_keys[pb_i].at;
            let pb_last: i64 = pb_keys[pb_j - 1].at;
            for pb_k in pb_j - pb_i - 1 {
                let pb_at: i64 = pb_keys[pb_i + pb_k].at;
                Book_CountsEntry_clear(pb_r[pb_at]);
                pb_gone[pb_at] = true;
            }
            pb_gone[pb_first] = false;
            pb_gone[pb_last] = true;
            pb_r[pb_first] = pb_r[pb_last];
            pb_r[pb_last] = Book_CountsEntry { .. };
        }
        pb_i = pb_j;
    }
    if pb_gone.len == 0 { return s; }
    var pb_kept: i64 = 0;
    for pb_k in pb_r.len {
        if pb_gone[pb_k] { continue; }
        if pb_kept != pb_k { pb_r[pb_kept] = pb_r[pb_k]; pb_r[pb_k] = Book_CountsEntry { .. }; }
        pb_kept++;
    }
    return pb_resize(Book_CountsEntry_entries, s, pb_kept);
}

// message ed24.legacy_name
struct legacy_name {
    Odd_Name: i32,
    pb_has0: u32,   // has-bits of fields with presence
    pb_unknown: pb_Span,   // unknown fields: raw wire bytes in pb_bytes
}

// A link to a legacy_name in legacy_name_pool, for sub-message fields.
struct legacy_name_Ref { m: legacy_name&<u32 in legacy_name_pool>? }
reusable var legacy_name_pool: legacy_name[>..] = [];
reusable[] var legacy_name_links: legacy_name_Ref[>..] = [];

// Merges the fields in r's window into m; on failure r.err is set.
// Fields it does not know, or with another wire type, are kept as
// unknown fields.
fn legacy_name_decode_from(r: pb_Reader&, m: legacy_name&) {
    var unknown_len: i64 = m.pb_unknown.len;
    let unknown_had: i64 = unknown_len;
    while r.pos < r.end {
        let start = r.pos;
        let tag = pb_read_tag(r);
        if r.err != PB_OK { break; }
        if tag == 8 {
            m.Odd_Name = pb_u64_to_int32(pb_read_varint(r));
            m.pb_has0 |= 0x00000001;
        } else {
            pb_unknown_append(r, start, tag, m.pb_unknown, unknown_len, unknown_had);
        }
    }
    m.pb_unknown = pb_bytes_trim(m.pb_unknown, unknown_len);
}

// Merges buf into m. 0 on success, else a PB_ERR_* code; m then holds a
// partial message, which the caller clears.
fn legacy_name_decode(buf: const u8[:], m: legacy_name&) -> i32 {
    var r = pb_reader(buf);
    legacy_name_decode_from(r, m);
    return r.err;
}

// Appends m's wire encoding, legacy_name_size_of(m) bytes, to out.
fn legacy_name_encode(m: legacy_name&, out: u8[>..]&) {
    if (m.pb_has0 & 0x00000001) != 0 {
        pb_write_varint(out, 8);
        pb_write_varint(out, pb_int32_to_u64(m.Odd_Name));
    }
    out.append(pb_run(pb_bytes, m.pb_unknown));
}

// The size of m's wire encoding, in bytes.
fn legacy_name_size_of(m: legacy_name&) -> i64 {
    var n: i64 = 0;
    if (m.pb_has0 & 0x00000001) != 0 { n += 1 + pb_varint_size(pb_int32_to_u64(m.Odd_Name)); }
    n += m.pb_unknown.len;
    return n;
}

// Frees what m owns and resets it to the empty message.
fn legacy_name_clear(m: legacy_name&) {
    m.Odd_Name = 0;
    m.pb_has0 = 0;
    m.pb_unknown = pb_bytes_free(m.pb_unknown);
}

// Makes dst a deep copy of src, freeing what dst owned. The two share
// nothing afterwards. Neither may be a sub-message of the other.
fn legacy_name_copy(dst: legacy_name&, src: legacy_name&) {
    if dst .== src { return; }
    legacy_name_clear(dst);
    dst.Odd_Name = src.Odd_Name;
    dst.pb_has0 = src.pb_has0;
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
}

// Sets Odd_Name and marks it present:
// it is encoded even when 0.
fn legacy_name_set_Odd_Name(m: legacy_name&, v: i32) {
    m.Odd_Name = v;
    m.pb_has0 |= 0x00000001;
}

fn legacy_name_has_Odd_Name(m: legacy_name&) -> bool { return (m.pb_has0 & 0x00000001) != 0; }

fn legacy_name_clear_Odd_Name(m: legacy_name&) {
    m.Odd_Name = 0;
    m.pb_has0 &= 0xfffffffe;
}
