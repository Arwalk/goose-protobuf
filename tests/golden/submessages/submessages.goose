// Makes dst a deep copy of src, freeing what dst owned. The two share
// nothing afterwards. Neither may be a sub-message of the other.
fn Inner_copy(dst: Inner&, src: Inner&) {
    if dst .== src { return; }
    Inner_clear(dst);
    dst.a = src.a;
    dst.s = pb_bytes_copy(src.s);
    dst.o = src.o;
    let pb_f4 = src.leaf.m;
    if pb_f4 { Leaf_copy(Inner_mutable_leaf(dst), pb_f4); }
    dst.pb_has0 = src.pb_has0;
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
}

// The contents of s, in pb_bytes: valid until it is next set or m
// is cleared.
fn Inner_s(m: Inner&) -> u8[:] { return pb_run(pb_bytes, m.s); }

// Sets s to a copy of v.
fn Inner_set_s(m: Inner&, v: const u8[:]) {
    m.s = pb_bytes_set(m.s, v);
}

// Sets o and marks it present:
// it is encoded even when 0.
fn Inner_set_o(m: Inner&, v: i32) {
    m.o = v;
    m.pb_has0 |= 0x00000001;
}

fn Inner_has_o(m: Inner&) -> bool { return (m.pb_has0 & 0x00000001) != 0; }

fn Inner_clear_o(m: Inner&) {
    m.o = 0;
    m.pb_has0 &= 0xfffffffe;
}

// The sub-message leaf, or null if it is not set. Valid until it or m is
// cleared.
fn Inner_leaf(m: Inner&) -> Leaf&? { return m.leaf.m; }

// The sub-message leaf, set to an empty one first if it is not set.
fn Inner_mutable_leaf(m: Inner&) -> Leaf& {
    let pb_sub = m.leaf.m;
    if pb_sub { return pb_sub; }
    let pb_new .= Leaf_pool.alloc_ref(Leaf { .. });
    m.leaf.m .= pb_new;
    return pb_new;
}

fn Inner_has_leaf(m: Inner&) -> bool { return m.leaf.m != null; }

// Frees the sub-message leaf and everything it owns.
fn Inner_clear_leaf(m: Inner&) {
    let pb_sub = m.leaf.m;
    guard pb_sub else { return; }
    Leaf_clear(pb_sub);
    Leaf_pool.free(Leaf_pool.index_of(pb_sub));
    m.leaf.m .= null;
}

// message submessages.Leaf
struct Leaf {
    x: i32,
    y: i32,
    pb_unknown: pb_Span,   // unknown fields: raw wire bytes in pb_bytes
}

// A link to a Leaf in Leaf_pool, for sub-message fields.
struct Leaf_Ref { m: Leaf&<u32 in Leaf_pool>? }
reusable var Leaf_pool: Leaf[>..] = [];
reusable[] var Leaf_links: Leaf_Ref[>..] = [];

// Merges the fields in r's window into m; on failure r.err is set.
// Fields it does not know, or with another wire type, are kept as
// unknown fields.
fn Leaf_decode_from(r: pb_Reader&, m: Leaf&) {
    var unknown_len: i64 = m.pb_unknown.len;
    while r.pos < r.end {
        let start = r.pos;
        let tag = pb_read_tag(r);
        if r.err != PB_OK { break; }
        if tag == 8 {
            m.x = pb_u64_to_int32(pb_read_varint(r));
        } else if tag == 16 {
            m.y = pb_u64_to_int32(pb_read_varint(r));
        } else {
            pb_unknown_append(r, start, tag, m.pb_unknown, unknown_len);
        }
    }
    m.pb_unknown = pb_bytes_trim(m.pb_unknown, unknown_len);
}

// Merges buf into m. 0 on success, else a PB_ERR_* code; m then holds a
// partial message, which the caller clears.
fn Leaf_decode(buf: const u8[:], m: Leaf&) -> i32 {
    var r = pb_reader(buf);
    Leaf_decode_from(r, m);
    return r.err;
}

// Appends m's wire encoding, Leaf_size_of(m) bytes, to out.
fn Leaf_encode(m: Leaf&, out: u8[>..]&) {
    if m.x != 0 {
        pb_write_varint(out, 8);
        pb_write_varint(out, pb_int32_to_u64(m.x));
    }
    if m.y != 0 {
        pb_write_varint(out, 16);
        pb_write_varint(out, pb_int32_to_u64(m.y));
    }
    out.append(pb_run(pb_bytes, m.pb_unknown));
}

// The size of m's wire encoding, in bytes.
fn Leaf_size_of(m: Leaf&) -> i64 {
    var n: i64 = 0;
    if m.x != 0 { n += 1 + pb_varint_size(pb_int32_to_u64(m.x)); }
    if m.y != 0 { n += 1 + pb_varint_size(pb_int32_to_u64(m.y)); }
    n += m.pb_unknown.len;
    return n;
}

// Frees what m owns and resets it to the empty message.
fn Leaf_clear(m: Leaf&) {
    m.x = 0;
    m.y = 0;
    m.pb_unknown = pb_bytes_free(m.pb_unknown);
}

// Makes dst a deep copy of src, freeing what dst owned. The two share
// nothing afterwards. Neither may be a sub-message of the other.
fn Leaf_copy(dst: Leaf&, src: Leaf&) {
    if dst .== src { return; }
    Leaf_clear(dst);
    dst.x = src.x;
    dst.y = src.y;
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
}

// message submessages.n
struct n {
    r: i32,
    pb_unknown: pb_Span,   // unknown fields: raw wire bytes in pb_bytes
}

// A link to a n in n_pool, for sub-message fields.
struct n_Ref { m: n&<u32 in n_pool>? }
reusable var n_pool: n[>..] = [];
reusable[] var n_links: n_Ref[>..] = [];

// Merges the fields in r's window into m; on failure r.err is set.
// Fields it does not know, or with another wire type, are kept as
// unknown fields.
fn n_decode_from(r: pb_Reader&, m: n&) {
    var unknown_len: i64 = m.pb_unknown.len;
    while r.pos < r.end {
        let start = r.pos;
        let tag = pb_read_tag(r);
        if r.err != PB_OK { break; }
        if tag == 8 {
            m.r = pb_u64_to_int32(pb_read_varint(r));
        } else {
            pb_unknown_append(r, start, tag, m.pb_unknown, unknown_len);
        }
    }
    m.pb_unknown = pb_bytes_trim(m.pb_unknown, unknown_len);
}

// Merges buf into m. 0 on success, else a PB_ERR_* code; m then holds a
// partial message, which the caller clears.
fn n_decode(buf: const u8[:], m: n&) -> i32 {
    var r = pb_reader(buf);
    n_decode_from(r, m);
    return r.err;
}

// Appends m's wire encoding, n_size_of(m) bytes, to out.
fn n_encode(m: n&, out: u8[>..]&) {
    if m.r != 0 {
        pb_write_varint(out, 8);
        pb_write_varint(out, pb_int32_to_u64(m.r));
    }
    out.append(pb_run(pb_bytes, m.pb_unknown));
}

// The size of m's wire encoding, in bytes.
fn n_size_of(m: n&) -> i64 {
    var n: i64 = 0;
    if m.r != 0 { n += 1 + pb_varint_size(pb_int32_to_u64(m.r)); }
    n += m.pb_unknown.len;
    return n;
}

// Frees what m owns and resets it to the empty message.
fn n_clear(m: n&) {
    m.r = 0;
    m.pb_unknown = pb_bytes_free(m.pb_unknown);
}

// Makes dst a deep copy of src, freeing what dst owned. The two share
// nothing afterwards. Neither may be a sub-message of the other.
fn n_copy(dst: n&, src: n&) {
    if dst .== src { return; }
    n_clear(dst);
    dst.r = src.r;
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
}
