    }
    if m.fars.len > 0 {
        for pb_v in pb_run(pb_i32s, m.fars) {
            pb_write_varint(out, 96);
            pb_write_varint(out, pb_int32_to_u64(pb_v));
        }
    }
    out.append(pb_run(pb_bytes, m.pb_unknown));
}

// The size of m's wire encoding, in bytes.
fn Lists_size_of(m: Lists&) -> i64 {
    var n: i64 = 0;
    if m.ints.len > 0 {
        var pb_n: i64 = 0;
        for pb_v in pb_run(pb_i32s, m.ints) { pb_n += pb_varint_size(pb_int32_to_u64(pb_v)); }
        n += 1 * m.ints.len + pb_n;
    }
    if m.packed_ints.len > 0 {
        var pb_n: i64 = 0;
        for pb_v in pb_run(pb_i32s, m.packed_ints) { pb_n += pb_varint_size(pb_int32_to_u64(pb_v)); }
        n += 1 + pb_len_size(pb_n);
    }
    for pb_v in pb_run(pb_spans, m.strs) { n += 1 + pb_bytes_size(pb_v); }
    for pb_v in pb_run(pb_spans, m.byts) { n += 1 + pb_bytes_size(pb_v); }
    for pb_ref in pb_run(Sub_links, m.subs) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        n += 1 + pb_len_size(Sub_size_of(pb_l));
    }
    if m.colors.len > 0 {
        var pb_n: i64 = 0;
        for pb_v in pb_run(pb_i32s, m.colors) { pb_n += pb_varint_size(pb_int32_to_u64(pb_v)); }
        n += 1 * m.colors.len + pb_n;
    }
    if m.packed_colors.len > 0 {
        var pb_n: i64 = 0;
        for pb_v in pb_run(pb_i32s, m.packed_colors) { pb_n += pb_varint_size(pb_int32_to_u64(pb_v)); }
        n += 1 + pb_len_size(pb_n);
    }
    if m.doubles.len > 0 {
        let pb_n: i64 = 8 * m.doubles.len;
        n += 1 * m.doubles.len + pb_n;
    }
    if m.packed_doubles.len > 0 {
        let pb_n: i64 = 8 * m.packed_doubles.len;
        n += 1 + pb_len_size(pb_n);
    }
    if m.zigs.len > 0 {
        var pb_n: i64 = 0;
        for pb_v in pb_run(pb_i32s, m.zigs) { pb_n += pb_varint_size(pb_zigzag32(pb_v)); }
        n += 1 * m.zigs.len + pb_n;
    }
    if m.bools.len > 0 {
        let pb_n: i64 = 1 * m.bools.len;
        n += 1 + pb_len_size(pb_n);
    }
    if m.fars.len > 0 {
        var pb_n: i64 = 0;
        for pb_v in pb_run(pb_i32s, m.fars) { pb_n += pb_varint_size(pb_int32_to_u64(pb_v)); }
        n += 1 * m.fars.len + pb_n;
    }
    n += m.pb_unknown.len;
    return n;
}

// Frees what m owns and resets it to the empty message.
fn Lists_clear(m: Lists&) {
    m.ints = pb_resize(pb_i32s, m.ints, 0);
    m.packed_ints = pb_resize(pb_i32s, m.packed_ints, 0);
    m.strs = pb_spans_free(m.strs);
    m.byts = pb_spans_free(m.byts);
    Lists_clear_subs(m);
    m.colors = pb_resize(pb_i32s, m.colors, 0);
    m.packed_colors = pb_resize(pb_i32s, m.packed_colors, 0);
    m.doubles = pb_resize(pb_f64s, m.doubles, 0);
    m.packed_doubles = pb_resize(pb_f64s, m.packed_doubles, 0);
    m.zigs = pb_resize(pb_i32s, m.zigs, 0);
    m.bools = pb_resize(pb_bools, m.bools, 0);
    m.fars = pb_resize(pb_i32s, m.fars, 0);
    m.pb_unknown = pb_bytes_free(m.pb_unknown);
}

// Makes dst a deep copy of src, freeing what dst owned. The two share
// nothing afterwards. Neither may be a sub-message of the other.
fn Lists_copy(dst: Lists&, src: Lists&) {
    if dst .== src { return; }
    Lists_clear(dst);
    dst.ints = pb_copy_run(pb_i32s, src.ints);
    dst.packed_ints = pb_copy_run(pb_i32s, src.packed_ints);
    dst.strs = pb_spans_copy(src.strs);
    dst.byts = pb_spans_copy(src.byts);
    dst.subs = pb_resize(Sub_links, dst.subs, src.subs.len);
    for pb_i in src.subs.len {
        let pb_l = pb_run(Sub_links, src.subs)[pb_i].m;
        guard pb_l else { continue; }
        let pb_c .= Sub_pool.alloc_ref(Sub { .. });
        pb_run(Sub_links, dst.subs)[pb_i].m .= pb_c;
        Sub_copy(pb_c, pb_l);
    }
    dst.colors = pb_copy_run(pb_i32s, src.colors);
    dst.packed_colors = pb_copy_run(pb_i32s, src.packed_colors);
    dst.doubles = pb_copy_run(pb_f64s, src.doubles);
    dst.packed_doubles = pb_copy_run(pb_f64s, src.packed_doubles);
    dst.zigs = pb_copy_run(pb_i32s, src.zigs);
    dst.bools = pb_copy_run(pb_bools, src.bools);
    dst.fars = pb_copy_run(pb_i32s, src.fars);
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
}

// The number of values of ints.
fn Lists_ints_len(m: Lists&) -> i64 { return m.ints.len; }

// The values of ints, in pb_i32s: valid until it is next changed or m is
// cleared.
fn Lists_ints(m: Lists&) -> i32[:] { return pb_run(pb_i32s, m.ints); }

fn Lists_ints_at(m: Lists&, i: i64) -> i32 { return pb_run(pb_i32s, m.ints)[i]; }

// Adds a value to ints. This moves its values, so Lists_set_ints is better for many.
fn Lists_add_ints(m: Lists&, v: i32) { m.ints = pb_add(pb_i32s, m.ints, v); }

// Sets ints to a copy of v.
fn Lists_set_ints(m: Lists&, v: const i32[:]) { m.ints = pb_set_run(pb_i32s, m.ints, v); }

fn Lists_clear_ints(m: Lists&) { m.ints = pb_resize(pb_i32s, m.ints, 0); }

// The number of values of packed_ints.
fn Lists_packed_ints_len(m: Lists&) -> i64 { return m.packed_ints.len; }

// The values of packed_ints, in pb_i32s: valid until it is next changed or m is
// cleared.
fn Lists_packed_ints(m: Lists&) -> i32[:] { return pb_run(pb_i32s, m.packed_ints); }

fn Lists_packed_ints_at(m: Lists&, i: i64) -> i32 { return pb_run(pb_i32s, m.packed_ints)[i]; }

// Adds a value to packed_ints. This moves its values, so Lists_set_packed_ints is better for many.
fn Lists_add_packed_ints(m: Lists&, v: i32) { m.packed_ints = pb_add(pb_i32s, m.packed_ints, v); }

// Sets packed_ints to a copy of v.
fn Lists_set_packed_ints(m: Lists&, v: const i32[:]) { m.packed_ints = pb_set_run(pb_i32s, m.packed_ints, v); }

fn Lists_clear_packed_ints(m: Lists&) { m.packed_ints = pb_resize(pb_i32s, m.packed_ints, 0); }

// The number of values of strs.
fn Lists_strs_len(m: Lists&) -> i64 { return m.strs.len; }

// The contents of value i of strs, in pb_bytes: valid until it is next
// set or m is cleared.
fn Lists_strs_at(m: Lists&, i: i64) -> u8[:] { return pb_run(pb_bytes, pb_run(pb_spans, m.strs)[i]); }

// Adds a copy of v to strs.
fn Lists_add_strs(m: Lists&, v: const u8[:]) { m.strs = pb_spans_add(m.strs, v); }

// Sets value i of strs to a copy of v.
fn Lists_set_strs(m: Lists&, i: i64, v: const u8[:]) { pb_spans_set(m.strs, i, v); }

fn Lists_clear_strs(m: Lists&) { m.strs = pb_spans_free(m.strs); }

// The number of values of byts.
fn Lists_byts_len(m: Lists&) -> i64 { return m.byts.len; }

// The contents of value i of byts, in pb_bytes: valid until it is next
// set or m is cleared.
fn Lists_byts_at(m: Lists&, i: i64) -> u8[:] { return pb_run(pb_bytes, pb_run(pb_spans, m.byts)[i]); }

// Adds a copy of v to byts.
fn Lists_add_byts(m: Lists&, v: const u8[:]) { m.byts = pb_spans_add(m.byts, v); }

// Sets value i of byts to a copy of v.
fn Lists_set_byts(m: Lists&, i: i64, v: const u8[:]) { pb_spans_set(m.byts, i, v); }

fn Lists_clear_byts(m: Lists&) { m.byts = pb_spans_free(m.byts); }

// The number of messages of subs.
fn Lists_subs_len(m: Lists&) -> i64 { return m.subs.len; }

// Message i of subs. Valid until it or m is cleared.
fn Lists_subs_at(m: Lists&, i: i64) -> Sub& {
    let pb_l = pb_run(Sub_links, m.subs)[i].m;
    assert(pb_l);
    return pb_l;
}

// Adds an empty message to subs and returns it.
fn Lists_add_subs(m: Lists&) -> Sub& {
    let pb_i: i64 = m.subs.len;
    m.subs = pb_resize(Sub_links, m.subs, pb_i + 1);
    let pb_new .= Sub_pool.alloc_ref(Sub { .. });
    pb_run(Sub_links, m.subs)[pb_i].m .= pb_new;
    return pb_new;
}

// Frees the messages of subs and everything they own.
fn Lists_clear_subs(m: Lists&) {
    for pb_ref in pb_run(Sub_links, m.subs) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        Sub_clear(pb_l);
        Sub_pool.free(Sub_pool.index_of(pb_l));
    }
    m.subs = pb_resize(Sub_links, m.subs, 0);
}

// The number of values of colors.
fn Lists_colors_len(m: Lists&) -> i64 { return m.colors.len; }

// The values of colors, in pb_i32s: valid until it is next changed or m is
