fn Lists_doubles(m: Lists&) -> f64[:] { return pb_run(pb_f64s, m.doubles); }

fn Lists_doubles_at(m: Lists&, i: i64) -> f64 { return pb_run(pb_f64s, m.doubles)[i]; }

// Adds a value to doubles. This moves its values, so Lists_set_doubles is better for many.
fn Lists_add_doubles(m: Lists&, v: f64) { m.doubles = pb_add(pb_f64s, m.doubles, v); }

// Sets doubles to a copy of v.
fn Lists_set_doubles(m: Lists&, v: const f64[:]) { m.doubles = pb_set_run(pb_f64s, m.doubles, v); }

fn Lists_clear_doubles(m: Lists&) { m.doubles = pb_resize(pb_f64s, m.doubles, 0); }

// The number of values of packed_doubles.
fn Lists_packed_doubles_len(m: Lists&) -> i64 { return m.packed_doubles.len; }

// The values of packed_doubles, in pb_f64s: valid until it is next changed or m is
// cleared.
fn Lists_packed_doubles(m: Lists&) -> f64[:] { return pb_run(pb_f64s, m.packed_doubles); }

fn Lists_packed_doubles_at(m: Lists&, i: i64) -> f64 { return pb_run(pb_f64s, m.packed_doubles)[i]; }

// Adds a value to packed_doubles. This moves its values, so Lists_set_packed_doubles is better for many.
fn Lists_add_packed_doubles(m: Lists&, v: f64) { m.packed_doubles = pb_add(pb_f64s, m.packed_doubles, v); }

// Sets packed_doubles to a copy of v.
fn Lists_set_packed_doubles(m: Lists&, v: const f64[:]) { m.packed_doubles = pb_set_run(pb_f64s, m.packed_doubles, v); }

fn Lists_clear_packed_doubles(m: Lists&) { m.packed_doubles = pb_resize(pb_f64s, m.packed_doubles, 0); }

// The number of values of zigs.
fn Lists_zigs_len(m: Lists&) -> i64 { return m.zigs.len; }

// The values of zigs, in pb_i32s: valid until it is next changed or m is
// cleared.
fn Lists_zigs(m: Lists&) -> i32[:] { return pb_run(pb_i32s, m.zigs); }

fn Lists_zigs_at(m: Lists&, i: i64) -> i32 { return pb_run(pb_i32s, m.zigs)[i]; }

// Adds a value to zigs. This moves its values, so Lists_set_zigs is better for many.
fn Lists_add_zigs(m: Lists&, v: i32) { m.zigs = pb_add(pb_i32s, m.zigs, v); }

