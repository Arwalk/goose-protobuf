// Merges buf into m. 0 on success, else a PB_ERR_* code; m then holds a
// partial message, which the caller clears.
fn Maps_NamesEntry_decode(buf: const u8[:], m: Maps_NamesEntry&) -> i32 {
    var r = pb_reader(buf);
    Maps_NamesEntry_decode_from(r, m);
    return r.err;
}

// Appends m's wire encoding, Maps_NamesEntry_size_of(m) bytes, to out.
fn Maps_NamesEntry_encode(m: Maps_NamesEntry&, out: u8[>..]&) {
    pb_write_varint(out, 8);
    pb_write_varint(out, pb_int32_to_u64(m.key));
    pb_write_varint(out, 18);
    pb_write_bytes(out, m.value);
    out.append(pb_run(pb_bytes, m.pb_unknown));
}

// The size of m's wire encoding, in bytes.
fn Maps_NamesEntry_size_of(m: Maps_NamesEntry&) -> i64 {
    var n: i64 = 0;
    n += 1 + pb_varint_size(pb_int32_to_u64(m.key));
    n += 1 + pb_bytes_size(m.value);
    n += m.pb_unknown.len;
    return n;
}

// Frees what m owns and resets it to the empty message.
fn Maps_NamesEntry_clear(m: Maps_NamesEntry&) {
    m.key = 0;
    m.value = pb_bytes_free(m.value);
    m.pb_unknown = pb_bytes_free(m.pb_unknown);
}

// Makes dst a deep copy of src, freeing what dst owned. The two share
// nothing afterwards. Neither may be a sub-message of the other.
fn Maps_NamesEntry_copy(dst: Maps_NamesEntry&, src: Maps_NamesEntry&) {
    if dst .== src { return; }
    Maps_NamesEntry_clear(dst);
    dst.key = src.key;
    dst.value = pb_bytes_copy(src.value);
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
}

// The contents of value, in pb_bytes: valid until it is next set or m
// is cleared.
fn Maps_NamesEntry_value(m: Maps_NamesEntry&) -> u8[:] { return pb_run(pb_bytes, m.value); }

// Sets value to a copy of v.
fn Maps_NamesEntry_set_value(m: Maps_NamesEntry&, v: const u8[:]) {
    m.value = pb_bytes_set(m.value, v);
}

// Runs of entries: one per map field of this type.
reusable[] var Maps_NamesEntry_entries: Maps_NamesEntry[>..] = [];

// The index of the entry with key k among the first `used` of run s, or -1.
fn Maps_NamesEntry_find(s: pb_Span, used: i64, k: i32) -> i64 {
    let pb_run_s = pb_run(Maps_NamesEntry_entries, s);
    for pb_i in used {
        if pb_run_s[pb_i].key == k { return pb_i; }
    }
    return -1;
}

// The entry with key k in run s, added with the default value if there is none.
fn Maps_NamesEntry_slot(s: pb_Span&, k: i32) -> Maps_NamesEntry& {
    var pb_i = Maps_NamesEntry_find(s, s.len, k);
    if pb_i < 0 {
        pb_i = s.len;
        s = pb_resize(Maps_NamesEntry_entries, s, pb_i + 1);
        pb_run(Maps_NamesEntry_entries, s)[pb_i].key = k;
    }
    return pb_run(Maps_NamesEntry_entries, s)[pb_i];
}

// Settles an entry just decoded: a missing message value is an empty one,
// and unknown fields are dropped.
fn Maps_NamesEntry_place(pb_e: Maps_NamesEntry&) {
    pb_e.pb_unknown = pb_bytes_free(pb_e.pb_unknown);
}

// Run s with each repeated key folded: the last value wins, in the place of
// the first occurrence, and what the others held is freed. O(n log n).
// fold_maps calls it; decoding leaves repeated keys for it.
fn Maps_NamesEntry_fold(s: pb_Span) -> pb_Span {
    if s.len < 2 { return s; }
    let pb_r = pb_run(Maps_NamesEntry_entries, s);
    var pb_keys: pb_NumKey[>..] = [];
    for pb_i in pb_r.len { pb_keys.push(pb_NumKey { key: pb_r[pb_i].key as! u64, at: pb_i as! u32 }); }
    pb_sort_num_keys(pb_keys);
    var pb_gone: bool[>..] = [];
    var pb_i: i64 = 0;
    while pb_i < pb_keys.len {
        var pb_j = pb_i + 1;
        while pb_j < pb_keys.len && pb_same_num_key(pb_keys[pb_i], pb_keys[pb_j]) { pb_j++; }
        if pb_j - pb_i > 1 {
            if pb_gone.len == 0 { for pb_k in pb_r.len { pb_gone.push(false); } }
            let pb_first: i64 = pb_keys[pb_i].at;
            let pb_last: i64 = pb_keys[pb_j - 1].at;
            for pb_k in pb_j - pb_i - 1 {
                let pb_at: i64 = pb_keys[pb_i + pb_k].at;
                Maps_NamesEntry_clear(pb_r[pb_at]);
                pb_gone[pb_at] = true;
            }
            pb_gone[pb_first] = false;
            pb_gone[pb_last] = true;
            pb_r[pb_first] = pb_r[pb_last];
            pb_r[pb_last] = Maps_NamesEntry { .. };
        }
        pb_i = pb_j;
    }
    if pb_gone.len == 0 { return s; }
    var pb_kept: i64 = 0;
    for pb_k in pb_r.len {
        if pb_gone[pb_k] { continue; }
        if pb_kept != pb_k { pb_r[pb_kept] = pb_r[pb_k]; pb_r[pb_k] = Maps_NamesEntry { .. }; }
        pb_kept++;
    }
    return pb_resize(Maps_NamesEntry_entries, s, pb_kept);
}

// message c2.Maps.SubsEntry
struct Maps_SubsEntry {
    key: pb_Span,
    value: Sub_Ref,
    pb_unknown: pb_Span,   // unknown fields: raw wire bytes in pb_bytes
}

// A link to a Maps_SubsEntry in Maps_SubsEntry_pool, for sub-message fields.
struct Maps_SubsEntry_Ref { m: Maps_SubsEntry&<u32 in Maps_SubsEntry_pool>? }
reusable var Maps_SubsEntry_pool: Maps_SubsEntry[>..] = [];
reusable[] var Maps_SubsEntry_links: Maps_SubsEntry_Ref[>..] = [];

// Merges the fields in r's window into m; on failure r.err is set.
// Fields it does not know, or with another wire type, are kept as
// unknown fields.
fn Maps_SubsEntry_decode_from(r: pb_Reader&, m: Maps_SubsEntry&) {
    var unknown_len: i64 = m.pb_unknown.len;
    let unknown_had: i64 = unknown_len;
    while r.pos < r.end {
        let start = r.pos;
        let tag = pb_read_tag(r);
        if r.err != PB_OK { break; }
        if tag == 10 {
            m.key = pb_read_bytes(r, m.key);
        } else if tag == 18 {
            pb_charge(r, 40);
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            if r.depth >= PB_MAX_DEPTH { pb_fail(r, PB_ERR_DEPTH); break; }
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            r.depth++;
            Sub_decode_from(r, Maps_SubsEntry_mutable_value(m));
            if r.err != PB_OK { break; }
            r.depth--;
            r.end = pb_outer;
        } else {
            pb_unknown_append(r, start, tag, m.pb_unknown, unknown_len, unknown_had);
        }
    }
    m.pb_unknown = pb_bytes_trim(m.pb_unknown, unknown_len);
}

// Merges buf into m. 0 on success, else a PB_ERR_* code; m then holds a
// partial message, which the caller clears.
fn Maps_SubsEntry_decode(buf: const u8[:], m: Maps_SubsEntry&) -> i32 {
    var r = pb_reader(buf);
    Maps_SubsEntry_decode_from(r, m);
    return r.err;
}

// Appends m's wire encoding, Maps_SubsEntry_size_of(m) bytes, to out.
fn Maps_SubsEntry_encode(m: Maps_SubsEntry&, out: u8[>..]&) {
    pb_write_varint(out, 10);
    pb_write_bytes(out, m.key);
    let pb_f2 = m.value.m;
    if pb_f2 {
        pb_write_varint(out, 18);
        pb_write_varint(out, Sub_size_of(pb_f2) as! u64);
        Sub_encode(pb_f2, out);
    }
    out.append(pb_run(pb_bytes, m.pb_unknown));
}

// The size of m's wire encoding, in bytes.
fn Maps_SubsEntry_size_of(m: Maps_SubsEntry&) -> i64 {
    var n: i64 = 0;
    n += 1 + pb_bytes_size(m.key);
    let pb_f2 = m.value.m;
    if pb_f2 { n += 1 + pb_len_size(Sub_size_of(pb_f2)); }
    n += m.pb_unknown.len;
    return n;
}

// Frees what m owns and resets it to the empty message.
fn Maps_SubsEntry_clear(m: Maps_SubsEntry&) {
    m.key = pb_bytes_free(m.key);
    Maps_SubsEntry_clear_value(m);
    m.pb_unknown = pb_bytes_free(m.pb_unknown);
}

// Makes dst a deep copy of src, freeing what dst owned. The two share
// nothing afterwards. Neither may be a sub-message of the other.
fn Maps_SubsEntry_copy(dst: Maps_SubsEntry&, src: Maps_SubsEntry&) {
    if dst .== src { return; }
    Maps_SubsEntry_clear(dst);
    dst.key = pb_bytes_copy(src.key);
    let pb_f2 = src.value.m;
    if pb_f2 { Sub_copy(Maps_SubsEntry_mutable_value(dst), pb_f2); }
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
}

// The contents of key, in pb_bytes: valid until it is next set or m
// is cleared.
fn Maps_SubsEntry_key(m: Maps_SubsEntry&) -> u8[:] { return pb_run(pb_bytes, m.key); }

// Sets key to a copy of v.
fn Maps_SubsEntry_set_key(m: Maps_SubsEntry&, v: const u8[:]) {
    m.key = pb_bytes_set(m.key, v);
}

// The sub-message value, or null if it is not set. Valid until it or m is
// cleared.
fn Maps_SubsEntry_value(m: Maps_SubsEntry&) -> Sub&? { return m.value.m; }

// The sub-message value, set to an empty one first if it is not set.
fn Maps_SubsEntry_mutable_value(m: Maps_SubsEntry&) -> Sub& {
    let pb_sub = m.value.m;
    if pb_sub { return pb_sub; }
    let pb_new .= Sub_pool.alloc_ref(Sub { .. });
    m.value.m .= pb_new;
    return pb_new;
}

fn Maps_SubsEntry_has_value(m: Maps_SubsEntry&) -> bool { return m.value.m != null; }

// Frees the sub-message value and everything it owns.
fn Maps_SubsEntry_clear_value(m: Maps_SubsEntry&) {
    let pb_sub = m.value.m;
    guard pb_sub else { return; }
    Sub_clear(pb_sub);
    Sub_pool.free(Sub_pool.index_of(pb_sub));
    m.value.m .= null;
}

// Runs of entries: one per map field of this type.
reusable[] var Maps_SubsEntry_entries: Maps_SubsEntry[>..] = [];

// The index of the entry with key k among the first `used` of run s, or -1.
fn Maps_SubsEntry_find(s: pb_Span, used: i64, k: const u8[:]) -> i64 {
    let pb_run_s = pb_run(Maps_SubsEntry_entries, s);
    for pb_i in used {
        if pb_run(pb_bytes, pb_run_s[pb_i].key) == k { return pb_i; }
    }
    return -1;
}

// The entry with key k in run s, added with the default value if there is none.
fn Maps_SubsEntry_slot(s: pb_Span&, k: const u8[:]) -> Maps_SubsEntry& {
    var pb_i = Maps_SubsEntry_find(s, s.len, k);
    if pb_i < 0 {
        pb_i = s.len;
        s = pb_resize(Maps_SubsEntry_entries, s, pb_i + 1);
        Maps_SubsEntry_set_key(pb_run(Maps_SubsEntry_entries, s)[pb_i], k);
        Maps_SubsEntry_mutable_value(pb_run(Maps_SubsEntry_entries, s)[pb_i]);
    }
    return pb_run(Maps_SubsEntry_entries, s)[pb_i];
}

// Settles an entry just decoded: a missing message value is an empty one,
// and unknown fields are dropped.
fn Maps_SubsEntry_place(pb_e: Maps_SubsEntry&) {
    Maps_SubsEntry_mutable_value(pb_e);
    pb_e.pb_unknown = pb_bytes_free(pb_e.pb_unknown);
}

// Run s with each repeated key folded: the last value wins, in the place of
// the first occurrence, and what the others held is freed. O(n log n).
// fold_maps calls it; decoding leaves repeated keys for it.
fn Maps_SubsEntry_fold(s: pb_Span) -> pb_Span {
    if s.len < 2 { return s; }
    let pb_r = pb_run(Maps_SubsEntry_entries, s);
    var pb_keys: pb_StrKey[>..] = [];
    for pb_i in pb_r.len { pb_keys.push(pb_StrKey { key: pb_r[pb_i].key, at: pb_i as! u32 }); }
    pb_sort_str_keys(pb_keys);
    var pb_gone: bool[>..] = [];
    var pb_i: i64 = 0;
    while pb_i < pb_keys.len {
        var pb_j = pb_i + 1;
        while pb_j < pb_keys.len && pb_same_str_key(pb_keys[pb_i], pb_keys[pb_j]) { pb_j++; }
        if pb_j - pb_i > 1 {
            if pb_gone.len == 0 { for pb_k in pb_r.len { pb_gone.push(false); } }
            let pb_first: i64 = pb_keys[pb_i].at;
            let pb_last: i64 = pb_keys[pb_j - 1].at;
            for pb_k in pb_j - pb_i - 1 {
                let pb_at: i64 = pb_keys[pb_i + pb_k].at;
                Maps_SubsEntry_clear(pb_r[pb_at]);
                pb_gone[pb_at] = true;
            }
            pb_gone[pb_first] = false;
            pb_gone[pb_last] = true;
            pb_r[pb_first] = pb_r[pb_last];
            pb_r[pb_last] = Maps_SubsEntry { .. };
        }
        pb_i = pb_j;
    }
    if pb_gone.len == 0 { return s; }
    var pb_kept: i64 = 0;
    for pb_k in pb_r.len {
        if pb_gone[pb_k] { continue; }
        if pb_kept != pb_k { pb_r[pb_kept] = pb_r[pb_k]; pb_r[pb_k] = Maps_SubsEntry { .. }; }
        pb_kept++;
    }
    return pb_resize(Maps_SubsEntry_entries, s, pb_kept);
}

// message c2.Maps.ColorsEntry
struct Maps_ColorsEntry {
    key: i32,
    value: i32,
    pb_unknown: pb_Span,   // unknown fields: raw wire bytes in pb_bytes
}

// A link to a Maps_ColorsEntry in Maps_ColorsEntry_pool, for sub-message fields.
struct Maps_ColorsEntry_Ref { m: Maps_ColorsEntry&<u32 in Maps_ColorsEntry_pool>? }
reusable var Maps_ColorsEntry_pool: Maps_ColorsEntry[>..] = [];
reusable[] var Maps_ColorsEntry_links: Maps_ColorsEntry_Ref[>..] = [];

// Merges the fields in r's window into m; on failure r.err is set.
// Fields it does not know, or with another wire type, are kept as
// unknown fields.
fn Maps_ColorsEntry_decode_from(r: pb_Reader&, m: Maps_ColorsEntry&) {
    var unknown_len: i64 = m.pb_unknown.len;
    let unknown_had: i64 = unknown_len;
    while r.pos < r.end {
        let start = r.pos;
        let tag = pb_read_tag(r);
        if r.err != PB_OK { break; }
        if tag == 8 {
            m.key = pb_u64_to_int32(pb_read_varint(r));
        } else if tag == 16 {
            m.value = pb_u64_to_int32(pb_read_varint(r));
        } else {
            pb_unknown_append(r, start, tag, m.pb_unknown, unknown_len, unknown_had);
        }
    }
    m.pb_unknown = pb_bytes_trim(m.pb_unknown, unknown_len);
}

// Merges buf into m. 0 on success, else a PB_ERR_* code; m then holds a
// partial message, which the caller clears.
fn Maps_ColorsEntry_decode(buf: const u8[:], m: Maps_ColorsEntry&) -> i32 {
    var r = pb_reader(buf);
    Maps_ColorsEntry_decode_from(r, m);
    return r.err;
}

// Appends m's wire encoding, Maps_ColorsEntry_size_of(m) bytes, to out.
fn Maps_ColorsEntry_encode(m: Maps_ColorsEntry&, out: u8[>..]&) {
    pb_write_varint(out, 8);
    pb_write_varint(out, pb_int32_to_u64(m.key));
    pb_write_varint(out, 16);
    pb_write_varint(out, pb_int32_to_u64(m.value));
    out.append(pb_run(pb_bytes, m.pb_unknown));
}

// The size of m's wire encoding, in bytes.
fn Maps_ColorsEntry_size_of(m: Maps_ColorsEntry&) -> i64 {
    var n: i64 = 0;
    n += 1 + pb_varint_size(pb_int32_to_u64(m.key));
    n += 1 + pb_varint_size(pb_int32_to_u64(m.value));
    n += m.pb_unknown.len;
    return n;
}

// Frees what m owns and resets it to the empty message.
fn Maps_ColorsEntry_clear(m: Maps_ColorsEntry&) {
    m.key = 0;
    m.value = 0;
    m.pb_unknown = pb_bytes_free(m.pb_unknown);
}

// Makes dst a deep copy of src, freeing what dst owned. The two share
// nothing afterwards. Neither may be a sub-message of the other.
fn Maps_ColorsEntry_copy(dst: Maps_ColorsEntry&, src: Maps_ColorsEntry&) {
    if dst .== src { return; }
    Maps_ColorsEntry_clear(dst);
    dst.key = src.key;
    dst.value = src.value;
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
}

// Runs of entries: one per map field of this type.
reusable[] var Maps_ColorsEntry_entries: Maps_ColorsEntry[>..] = [];

// The index of the entry with key k among the first `used` of run s, or -1.
fn Maps_ColorsEntry_find(s: pb_Span, used: i64, k: i32) -> i64 {
    let pb_run_s = pb_run(Maps_ColorsEntry_entries, s);
    for pb_i in used {
        if pb_run_s[pb_i].key == k { return pb_i; }
    }
    return -1;
}

// The entry with key k in run s, added with the default value if there is none.
fn Maps_ColorsEntry_slot(s: pb_Span&, k: i32) -> Maps_ColorsEntry& {
    var pb_i = Maps_ColorsEntry_find(s, s.len, k);
    if pb_i < 0 {
        pb_i = s.len;
        s = pb_resize(Maps_ColorsEntry_entries, s, pb_i + 1);
        pb_run(Maps_ColorsEntry_entries, s)[pb_i].key = k;
    }
    return pb_run(Maps_ColorsEntry_entries, s)[pb_i];
}

// Settles an entry just decoded: a missing message value is an empty one,
// and unknown fields are dropped.
fn Maps_ColorsEntry_place(pb_e: Maps_ColorsEntry&) {
    pb_e.pb_unknown = pb_bytes_free(pb_e.pb_unknown);
}

// Run s with each repeated key folded: the last value wins, in the place of
// the first occurrence, and what the others held is freed. O(n log n).
// fold_maps calls it; decoding leaves repeated keys for it.
fn Maps_ColorsEntry_fold(s: pb_Span) -> pb_Span {
    if s.len < 2 { return s; }
    let pb_r = pb_run(Maps_ColorsEntry_entries, s);
    var pb_keys: pb_NumKey[>..] = [];
    for pb_i in pb_r.len { pb_keys.push(pb_NumKey { key: pb_r[pb_i].key as! u64, at: pb_i as! u32 }); }
    pb_sort_num_keys(pb_keys);
    var pb_gone: bool[>..] = [];
    var pb_i: i64 = 0;
    while pb_i < pb_keys.len {
        var pb_j = pb_i + 1;
        while pb_j < pb_keys.len && pb_same_num_key(pb_keys[pb_i], pb_keys[pb_j]) { pb_j++; }
        if pb_j - pb_i > 1 {
            if pb_gone.len == 0 { for pb_k in pb_r.len { pb_gone.push(false); } }
            let pb_first: i64 = pb_keys[pb_i].at;
            let pb_last: i64 = pb_keys[pb_j - 1].at;
            for pb_k in pb_j - pb_i - 1 {
                let pb_at: i64 = pb_keys[pb_i + pb_k].at;
                Maps_ColorsEntry_clear(pb_r[pb_at]);
                pb_gone[pb_at] = true;
            }
            pb_gone[pb_first] = false;
            pb_gone[pb_last] = true;
            pb_r[pb_first] = pb_r[pb_last];
            pb_r[pb_last] = Maps_ColorsEntry { .. };
        }
        pb_i = pb_j;
    }
    if pb_gone.len == 0 { return s; }
    var pb_kept: i64 = 0;
    for pb_k in pb_r.len {
        if pb_gone[pb_k] { continue; }
        if pb_kept != pb_k { pb_r[pb_kept] = pb_r[pb_k]; pb_r[pb_k] = Maps_ColorsEntry { .. }; }
        pb_kept++;
    }
    return pb_resize(Maps_ColorsEntry_entries, s, pb_kept);
}

// message c2.ReqSub
struct ReqSub {
    r: i32,
    pb_has0: u32,   // has-bits of fields with presence
    pb_unknown: pb_Span,   // unknown fields: raw wire bytes in pb_bytes
}

// A link to a ReqSub in ReqSub_pool, for sub-message fields.
struct ReqSub_Ref { m: ReqSub&<u32 in ReqSub_pool>? }
reusable var ReqSub_pool: ReqSub[>..] = [];
reusable[] var ReqSub_links: ReqSub_Ref[>..] = [];

// Merges the fields in r's window into m; on failure r.err is set.
// Fields it does not know, or with another wire type, are kept as
// unknown fields.
fn ReqSub_decode_from(r: pb_Reader&, m: ReqSub&) {
    var unknown_len: i64 = m.pb_unknown.len;
    let unknown_had: i64 = unknown_len;
    while r.pos < r.end {
        let start = r.pos;
        let tag = pb_read_tag(r);
        if r.err != PB_OK { break; }
        if tag == 8 {
            m.r = pb_u64_to_int32(pb_read_varint(r));
            m.pb_has0 |= 0x00000001;
        } else {
            pb_unknown_append(r, start, tag, m.pb_unknown, unknown_len, unknown_had);
        }
    }
    m.pb_unknown = pb_bytes_trim(m.pb_unknown, unknown_len);
}

// Merges buf into m. 0 on success, else a PB_ERR_* code; m then holds a
// partial message, which the caller clears.
fn ReqSub_decode(buf: const u8[:], m: ReqSub&) -> i32 {
    var r = pb_reader(buf);
    ReqSub_decode_from(r, m);
    if r.err == PB_OK && !ReqSub_is_initialized(m) { return PB_ERR_REQUIRED; }
    return r.err;
}

// Appends m's wire encoding, ReqSub_size_of(m) bytes, to out.
fn ReqSub_encode(m: ReqSub&, out: u8[>..]&) {
    if (m.pb_has0 & 0x00000001) != 0 {
        pb_write_varint(out, 8);
        pb_write_varint(out, pb_int32_to_u64(m.r));
    }
    out.append(pb_run(pb_bytes, m.pb_unknown));
}

// The size of m's wire encoding, in bytes.
fn ReqSub_size_of(m: ReqSub&) -> i64 {
    var n: i64 = 0;
    if (m.pb_has0 & 0x00000001) != 0 { n += 1 + pb_varint_size(pb_int32_to_u64(m.r)); }
    n += m.pb_unknown.len;
    return n;
}

// Frees what m owns and resets it to the empty message.
fn ReqSub_clear(m: ReqSub&) {
    m.r = 0;
    m.pb_has0 = 0;
    m.pb_unknown = pb_bytes_free(m.pb_unknown);
}

// Makes dst a deep copy of src, freeing what dst owned. The two share
// nothing afterwards. Neither may be a sub-message of the other.
fn ReqSub_copy(dst: ReqSub&, src: ReqSub&) {
    if dst .== src { return; }
    ReqSub_clear(dst);
    dst.r = src.r;
    dst.pb_has0 = src.pb_has0;
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
}

// True if every required field is set, in m and in the messages it holds.
fn ReqSub_is_initialized(m: ReqSub&) -> bool {
    if (m.pb_has0 & 0x00000001) != 0x00000001 { return false; }
    return true;
}

// Sets r and marks it present:
// it is encoded even when 0.
fn ReqSub_set_r(m: ReqSub&, v: i32) {
    m.r = v;
    m.pb_has0 |= 0x00000001;
}

fn ReqSub_has_r(m: ReqSub&) -> bool { return (m.pb_has0 & 0x00000001) != 0; }

fn ReqSub_clear_r(m: ReqSub&) {
    m.r = 0;
    m.pb_has0 &= 0xfffffffe;
}

// message c2.Reqs
enum Reqs_one {
    pb_none,
    member { v: ReqSub_Ref },
}

struct Reqs {
    list: pb_Span,
    by_name: pb_Span,
    one: Reqs_one = Reqs_one.pb_none,
    pb_unknown: pb_Span,   // unknown fields: raw wire bytes in pb_bytes
}

// A link to a Reqs in Reqs_pool, for sub-message fields.
struct Reqs_Ref { m: Reqs&<u32 in Reqs_pool>? }
reusable var Reqs_pool: Reqs[>..] = [];
reusable[] var Reqs_links: Reqs_Ref[>..] = [];

// Merges the fields in r's window into m; on failure r.err is set.
// Fields it does not know, or with another wire type, are kept as
// unknown fields.
fn Reqs_decode_from(r: pb_Reader&, m: Reqs&) {
    var unknown_len: i64 = m.pb_unknown.len;
    let unknown_had: i64 = unknown_len;
    let pb_had1: i64 = m.list.len;
    var pb_len1: i64 = pb_had1;
    let pb_had2: i64 = m.by_name.len;
    var pb_len2: i64 = pb_had2;
    while r.pos < r.end {
        let start = r.pos;
        let tag = pb_read_tag(r);
        if r.err != PB_OK { break; }
        if tag == 10 {
            pb_charge(r, 40);
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            if r.depth >= PB_MAX_DEPTH { pb_fail(r, PB_ERR_DEPTH); break; }
            pb_reserve(ReqSub_links, m.list, pb_len1, pb_had1);
            let pb_sub .= ReqSub_pool.alloc_ref(ReqSub { .. });
            pb_run(ReqSub_links, m.list)[pb_len1].m .= pb_sub;
            pb_len1++;
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            r.depth++;
            ReqSub_decode_from(r, pb_sub);
            if r.err != PB_OK { break; }
            r.depth--;
            r.end = pb_outer;
        } else if tag == 18 {
            pb_charge(r, 48);
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            if r.depth >= PB_MAX_DEPTH { pb_fail(r, PB_ERR_DEPTH); break; }
            pb_reserve(Reqs_ByNameEntry_entries, m.by_name, pb_len2, pb_had2);
            let pb_e .= pb_run(Reqs_ByNameEntry_entries, m.by_name)[pb_len2];
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            r.depth++;
            Reqs_ByNameEntry_decode_from(r, pb_e);
            if r.err != PB_OK { Reqs_ByNameEntry_clear(pb_e); break; }
            r.depth--;
            r.end = pb_outer;
            Reqs_ByNameEntry_place(pb_e);
            pb_len2++;
        } else if tag == 26 {
            pb_charge(r, 40);
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            if r.depth >= PB_MAX_DEPTH { pb_fail(r, PB_ERR_DEPTH); break; }
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            r.depth++;
            ReqSub_decode_from(r, Reqs_mutable_member(m));
            if r.err != PB_OK { break; }
            r.depth--;
            r.end = pb_outer;
        } else {
            pb_unknown_append(r, start, tag, m.pb_unknown, unknown_len, unknown_had);
        }
    }
    m.list = pb_trim(ReqSub_links, m.list, pb_len1);
    m.by_name = pb_trim(Reqs_ByNameEntry_entries, m.by_name, pb_len2);
    m.pb_unknown = pb_bytes_trim(m.pb_unknown, unknown_len);
}

// Merges buf into m. 0 on success, else a PB_ERR_* code; m then holds a
// partial message, which the caller clears.
fn Reqs_decode(buf: const u8[:], m: Reqs&) -> i32 {
    var r = pb_reader(buf);
    Reqs_decode_from(r, m);
    if r.err == PB_OK { Reqs_fold_maps(m); }
    if r.err == PB_OK && !Reqs_is_initialized(m) { return PB_ERR_REQUIRED; }
    return r.err;
}

// Appends m's wire encoding, Reqs_size_of(m) bytes, to out.
fn Reqs_encode(m: Reqs&, out: u8[>..]&) {
    for pb_ref in pb_run(ReqSub_links, m.list) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        pb_write_varint(out, 10);
        pb_write_varint(out, ReqSub_size_of(pb_l) as! u64);
        ReqSub_encode(pb_l, out);
    }
    for pb_i in m.by_name.len {
        let pb_e .= pb_run(Reqs_ByNameEntry_entries, m.by_name)[pb_i];
        pb_write_varint(out, 18);
        pb_write_varint(out, Reqs_ByNameEntry_size_of(pb_e) as! u64);
        Reqs_ByNameEntry_encode(pb_e, out);
    }
    match m.one {
        member pb_p => {
            let pb_l = pb_p.v.m;
            if pb_l {
                pb_write_varint(out, 26);
                pb_write_varint(out, ReqSub_size_of(pb_l) as! u64);
                ReqSub_encode(pb_l, out);
            }
        },
        _ => {},
    }
    out.append(pb_run(pb_bytes, m.pb_unknown));
}

// The size of m's wire encoding, in bytes.
fn Reqs_size_of(m: Reqs&) -> i64 {
    var n: i64 = 0;
    for pb_ref in pb_run(ReqSub_links, m.list) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        n += 1 + pb_len_size(ReqSub_size_of(pb_l));
    }
    for pb_i in m.by_name.len {
        n += 1 + pb_len_size(Reqs_ByNameEntry_size_of(pb_run(Reqs_ByNameEntry_entries, m.by_name)[pb_i]));
    }
    match m.one {
        member pb_p => {
            let pb_l = pb_p.v.m;
            if pb_l { n += 1 + pb_len_size(ReqSub_size_of(pb_l)); }
        },
        _ => {},
    }
    n += m.pb_unknown.len;
    return n;
}

// Frees what m owns and resets it to the empty message.
fn Reqs_clear(m: Reqs&) {
    Reqs_clear_list(m);
    Reqs_clear_by_name(m);
    Reqs_clear_one(m);
    m.pb_unknown = pb_bytes_free(m.pb_unknown);
}

// Makes dst a deep copy of src, freeing what dst owned. The two share
// nothing afterwards. Neither may be a sub-message of the other.
fn Reqs_copy(dst: Reqs&, src: Reqs&) {
    if dst .== src { return; }
    Reqs_clear(dst);
    dst.list = pb_resize(ReqSub_links, dst.list, src.list.len);
    for pb_i in src.list.len {
        let pb_l = pb_run(ReqSub_links, src.list)[pb_i].m;
        guard pb_l else { continue; }
        let pb_c .= ReqSub_pool.alloc_ref(ReqSub { .. });
        pb_run(ReqSub_links, dst.list)[pb_i].m .= pb_c;
        ReqSub_copy(pb_c, pb_l);
    }
    dst.by_name = pb_resize(Reqs_ByNameEntry_entries, dst.by_name, src.by_name.len);
    for pb_i in src.by_name.len {
        Reqs_ByNameEntry_copy(pb_run(Reqs_ByNameEntry_entries, dst.by_name)[pb_i], pb_run(Reqs_ByNameEntry_entries, src.by_name)[pb_i]);
    }
    match src.one {
        member pb_p => {
            let pb_l = pb_p.v.m;
            if pb_l { ReqSub_copy(Reqs_mutable_member(dst), pb_l); }
        },
        _ => {},
    }
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
}

// True if every required field is set, in m and in the messages it holds.
fn Reqs_is_initialized(m: Reqs&) -> bool {
    for pb_ref in pb_run(ReqSub_links, m.list) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        if !ReqSub_is_initialized(pb_l) { return false; }
    }
    for pb_i in m.by_name.len {
        if !Reqs_ByNameEntry_is_initialized(pb_run(Reqs_ByNameEntry_entries, m.by_name)[pb_i]) { return false; }
    }
    match m.one {
        member pb_p => {
            let pb_l = pb_p.v.m;
            if pb_l { if !ReqSub_is_initialized(pb_l) { return false; } }
        },
        _ => {},
    }
    return true;
}

// Folds repeated keys in the maps of m and of the messages it holds, which
// decoding appends without looking them up: the last value wins, in the
// place of the first occurrence.
fn Reqs_fold_maps(m: Reqs&) {
    m.by_name = Reqs_ByNameEntry_fold(m.by_name);
}

// Frees what oneof one holds, and sets no member.
fn Reqs_clear_one(m: Reqs&) {
    match m.one {
        member pb_p => {
            let pb_sub = pb_p.v.m;
            if pb_sub {
                ReqSub_clear(pb_sub);
                ReqSub_pool.free(ReqSub_pool.index_of(pb_sub));
            }
        },
        _ => {},
    }
    m.one = Reqs_one.pb_none;
}

// The number of messages of list.
fn Reqs_list_len(m: Reqs&) -> i64 { return m.list.len; }

// Message i of list. Valid until it or m is cleared.
fn Reqs_list_at(m: Reqs&, i: i64) -> ReqSub& {
    let pb_l = pb_run(ReqSub_links, m.list)[i].m;
    assert(pb_l);
    return pb_l;
}

// Adds an empty message to list and returns it.
fn Reqs_add_list(m: Reqs&) -> ReqSub& {
    let pb_i: i64 = m.list.len;
    m.list = pb_resize(ReqSub_links, m.list, pb_i + 1);
    let pb_new .= ReqSub_pool.alloc_ref(ReqSub { .. });
    pb_run(ReqSub_links, m.list)[pb_i].m .= pb_new;
    return pb_new;
}

// Frees the messages of list and everything they own.
fn Reqs_clear_list(m: Reqs&) {
    for pb_ref in pb_run(ReqSub_links, m.list) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        ReqSub_clear(pb_l);
        ReqSub_pool.free(ReqSub_pool.index_of(pb_l));
    }
    m.list = pb_resize(ReqSub_links, m.list, 0);
}

// The number of entries of by_name.
fn Reqs_by_name_len(m: Reqs&) -> i64 { return m.by_name.len; }

// The key of entry i of by_name, in insertion order. Valid until the map next
// changes or m is cleared.
fn Reqs_by_name_key_at(m: Reqs&, i: i64) -> u8[:] { return pb_run(pb_bytes, pb_run(Reqs_ByNameEntry_entries, m.by_name)[i].key); }

// The value of entry i of by_name. Valid until its entry is removed or m is
// cleared.
fn Reqs_by_name_value_at(m: Reqs&, i: i64) -> ReqSub& {
    let pb_l = pb_run(Reqs_ByNameEntry_entries, m.by_name)[i].value.m;
    assert(pb_l);
    return pb_l;
}

// The value with key k, or null if there is none. Valid until its entry
// is removed or m is cleared.
fn Reqs_by_name_get(m: Reqs&, k: const u8[:]) -> ReqSub&? {
    let pb_i = Reqs_ByNameEntry_find(m.by_name, m.by_name.len, k);
    if pb_i < 0 { return null; }
    return pb_run(Reqs_ByNameEntry_entries, m.by_name)[pb_i].value.m;
}

// The value with key k, added empty if there is none.
fn Reqs_by_name_put(m: Reqs&, k: const u8[:]) -> ReqSub& {
    return Reqs_ByNameEntry_mutable_value(Reqs_ByNameEntry_slot(m.by_name, k));
}

// Adds an entry without looking for key k, much faster than Reqs_by_name_put for many.
// Call Reqs_fold_maps(m) before reading the map: until then, a repeated key is
// there twice. There, the last value wins, in the place of the first occurrence.
fn Reqs_by_name_append(m: Reqs&, k: const u8[:]) -> ReqSub& {
    let pb_i: i64 = m.by_name.len;
    m.by_name = pb_resize(Reqs_ByNameEntry_entries, m.by_name, pb_i + 1);
    let pb_e .= pb_run(Reqs_ByNameEntry_entries, m.by_name)[pb_i];
    Reqs_ByNameEntry_set_key(pb_e, k);
    return Reqs_ByNameEntry_mutable_value(pb_e);
}

// Removes the entry with key k and frees what it owns. False if there is
// none. Later entries keep their order.
fn Reqs_by_name_remove(m: Reqs&, k: const u8[:]) -> bool {
    let pb_i = Reqs_ByNameEntry_find(m.by_name, m.by_name.len, k);
    if pb_i < 0 { return false; }
    let pb_r = pb_run(Reqs_ByNameEntry_entries, m.by_name);
    Reqs_ByNameEntry_clear(pb_r[pb_i]);
    var pb_j = pb_i;
    while pb_j + 1 < pb_r.len { pb_r[pb_j] = pb_r[pb_j + 1]; pb_j++; }
    pb_r[pb_j] = Reqs_ByNameEntry { .. };
    m.by_name = pb_resize(Reqs_ByNameEntry_entries, m.by_name, pb_j);
    return true;
}

// Frees the entries of by_name and everything they own.
fn Reqs_clear_by_name(m: Reqs&) {
    for pb_i in m.by_name.len { Reqs_ByNameEntry_clear(pb_run(Reqs_ByNameEntry_entries, m.by_name)[pb_i]); }
    m.by_name = pb_resize(Reqs_ByNameEntry_entries, m.by_name, 0);
}

// The sub-message member, or null if it is not the member set. Valid until
// oneof one changes or m is cleared.
fn Reqs_member(m: Reqs&) -> ReqSub&? {
    match m.one {
        member pb_p => { return pb_p.v.m; },
        _ => {},
    }
    return null;
}

// The sub-message member, first made the member set, and empty, if it is not.
fn Reqs_mutable_member(m: Reqs&) -> ReqSub& {
    match m.one {
        member pb_p => {
            let pb_l = pb_p.v.m;
            if pb_l { return pb_l; }
        },
        _ => {},
    }
    Reqs_clear_one(m);
    let pb_new .= ReqSub_pool.alloc_ref(ReqSub { .. });
    m.one = Reqs_one.member { v: ReqSub_Ref { m: pb_new } };
    return pb_new;
}

fn Reqs_has_member(m: Reqs&) -> bool { return match m.one { member => true, _ => false }; }

// Clears oneof one if member is the member set.
fn Reqs_clear_member(m: Reqs&) { if Reqs_has_member(m) { Reqs_clear_one(m); } }

// message c2.Reqs.ByNameEntry
struct Reqs_ByNameEntry {
    key: pb_Span,
    value: ReqSub_Ref,
    pb_unknown: pb_Span,   // unknown fields: raw wire bytes in pb_bytes
}

// A link to a Reqs_ByNameEntry in Reqs_ByNameEntry_pool, for sub-message fields.
struct Reqs_ByNameEntry_Ref { m: Reqs_ByNameEntry&<u32 in Reqs_ByNameEntry_pool>? }
reusable var Reqs_ByNameEntry_pool: Reqs_ByNameEntry[>..] = [];
reusable[] var Reqs_ByNameEntry_links: Reqs_ByNameEntry_Ref[>..] = [];

// Merges the fields in r's window into m; on failure r.err is set.
// Fields it does not know, or with another wire type, are kept as
// unknown fields.
fn Reqs_ByNameEntry_decode_from(r: pb_Reader&, m: Reqs_ByNameEntry&) {
    var unknown_len: i64 = m.pb_unknown.len;
    let unknown_had: i64 = unknown_len;
    while r.pos < r.end {
        let start = r.pos;
        let tag = pb_read_tag(r);
        if r.err != PB_OK { break; }
        if tag == 10 {
            m.key = pb_read_bytes(r, m.key);
        } else if tag == 18 {
            pb_charge(r, 40);
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            if r.depth >= PB_MAX_DEPTH { pb_fail(r, PB_ERR_DEPTH); break; }
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            r.depth++;
            ReqSub_decode_from(r, Reqs_ByNameEntry_mutable_value(m));
            if r.err != PB_OK { break; }
            r.depth--;
            r.end = pb_outer;
        } else {
            pb_unknown_append(r, start, tag, m.pb_unknown, unknown_len, unknown_had);
        }
    }
    m.pb_unknown = pb_bytes_trim(m.pb_unknown, unknown_len);
}

// Merges buf into m. 0 on success, else a PB_ERR_* code; m then holds a
// partial message, which the caller clears.
fn Reqs_ByNameEntry_decode(buf: const u8[:], m: Reqs_ByNameEntry&) -> i32 {
    var r = pb_reader(buf);
    Reqs_ByNameEntry_decode_from(r, m);
    if r.err == PB_OK && !Reqs_ByNameEntry_is_initialized(m) { return PB_ERR_REQUIRED; }
    return r.err;
}

// Appends m's wire encoding, Reqs_ByNameEntry_size_of(m) bytes, to out.
fn Reqs_ByNameEntry_encode(m: Reqs_ByNameEntry&, out: u8[>..]&) {
    pb_write_varint(out, 10);
    pb_write_bytes(out, m.key);
    let pb_f2 = m.value.m;
    if pb_f2 {
        pb_write_varint(out, 18);
        pb_write_varint(out, ReqSub_size_of(pb_f2) as! u64);
        ReqSub_encode(pb_f2, out);
    }
    out.append(pb_run(pb_bytes, m.pb_unknown));
}

// The size of m's wire encoding, in bytes.
fn Reqs_ByNameEntry_size_of(m: Reqs_ByNameEntry&) -> i64 {
    var n: i64 = 0;
    n += 1 + pb_bytes_size(m.key);
    let pb_f2 = m.value.m;
    if pb_f2 { n += 1 + pb_len_size(ReqSub_size_of(pb_f2)); }
    n += m.pb_unknown.len;
    return n;
}

// Frees what m owns and resets it to the empty message.
fn Reqs_ByNameEntry_clear(m: Reqs_ByNameEntry&) {
    m.key = pb_bytes_free(m.key);
    Reqs_ByNameEntry_clear_value(m);
    m.pb_unknown = pb_bytes_free(m.pb_unknown);
}

// Makes dst a deep copy of src, freeing what dst owned. The two share
// nothing afterwards. Neither may be a sub-message of the other.
fn Reqs_ByNameEntry_copy(dst: Reqs_ByNameEntry&, src: Reqs_ByNameEntry&) {
    if dst .== src { return; }
    Reqs_ByNameEntry_clear(dst);
    dst.key = pb_bytes_copy(src.key);
    let pb_f2 = src.value.m;
    if pb_f2 { ReqSub_copy(Reqs_ByNameEntry_mutable_value(dst), pb_f2); }
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
}

// True if every required field is set, in m and in the messages it holds.
fn Reqs_ByNameEntry_is_initialized(m: Reqs_ByNameEntry&) -> bool {
    let pb_f2 = m.value.m;
    if pb_f2 { if !ReqSub_is_initialized(pb_f2) { return false; } }
    return true;
}

// The contents of key, in pb_bytes: valid until it is next set or m
// is cleared.
fn Reqs_ByNameEntry_key(m: Reqs_ByNameEntry&) -> u8[:] { return pb_run(pb_bytes, m.key); }

// Sets key to a copy of v.
fn Reqs_ByNameEntry_set_key(m: Reqs_ByNameEntry&, v: const u8[:]) {
    m.key = pb_bytes_set(m.key, v);
}

// The sub-message value, or null if it is not set. Valid until it or m is
// cleared.
fn Reqs_ByNameEntry_value(m: Reqs_ByNameEntry&) -> ReqSub&? { return m.value.m; }

// The sub-message value, set to an empty one first if it is not set.
fn Reqs_ByNameEntry_mutable_value(m: Reqs_ByNameEntry&) -> ReqSub& {
    let pb_sub = m.value.m;
    if pb_sub { return pb_sub; }
    let pb_new .= ReqSub_pool.alloc_ref(ReqSub { .. });
    m.value.m .= pb_new;
    return pb_new;
}

fn Reqs_ByNameEntry_has_value(m: Reqs_ByNameEntry&) -> bool { return m.value.m != null; }

// Frees the sub-message value and everything it owns.
fn Reqs_ByNameEntry_clear_value(m: Reqs_ByNameEntry&) {
    let pb_sub = m.value.m;
    guard pb_sub else { return; }
    ReqSub_clear(pb_sub);
    ReqSub_pool.free(ReqSub_pool.index_of(pb_sub));
    m.value.m .= null;
}

// Runs of entries: one per map field of this type.
reusable[] var Reqs_ByNameEntry_entries: Reqs_ByNameEntry[>..] = [];

// The index of the entry with key k among the first `used` of run s, or -1.
fn Reqs_ByNameEntry_find(s: pb_Span, used: i64, k: const u8[:]) -> i64 {
    let pb_run_s = pb_run(Reqs_ByNameEntry_entries, s);
    for pb_i in used {
        if pb_run(pb_bytes, pb_run_s[pb_i].key) == k { return pb_i; }
    }
    return -1;
}

// The entry with key k in run s, added with the default value if there is none.
fn Reqs_ByNameEntry_slot(s: pb_Span&, k: const u8[:]) -> Reqs_ByNameEntry& {
    var pb_i = Reqs_ByNameEntry_find(s, s.len, k);
    if pb_i < 0 {
        pb_i = s.len;
        s = pb_resize(Reqs_ByNameEntry_entries, s, pb_i + 1);
        Reqs_ByNameEntry_set_key(pb_run(Reqs_ByNameEntry_entries, s)[pb_i], k);
        Reqs_ByNameEntry_mutable_value(pb_run(Reqs_ByNameEntry_entries, s)[pb_i]);
    }
    return pb_run(Reqs_ByNameEntry_entries, s)[pb_i];
}

// Settles an entry just decoded: a missing message value is an empty one,
// and unknown fields are dropped.
fn Reqs_ByNameEntry_place(pb_e: Reqs_ByNameEntry&) {
    Reqs_ByNameEntry_mutable_value(pb_e);
    pb_e.pb_unknown = pb_bytes_free(pb_e.pb_unknown);
}

// Run s with each repeated key folded: the last value wins, in the place of
// the first occurrence, and what the others held is freed. O(n log n).
// fold_maps calls it; decoding leaves repeated keys for it.
fn Reqs_ByNameEntry_fold(s: pb_Span) -> pb_Span {
    if s.len < 2 { return s; }
    let pb_r = pb_run(Reqs_ByNameEntry_entries, s);
    var pb_keys: pb_StrKey[>..] = [];
    for pb_i in pb_r.len { pb_keys.push(pb_StrKey { key: pb_r[pb_i].key, at: pb_i as! u32 }); }
    pb_sort_str_keys(pb_keys);
    var pb_gone: bool[>..] = [];
    var pb_i: i64 = 0;
    while pb_i < pb_keys.len {
        var pb_j = pb_i + 1;
        while pb_j < pb_keys.len && pb_same_str_key(pb_keys[pb_i], pb_keys[pb_j]) { pb_j++; }
        if pb_j - pb_i > 1 {
            if pb_gone.len == 0 { for pb_k in pb_r.len { pb_gone.push(false); } }
            let pb_first: i64 = pb_keys[pb_i].at;
            let pb_last: i64 = pb_keys[pb_j - 1].at;
            for pb_k in pb_j - pb_i - 1 {
                let pb_at: i64 = pb_keys[pb_i + pb_k].at;
                Reqs_ByNameEntry_clear(pb_r[pb_at]);
                pb_gone[pb_at] = true;
            }
            pb_gone[pb_first] = false;
            pb_gone[pb_last] = true;
            pb_r[pb_first] = pb_r[pb_last];
            pb_r[pb_last] = Reqs_ByNameEntry { .. };
        }
        pb_i = pb_j;
    }
    if pb_gone.len == 0 { return s; }
    var pb_kept: i64 = 0;
    for pb_k in pb_r.len {
        if pb_gone[pb_k] { continue; }
        if pb_kept != pb_k { pb_r[pb_kept] = pb_r[pb_k]; pb_r[pb_k] = Reqs_ByNameEntry { .. }; }
        pb_kept++;
    }
    return pb_resize(Reqs_ByNameEntry_entries, s, pb_kept);
}

// message c2.OnlyGroup
enum OnlyGroup_one {
    pb_none,
    grp { v: OnlyGroup_Grp_Ref },
}

struct OnlyGroup {
    one: OnlyGroup_one = OnlyGroup_one.pb_none,
    pb_unknown: pb_Span,   // unknown fields: raw wire bytes in pb_bytes
}

// A link to a OnlyGroup in OnlyGroup_pool, for sub-message fields.
struct OnlyGroup_Ref { m: OnlyGroup&<u32 in OnlyGroup_pool>? }
reusable var OnlyGroup_pool: OnlyGroup[>..] = [];
reusable[] var OnlyGroup_links: OnlyGroup_Ref[>..] = [];

// Merges the fields in r's window into m; on failure r.err is set.
// Fields it does not know, or with another wire type, are kept as
// unknown fields.
fn OnlyGroup_decode_from(r: pb_Reader&, m: OnlyGroup&) {
    var unknown_len: i64 = m.pb_unknown.len;
    let unknown_had: i64 = unknown_len;
    while r.pos < r.end {
        let start = r.pos;
        let tag = pb_read_tag(r);
        if r.err != PB_OK { break; }
        if tag == 11 {
            pb_charge(r, 40);
            let pb_body = r.pos;
            let pb_stop = pb_skip_group(r, tag);
            if r.err != PB_OK { break; }
            let pb_after = r.pos;
            let pb_outer = r.end;
            r.pos = pb_body;
            r.end = pb_stop;
            r.depth++;
            OnlyGroup_Grp_decode_from(r, OnlyGroup_mutable_grp(m));
            if r.err != PB_OK { break; }
            r.depth--;
            r.end = pb_outer;
            r.pos = pb_after;
        } else {
            pb_unknown_append(r, start, tag, m.pb_unknown, unknown_len, unknown_had);
        }
    }
    m.pb_unknown = pb_bytes_trim(m.pb_unknown, unknown_len);
}

// Merges buf into m. 0 on success, else a PB_ERR_* code; m then holds a
// partial message, which the caller clears.
fn OnlyGroup_decode(buf: const u8[:], m: OnlyGroup&) -> i32 {
    var r = pb_reader(buf);
    OnlyGroup_decode_from(r, m);
    return r.err;
}

// Appends m's wire encoding, OnlyGroup_size_of(m) bytes, to out.
fn OnlyGroup_encode(m: OnlyGroup&, out: u8[>..]&) {
    match m.one {
        grp pb_p => {
            let pb_l = pb_p.v.m;
            if pb_l {
                pb_write_varint(out, 11);
                OnlyGroup_Grp_encode(pb_l, out);
                pb_write_varint(out, 12);
            }
        },
        _ => {},
    }
    out.append(pb_run(pb_bytes, m.pb_unknown));
}

// The size of m's wire encoding, in bytes.
fn OnlyGroup_size_of(m: OnlyGroup&) -> i64 {
    var n: i64 = 0;
    match m.one {
        grp pb_p => {
            let pb_l = pb_p.v.m;
            if pb_l { n += 2 + OnlyGroup_Grp_size_of(pb_l); }
        },
        _ => {},
    }
    n += m.pb_unknown.len;
    return n;
}

// Frees what m owns and resets it to the empty message.
fn OnlyGroup_clear(m: OnlyGroup&) {
    OnlyGroup_clear_one(m);
    m.pb_unknown = pb_bytes_free(m.pb_unknown);
}

// Makes dst a deep copy of src, freeing what dst owned. The two share
// nothing afterwards. Neither may be a sub-message of the other.
fn OnlyGroup_copy(dst: OnlyGroup&, src: OnlyGroup&) {
    if dst .== src { return; }
    OnlyGroup_clear(dst);
    match src.one {
        grp pb_p => {
            let pb_l = pb_p.v.m;
            if pb_l { OnlyGroup_Grp_copy(OnlyGroup_mutable_grp(dst), pb_l); }
        },
        _ => {},
    }
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
}

// Frees what oneof one holds, and sets no member.
fn OnlyGroup_clear_one(m: OnlyGroup&) {
    match m.one {
        grp pb_p => {
            let pb_sub = pb_p.v.m;
            if pb_sub {
                OnlyGroup_Grp_clear(pb_sub);
                OnlyGroup_Grp_pool.free(OnlyGroup_Grp_pool.index_of(pb_sub));
            }
        },
        _ => {},
    }
    m.one = OnlyGroup_one.pb_none;
}

// The sub-message grp, or null if it is not the member set. Valid until
// oneof one changes or m is cleared.
fn OnlyGroup_grp(m: OnlyGroup&) -> OnlyGroup_Grp&? {
    match m.one {
        grp pb_p => { return pb_p.v.m; },
        _ => {},
    }
    return null;
}

// The sub-message grp, first made the member set, and empty, if it is not.
fn OnlyGroup_mutable_grp(m: OnlyGroup&) -> OnlyGroup_Grp& {
    match m.one {
        grp pb_p => {
            let pb_l = pb_p.v.m;
            if pb_l { return pb_l; }
        },
        _ => {},
    }
    OnlyGroup_clear_one(m);
    let pb_new .= OnlyGroup_Grp_pool.alloc_ref(OnlyGroup_Grp { .. });
    m.one = OnlyGroup_one.grp { v: OnlyGroup_Grp_Ref { m: pb_new } };
    return pb_new;
}

fn OnlyGroup_has_grp(m: OnlyGroup&) -> bool { return match m.one { grp => true, _ => false }; }

// Clears oneof one if grp is the member set.
fn OnlyGroup_clear_grp(m: OnlyGroup&) { if OnlyGroup_has_grp(m) { OnlyGroup_clear_one(m); } }

// message c2.OnlyGroup.Grp
struct OnlyGroup_Grp {
    g: i32,
    pb_has0: u32,   // has-bits of fields with presence
    pb_unknown: pb_Span,   // unknown fields: raw wire bytes in pb_bytes
}

// A link to a OnlyGroup_Grp in OnlyGroup_Grp_pool, for sub-message fields.
struct OnlyGroup_Grp_Ref { m: OnlyGroup_Grp&<u32 in OnlyGroup_Grp_pool>? }
reusable var OnlyGroup_Grp_pool: OnlyGroup_Grp[>..] = [];
reusable[] var OnlyGroup_Grp_links: OnlyGroup_Grp_Ref[>..] = [];

// Merges the fields in r's window into m; on failure r.err is set.
// Fields it does not know, or with another wire type, are kept as
// unknown fields.
fn OnlyGroup_Grp_decode_from(r: pb_Reader&, m: OnlyGroup_Grp&) {
    var unknown_len: i64 = m.pb_unknown.len;
    let unknown_had: i64 = unknown_len;
    while r.pos < r.end {
        let start = r.pos;
        let tag = pb_read_tag(r);
        if r.err != PB_OK { break; }
        if tag == 8 {
            m.g = pb_u64_to_int32(pb_read_varint(r));
            m.pb_has0 |= 0x00000001;
        } else {
            pb_unknown_append(r, start, tag, m.pb_unknown, unknown_len, unknown_had);
        }
    }
    m.pb_unknown = pb_bytes_trim(m.pb_unknown, unknown_len);
}

// Merges buf into m. 0 on success, else a PB_ERR_* code; m then holds a
// partial message, which the caller clears.
fn OnlyGroup_Grp_decode(buf: const u8[:], m: OnlyGroup_Grp&) -> i32 {
    var r = pb_reader(buf);
    OnlyGroup_Grp_decode_from(r, m);
    return r.err;
}

// Appends m's wire encoding, OnlyGroup_Grp_size_of(m) bytes, to out.
fn OnlyGroup_Grp_encode(m: OnlyGroup_Grp&, out: u8[>..]&) {
    if (m.pb_has0 & 0x00000001) != 0 {
        pb_write_varint(out, 8);
        pb_write_varint(out, pb_int32_to_u64(m.g));
    }
    out.append(pb_run(pb_bytes, m.pb_unknown));
}

// The size of m's wire encoding, in bytes.
fn OnlyGroup_Grp_size_of(m: OnlyGroup_Grp&) -> i64 {
    var n: i64 = 0;
    if (m.pb_has0 & 0x00000001) != 0 { n += 1 + pb_varint_size(pb_int32_to_u64(m.g)); }
    n += m.pb_unknown.len;
    return n;
}

// Frees what m owns and resets it to the empty message.
fn OnlyGroup_Grp_clear(m: OnlyGroup_Grp&) {
    m.g = 0;
    m.pb_has0 = 0;
    m.pb_unknown = pb_bytes_free(m.pb_unknown);
}

// Makes dst a deep copy of src, freeing what dst owned. The two share
// nothing afterwards. Neither may be a sub-message of the other.
fn OnlyGroup_Grp_copy(dst: OnlyGroup_Grp&, src: OnlyGroup_Grp&) {
    if dst .== src { return; }
    OnlyGroup_Grp_clear(dst);
    dst.g = src.g;
    dst.pb_has0 = src.pb_has0;
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
}

// Sets g and marks it present:
// it is encoded even when 0.
fn OnlyGroup_Grp_set_g(m: OnlyGroup_Grp&, v: i32) {
    m.g = v;
    m.pb_has0 |= 0x00000001;
}

fn OnlyGroup_Grp_has_g(m: OnlyGroup_Grp&) -> bool { return (m.pb_has0 & 0x00000001) != 0; }

fn OnlyGroup_Grp_clear_g(m: OnlyGroup_Grp&) {
    m.g = 0;
    m.pb_has0 &= 0xfffffffe;
}
