fn Lists_set_fars(m: Lists&, v: const i32[:]) { m.fars = pb_set_run(pb_i32s, m.fars, v); }

fn Lists_clear_fars(m: Lists&) { m.fars = pb_resize(pb_i32s, m.fars, 0); }

// message c2.Pick
enum Pick_pick {
    pb_none,
    i { v: i32 },
    s { v: pb_Span },
    b { v: pb_Span },
    m { v: Sub_Ref },
    c { v: i32 },
    f { v: i32 },
}

struct Pick {
    after: i32,
    pick: Pick_pick = Pick_pick.pb_none,
    pb_has0: u32,   // has-bits of fields with presence
    pb_unknown: pb_Span,   // unknown fields: raw wire bytes in pb_bytes
}

// A link to a Pick in Pick_pool, for sub-message fields.
struct Pick_Ref { m: Pick&<u32 in Pick_pool>? }
reusable var Pick_pool: Pick[>..] = [];
reusable[] var Pick_links: Pick_Ref[>..] = [];

// Merges the fields in r's window into m; on failure r.err is set.
// Fields it does not know, or with another wire type, are kept as
// unknown fields.
fn Pick_decode_from(r: pb_Reader&, m: Pick&) {
    var unknown_len: i64 = m.pb_unknown.len;
    let unknown_had: i64 = unknown_len;
    while r.pos < r.end {
        let start = r.pos;
        let tag = pb_read_tag(r);
        if r.err != PB_OK { break; }
        if tag == 8 {
            let pb_v = pb_u64_to_int32(pb_read_varint(r));
            if r.err != PB_OK { break; }
            Pick_clear_pick(m);
            m.pick = Pick_pick.i { v: pb_v };
        } else if tag == 18 {
            let pb_v = pb_read_bytes(r, pb_Span { at: 0, len: 0 });
            if r.err != PB_OK { break; }
            Pick_clear_pick(m);
            m.pick = Pick_pick.s { v: pb_v };
        } else if tag == 26 {
            let pb_v = pb_read_bytes(r, pb_Span { at: 0, len: 0 });
            if r.err != PB_OK { break; }
            Pick_clear_pick(m);
            m.pick = Pick_pick.b { v: pb_v };
        } else if tag == 34 {
            pb_charge(r, 40);
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            if r.depth >= PB_MAX_DEPTH { pb_fail(r, PB_ERR_DEPTH); break; }
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            r.depth++;
            Sub_decode_from(r, Pick_mutable_m(m));
            if r.err != PB_OK { break; }
            r.depth--;
            r.end = pb_outer;
        } else if tag == 40 {
            let pb_v = pb_u64_to_int32(pb_read_varint(r));
            if r.err != PB_OK { break; }
            if !((pb_v >= 0 && pb_v <= 1) || pb_v == 5) {
                pb_unknown_keep(r, start, m.pb_unknown, unknown_len, unknown_had);
                continue;
            }
            Pick_clear_pick(m);
            m.pick = Pick_pick.c { v: pb_v };
        } else if tag == 48 {
            let pb_v = pb_u64_to_int32(pb_read_varint(r));
            if r.err != PB_OK { break; }
            if !((pb_v >= 1 && pb_v <= 2)) {
                pb_unknown_keep(r, start, m.pb_unknown, unknown_len, unknown_had);
                continue;
            }
            Pick_clear_pick(m);
            m.pick = Pick_pick.f { v: pb_v };
        } else if tag == 56 {
            m.after = pb_u64_to_int32(pb_read_varint(r));
            m.pb_has0 |= 0x00000001;
        } else {
            pb_unknown_append(r, start, tag, m.pb_unknown, unknown_len, unknown_had);
        }
    }
    m.pb_unknown = pb_bytes_trim(m.pb_unknown, unknown_len);
}

// Merges buf into m. 0 on success, else a PB_ERR_* code; m then holds a
// partial message, which the caller clears.
fn Pick_decode(buf: const u8[:], m: Pick&) -> i32 {
    var r = pb_reader(buf);
    Pick_decode_from(r, m);
    return r.err;
}

// Appends m's wire encoding, Pick_size_of(m) bytes, to out.
fn Pick_encode(m: Pick&, out: u8[>..]&) {
    match m.pick {
        i pb_p => {
            pb_write_varint(out, 8);
            pb_write_varint(out, pb_int32_to_u64(pb_p.v));
        },
        _ => {},
    }
    match m.pick {
        s pb_p => {
            pb_write_varint(out, 18);
            pb_write_bytes(out, pb_p.v);
        },
        _ => {},
    }
    match m.pick {
        b pb_p => {
            pb_write_varint(out, 26);
            pb_write_bytes(out, pb_p.v);
        },
        _ => {},
    }
    match m.pick {
        m pb_p => {
            let pb_l = pb_p.v.m;
            if pb_l {
                pb_write_varint(out, 34);
                pb_write_varint(out, Sub_size_of(pb_l) as! u64);
                Sub_encode(pb_l, out);
            }
        },
        _ => {},
    }
    match m.pick {
        c pb_p => {
            pb_write_varint(out, 40);
            pb_write_varint(out, pb_int32_to_u64(pb_p.v));
        },
        _ => {},
    }
    match m.pick {
        f pb_p => {
            pb_write_varint(out, 48);
            pb_write_varint(out, pb_int32_to_u64(pb_p.v));
        },
        _ => {},
    }
    if (m.pb_has0 & 0x00000001) != 0 {
        pb_write_varint(out, 56);
        pb_write_varint(out, pb_int32_to_u64(m.after));
    }
    out.append(pb_run(pb_bytes, m.pb_unknown));
}

// The size of m's wire encoding, in bytes.
fn Pick_size_of(m: Pick&) -> i64 {
    var n: i64 = 0;
    match m.pick {
        i pb_p => { n += 1 + pb_varint_size(pb_int32_to_u64(pb_p.v)); },
        _ => {},
    }
    match m.pick {
        s pb_p => { n += 1 + pb_bytes_size(pb_p.v); },
        _ => {},
    }
    match m.pick {
        b pb_p => { n += 1 + pb_bytes_size(pb_p.v); },
        _ => {},
    }
    match m.pick {
        m pb_p => {
            let pb_l = pb_p.v.m;
            if pb_l { n += 1 + pb_len_size(Sub_size_of(pb_l)); }
        },
        _ => {},
    }
    match m.pick {
        c pb_p => { n += 1 + pb_varint_size(pb_int32_to_u64(pb_p.v)); },
        _ => {},
    }
    match m.pick {
        f pb_p => { n += 1 + pb_varint_size(pb_int32_to_u64(pb_p.v)); },
        _ => {},
    }
    if (m.pb_has0 & 0x00000001) != 0 { n += 1 + pb_varint_size(pb_int32_to_u64(m.after)); }
    n += m.pb_unknown.len;
    return n;
}

// Frees what m owns and resets it to the empty message.
fn Pick_clear(m: Pick&) {
    m.after = 0;
    Pick_clear_pick(m);
    m.pb_has0 = 0;
    m.pb_unknown = pb_bytes_free(m.pb_unknown);
}

// Makes dst a deep copy of src, freeing what dst owned. The two share
// nothing afterwards. Neither may be a sub-message of the other.
fn Pick_copy(dst: Pick&, src: Pick&) {
    if dst .== src { return; }
    Pick_clear(dst);
    dst.after = src.after;
    match src.pick {
        i pb_p => { dst.pick = Pick_pick.i { v: pb_p.v }; },
        s pb_p => { dst.pick = Pick_pick.s { v: pb_bytes_copy(pb_p.v) }; },
        b pb_p => { dst.pick = Pick_pick.b { v: pb_bytes_copy(pb_p.v) }; },
        m pb_p => {
            let pb_l = pb_p.v.m;
            if pb_l { Sub_copy(Pick_mutable_m(dst), pb_l); }
        },
        c pb_p => { dst.pick = Pick_pick.c { v: pb_p.v }; },
        f pb_p => { dst.pick = Pick_pick.f { v: pb_p.v }; },
        _ => {},
    }
    dst.pb_has0 = src.pb_has0;
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
}

// Frees what oneof pick holds, and sets no member.
fn Pick_clear_pick(m: Pick&) {
    match m.pick {
        s pb_p => { pb_bytes_free(pb_p.v); },
        b pb_p => { pb_bytes_free(pb_p.v); },
        m pb_p => {
            let pb_sub = pb_p.v.m;
            if pb_sub {
                Sub_clear(pb_sub);
                Sub_pool.free(Sub_pool.index_of(pb_sub));
            }
        },
        _ => {},
    }
    m.pick = Pick_pick.pb_none;
}

// The value of i, the default if it is not the member set.
fn Pick_i(m: Pick&) -> i32 {
    match m.pick {
        i pb_p => { return pb_p.v; },
        _ => {},
    }
    return 0;
}

// Makes i the member set, with value v: it is encoded even when 0.
fn Pick_set_i(m: Pick&, v: i32) {
    Pick_clear_pick(m);
    m.pick = Pick_pick.i { v: v };
}

fn Pick_has_i(m: Pick&) -> bool { return match m.pick { i => true, _ => false }; }

// Clears oneof pick if i is the member set.
fn Pick_clear_i(m: Pick&) { if Pick_has_i(m) { Pick_clear_pick(m); } }

// The contents of s in pb_bytes, empty if it is not the member set: valid
// until oneof pick changes or m is cleared.
fn Pick_s(m: Pick&) -> u8[:] {
    match m.pick {
        s pb_p => { return pb_run(pb_bytes, pb_p.v); },
        _ => {},
    }
    return pb_run(pb_bytes, pb_Span { at: 0, len: 0 });
}

// Makes s the member set, with a copy of v, which may be its own contents.
fn Pick_set_s(m: Pick&, v: const u8[:]) {
    let pb_t = pb_bytes_set(pb_Span { at: 0, len: 0 }, v);
    Pick_clear_pick(m);
    m.pick = Pick_pick.s { v: pb_t };
}

fn Pick_has_s(m: Pick&) -> bool { return match m.pick { s => true, _ => false }; }

// Clears oneof pick if s is the member set.
fn Pick_clear_s(m: Pick&) { if Pick_has_s(m) { Pick_clear_pick(m); } }

// The contents of b in pb_bytes, empty if it is not the member set: valid
// until oneof pick changes or m is cleared.
fn Pick_b(m: Pick&) -> u8[:] {
    match m.pick {
        b pb_p => { return pb_run(pb_bytes, pb_p.v); },
        _ => {},
    }
    return pb_run(pb_bytes, pb_Span { at: 0, len: 0 });
}

// Makes b the member set, with a copy of v, which may be its own contents.
fn Pick_set_b(m: Pick&, v: const u8[:]) {
    let pb_t = pb_bytes_set(pb_Span { at: 0, len: 0 }, v);
    Pick_clear_pick(m);
    m.pick = Pick_pick.b { v: pb_t };
}

fn Pick_has_b(m: Pick&) -> bool { return match m.pick { b => true, _ => false }; }

// Clears oneof pick if b is the member set.
fn Pick_clear_b(m: Pick&) { if Pick_has_b(m) { Pick_clear_pick(m); } }

// The sub-message m, or null if it is not the member set. Valid until
// oneof pick changes or m is cleared.
fn Pick_m(m: Pick&) -> Sub&? {
    match m.pick {
        m pb_p => { return pb_p.v.m; },
        _ => {},
    }
    return null;
}

// The sub-message m, first made the member set, and empty, if it is not.
fn Pick_mutable_m(m: Pick&) -> Sub& {
    match m.pick {
        m pb_p => {
            let pb_l = pb_p.v.m;
            if pb_l { return pb_l; }
        },
        _ => {},
    }
    Pick_clear_pick(m);
    let pb_new .= Sub_pool.alloc_ref(Sub { .. });
    m.pick = Pick_pick.m { v: Sub_Ref { m: pb_new } };
    return pb_new;
}

fn Pick_has_m(m: Pick&) -> bool { return match m.pick { m => true, _ => false }; }

// Clears oneof pick if m is the member set.
fn Pick_clear_m(m: Pick&) { if Pick_has_m(m) { Pick_clear_pick(m); } }

// The value of c, the default if it is not the member set.
fn Pick_c(m: Pick&) -> i32 {
    match m.pick {
        c pb_p => { return pb_p.v; },
        _ => {},
    }
    return 0;
}

// Makes c the member set, with value v: it is encoded even when 0.
fn Pick_set_c(m: Pick&, v: i32) {
    Pick_clear_pick(m);
    m.pick = Pick_pick.c { v: v };
}

fn Pick_has_c(m: Pick&) -> bool { return match m.pick { c => true, _ => false }; }

// Clears oneof pick if c is the member set.
fn Pick_clear_c(m: Pick&) { if Pick_has_c(m) { Pick_clear_pick(m); } }

// The value of f, the default if it is not the member set.
fn Pick_f(m: Pick&) -> i32 {
    match m.pick {
        f pb_p => { return pb_p.v; },
        _ => {},
    }
    return 1;
}

// Makes f the member set, with value v: it is encoded even when 0.
fn Pick_set_f(m: Pick&, v: i32) {
    Pick_clear_pick(m);
    m.pick = Pick_pick.f { v: v };
}

fn Pick_has_f(m: Pick&) -> bool { return match m.pick { f => true, _ => false }; }

// Clears oneof pick if f is the member set.
fn Pick_clear_f(m: Pick&) { if Pick_has_f(m) { Pick_clear_pick(m); } }

// Sets after and marks it present:
// it is encoded even when 0.
fn Pick_set_after(m: Pick&, v: i32) {
    m.after = v;
    m.pb_has0 |= 0x00000001;
}

fn Pick_has_after(m: Pick&) -> bool { return (m.pb_has0 & 0x00000001) != 0; }

fn Pick_clear_after(m: Pick&) {
    m.after = 0;
    m.pb_has0 &= 0xfffffffe;
}

// message c2.Maps
struct Maps {
    counts: pb_Span,
    names: pb_Span,
    subs: pb_Span,
    colors: pb_Span,
    pb_unknown: pb_Span,   // unknown fields: raw wire bytes in pb_bytes
}

// A link to a Maps in Maps_pool, for sub-message fields.
struct Maps_Ref { m: Maps&<u32 in Maps_pool>? }
reusable var Maps_pool: Maps[>..] = [];
reusable[] var Maps_links: Maps_Ref[>..] = [];

// Merges the fields in r's window into m; on failure r.err is set.
// Fields it does not know, or with another wire type, are kept as
// unknown fields.
fn Maps_decode_from(r: pb_Reader&, m: Maps&) {
    var unknown_len: i64 = m.pb_unknown.len;
    let unknown_had: i64 = unknown_len;
    let pb_had1: i64 = m.counts.len;
    var pb_len1: i64 = pb_had1;
    let pb_had2: i64 = m.names.len;
    var pb_len2: i64 = pb_had2;
    let pb_had3: i64 = m.subs.len;
    var pb_len3: i64 = pb_had3;
    let pb_had4: i64 = m.colors.len;
    var pb_len4: i64 = pb_had4;
    while r.pos < r.end {
        let start = r.pos;
        let tag = pb_read_tag(r);
        if r.err != PB_OK { break; }
        if tag == 10 {
            pb_charge(r, 48);
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            if r.depth >= PB_MAX_DEPTH { pb_fail(r, PB_ERR_DEPTH); break; }
            pb_reserve(Maps_CountsEntry_entries, m.counts, pb_len1, pb_had1);
            let pb_e .= pb_run(Maps_CountsEntry_entries, m.counts)[pb_len1];
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            r.depth++;
            Maps_CountsEntry_decode_from(r, pb_e);
            if r.err != PB_OK { Maps_CountsEntry_clear(pb_e); break; }
            r.depth--;
            r.end = pb_outer;
            Maps_CountsEntry_place(pb_e);
            pb_len1++;
        } else if tag == 18 {
            pb_charge(r, 48);
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            if r.depth >= PB_MAX_DEPTH { pb_fail(r, PB_ERR_DEPTH); break; }
            pb_reserve(Maps_NamesEntry_entries, m.names, pb_len2, pb_had2);
            let pb_e .= pb_run(Maps_NamesEntry_entries, m.names)[pb_len2];
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            r.depth++;
            Maps_NamesEntry_decode_from(r, pb_e);
            if r.err != PB_OK { Maps_NamesEntry_clear(pb_e); break; }
            r.depth--;
            r.end = pb_outer;
            Maps_NamesEntry_place(pb_e);
            pb_len2++;
        } else if tag == 26 {
            pb_charge(r, 48);
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            if r.depth >= PB_MAX_DEPTH { pb_fail(r, PB_ERR_DEPTH); break; }
            pb_reserve(Maps_SubsEntry_entries, m.subs, pb_len3, pb_had3);
            let pb_e .= pb_run(Maps_SubsEntry_entries, m.subs)[pb_len3];
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            r.depth++;
            Maps_SubsEntry_decode_from(r, pb_e);
            if r.err != PB_OK { Maps_SubsEntry_clear(pb_e); break; }
            r.depth--;
            r.end = pb_outer;
            Maps_SubsEntry_place(pb_e);
            pb_len3++;
        } else if tag == 34 {
            pb_charge(r, 48);
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            if r.depth >= PB_MAX_DEPTH { pb_fail(r, PB_ERR_DEPTH); break; }
            pb_reserve(Maps_ColorsEntry_entries, m.colors, pb_len4, pb_had4);
            let pb_e .= pb_run(Maps_ColorsEntry_entries, m.colors)[pb_len4];
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            r.depth++;
            Maps_ColorsEntry_decode_from(r, pb_e);
            if r.err != PB_OK { Maps_ColorsEntry_clear(pb_e); break; }
            r.depth--;
            r.end = pb_outer;
            let pb_v = pb_e.value;
            if !((pb_v >= 0 && pb_v <= 1) || pb_v == 5) {
                Maps_ColorsEntry_clear(pb_e);
                pb_unknown_keep(r, start, m.pb_unknown, unknown_len, unknown_had);
                continue;
            }
            Maps_ColorsEntry_place(pb_e);
            pb_len4++;
        } else {
            pb_unknown_append(r, start, tag, m.pb_unknown, unknown_len, unknown_had);
        }
    }
    m.counts = pb_trim(Maps_CountsEntry_entries, m.counts, pb_len1);
    m.names = pb_trim(Maps_NamesEntry_entries, m.names, pb_len2);
    m.subs = pb_trim(Maps_SubsEntry_entries, m.subs, pb_len3);
    m.colors = pb_trim(Maps_ColorsEntry_entries, m.colors, pb_len4);
    m.pb_unknown = pb_bytes_trim(m.pb_unknown, unknown_len);
}

// Merges buf into m. 0 on success, else a PB_ERR_* code; m then holds a
// partial message, which the caller clears.
fn Maps_decode(buf: const u8[:], m: Maps&) -> i32 {
    var r = pb_reader(buf);
    Maps_decode_from(r, m);
    if r.err == PB_OK { Maps_fold_maps(m); }
    return r.err;
}

// Appends m's wire encoding, Maps_size_of(m) bytes, to out.
fn Maps_encode(m: Maps&, out: u8[>..]&) {
    for pb_i in m.counts.len {
        let pb_e .= pb_run(Maps_CountsEntry_entries, m.counts)[pb_i];
        pb_write_varint(out, 10);
        pb_write_varint(out, Maps_CountsEntry_size_of(pb_e) as! u64);
        Maps_CountsEntry_encode(pb_e, out);
    }
    for pb_i in m.names.len {
        let pb_e .= pb_run(Maps_NamesEntry_entries, m.names)[pb_i];
        pb_write_varint(out, 18);
        pb_write_varint(out, Maps_NamesEntry_size_of(pb_e) as! u64);
        Maps_NamesEntry_encode(pb_e, out);
    }
    for pb_i in m.subs.len {
        let pb_e .= pb_run(Maps_SubsEntry_entries, m.subs)[pb_i];
        pb_write_varint(out, 26);
        pb_write_varint(out, Maps_SubsEntry_size_of(pb_e) as! u64);
        Maps_SubsEntry_encode(pb_e, out);
    }
    for pb_i in m.colors.len {
        let pb_e .= pb_run(Maps_ColorsEntry_entries, m.colors)[pb_i];
        pb_write_varint(out, 34);
        pb_write_varint(out, Maps_ColorsEntry_size_of(pb_e) as! u64);
        Maps_ColorsEntry_encode(pb_e, out);
    }
    out.append(pb_run(pb_bytes, m.pb_unknown));
}

// The size of m's wire encoding, in bytes.
fn Maps_size_of(m: Maps&) -> i64 {
    var n: i64 = 0;
    for pb_i in m.counts.len {
        n += 1 + pb_len_size(Maps_CountsEntry_size_of(pb_run(Maps_CountsEntry_entries, m.counts)[pb_i]));
    }
    for pb_i in m.names.len {
        n += 1 + pb_len_size(Maps_NamesEntry_size_of(pb_run(Maps_NamesEntry_entries, m.names)[pb_i]));
    }
    for pb_i in m.subs.len {
        n += 1 + pb_len_size(Maps_SubsEntry_size_of(pb_run(Maps_SubsEntry_entries, m.subs)[pb_i]));
    }
    for pb_i in m.colors.len {
        n += 1 + pb_len_size(Maps_ColorsEntry_size_of(pb_run(Maps_ColorsEntry_entries, m.colors)[pb_i]));
    }
    n += m.pb_unknown.len;
    return n;
}

// Frees what m owns and resets it to the empty message.
fn Maps_clear(m: Maps&) {
    Maps_clear_counts(m);
    Maps_clear_names(m);
    Maps_clear_subs(m);
    Maps_clear_colors(m);
    m.pb_unknown = pb_bytes_free(m.pb_unknown);
}

// Makes dst a deep copy of src, freeing what dst owned. The two share
// nothing afterwards. Neither may be a sub-message of the other.
fn Maps_copy(dst: Maps&, src: Maps&) {
    if dst .== src { return; }
    Maps_clear(dst);
    dst.counts = pb_resize(Maps_CountsEntry_entries, dst.counts, src.counts.len);
    for pb_i in src.counts.len {
        Maps_CountsEntry_copy(pb_run(Maps_CountsEntry_entries, dst.counts)[pb_i], pb_run(Maps_CountsEntry_entries, src.counts)[pb_i]);
    }
    dst.names = pb_resize(Maps_NamesEntry_entries, dst.names, src.names.len);
    for pb_i in src.names.len {
        Maps_NamesEntry_copy(pb_run(Maps_NamesEntry_entries, dst.names)[pb_i], pb_run(Maps_NamesEntry_entries, src.names)[pb_i]);
    }
    dst.subs = pb_resize(Maps_SubsEntry_entries, dst.subs, src.subs.len);
    for pb_i in src.subs.len {
        Maps_SubsEntry_copy(pb_run(Maps_SubsEntry_entries, dst.subs)[pb_i], pb_run(Maps_SubsEntry_entries, src.subs)[pb_i]);
    }
    dst.colors = pb_resize(Maps_ColorsEntry_entries, dst.colors, src.colors.len);
    for pb_i in src.colors.len {
        Maps_ColorsEntry_copy(pb_run(Maps_ColorsEntry_entries, dst.colors)[pb_i], pb_run(Maps_ColorsEntry_entries, src.colors)[pb_i]);
    }
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
}

// Folds repeated keys in the maps of m and of the messages it holds, which
// decoding appends without looking them up: the last value wins, in the
// place of the first occurrence.
fn Maps_fold_maps(m: Maps&) {
    m.counts = Maps_CountsEntry_fold(m.counts);
    m.names = Maps_NamesEntry_fold(m.names);
    m.subs = Maps_SubsEntry_fold(m.subs);
    m.colors = Maps_ColorsEntry_fold(m.colors);
}

// The number of entries of counts.
fn Maps_counts_len(m: Maps&) -> i64 { return m.counts.len; }

// The key of entry i of counts, in insertion order. Valid until the map next
// changes or m is cleared.
fn Maps_counts_key_at(m: Maps&, i: i64) -> u8[:] { return pb_run(pb_bytes, pb_run(Maps_CountsEntry_entries, m.counts)[i].key); }

// The value of entry i of counts.
fn Maps_counts_value_at(m: Maps&, i: i64) -> i32 { return pb_run(Maps_CountsEntry_entries, m.counts)[i].value; }

// The value with key k and true, or the default and false.
fn Maps_counts_get(m: Maps&, k: const u8[:]) -> i32, bool {
    let pb_i = Maps_CountsEntry_find(m.counts, m.counts.len, k);
    if pb_i < 0 { return 0, false; }
    return pb_run(Maps_CountsEntry_entries, m.counts)[pb_i].value, true;
}

// Sets the value with key k to v, adding an entry if there is none.
fn Maps_counts_put(m: Maps&, k: const u8[:], v: i32) {
    Maps_CountsEntry_slot(m.counts, k).value = v;
}

// Adds an entry without looking for key k, much faster than Maps_counts_put for many.
// Call Maps_fold_maps(m) before reading the map: until then, a repeated key is
// there twice. There, the last value wins, in the place of the first occurrence.
fn Maps_counts_append(m: Maps&, k: const u8[:], v: i32) {
    let pb_i: i64 = m.counts.len;
    m.counts = pb_resize(Maps_CountsEntry_entries, m.counts, pb_i + 1);
    let pb_e .= pb_run(Maps_CountsEntry_entries, m.counts)[pb_i];
    Maps_CountsEntry_set_key(pb_e, k);
    pb_e.value = v;
}

// Removes the entry with key k and frees what it owns. False if there is
// none. Later entries keep their order.
fn Maps_counts_remove(m: Maps&, k: const u8[:]) -> bool {
    let pb_i = Maps_CountsEntry_find(m.counts, m.counts.len, k);
    if pb_i < 0 { return false; }
    let pb_r = pb_run(Maps_CountsEntry_entries, m.counts);
    Maps_CountsEntry_clear(pb_r[pb_i]);
    var pb_j = pb_i;
    while pb_j + 1 < pb_r.len { pb_r[pb_j] = pb_r[pb_j + 1]; pb_j++; }
    pb_r[pb_j] = Maps_CountsEntry { .. };
    m.counts = pb_resize(Maps_CountsEntry_entries, m.counts, pb_j);
    return true;
}

// Frees the entries of counts and everything they own.
fn Maps_clear_counts(m: Maps&) {
    for pb_i in m.counts.len { Maps_CountsEntry_clear(pb_run(Maps_CountsEntry_entries, m.counts)[pb_i]); }
    m.counts = pb_resize(Maps_CountsEntry_entries, m.counts, 0);
}

// The number of entries of names.
fn Maps_names_len(m: Maps&) -> i64 { return m.names.len; }

// The key of entry i of names, in insertion order.
fn Maps_names_key_at(m: Maps&, i: i64) -> i32 { return pb_run(Maps_NamesEntry_entries, m.names)[i].key; }

// The value of entry i of names. Valid until the map next changes or m is
// cleared.
fn Maps_names_value_at(m: Maps&, i: i64) -> u8[:] { return pb_run(pb_bytes, pb_run(Maps_NamesEntry_entries, m.names)[i].value); }

// The value with key k and true, or the default and false. Valid until the
// map next changes or m is cleared.
fn Maps_names_get(m: Maps&, k: i32) -> u8[:], bool {
    let pb_i = Maps_NamesEntry_find(m.names, m.names.len, k);
    if pb_i < 0 { return pb_run(pb_bytes, pb_Span { at: 0, len: 0 }), false; }
    return pb_run(pb_bytes, pb_run(Maps_NamesEntry_entries, m.names)[pb_i].value), true;
}

// Sets the value with key k to a copy of v, adding an entry if there is none.
fn Maps_names_put(m: Maps&, k: i32, v: const u8[:]) {
    Maps_NamesEntry_set_value(Maps_NamesEntry_slot(m.names, k), v);
}

// Adds an entry without looking for key k, much faster than Maps_names_put for many.
// Call Maps_fold_maps(m) before reading the map: until then, a repeated key is
// there twice. There, the last value wins, in the place of the first occurrence.
fn Maps_names_append(m: Maps&, k: i32, v: const u8[:]) {
    let pb_i: i64 = m.names.len;
    m.names = pb_resize(Maps_NamesEntry_entries, m.names, pb_i + 1);
    let pb_e .= pb_run(Maps_NamesEntry_entries, m.names)[pb_i];
    pb_e.key = k;
    Maps_NamesEntry_set_value(pb_e, v);
}

// Removes the entry with key k and frees what it owns. False if there is
// none. Later entries keep their order.
fn Maps_names_remove(m: Maps&, k: i32) -> bool {
    let pb_i = Maps_NamesEntry_find(m.names, m.names.len, k);
    if pb_i < 0 { return false; }
    let pb_r = pb_run(Maps_NamesEntry_entries, m.names);
    Maps_NamesEntry_clear(pb_r[pb_i]);
    var pb_j = pb_i;
    while pb_j + 1 < pb_r.len { pb_r[pb_j] = pb_r[pb_j + 1]; pb_j++; }
    pb_r[pb_j] = Maps_NamesEntry { .. };
    m.names = pb_resize(Maps_NamesEntry_entries, m.names, pb_j);
    return true;
}

// Frees the entries of names and everything they own.
fn Maps_clear_names(m: Maps&) {
    for pb_i in m.names.len { Maps_NamesEntry_clear(pb_run(Maps_NamesEntry_entries, m.names)[pb_i]); }
    m.names = pb_resize(Maps_NamesEntry_entries, m.names, 0);
}

// The number of entries of subs.
fn Maps_subs_len(m: Maps&) -> i64 { return m.subs.len; }

// The key of entry i of subs, in insertion order. Valid until the map next
// changes or m is cleared.
fn Maps_subs_key_at(m: Maps&, i: i64) -> u8[:] { return pb_run(pb_bytes, pb_run(Maps_SubsEntry_entries, m.subs)[i].key); }

// The value of entry i of subs. Valid until its entry is removed or m is
// cleared.
fn Maps_subs_value_at(m: Maps&, i: i64) -> Sub& {
    let pb_l = pb_run(Maps_SubsEntry_entries, m.subs)[i].value.m;
    assert(pb_l);
    return pb_l;
}

// The value with key k, or null if there is none. Valid until its entry
// is removed or m is cleared.
fn Maps_subs_get(m: Maps&, k: const u8[:]) -> Sub&? {
    let pb_i = Maps_SubsEntry_find(m.subs, m.subs.len, k);
    if pb_i < 0 { return null; }
    return pb_run(Maps_SubsEntry_entries, m.subs)[pb_i].value.m;
}

// The value with key k, added empty if there is none.
fn Maps_subs_put(m: Maps&, k: const u8[:]) -> Sub& {
    return Maps_SubsEntry_mutable_value(Maps_SubsEntry_slot(m.subs, k));
}

// Adds an entry without looking for key k, much faster than Maps_subs_put for many.
// Call Maps_fold_maps(m) before reading the map: until then, a repeated key is
// there twice. There, the last value wins, in the place of the first occurrence.
fn Maps_subs_append(m: Maps&, k: const u8[:]) -> Sub& {
    let pb_i: i64 = m.subs.len;
    m.subs = pb_resize(Maps_SubsEntry_entries, m.subs, pb_i + 1);
    let pb_e .= pb_run(Maps_SubsEntry_entries, m.subs)[pb_i];
    Maps_SubsEntry_set_key(pb_e, k);
    return Maps_SubsEntry_mutable_value(pb_e);
}

// Removes the entry with key k and frees what it owns. False if there is
// none. Later entries keep their order.
fn Maps_subs_remove(m: Maps&, k: const u8[:]) -> bool {
    let pb_i = Maps_SubsEntry_find(m.subs, m.subs.len, k);
    if pb_i < 0 { return false; }
    let pb_r = pb_run(Maps_SubsEntry_entries, m.subs);
    Maps_SubsEntry_clear(pb_r[pb_i]);
    var pb_j = pb_i;
    while pb_j + 1 < pb_r.len { pb_r[pb_j] = pb_r[pb_j + 1]; pb_j++; }
    pb_r[pb_j] = Maps_SubsEntry { .. };
    m.subs = pb_resize(Maps_SubsEntry_entries, m.subs, pb_j);
    return true;
}

// Frees the entries of subs and everything they own.
fn Maps_clear_subs(m: Maps&) {
    for pb_i in m.subs.len { Maps_SubsEntry_clear(pb_run(Maps_SubsEntry_entries, m.subs)[pb_i]); }
    m.subs = pb_resize(Maps_SubsEntry_entries, m.subs, 0);
}

// The number of entries of colors.
