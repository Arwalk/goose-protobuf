// Merges buf into m. 0 on success, else a PB_ERR_* code; m then holds a
// partial message, which the caller clears.
fn pb_x_decode_(buf: const u8[:], m: pb_x_&) -> i32 {
    var r = pb_reader(buf);
    pb_x_decode_from_(r, m);
    return r.err;
}

// Appends m's wire encoding, pb_x_size_of_(m) bytes, to out.
fn pb_x_encode_(m: pb_x_&, out: u8[>..]&) {
    out.append(pb_run(pb_bytes, m.pb_unknown));
}

// The size of m's wire encoding, in bytes.
fn pb_x_size_of_(m: pb_x_&) -> i64 {
    var n: i64 = 0;
    n += m.pb_unknown.len;
    return n;
}

// Frees what m owns and resets it to the empty message.
fn pb_x_clear_(m: pb_x_&) {
    m.pb_unknown = pb_bytes_free(m.pb_unknown);
}

// Makes dst a deep copy of src, freeing what dst owned. The two share
// nothing afterwards. Neither may be a sub-message of the other.
fn pb_x_copy_(dst: pb_x_&, src: pb_x_&) {
    if dst .== src { return; }
    pb_x_clear_(dst);
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
}

// message reserved.thread
struct thread {
    pb_unknown: pb_Span,   // unknown fields: raw wire bytes in pb_bytes
}

// A link to a thread in thread_pool, for sub-message fields.
struct thread_Ref { m: thread&<u32 in thread_pool>? }
reusable var thread_pool: thread[>..] = [];
reusable[] var thread_links: thread_Ref[>..] = [];

// Merges the fields in r's window into m; on failure r.err is set.
// Fields it does not know, or with another wire type, are kept as
// unknown fields.
fn thread_decode_from(r: pb_Reader&, m: thread&) {
    var unknown_len: i64 = m.pb_unknown.len;
    while r.pos < r.end {
        let start = r.pos;
        let tag = pb_read_tag(r);
        if r.err != PB_OK { break; }
        pb_unknown_append(r, start, tag, m.pb_unknown, unknown_len);
    }
    m.pb_unknown = pb_bytes_trim(m.pb_unknown, unknown_len);
}

// Merges buf into m. 0 on success, else a PB_ERR_* code; m then holds a
// partial message, which the caller clears.
fn thread_decode(buf: const u8[:], m: thread&) -> i32 {
    var r = pb_reader(buf);
    thread_decode_from(r, m);
    return r.err;
}

// Appends m's wire encoding, thread_size_of(m) bytes, to out.
fn thread_encode(m: thread&, out: u8[>..]&) {
    out.append(pb_run(pb_bytes, m.pb_unknown));
}

// The size of m's wire encoding, in bytes.
fn thread_size_of(m: thread&) -> i64 {
    var n: i64 = 0;
    n += m.pb_unknown.len;
    return n;
}

// Frees what m owns and resets it to the empty message.
fn thread_clear(m: thread&) {
    m.pb_unknown = pb_bytes_free(m.pb_unknown);
}

// Makes dst a deep copy of src, freeing what dst owned. The two share
// nothing afterwards. Neither may be a sub-message of the other.
fn thread_copy(dst: thread&, src: thread&) {
    if dst .== src { return; }
    thread_clear(dst);
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
}

// message reserved.thread.spawn
struct thread_spawn_ {
    pb_unknown: pb_Span,   // unknown fields: raw wire bytes in pb_bytes
}

// A link to a thread_spawn_ in thread_spawn_pool, for sub-message fields.
struct thread_spawn_Ref { m: thread_spawn_&<u32 in thread_spawn_pool>? }
reusable var thread_spawn_pool: thread_spawn_[>..] = [];
reusable[] var thread_spawn_links: thread_spawn_Ref[>..] = [];

// Merges the fields in r's window into m; on failure r.err is set.
// Fields it does not know, or with another wire type, are kept as
// unknown fields.
fn thread_spawn_decode_from(r: pb_Reader&, m: thread_spawn_&) {
    var unknown_len: i64 = m.pb_unknown.len;
    while r.pos < r.end {
        let start = r.pos;
        let tag = pb_read_tag(r);
        if r.err != PB_OK { break; }
        pb_unknown_append(r, start, tag, m.pb_unknown, unknown_len);
    }
    m.pb_unknown = pb_bytes_trim(m.pb_unknown, unknown_len);
}

// Merges buf into m. 0 on success, else a PB_ERR_* code; m then holds a
// partial message, which the caller clears.
fn thread_spawn_decode(buf: const u8[:], m: thread_spawn_&) -> i32 {
    var r = pb_reader(buf);
    thread_spawn_decode_from(r, m);
    return r.err;
}

// Appends m's wire encoding, thread_spawn_size_of(m) bytes, to out.
fn thread_spawn_encode(m: thread_spawn_&, out: u8[>..]&) {
    out.append(pb_run(pb_bytes, m.pb_unknown));
}

// The size of m's wire encoding, in bytes.
fn thread_spawn_size_of(m: thread_spawn_&) -> i64 {
    var n: i64 = 0;
    n += m.pb_unknown.len;
    return n;
}

// Frees what m owns and resets it to the empty message.
fn thread_spawn_clear(m: thread_spawn_&) {
    m.pb_unknown = pb_bytes_free(m.pb_unknown);
}

// Makes dst a deep copy of src, freeing what dst owned. The two share
// nothing afterwards. Neither may be a sub-message of the other.
fn thread_spawn_copy(dst: thread_spawn_&, src: thread_spawn_&) {
    if dst .== src { return; }
    thread_spawn_clear(dst);
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
}

// message reserved.E
struct E {
    x: pb_Span,
    pb_unknown: pb_Span,   // unknown fields: raw wire bytes in pb_bytes
}

// A link to a E in E_pool, for sub-message fields.
struct E_Ref { m: E&<u32 in E_pool>? }
reusable var E_pool: E[>..] = [];
reusable[] var E_links: E_Ref[>..] = [];

// Merges the fields in r's window into m; on failure r.err is set.
// Fields it does not know, or with another wire type, are kept as
// unknown fields.
fn E_decode_from(r: pb_Reader&, m: E&) {
    var unknown_len: i64 = m.pb_unknown.len;
    while r.pos < r.end {
        let start = r.pos;
        let tag = pb_read_tag(r);
        if r.err != PB_OK { break; }
        if tag == 10 {
            m.x = pb_read_string(r, m.x);
        } else {
            pb_unknown_append(r, start, tag, m.pb_unknown, unknown_len);
        }
    }
    m.pb_unknown = pb_bytes_trim(m.pb_unknown, unknown_len);
}

// Merges buf into m. 0 on success, else a PB_ERR_* code; m then holds a
// partial message, which the caller clears.
fn E_decode(buf: const u8[:], m: E&) -> i32 {
    var r = pb_reader(buf);
    E_decode_from(r, m);
    return r.err;
}

// Appends m's wire encoding, E_size_of(m) bytes, to out.
fn E_encode(m: E&, out: u8[>..]&) {
    if m.x.len > 0 {
        pb_write_varint(out, 10);
        pb_write_bytes(out, m.x);
    }
    out.append(pb_run(pb_bytes, m.pb_unknown));
}

// The size of m's wire encoding, in bytes.
fn E_size_of(m: E&) -> i64 {
    var n: i64 = 0;
    if m.x.len > 0 { n += 1 + pb_bytes_size(m.x); }
    n += m.pb_unknown.len;
    return n;
}

// Frees what m owns and resets it to the empty message.
fn E_clear(m: E&) {
    m.x = pb_bytes_free(m.x);
    m.pb_unknown = pb_bytes_free(m.pb_unknown);
}

// Makes dst a deep copy of src, freeing what dst owned. The two share
// nothing afterwards. Neither may be a sub-message of the other.
fn E_copy(dst: E&, src: E&) {
    if dst .== src { return; }
    E_clear(dst);
    dst.x = pb_bytes_copy(src.x);
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
}

// The contents of x, in pb_bytes: valid until it is next set or m
// is cleared.
fn E_x(m: E&) -> u8[:] { return pb_run(pb_bytes, m.x); }

// Sets x to a copy of v.
fn E_set_x(m: E&, v: const u8[:]) {
    m.x = pb_bytes_set(m.x, v);
}
