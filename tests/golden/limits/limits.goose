    let pb_had6: i64 = m.packed.len;
    var pb_len6: i64 = pb_had6;
    let pb_had7: i64 = m.flags.len;
    var pb_len7: i64 = pb_had7;
    let pb_had8: i64 = m.names.len;
    var pb_len8: i64 = pb_had8;
    let pb_had9: i64 = m.blobs.len;
    var pb_len9: i64 = pb_had9;
    let pb_had12: i64 = m.closed.len;
    var pb_len12: i64 = pb_had12;
    let pb_had13: i64 = m.closed_packed.len;
    var pb_len13: i64 = pb_had13;
    let pb_had15: i64 = m.choices.len;
    var pb_len15: i64 = pb_had15;
    while r.pos < r.end {
        let start = r.pos;
        let tag = pb_read_tag(r);
        if r.err != PB_OK { break; }
        if tag == 10 {
            pb_charge(r, 48);
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            if r.depth >= PB_MAX_DEPTH { pb_fail(r, PB_ERR_DEPTH); break; }
            pb_reserve(Leaf_links, m.leaves, pb_len1, pb_had1);
            let pb_sub .= Leaf_pool.alloc_ref(Leaf { .. });
            pb_run(Leaf_links, m.leaves)[pb_len1].m .= pb_sub;
            pb_len1++;
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            r.depth++;
            Leaf_decode_from(r, pb_sub);
            if r.err != PB_OK { break; }
            r.depth--;
            r.end = pb_outer;
        } else if tag == 19 {
            pb_charge(r, 40);
            let pb_body = r.pos;
            let pb_stop = pb_skip_group(r, tag);
            if r.err != PB_OK { break; }
            let pb_after = r.pos;
            pb_reserve(All_Items_links, m.items, pb_len2, pb_had2);
            let pb_sub .= All_Items_pool.alloc_ref(All_Items { .. });
            pb_run(All_Items_links, m.items)[pb_len2].m .= pb_sub;
            pb_len2++;
            let pb_outer = r.end;
            r.pos = pb_body;
            r.end = pb_stop;
            r.depth++;
            All_Items_decode_from(r, pb_sub);
            if r.err != PB_OK { break; }
            r.depth--;
            r.end = pb_outer;
            r.pos = pb_after;
        } else if tag == 26 {
            pb_charge(r, 48);
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            if r.depth >= PB_MAX_DEPTH { pb_fail(r, PB_ERR_DEPTH); break; }
            pb_reserve(All_NumbersEntry_entries, m.numbers, pb_len3, pb_had3);
            let pb_e .= pb_run(All_NumbersEntry_entries, m.numbers)[pb_len3];
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            r.depth++;
            All_NumbersEntry_decode_from(r, pb_e);
            if r.err != PB_OK { All_NumbersEntry_clear(pb_e); break; }
            r.depth--;
            r.end = pb_outer;
            All_NumbersEntry_place(pb_e);
            pb_len3++;
        } else if tag == 34 {
            pb_charge(r, 48);
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            if r.depth >= PB_MAX_DEPTH { pb_fail(r, PB_ERR_DEPTH); break; }
            pb_reserve(All_NamedEntry_entries, m.named, pb_len4, pb_had4);
            let pb_e .= pb_run(All_NamedEntry_entries, m.named)[pb_len4];
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            r.depth++;
            All_NamedEntry_decode_from(r, pb_e);
            if r.err != PB_OK { All_NamedEntry_clear(pb_e); break; }
            r.depth--;
            r.end = pb_outer;
            All_NamedEntry_place(pb_e);
            pb_len4++;
        } else if tag == 40 {
            pb_charge(r, 8);
            pb_append(pb_i64s, m.unpacked, pb_len5, pb_had5, pb_u64_to_int64(pb_read_varint(r)));
        } else if tag == 42 {
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            while r.pos < r.end {
                pb_charge(r, 8);
                pb_append(pb_i64s, m.unpacked, pb_len5, pb_had5, pb_u64_to_int64(pb_read_varint(r)));
            }
            if r.err != PB_OK { break; }
            r.end = pb_outer;
        } else if tag == 48 {
            pb_charge(r, 8);
            pb_append(pb_i64s, m.packed, pb_len6, pb_had6, pb_u64_to_int64(pb_read_varint(r)));
        } else if tag == 50 {
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            while r.pos < r.end {
                pb_charge(r, 8);
                pb_append(pb_i64s, m.packed, pb_len6, pb_had6, pb_u64_to_int64(pb_read_varint(r)));
            }
            if r.err != PB_OK { break; }
            r.end = pb_outer;
        } else if tag == 56 {
            pb_charge(r, 1);
            pb_append(pb_bools, m.flags, pb_len7, pb_had7, pb_read_varint(r) != 0);
        } else if tag == 58 {
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            while r.pos < r.end {
                pb_charge(r, 1);
                pb_append(pb_bools, m.flags, pb_len7, pb_had7, pb_read_varint(r) != 0);
            }
            if r.err != PB_OK { break; }
            r.end = pb_outer;
        } else if tag == 66 {
            pb_charge(r, 8);
            pb_append(pb_spans, m.names, pb_len8, pb_had8, pb_read_bytes(r, pb_Span { at: 0, len: 0 }));
        } else if tag == 74 {
            pb_charge(r, 8);
            pb_append(pb_spans, m.blobs, pb_len9, pb_had9, pb_read_bytes(r, pb_Span { at: 0, len: 0 }));
        } else if tag == 82 {
            m.text = pb_read_bytes(r, m.text);
            m.pb_has0 |= 0x00000001;
        } else if tag == 90 {
            m.blob = pb_read_bytes(r, m.blob);
            m.pb_has0 |= 0x00000002;
        } else if tag == 96 {
            let pb_v = pb_u64_to_int32(pb_read_varint(r));
            if r.err != PB_OK { break; }
            if (pb_v >= 0 && pb_v <= 1) {
                pb_charge(r, 4);
                pb_append(pb_i32s, m.closed, pb_len12, pb_had12, pb_v);
            } else {
                pb_unknown_keep(r, start, m.pb_unknown, unknown_len, unknown_had);
            }
        } else if tag == 98 {
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            while r.pos < r.end {
                let pb_at = r.pos;
                let pb_v = pb_u64_to_int32(pb_read_varint(r));
                if r.err != PB_OK { break; }
                if (pb_v >= 0 && pb_v <= 1) {
                    pb_charge(r, 4);
                    pb_append(pb_i32s, m.closed, pb_len12, pb_had12, pb_v);
                } else {
                    pb_unknown_element(r, 96, pb_at, m.pb_unknown, unknown_len, unknown_had);
                }
            }
            if r.err != PB_OK { break; }
            r.end = pb_outer;
        } else if tag == 104 {
            let pb_v = pb_u64_to_int32(pb_read_varint(r));
            if r.err != PB_OK { break; }
            if (pb_v >= 0 && pb_v <= 1) {
                pb_charge(r, 4);
                pb_append(pb_i32s, m.closed_packed, pb_len13, pb_had13, pb_v);
            } else {
                pb_unknown_keep(r, start, m.pb_unknown, unknown_len, unknown_had);
            }
        } else if tag == 106 {
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            while r.pos < r.end {
                let pb_at = r.pos;
                let pb_v = pb_u64_to_int32(pb_read_varint(r));
                if r.err != PB_OK { break; }
                if (pb_v >= 0 && pb_v <= 1) {
                    pb_charge(r, 4);
                    pb_append(pb_i32s, m.closed_packed, pb_len13, pb_had13, pb_v);
                } else {
                    pb_unknown_element(r, 104, pb_at, m.pb_unknown, unknown_len, unknown_had);
                }
            }
            if r.err != PB_OK { break; }
            r.end = pb_outer;
        } else if tag == 114 {
            pb_charge(r, 48);
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            if r.depth >= PB_MAX_DEPTH { pb_fail(r, PB_ERR_DEPTH); break; }
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            r.depth++;
            Tree_decode_from(r, All_mutable_tree(m));
            if r.err != PB_OK { break; }
            r.depth--;
            r.end = pb_outer;
        } else if tag == 122 {
            pb_charge(r, 48);
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            if r.depth >= PB_MAX_DEPTH { pb_fail(r, PB_ERR_DEPTH); break; }
            pb_reserve(Choice_links, m.choices, pb_len15, pb_had15);
            let pb_sub .= Choice_pool.alloc_ref(Choice { .. });
            pb_run(Choice_links, m.choices)[pb_len15].m .= pb_sub;
            pb_len15++;
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            r.depth++;
            Choice_decode_from(r, pb_sub);
            if r.err != PB_OK { break; }
            r.depth--;
            r.end = pb_outer;
        } else {
            pb_unknown_append(r, start, tag, m.pb_unknown, unknown_len, unknown_had);
        }
    }
    m.leaves = pb_trim(Leaf_links, m.leaves, pb_len1);
    m.items = pb_trim(All_Items_links, m.items, pb_len2);
    m.numbers = pb_trim(All_NumbersEntry_entries, m.numbers, pb_len3);
    m.named = pb_trim(All_NamedEntry_entries, m.named, pb_len4);
    m.unpacked = pb_trim(pb_i64s, m.unpacked, pb_len5);
    m.packed = pb_trim(pb_i64s, m.packed, pb_len6);
    m.flags = pb_trim(pb_bools, m.flags, pb_len7);
    m.names = pb_trim(pb_spans, m.names, pb_len8);
    m.blobs = pb_trim(pb_spans, m.blobs, pb_len9);
    m.closed = pb_trim(pb_i32s, m.closed, pb_len12);
    m.closed_packed = pb_trim(pb_i32s, m.closed_packed, pb_len13);
    m.choices = pb_trim(Choice_links, m.choices, pb_len15);
    m.pb_unknown = pb_bytes_trim(m.pb_unknown, unknown_len);
}

// Merges buf into m. 0 on success, else a PB_ERR_* code; m then holds a
// partial message, which the caller clears.
fn All_decode(buf: const u8[:], m: All&) -> i32 {
    var r = pb_reader(buf);
    All_decode_from(r, m);
    if r.err == PB_OK { All_fold_maps(m); }
    return r.err;
}

// Appends m's wire encoding, All_size_of(m) bytes, to out.
fn All_encode(m: All&, out: u8[>..]&) {
    for pb_ref in pb_run(Leaf_links, m.leaves) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        pb_write_varint(out, 10);
        pb_write_varint(out, Leaf_size_of(pb_l) as! u64);
        Leaf_encode(pb_l, out);
    }
    for pb_ref in pb_run(All_Items_links, m.items) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        pb_write_varint(out, 19);
        All_Items_encode(pb_l, out);
        pb_write_varint(out, 20);
    }
    for pb_i in m.numbers.len {
        let pb_e .= pb_run(All_NumbersEntry_entries, m.numbers)[pb_i];
        pb_write_varint(out, 26);
        pb_write_varint(out, All_NumbersEntry_size_of(pb_e) as! u64);
        All_NumbersEntry_encode(pb_e, out);
    }
    for pb_i in m.named.len {
        let pb_e .= pb_run(All_NamedEntry_entries, m.named)[pb_i];
        pb_write_varint(out, 34);
        pb_write_varint(out, All_NamedEntry_size_of(pb_e) as! u64);
        All_NamedEntry_encode(pb_e, out);
    }
    if m.unpacked.len > 0 {
        for pb_v in pb_run(pb_i64s, m.unpacked) {
            pb_write_varint(out, 40);
            pb_write_varint(out, pb_int64_to_u64(pb_v));
        }
    }
    if m.packed.len > 0 {
        pb_write_varint(out, 50);
        var pb_n: i64 = 0;
        for pb_v in pb_run(pb_i64s, m.packed) { pb_n += pb_varint_size(pb_int64_to_u64(pb_v)); }
        pb_write_varint(out, pb_n as! u64);
        for pb_v in pb_run(pb_i64s, m.packed) { pb_write_varint(out, pb_int64_to_u64(pb_v)); }
    }
    if m.flags.len > 0 {
        pb_write_varint(out, 58);
        let pb_n: i64 = 1 * m.flags.len;
        pb_write_varint(out, pb_n as! u64);
        for pb_v in pb_run(pb_bools, m.flags) { pb_write_varint(out, pb_bool_to_u64(pb_v)); }
    }
    for pb_v in pb_run(pb_spans, m.names) {
        pb_write_varint(out, 66);
        pb_write_bytes(out, pb_v);
    }
    for pb_v in pb_run(pb_spans, m.blobs) {
        pb_write_varint(out, 74);
        pb_write_bytes(out, pb_v);
    }
    if (m.pb_has0 & 0x00000001) != 0 {
        pb_write_varint(out, 82);
        pb_write_bytes(out, m.text);
    }
    if (m.pb_has0 & 0x00000002) != 0 {
        pb_write_varint(out, 90);
        pb_write_bytes(out, m.blob);
    }
    if m.closed.len > 0 {
        for pb_v in pb_run(pb_i32s, m.closed) {
            pb_write_varint(out, 96);
            pb_write_varint(out, pb_int32_to_u64(pb_v));
        }
    }
    if m.closed_packed.len > 0 {
        pb_write_varint(out, 106);
        var pb_n: i64 = 0;
        for pb_v in pb_run(pb_i32s, m.closed_packed) { pb_n += pb_varint_size(pb_int32_to_u64(pb_v)); }
        pb_write_varint(out, pb_n as! u64);
        for pb_v in pb_run(pb_i32s, m.closed_packed) { pb_write_varint(out, pb_int32_to_u64(pb_v)); }
    }
    let pb_f14 = m.tree.m;
    if pb_f14 {
        pb_write_varint(out, 114);
        pb_write_varint(out, Tree_size_of(pb_f14) as! u64);
        Tree_encode(pb_f14, out);
    }
    for pb_ref in pb_run(Choice_links, m.choices) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        pb_write_varint(out, 122);
        pb_write_varint(out, Choice_size_of(pb_l) as! u64);
        Choice_encode(pb_l, out);
    }
    out.append(pb_run(pb_bytes, m.pb_unknown));
}

// The size of m's wire encoding, in bytes.
fn All_size_of(m: All&) -> i64 {
    var n: i64 = 0;
    for pb_ref in pb_run(Leaf_links, m.leaves) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        n += 1 + pb_len_size(Leaf_size_of(pb_l));
    }
    for pb_ref in pb_run(All_Items_links, m.items) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        n += 2 + All_Items_size_of(pb_l);
    }
    for pb_i in m.numbers.len {
        n += 1 + pb_len_size(All_NumbersEntry_size_of(pb_run(All_NumbersEntry_entries, m.numbers)[pb_i]));
    }
    for pb_i in m.named.len {
        n += 1 + pb_len_size(All_NamedEntry_size_of(pb_run(All_NamedEntry_entries, m.named)[pb_i]));
    }
    if m.unpacked.len > 0 {
        var pb_n: i64 = 0;
        for pb_v in pb_run(pb_i64s, m.unpacked) { pb_n += pb_varint_size(pb_int64_to_u64(pb_v)); }
        n += 1 * m.unpacked.len + pb_n;
    }
    if m.packed.len > 0 {
        var pb_n: i64 = 0;
        for pb_v in pb_run(pb_i64s, m.packed) { pb_n += pb_varint_size(pb_int64_to_u64(pb_v)); }
        n += 1 + pb_len_size(pb_n);
    }
    if m.flags.len > 0 {
        let pb_n: i64 = 1 * m.flags.len;
        n += 1 + pb_len_size(pb_n);
    }
    for pb_v in pb_run(pb_spans, m.names) { n += 1 + pb_bytes_size(pb_v); }
    for pb_v in pb_run(pb_spans, m.blobs) { n += 1 + pb_bytes_size(pb_v); }
    if (m.pb_has0 & 0x00000001) != 0 { n += 1 + pb_bytes_size(m.text); }
    if (m.pb_has0 & 0x00000002) != 0 { n += 1 + pb_bytes_size(m.blob); }
    if m.closed.len > 0 {
        var pb_n: i64 = 0;
        for pb_v in pb_run(pb_i32s, m.closed) { pb_n += pb_varint_size(pb_int32_to_u64(pb_v)); }
        n += 1 * m.closed.len + pb_n;
    }
    if m.closed_packed.len > 0 {
        var pb_n: i64 = 0;
        for pb_v in pb_run(pb_i32s, m.closed_packed) { pb_n += pb_varint_size(pb_int32_to_u64(pb_v)); }
        n += 1 + pb_len_size(pb_n);
    }
    let pb_f14 = m.tree.m;
    if pb_f14 { n += 1 + pb_len_size(Tree_size_of(pb_f14)); }
    for pb_ref in pb_run(Choice_links, m.choices) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        n += 1 + pb_len_size(Choice_size_of(pb_l));
    }
    n += m.pb_unknown.len;
    return n;
}

// Frees what m owns and resets it to the empty message.
fn All_clear(m: All&) {
    All_clear_leaves(m);
    All_clear_items(m);
    All_clear_numbers(m);
    All_clear_named(m);
    m.unpacked = pb_resize(pb_i64s, m.unpacked, 0);
    m.packed = pb_resize(pb_i64s, m.packed, 0);
    m.flags = pb_resize(pb_bools, m.flags, 0);
    m.names = pb_spans_free(m.names);
    m.blobs = pb_spans_free(m.blobs);
    m.text = pb_bytes_free(m.text);
    m.blob = pb_bytes_free(m.blob);
    m.closed = pb_resize(pb_i32s, m.closed, 0);
    m.closed_packed = pb_resize(pb_i32s, m.closed_packed, 0);
    All_clear_tree(m);
    All_clear_choices(m);
    m.pb_has0 = 0;
    m.pb_unknown = pb_bytes_free(m.pb_unknown);
}

// Makes dst a deep copy of src, freeing what dst owned. The two share
// nothing afterwards. Neither may be a sub-message of the other.
fn All_copy(dst: All&, src: All&) {
    if dst .== src { return; }
    All_clear(dst);
    dst.leaves = pb_resize(Leaf_links, dst.leaves, src.leaves.len);
    for pb_i in src.leaves.len {
        let pb_l = pb_run(Leaf_links, src.leaves)[pb_i].m;
        guard pb_l else { continue; }
        let pb_c .= Leaf_pool.alloc_ref(Leaf { .. });
        pb_run(Leaf_links, dst.leaves)[pb_i].m .= pb_c;
        Leaf_copy(pb_c, pb_l);
    }
    dst.items = pb_resize(All_Items_links, dst.items, src.items.len);
    for pb_i in src.items.len {
        let pb_l = pb_run(All_Items_links, src.items)[pb_i].m;
        guard pb_l else { continue; }
        let pb_c .= All_Items_pool.alloc_ref(All_Items { .. });
        pb_run(All_Items_links, dst.items)[pb_i].m .= pb_c;
        All_Items_copy(pb_c, pb_l);
    }
    dst.numbers = pb_resize(All_NumbersEntry_entries, dst.numbers, src.numbers.len);
    for pb_i in src.numbers.len {
        All_NumbersEntry_copy(pb_run(All_NumbersEntry_entries, dst.numbers)[pb_i], pb_run(All_NumbersEntry_entries, src.numbers)[pb_i]);
    }
    dst.named = pb_resize(All_NamedEntry_entries, dst.named, src.named.len);
    for pb_i in src.named.len {
        All_NamedEntry_copy(pb_run(All_NamedEntry_entries, dst.named)[pb_i], pb_run(All_NamedEntry_entries, src.named)[pb_i]);
    }
    dst.unpacked = pb_copy_run(pb_i64s, src.unpacked);
    dst.packed = pb_copy_run(pb_i64s, src.packed);
    dst.flags = pb_copy_run(pb_bools, src.flags);
    dst.names = pb_spans_copy(src.names);
    dst.blobs = pb_spans_copy(src.blobs);
    dst.text = pb_bytes_copy(src.text);
    dst.blob = pb_bytes_copy(src.blob);
    dst.closed = pb_copy_run(pb_i32s, src.closed);
    dst.closed_packed = pb_copy_run(pb_i32s, src.closed_packed);
    let pb_f14 = src.tree.m;
    if pb_f14 { Tree_copy(All_mutable_tree(dst), pb_f14); }
    dst.choices = pb_resize(Choice_links, dst.choices, src.choices.len);
    for pb_i in src.choices.len {
        let pb_l = pb_run(Choice_links, src.choices)[pb_i].m;
        guard pb_l else { continue; }
        let pb_c .= Choice_pool.alloc_ref(Choice { .. });
        pb_run(Choice_links, dst.choices)[pb_i].m .= pb_c;
        Choice_copy(pb_c, pb_l);
    }
    dst.pb_has0 = src.pb_has0;
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
}

// Folds repeated keys in the maps of m and of the messages it holds, which
// decoding appends without looking them up: the last value wins, in the
// place of the first occurrence.
fn All_fold_maps(m: All&) {
    m.numbers = All_NumbersEntry_fold(m.numbers);
    m.named = All_NamedEntry_fold(m.named);
}

// The number of messages of leaves.
fn All_leaves_len(m: All&) -> i64 { return m.leaves.len; }

// Message i of leaves. Valid until it or m is cleared.
fn All_leaves_at(m: All&, i: i64) -> Leaf& {
    let pb_l = pb_run(Leaf_links, m.leaves)[i].m;
    assert(pb_l);
    return pb_l;
}

// Adds an empty message to leaves and returns it.
fn All_add_leaves(m: All&) -> Leaf& {
    let pb_i: i64 = m.leaves.len;
    m.leaves = pb_resize(Leaf_links, m.leaves, pb_i + 1);
    let pb_new .= Leaf_pool.alloc_ref(Leaf { .. });
    pb_run(Leaf_links, m.leaves)[pb_i].m .= pb_new;
    return pb_new;
}

// Frees the messages of leaves and everything they own.
fn All_clear_leaves(m: All&) {
    for pb_ref in pb_run(Leaf_links, m.leaves) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        Leaf_clear(pb_l);
        Leaf_pool.free(Leaf_pool.index_of(pb_l));
    }
    m.leaves = pb_resize(Leaf_links, m.leaves, 0);
}

// The number of messages of items.
fn All_items_len(m: All&) -> i64 { return m.items.len; }

// Message i of items. Valid until it or m is cleared.
fn All_items_at(m: All&, i: i64) -> All_Items& {
    let pb_l = pb_run(All_Items_links, m.items)[i].m;
    assert(pb_l);
    return pb_l;
}

// Adds an empty message to items and returns it.
fn All_add_items(m: All&) -> All_Items& {
    let pb_i: i64 = m.items.len;
    m.items = pb_resize(All_Items_links, m.items, pb_i + 1);
    let pb_new .= All_Items_pool.alloc_ref(All_Items { .. });
    pb_run(All_Items_links, m.items)[pb_i].m .= pb_new;
    return pb_new;
}

// Frees the messages of items and everything they own.
fn All_clear_items(m: All&) {
    for pb_ref in pb_run(All_Items_links, m.items) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        All_Items_clear(pb_l);
        All_Items_pool.free(All_Items_pool.index_of(pb_l));
    }
    m.items = pb_resize(All_Items_links, m.items, 0);
}

// The number of entries of numbers.
fn All_numbers_len(m: All&) -> i64 { return m.numbers.len; }

// The key of entry i of numbers, in insertion order.
fn All_numbers_key_at(m: All&, i: i64) -> i32 { return pb_run(All_NumbersEntry_entries, m.numbers)[i].key; }

// The value of entry i of numbers.
fn All_numbers_value_at(m: All&, i: i64) -> i32 { return pb_run(All_NumbersEntry_entries, m.numbers)[i].value; }

// The value with key k and true, or the default and false.
fn All_numbers_get(m: All&, k: i32) -> i32, bool {
    let pb_i = All_NumbersEntry_find(m.numbers, m.numbers.len, k);
    if pb_i < 0 { return 0, false; }
    return pb_run(All_NumbersEntry_entries, m.numbers)[pb_i].value, true;
}

// Sets the value with key k to v, adding an entry if there is none.
fn All_numbers_put(m: All&, k: i32, v: i32) {
    All_NumbersEntry_slot(m.numbers, k).value = v;
}

// Adds an entry without looking for key k, much faster than All_numbers_put for many.
// Call All_fold_maps(m) before reading the map: until then, a repeated key is
// there twice. There, the last value wins, in the place of the first occurrence.
fn All_numbers_append(m: All&, k: i32, v: i32) {
    let pb_i: i64 = m.numbers.len;
    m.numbers = pb_resize(All_NumbersEntry_entries, m.numbers, pb_i + 1);
    let pb_e .= pb_run(All_NumbersEntry_entries, m.numbers)[pb_i];
    pb_e.key = k;
    pb_e.value = v;
}

// Removes the entry with key k and frees what it owns. False if there is
// none. Later entries keep their order.
fn All_numbers_remove(m: All&, k: i32) -> bool {
    let pb_i = All_NumbersEntry_find(m.numbers, m.numbers.len, k);
    if pb_i < 0 { return false; }
    let pb_r = pb_run(All_NumbersEntry_entries, m.numbers);
    All_NumbersEntry_clear(pb_r[pb_i]);
    var pb_j = pb_i;
    while pb_j + 1 < pb_r.len { pb_r[pb_j] = pb_r[pb_j + 1]; pb_j++; }
    pb_r[pb_j] = All_NumbersEntry { .. };
    m.numbers = pb_resize(All_NumbersEntry_entries, m.numbers, pb_j);
    return true;
}

// Frees the entries of numbers and everything they own.
fn All_clear_numbers(m: All&) {
    for pb_i in m.numbers.len { All_NumbersEntry_clear(pb_run(All_NumbersEntry_entries, m.numbers)[pb_i]); }
    m.numbers = pb_resize(All_NumbersEntry_entries, m.numbers, 0);
}

// The number of entries of named.
fn All_named_len(m: All&) -> i64 { return m.named.len; }

// The key of entry i of named, in insertion order. Valid until the map next
// changes or m is cleared.
fn All_named_key_at(m: All&, i: i64) -> u8[:] { return pb_run(pb_bytes, pb_run(All_NamedEntry_entries, m.named)[i].key); }

// The value of entry i of named. Valid until its entry is removed or m is
// cleared.
fn All_named_value_at(m: All&, i: i64) -> Leaf& {
    let pb_l = pb_run(All_NamedEntry_entries, m.named)[i].value.m;
    assert(pb_l);
    return pb_l;
}

// The value with key k, or null if there is none. Valid until its entry
// is removed or m is cleared.
fn All_named_get(m: All&, k: const u8[:]) -> Leaf&? {
    let pb_i = All_NamedEntry_find(m.named, m.named.len, k);
    if pb_i < 0 { return null; }
    return pb_run(All_NamedEntry_entries, m.named)[pb_i].value.m;
}

// The value with key k, added empty if there is none.
fn All_named_put(m: All&, k: const u8[:]) -> Leaf& {
    return All_NamedEntry_mutable_value(All_NamedEntry_slot(m.named, k));
}

// Adds an entry without looking for key k, much faster than All_named_put for many.
// Call All_fold_maps(m) before reading the map: until then, a repeated key is
// there twice. There, the last value wins, in the place of the first occurrence.
fn All_named_append(m: All&, k: const u8[:]) -> Leaf& {
    let pb_i: i64 = m.named.len;
    m.named = pb_resize(All_NamedEntry_entries, m.named, pb_i + 1);
    let pb_e .= pb_run(All_NamedEntry_entries, m.named)[pb_i];
    All_NamedEntry_set_key(pb_e, k);
    return All_NamedEntry_mutable_value(pb_e);
}

// Removes the entry with key k and frees what it owns. False if there is
// none. Later entries keep their order.
fn All_named_remove(m: All&, k: const u8[:]) -> bool {
    let pb_i = All_NamedEntry_find(m.named, m.named.len, k);
    if pb_i < 0 { return false; }
    let pb_r = pb_run(All_NamedEntry_entries, m.named);
    All_NamedEntry_clear(pb_r[pb_i]);
    var pb_j = pb_i;
    while pb_j + 1 < pb_r.len { pb_r[pb_j] = pb_r[pb_j + 1]; pb_j++; }
    pb_r[pb_j] = All_NamedEntry { .. };
    m.named = pb_resize(All_NamedEntry_entries, m.named, pb_j);
    return true;
}

// Frees the entries of named and everything they own.
fn All_clear_named(m: All&) {
    for pb_i in m.named.len { All_NamedEntry_clear(pb_run(All_NamedEntry_entries, m.named)[pb_i]); }
    m.named = pb_resize(All_NamedEntry_entries, m.named, 0);
}

// The number of values of unpacked.
fn All_unpacked_len(m: All&) -> i64 { return m.unpacked.len; }

// The values of unpacked, in pb_i64s: valid until it is next changed or m is
// cleared.
fn All_unpacked(m: All&) -> i64[:] { return pb_run(pb_i64s, m.unpacked); }

fn All_unpacked_at(m: All&, i: i64) -> i64 { return pb_run(pb_i64s, m.unpacked)[i]; }

// Adds a value to unpacked. This moves its values, so All_set_unpacked is better for many.
fn All_add_unpacked(m: All&, v: i64) { m.unpacked = pb_add(pb_i64s, m.unpacked, v); }

// Sets unpacked to a copy of v.
fn All_set_unpacked(m: All&, v: const i64[:]) { m.unpacked = pb_set_run(pb_i64s, m.unpacked, v); }

fn All_clear_unpacked(m: All&) { m.unpacked = pb_resize(pb_i64s, m.unpacked, 0); }

// The number of values of packed.
fn All_packed_len(m: All&) -> i64 { return m.packed.len; }

// The values of packed, in pb_i64s: valid until it is next changed or m is
// cleared.
fn All_packed(m: All&) -> i64[:] { return pb_run(pb_i64s, m.packed); }

fn All_packed_at(m: All&, i: i64) -> i64 { return pb_run(pb_i64s, m.packed)[i]; }

// Adds a value to packed. This moves its values, so All_set_packed is better for many.
fn All_add_packed(m: All&, v: i64) { m.packed = pb_add(pb_i64s, m.packed, v); }

// Sets packed to a copy of v.
fn All_set_packed(m: All&, v: const i64[:]) { m.packed = pb_set_run(pb_i64s, m.packed, v); }

fn All_clear_packed(m: All&) { m.packed = pb_resize(pb_i64s, m.packed, 0); }

// The number of values of flags.
fn All_flags_len(m: All&) -> i64 { return m.flags.len; }

// The values of flags, in pb_bools: valid until it is next changed or m is
// cleared.
fn All_flags(m: All&) -> bool[:] { return pb_run(pb_bools, m.flags); }

fn All_flags_at(m: All&, i: i64) -> bool { return pb_run(pb_bools, m.flags)[i]; }

// Adds a value to flags. This moves its values, so All_set_flags is better for many.
fn All_add_flags(m: All&, v: bool) { m.flags = pb_add(pb_bools, m.flags, v); }

// Sets flags to a copy of v.
fn All_set_flags(m: All&, v: const bool[:]) { m.flags = pb_set_run(pb_bools, m.flags, v); }

fn All_clear_flags(m: All&) { m.flags = pb_resize(pb_bools, m.flags, 0); }

// The number of values of names.
fn All_names_len(m: All&) -> i64 { return m.names.len; }

// The contents of value i of names, in pb_bytes: valid until it is next
// set or m is cleared.
fn All_names_at(m: All&, i: i64) -> u8[:] { return pb_run(pb_bytes, pb_run(pb_spans, m.names)[i]); }

// Adds a copy of v to names.
fn All_add_names(m: All&, v: const u8[:]) { m.names = pb_spans_add(m.names, v); }

// Sets value i of names to a copy of v.
fn All_set_names(m: All&, i: i64, v: const u8[:]) { pb_spans_set(m.names, i, v); }

fn All_clear_names(m: All&) { m.names = pb_spans_free(m.names); }

// The number of values of blobs.
fn All_blobs_len(m: All&) -> i64 { return m.blobs.len; }

// The contents of value i of blobs, in pb_bytes: valid until it is next
// set or m is cleared.
fn All_blobs_at(m: All&, i: i64) -> u8[:] { return pb_run(pb_bytes, pb_run(pb_spans, m.blobs)[i]); }

// Adds a copy of v to blobs.
fn All_add_blobs(m: All&, v: const u8[:]) { m.blobs = pb_spans_add(m.blobs, v); }

// Sets value i of blobs to a copy of v.
fn All_set_blobs(m: All&, i: i64, v: const u8[:]) { pb_spans_set(m.blobs, i, v); }

fn All_clear_blobs(m: All&) { m.blobs = pb_spans_free(m.blobs); }

// The contents of text, in pb_bytes: valid until it is next set or m
// is cleared.
fn All_text(m: All&) -> u8[:] { return pb_run(pb_bytes, m.text); }

// Sets text to a copy of v and marks it present:
// it is encoded even when empty.
fn All_set_text(m: All&, v: const u8[:]) {
    m.text = pb_bytes_set(m.text, v);
    m.pb_has0 |= 0x00000001;
}

fn All_has_text(m: All&) -> bool { return (m.pb_has0 & 0x00000001) != 0; }

fn All_clear_text(m: All&) {
    m.text = pb_bytes_free(m.text);
    m.pb_has0 &= 0xfffffffe;
}

// The contents of blob, in pb_bytes: valid until it is next set or m
// is cleared.
fn All_blob(m: All&) -> u8[:] { return pb_run(pb_bytes, m.blob); }

// Sets blob to a copy of v and marks it present:
// it is encoded even when empty.
fn All_set_blob(m: All&, v: const u8[:]) {
    m.blob = pb_bytes_set(m.blob, v);
    m.pb_has0 |= 0x00000002;
}

fn All_has_blob(m: All&) -> bool { return (m.pb_has0 & 0x00000002) != 0; }

fn All_clear_blob(m: All&) {
    m.blob = pb_bytes_free(m.blob);
    m.pb_has0 &= 0xfffffffd;
}

// The number of values of closed.
fn All_closed_len(m: All&) -> i64 { return m.closed.len; }

// The values of closed, in pb_i32s: valid until it is next changed or m is
// cleared.
fn All_closed(m: All&) -> i32[:] { return pb_run(pb_i32s, m.closed); }

fn All_closed_at(m: All&, i: i64) -> i32 { return pb_run(pb_i32s, m.closed)[i]; }

// Adds a value to closed. This moves its values, so All_set_closed is better for many.
fn All_add_closed(m: All&, v: i32) { m.closed = pb_add(pb_i32s, m.closed, v); }

// Sets closed to a copy of v.
fn All_set_closed(m: All&, v: const i32[:]) { m.closed = pb_set_run(pb_i32s, m.closed, v); }

fn All_clear_closed(m: All&) { m.closed = pb_resize(pb_i32s, m.closed, 0); }

// The number of values of closed_packed.
fn All_closed_packed_len(m: All&) -> i64 { return m.closed_packed.len; }

// The values of closed_packed, in pb_i32s: valid until it is next changed or m is
// cleared.
fn All_closed_packed(m: All&) -> i32[:] { return pb_run(pb_i32s, m.closed_packed); }

fn All_closed_packed_at(m: All&, i: i64) -> i32 { return pb_run(pb_i32s, m.closed_packed)[i]; }

// Adds a value to closed_packed. This moves its values, so All_set_closed_packed is better for many.
fn All_add_closed_packed(m: All&, v: i32) { m.closed_packed = pb_add(pb_i32s, m.closed_packed, v); }

// Sets closed_packed to a copy of v.
fn All_set_closed_packed(m: All&, v: const i32[:]) { m.closed_packed = pb_set_run(pb_i32s, m.closed_packed, v); }

fn All_clear_closed_packed(m: All&) { m.closed_packed = pb_resize(pb_i32s, m.closed_packed, 0); }

// The sub-message tree, or null if it is not set. Valid until it or m is
// cleared.
fn All_tree(m: All&) -> Tree&? { return m.tree.m; }

// The sub-message tree, set to an empty one first if it is not set.
fn All_mutable_tree(m: All&) -> Tree& {
    let pb_sub = m.tree.m;
    if pb_sub { return pb_sub; }
    let pb_new .= Tree_pool.alloc_ref(Tree { .. });
    m.tree.m .= pb_new;
    return pb_new;
}

fn All_has_tree(m: All&) -> bool { return m.tree.m != null; }

// Frees the sub-message tree and everything it owns.
fn All_clear_tree(m: All&) {
    let pb_sub = m.tree.m;
    guard pb_sub else { return; }
    Tree_clear(pb_sub);
    Tree_pool.free(Tree_pool.index_of(pb_sub));
    m.tree.m .= null;
}

// The number of messages of choices.
fn All_choices_len(m: All&) -> i64 { return m.choices.len; }

// Message i of choices. Valid until it or m is cleared.
fn All_choices_at(m: All&, i: i64) -> Choice& {
    let pb_l = pb_run(Choice_links, m.choices)[i].m;
    assert(pb_l);
    return pb_l;
}

// Adds an empty message to choices and returns it.
fn All_add_choices(m: All&) -> Choice& {
    let pb_i: i64 = m.choices.len;
    m.choices = pb_resize(Choice_links, m.choices, pb_i + 1);
    let pb_new .= Choice_pool.alloc_ref(Choice { .. });
    pb_run(Choice_links, m.choices)[pb_i].m .= pb_new;
    return pb_new;
}

// Frees the messages of choices and everything they own.
fn All_clear_choices(m: All&) {
    for pb_ref in pb_run(Choice_links, m.choices) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        Choice_clear(pb_l);
        Choice_pool.free(Choice_pool.index_of(pb_l));
    }
    m.choices = pb_resize(Choice_links, m.choices, 0);
}

// message limits.All.Items
struct All_Items {
    a: i32,
    pb_has0: u32,   // has-bits of fields with presence
    pb_unknown: pb_Span,   // unknown fields: raw wire bytes in pb_bytes
}

// A link to a All_Items in All_Items_pool, for sub-message fields.
struct All_Items_Ref { m: All_Items&<u32 in All_Items_pool>? }
reusable var All_Items_pool: All_Items[>..] = [];
reusable[] var All_Items_links: All_Items_Ref[>..] = [];

// Merges the fields in r's window into m; on failure r.err is set.
// Fields it does not know, or with another wire type, are kept as
// unknown fields.
fn All_Items_decode_from(r: pb_Reader&, m: All_Items&) {
    var unknown_len: i64 = m.pb_unknown.len;
    let unknown_had: i64 = unknown_len;
    while r.pos < r.end {
        let start = r.pos;
        let tag = pb_read_tag(r);
        if r.err != PB_OK { break; }
        if tag == 8 {
            m.a = pb_u64_to_int32(pb_read_varint(r));
            m.pb_has0 |= 0x00000001;
        } else {
            pb_unknown_append(r, start, tag, m.pb_unknown, unknown_len, unknown_had);
        }
    }
    m.pb_unknown = pb_bytes_trim(m.pb_unknown, unknown_len);
}

// Merges buf into m. 0 on success, else a PB_ERR_* code; m then holds a
// partial message, which the caller clears.
fn All_Items_decode(buf: const u8[:], m: All_Items&) -> i32 {
    var r = pb_reader(buf);
    All_Items_decode_from(r, m);
    return r.err;
}

// Appends m's wire encoding, All_Items_size_of(m) bytes, to out.
fn All_Items_encode(m: All_Items&, out: u8[>..]&) {
    if (m.pb_has0 & 0x00000001) != 0 {
        pb_write_varint(out, 8);
        pb_write_varint(out, pb_int32_to_u64(m.a));
    }
    out.append(pb_run(pb_bytes, m.pb_unknown));
}

// The size of m's wire encoding, in bytes.
fn All_Items_size_of(m: All_Items&) -> i64 {
    var n: i64 = 0;
    if (m.pb_has0 & 0x00000001) != 0 { n += 1 + pb_varint_size(pb_int32_to_u64(m.a)); }
    n += m.pb_unknown.len;
    return n;
}

// Frees what m owns and resets it to the empty message.
fn All_Items_clear(m: All_Items&) {
    m.a = 0;
    m.pb_has0 = 0;
    m.pb_unknown = pb_bytes_free(m.pb_unknown);
}

// Makes dst a deep copy of src, freeing what dst owned. The two share
// nothing afterwards. Neither may be a sub-message of the other.
fn All_Items_copy(dst: All_Items&, src: All_Items&) {
    if dst .== src { return; }
    All_Items_clear(dst);
    dst.a = src.a;
    dst.pb_has0 = src.pb_has0;
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
}

// Sets a and marks it present:
// it is encoded even when 0.
fn All_Items_set_a(m: All_Items&, v: i32) {
    m.a = v;
    m.pb_has0 |= 0x00000001;
}

fn All_Items_has_a(m: All_Items&) -> bool { return (m.pb_has0 & 0x00000001) != 0; }

fn All_Items_clear_a(m: All_Items&) {
    m.a = 0;
    m.pb_has0 &= 0xfffffffe;
}

// message limits.All.NumbersEntry
struct All_NumbersEntry {
    key: i32,
    value: i32,
    pb_unknown: pb_Span,   // unknown fields: raw wire bytes in pb_bytes
}

// A link to a All_NumbersEntry in All_NumbersEntry_pool, for sub-message fields.
struct All_NumbersEntry_Ref { m: All_NumbersEntry&<u32 in All_NumbersEntry_pool>? }
reusable var All_NumbersEntry_pool: All_NumbersEntry[>..] = [];
reusable[] var All_NumbersEntry_links: All_NumbersEntry_Ref[>..] = [];

// Merges the fields in r's window into m; on failure r.err is set.
// Fields it does not know, or with another wire type, are kept as
// unknown fields.
fn All_NumbersEntry_decode_from(r: pb_Reader&, m: All_NumbersEntry&) {
    var unknown_len: i64 = m.pb_unknown.len;
    let unknown_had: i64 = unknown_len;
    while r.pos < r.end {
        let start = r.pos;
        let tag = pb_read_tag(r);
        if r.err != PB_OK { break; }
        if tag == 8 {
            m.key = pb_u64_to_int32(pb_read_varint(r));
        } else if tag == 16 {
            m.value = pb_u64_to_int32(pb_read_varint(r));
        } else {
            pb_unknown_append(r, start, tag, m.pb_unknown, unknown_len, unknown_had);
        }
    }
    m.pb_unknown = pb_bytes_trim(m.pb_unknown, unknown_len);
}

// Merges buf into m. 0 on success, else a PB_ERR_* code; m then holds a
// partial message, which the caller clears.
fn All_NumbersEntry_decode(buf: const u8[:], m: All_NumbersEntry&) -> i32 {
    var r = pb_reader(buf);
    All_NumbersEntry_decode_from(r, m);
    return r.err;
}

// Appends m's wire encoding, All_NumbersEntry_size_of(m) bytes, to out.
fn All_NumbersEntry_encode(m: All_NumbersEntry&, out: u8[>..]&) {
    pb_write_varint(out, 8);
    pb_write_varint(out, pb_int32_to_u64(m.key));
    pb_write_varint(out, 16);
    pb_write_varint(out, pb_int32_to_u64(m.value));
    out.append(pb_run(pb_bytes, m.pb_unknown));
}

// The size of m's wire encoding, in bytes.
fn All_NumbersEntry_size_of(m: All_NumbersEntry&) -> i64 {
    var n: i64 = 0;
    n += 1 + pb_varint_size(pb_int32_to_u64(m.key));
    n += 1 + pb_varint_size(pb_int32_to_u64(m.value));
    n += m.pb_unknown.len;
    return n;
}

// Frees what m owns and resets it to the empty message.
fn All_NumbersEntry_clear(m: All_NumbersEntry&) {
    m.key = 0;
    m.value = 0;
    m.pb_unknown = pb_bytes_free(m.pb_unknown);
}

// Makes dst a deep copy of src, freeing what dst owned. The two share
// nothing afterwards. Neither may be a sub-message of the other.
fn All_NumbersEntry_copy(dst: All_NumbersEntry&, src: All_NumbersEntry&) {
    if dst .== src { return; }
    All_NumbersEntry_clear(dst);
    dst.key = src.key;
    dst.value = src.value;
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
}

// Runs of entries: one per map field of this type.
reusable[] var All_NumbersEntry_entries: All_NumbersEntry[>..] = [];

// The index of the entry with key k among the first `used` of run s, or -1.
fn All_NumbersEntry_find(s: pb_Span, used: i64, k: i32) -> i64 {
    let pb_run_s = pb_run(All_NumbersEntry_entries, s);
    for pb_i in used {
        if pb_run_s[pb_i].key == k { return pb_i; }
    }
    return -1;
}

// The entry with key k in run s, added with the default value if there is none.
fn All_NumbersEntry_slot(s: pb_Span&, k: i32) -> All_NumbersEntry& {
    var pb_i = All_NumbersEntry_find(s, s.len, k);
    if pb_i < 0 {
        pb_i = s.len;
        s = pb_resize(All_NumbersEntry_entries, s, pb_i + 1);
        pb_run(All_NumbersEntry_entries, s)[pb_i].key = k;
    }
    return pb_run(All_NumbersEntry_entries, s)[pb_i];
}

// Settles an entry just decoded: a missing message value is an empty one,
// and unknown fields are dropped.
fn All_NumbersEntry_place(pb_e: All_NumbersEntry&) {
    pb_e.pb_unknown = pb_bytes_free(pb_e.pb_unknown);
}

// Run s with each repeated key folded: the last value wins, in the place of
// the first occurrence, and what the others held is freed. O(n log n).
// fold_maps calls it; decoding leaves repeated keys for it.
fn All_NumbersEntry_fold(s: pb_Span) -> pb_Span {
    if s.len < 2 { return s; }
    let pb_r = pb_run(All_NumbersEntry_entries, s);
    var pb_keys: pb_NumKey[>..] = [];
    for pb_i in pb_r.len { pb_keys.push(pb_NumKey { key: pb_r[pb_i].key as! u64, at: pb_i as! u32 }); }
    pb_sort_num_keys(pb_keys);
    var pb_gone: bool[>..] = [];
    var pb_i: i64 = 0;
    while pb_i < pb_keys.len {
        var pb_j = pb_i + 1;
        while pb_j < pb_keys.len && pb_same_num_key(pb_keys[pb_i], pb_keys[pb_j]) { pb_j++; }
        if pb_j - pb_i > 1 {
            if pb_gone.len == 0 { for pb_k in pb_r.len { pb_gone.push(false); } }
            let pb_first: i64 = pb_keys[pb_i].at;
            let pb_last: i64 = pb_keys[pb_j - 1].at;
            for pb_k in pb_j - pb_i - 1 {
                let pb_at: i64 = pb_keys[pb_i + pb_k].at;
                All_NumbersEntry_clear(pb_r[pb_at]);
                pb_gone[pb_at] = true;
            }
            pb_gone[pb_first] = false;
            pb_gone[pb_last] = true;
            pb_r[pb_first] = pb_r[pb_last];
            pb_r[pb_last] = All_NumbersEntry { .. };
        }
        pb_i = pb_j;
    }
    if pb_gone.len == 0 { return s; }
    var pb_kept: i64 = 0;
    for pb_k in pb_r.len {
        if pb_gone[pb_k] { continue; }
        if pb_kept != pb_k { pb_r[pb_kept] = pb_r[pb_k]; pb_r[pb_k] = All_NumbersEntry { .. }; }
        pb_kept++;
    }
    return pb_resize(All_NumbersEntry_entries, s, pb_kept);
}

// message limits.All.NamedEntry
struct All_NamedEntry {
    key: pb_Span,
    value: Leaf_Ref,
    pb_unknown: pb_Span,   // unknown fields: raw wire bytes in pb_bytes
}

// A link to a All_NamedEntry in All_NamedEntry_pool, for sub-message fields.
struct All_NamedEntry_Ref { m: All_NamedEntry&<u32 in All_NamedEntry_pool>? }
reusable var All_NamedEntry_pool: All_NamedEntry[>..] = [];
reusable[] var All_NamedEntry_links: All_NamedEntry_Ref[>..] = [];

// Merges the fields in r's window into m; on failure r.err is set.
// Fields it does not know, or with another wire type, are kept as
// unknown fields.
fn All_NamedEntry_decode_from(r: pb_Reader&, m: All_NamedEntry&) {
    var unknown_len: i64 = m.pb_unknown.len;
    let unknown_had: i64 = unknown_len;
    while r.pos < r.end {
        let start = r.pos;
        let tag = pb_read_tag(r);
        if r.err != PB_OK { break; }
        if tag == 10 {
            m.key = pb_read_bytes(r, m.key);
        } else if tag == 18 {
            pb_charge(r, 48);
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            if r.depth >= PB_MAX_DEPTH { pb_fail(r, PB_ERR_DEPTH); break; }
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            r.depth++;
            Leaf_decode_from(r, All_NamedEntry_mutable_value(m));
            if r.err != PB_OK { break; }
            r.depth--;
            r.end = pb_outer;
        } else {
            pb_unknown_append(r, start, tag, m.pb_unknown, unknown_len, unknown_had);
        }
    }
    m.pb_unknown = pb_bytes_trim(m.pb_unknown, unknown_len);
}

// Merges buf into m. 0 on success, else a PB_ERR_* code; m then holds a
// partial message, which the caller clears.
fn All_NamedEntry_decode(buf: const u8[:], m: All_NamedEntry&) -> i32 {
    var r = pb_reader(buf);
    All_NamedEntry_decode_from(r, m);
    return r.err;
}

// Appends m's wire encoding, All_NamedEntry_size_of(m) bytes, to out.
fn All_NamedEntry_encode(m: All_NamedEntry&, out: u8[>..]&) {
    pb_write_varint(out, 10);
    pb_write_bytes(out, m.key);
    let pb_f2 = m.value.m;
    if pb_f2 {
        pb_write_varint(out, 18);
        pb_write_varint(out, Leaf_size_of(pb_f2) as! u64);
        Leaf_encode(pb_f2, out);
    }
    out.append(pb_run(pb_bytes, m.pb_unknown));
}

// The size of m's wire encoding, in bytes.
fn All_NamedEntry_size_of(m: All_NamedEntry&) -> i64 {
    var n: i64 = 0;
    n += 1 + pb_bytes_size(m.key);
    let pb_f2 = m.value.m;
    if pb_f2 { n += 1 + pb_len_size(Leaf_size_of(pb_f2)); }
    n += m.pb_unknown.len;
    return n;
}

// Frees what m owns and resets it to the empty message.
fn All_NamedEntry_clear(m: All_NamedEntry&) {
    m.key = pb_bytes_free(m.key);
    All_NamedEntry_clear_value(m);
    m.pb_unknown = pb_bytes_free(m.pb_unknown);
}

// Makes dst a deep copy of src, freeing what dst owned. The two share
// nothing afterwards. Neither may be a sub-message of the other.
fn All_NamedEntry_copy(dst: All_NamedEntry&, src: All_NamedEntry&) {
    if dst .== src { return; }
    All_NamedEntry_clear(dst);
    dst.key = pb_bytes_copy(src.key);
    let pb_f2 = src.value.m;
    if pb_f2 { Leaf_copy(All_NamedEntry_mutable_value(dst), pb_f2); }
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
}

// The contents of key, in pb_bytes: valid until it is next set or m
// is cleared.
fn All_NamedEntry_key(m: All_NamedEntry&) -> u8[:] { return pb_run(pb_bytes, m.key); }

// Sets key to a copy of v.
fn All_NamedEntry_set_key(m: All_NamedEntry&, v: const u8[:]) {
    m.key = pb_bytes_set(m.key, v);
}

// The sub-message value, or null if it is not set. Valid until it or m is
// cleared.
fn All_NamedEntry_value(m: All_NamedEntry&) -> Leaf&? { return m.value.m; }

// The sub-message value, set to an empty one first if it is not set.
fn All_NamedEntry_mutable_value(m: All_NamedEntry&) -> Leaf& {
    let pb_sub = m.value.m;
    if pb_sub { return pb_sub; }
    let pb_new .= Leaf_pool.alloc_ref(Leaf { .. });
    m.value.m .= pb_new;
    return pb_new;
}

fn All_NamedEntry_has_value(m: All_NamedEntry&) -> bool { return m.value.m != null; }

// Frees the sub-message value and everything it owns.
fn All_NamedEntry_clear_value(m: All_NamedEntry&) {
    let pb_sub = m.value.m;
    guard pb_sub else { return; }
    Leaf_clear(pb_sub);
    Leaf_pool.free(Leaf_pool.index_of(pb_sub));
    m.value.m .= null;
}

// Runs of entries: one per map field of this type.
reusable[] var All_NamedEntry_entries: All_NamedEntry[>..] = [];

// The index of the entry with key k among the first `used` of run s, or -1.
fn All_NamedEntry_find(s: pb_Span, used: i64, k: const u8[:]) -> i64 {
    let pb_run_s = pb_run(All_NamedEntry_entries, s);
    for pb_i in used {
        if pb_run(pb_bytes, pb_run_s[pb_i].key) == k { return pb_i; }
    }
    return -1;
}

// The entry with key k in run s, added with the default value if there is none.
fn All_NamedEntry_slot(s: pb_Span&, k: const u8[:]) -> All_NamedEntry& {
    var pb_i = All_NamedEntry_find(s, s.len, k);
    if pb_i < 0 {
        pb_i = s.len;
        s = pb_resize(All_NamedEntry_entries, s, pb_i + 1);
        All_NamedEntry_set_key(pb_run(All_NamedEntry_entries, s)[pb_i], k);
        All_NamedEntry_mutable_value(pb_run(All_NamedEntry_entries, s)[pb_i]);
    }
    return pb_run(All_NamedEntry_entries, s)[pb_i];
}

// Settles an entry just decoded: a missing message value is an empty one,
// and unknown fields are dropped.
fn All_NamedEntry_place(pb_e: All_NamedEntry&) {
    All_NamedEntry_mutable_value(pb_e);
    pb_e.pb_unknown = pb_bytes_free(pb_e.pb_unknown);
}

// Run s with each repeated key folded: the last value wins, in the place of
// the first occurrence, and what the others held is freed. O(n log n).
// fold_maps calls it; decoding leaves repeated keys for it.
fn All_NamedEntry_fold(s: pb_Span) -> pb_Span {
    if s.len < 2 { return s; }
    let pb_r = pb_run(All_NamedEntry_entries, s);
    var pb_keys: pb_StrKey[>..] = [];
    for pb_i in pb_r.len { pb_keys.push(pb_StrKey { key: pb_r[pb_i].key, at: pb_i as! u32 }); }
    pb_sort_str_keys(pb_keys);
    var pb_gone: bool[>..] = [];
    var pb_i: i64 = 0;
    while pb_i < pb_keys.len {
        var pb_j = pb_i + 1;
        while pb_j < pb_keys.len && pb_same_str_key(pb_keys[pb_i], pb_keys[pb_j]) { pb_j++; }
        if pb_j - pb_i > 1 {
            if pb_gone.len == 0 { for pb_k in pb_r.len { pb_gone.push(false); } }
            let pb_first: i64 = pb_keys[pb_i].at;
            let pb_last: i64 = pb_keys[pb_j - 1].at;
            for pb_k in pb_j - pb_i - 1 {
                let pb_at: i64 = pb_keys[pb_i + pb_k].at;
                All_NamedEntry_clear(pb_r[pb_at]);
                pb_gone[pb_at] = true;
            }
            pb_gone[pb_first] = false;
            pb_gone[pb_last] = true;
            pb_r[pb_first] = pb_r[pb_last];
            pb_r[pb_last] = All_NamedEntry { .. };
        }
        pb_i = pb_j;
    }
    if pb_gone.len == 0 { return s; }
    var pb_kept: i64 = 0;
    for pb_k in pb_r.len {
        if pb_gone[pb_k] { continue; }
        if pb_kept != pb_k { pb_r[pb_kept] = pb_r[pb_k]; pb_r[pb_k] = All_NamedEntry { .. }; }
        pb_kept++;
    }
    return pb_resize(All_NamedEntry_entries, s, pb_kept);
}
