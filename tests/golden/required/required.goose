    n += m.pb_unknown.len;
    return n;
}

// Frees what m owns and resets it to the empty message.
fn Uses_ByNameEntry_clear(m: Uses_ByNameEntry&) {
    m.key = pb_bytes_free(m.key);
    Uses_ByNameEntry_clear_value(m);
    m.pb_unknown = pb_bytes_free(m.pb_unknown);
}

// Makes dst a deep copy of src, freeing what dst owned. The two share
// nothing afterwards. Neither may be a sub-message of the other.
fn Uses_ByNameEntry_copy(dst: Uses_ByNameEntry&, src: Uses_ByNameEntry&) {
    if dst .== src { return; }
    Uses_ByNameEntry_clear(dst);
    dst.key = pb_bytes_copy(src.key);
    let pb_f2 = src.value.m;
    if pb_f2 { req::Inner_copy(Uses_ByNameEntry_mutable_value(dst), pb_f2); }
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
}

// True if every required field is set, in m and in the messages it holds.
fn Uses_ByNameEntry_is_initialized(m: Uses_ByNameEntry&) -> bool {
    let pb_f2 = m.value.m;
    if pb_f2 { if !req::Inner_is_initialized(pb_f2) { return false; } }
    return true;
}

// The contents of key, in pb_bytes: valid until it is next set or m
// is cleared.
fn Uses_ByNameEntry_key(m: Uses_ByNameEntry&) -> u8[:] { return pb_run(pb_bytes, m.key); }

// Sets key to a copy of v.
fn Uses_ByNameEntry_set_key(m: Uses_ByNameEntry&, v: const u8[:]) {
    m.key = pb_bytes_set(m.key, v);
}

// The sub-message value, or null if it is not set. Valid until it or m is
// cleared.
fn Uses_ByNameEntry_value(m: Uses_ByNameEntry&) -> req::Inner&? { return m.value.m; }

// The sub-message value, set to an empty one first if it is not set.
fn Uses_ByNameEntry_mutable_value(m: Uses_ByNameEntry&) -> req::Inner& {
    let pb_sub = m.value.m;
    if pb_sub { return pb_sub; }
    let pb_new .= req::Inner_pool.alloc_ref(req::Inner { .. });
    m.value.m .= pb_new;
    return pb_new;
}

fn Uses_ByNameEntry_has_value(m: Uses_ByNameEntry&) -> bool { return m.value.m != null; }

// Frees the sub-message value and everything it owns.
fn Uses_ByNameEntry_clear_value(m: Uses_ByNameEntry&) {
    let pb_sub = m.value.m;
    guard pb_sub else { return; }
    req::Inner_clear(pb_sub);
    req::Inner_pool.free(req::Inner_pool.index_of(pb_sub));
    m.value.m .= null;
}

// Runs of entries: one per map field of this type.
reusable[] var Uses_ByNameEntry_entries: Uses_ByNameEntry[>..] = [];

// The index of the entry with key k among the first `used` of run s, or -1.
fn Uses_ByNameEntry_find(s: pb_Span, used: i64, k: const u8[:]) -> i64 {
    let pb_run_s = pb_run(Uses_ByNameEntry_entries, s);
    for pb_i in used {
        if pb_run(pb_bytes, pb_run_s[pb_i].key) == k { return pb_i; }
    }
    return -1;
}

// The entry with key k in run s, added with the default value if there is none.
fn Uses_ByNameEntry_slot(s: pb_Span&, k: const u8[:]) -> Uses_ByNameEntry& {
    var pb_i = Uses_ByNameEntry_find(s, s.len, k);
    if pb_i < 0 {
        pb_i = s.len;
        s = pb_resize(Uses_ByNameEntry_entries, s, pb_i + 1);
        Uses_ByNameEntry_set_key(pb_run(Uses_ByNameEntry_entries, s)[pb_i], k);
        Uses_ByNameEntry_mutable_value(pb_run(Uses_ByNameEntry_entries, s)[pb_i]);
    }
    return pb_run(Uses_ByNameEntry_entries, s)[pb_i];
}

// Settles an entry just decoded: a missing message value is an empty one,
// and unknown fields are dropped.
fn Uses_ByNameEntry_place(pb_e: Uses_ByNameEntry&) {
    Uses_ByNameEntry_mutable_value(pb_e);
    pb_e.pb_unknown = pb_bytes_free(pb_e.pb_unknown);
}

// Run s with each repeated key folded: the last value wins, in the place of
// the first occurrence, and what the others held is freed. O(n log n).
// fold_maps calls it; decoding leaves repeated keys for it.
fn Uses_ByNameEntry_fold(s: pb_Span) -> pb_Span {
    if s.len < 2 { return s; }
    let pb_r = pb_run(Uses_ByNameEntry_entries, s);
    var pb_keys: pb_StrKey[>..] = [];
    for pb_i in pb_r.len { pb_keys.push(pb_StrKey { key: pb_r[pb_i].key, at: pb_i as! u32 }); }
    pb_sort_str_keys(pb_keys);
    var pb_gone: bool[>..] = [];
    var pb_i: i64 = 0;
    while pb_i < pb_keys.len {
        var pb_j = pb_i + 1;
        while pb_j < pb_keys.len && pb_same_str_key(pb_keys[pb_i], pb_keys[pb_j]) { pb_j++; }
        if pb_j - pb_i > 1 {
            if pb_gone.len == 0 { for pb_k in pb_r.len { pb_gone.push(false); } }
            let pb_first: i64 = pb_keys[pb_i].at;
            let pb_last: i64 = pb_keys[pb_j - 1].at;
            for pb_k in pb_j - pb_i - 1 {
                let pb_at: i64 = pb_keys[pb_i + pb_k].at;
                Uses_ByNameEntry_clear(pb_r[pb_at]);
                pb_gone[pb_at] = true;
            }
            pb_gone[pb_first] = false;
            pb_gone[pb_last] = true;
            pb_r[pb_first] = pb_r[pb_last];
            pb_r[pb_last] = Uses_ByNameEntry { .. };
        }
        pb_i = pb_j;
    }
    if pb_gone.len == 0 { return s; }
    var pb_kept: i64 = 0;
    for pb_k in pb_r.len {
        if pb_gone[pb_k] { continue; }
        if pb_kept != pb_k { pb_r[pb_kept] = pb_r[pb_k]; pb_r[pb_k] = Uses_ByNameEntry { .. }; }
        pb_kept++;
    }
    return pb_resize(Uses_ByNameEntry_entries, s, pb_kept);
}

// message holder.Plain
struct Plain {
    free: req::Free_Ref,
    more: pb_Span,
    pb_unknown: pb_Span,   // unknown fields: raw wire bytes in pb_bytes
}

// A link to a Plain in Plain_pool, for sub-message fields.
struct Plain_Ref { m: Plain&<u32 in Plain_pool>? }
reusable var Plain_pool: Plain[>..] = [];
reusable[] var Plain_links: Plain_Ref[>..] = [];

// Merges the fields in r's window into m; on failure r.err is set.
// Fields it does not know, or with another wire type, are kept as
// unknown fields.
recursive fn Plain_decode_from(r: pb_Reader&, m: Plain&) {
    var unknown_len: i64 = m.pb_unknown.len;
    let unknown_had: i64 = unknown_len;
    let pb_had2: i64 = m.more.len;
    var pb_len2: i64 = pb_had2;
    while r.pos < r.end {
        let start = r.pos;
        let tag = pb_read_tag(r);
        if r.err != PB_OK { break; }
        if tag == 10 {
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            if r.depth >= PB_MAX_DEPTH { pb_fail(r, PB_ERR_DEPTH); break; }
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            r.depth++;
            req::Free_decode_from(r, Plain_mutable_free(m));
            if r.err != PB_OK { break; }
            r.depth--;
            r.end = pb_outer;
        } else if tag == 18 {
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            if r.depth >= PB_MAX_DEPTH { pb_fail(r, PB_ERR_DEPTH); break; }
            pb_reserve(Plain_links, m.more, pb_len2, pb_had2);
            let pb_sub .= Plain_pool.alloc_ref(Plain { .. });
            pb_run(Plain_links, m.more)[pb_len2].m .= pb_sub;
            pb_len2++;
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            r.depth++;
            Plain_decode_from(r, pb_sub);
            if r.err != PB_OK { break; }
            r.depth--;
            r.end = pb_outer;
        } else {
            pb_unknown_append(r, start, tag, m.pb_unknown, unknown_len, unknown_had);
        }
    }
    m.more = pb_trim(Plain_links, m.more, pb_len2);
    m.pb_unknown = pb_bytes_trim(m.pb_unknown, unknown_len);
}

// Merges buf into m. 0 on success, else a PB_ERR_* code; m then holds a
// partial message, which the caller clears.
fn Plain_decode(buf: const u8[:], m: Plain&) -> i32 {
    var r = pb_reader(buf);
    Plain_decode_from(r, m);
    return r.err;
}

// Appends m's wire encoding, Plain_size_of(m) bytes, to out.
recursive fn Plain_encode(m: Plain&, out: u8[>..]&) {
    let pb_f1 = m.free.m;
    if pb_f1 {
        pb_write_varint(out, 10);
        pb_write_varint(out, req::Free_size_of(pb_f1) as! u64);
        req::Free_encode(pb_f1, out);
    }
    for pb_ref in pb_run(Plain_links, m.more) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        pb_write_varint(out, 18);
        pb_write_varint(out, Plain_size_of(pb_l) as! u64);
        Plain_encode(pb_l, out);
    }
    out.append(pb_run(pb_bytes, m.pb_unknown));
}

// The size of m's wire encoding, in bytes.
recursive fn Plain_size_of(m: Plain&) -> i64 {
    var n: i64 = 0;
    let pb_f1 = m.free.m;
    if pb_f1 { n += 1 + pb_len_size(req::Free_size_of(pb_f1)); }
    for pb_ref in pb_run(Plain_links, m.more) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        n += 1 + pb_len_size(Plain_size_of(pb_l));
    }
    n += m.pb_unknown.len;
    return n;
}

// Frees what m owns and resets it to the empty message.
recursive fn Plain_clear(m: Plain&) {
    Plain_clear_free(m);
    Plain_clear_more(m);
    m.pb_unknown = pb_bytes_free(m.pb_unknown);
}

// Makes dst a deep copy of src, freeing what dst owned. The two share
// nothing afterwards. Neither may be a sub-message of the other.
recursive fn Plain_copy(dst: Plain&, src: Plain&) {
    if dst .== src { return; }
    Plain_clear(dst);
    let pb_f1 = src.free.m;
    if pb_f1 { req::Free_copy(Plain_mutable_free(dst), pb_f1); }
    dst.more = pb_resize(Plain_links, dst.more, src.more.len);
    for pb_i in src.more.len {
        let pb_l = pb_run(Plain_links, src.more)[pb_i].m;
        guard pb_l else { continue; }
        let pb_c .= Plain_pool.alloc_ref(Plain { .. });
        pb_run(Plain_links, dst.more)[pb_i].m .= pb_c;
        Plain_copy(pb_c, pb_l);
    }
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
}

// The sub-message free, or null if it is not set. Valid until it or m is
// cleared.
fn Plain_free(m: Plain&) -> req::Free&? { return m.free.m; }

// The sub-message free, set to an empty one first if it is not set.
fn Plain_mutable_free(m: Plain&) -> req::Free& {
    let pb_sub = m.free.m;
    if pb_sub { return pb_sub; }
    let pb_new .= req::Free_pool.alloc_ref(req::Free { .. });
    m.free.m .= pb_new;
    return pb_new;
}

fn Plain_has_free(m: Plain&) -> bool { return m.free.m != null; }

// Frees the sub-message free and everything it owns.
recursive fn Plain_clear_free(m: Plain&) {
    let pb_sub = m.free.m;
    guard pb_sub else { return; }
    req::Free_clear(pb_sub);
    req::Free_pool.free(req::Free_pool.index_of(pb_sub));
    m.free.m .= null;
}

// The links of more, in Plain_links: its .len is the number of messages.
fn Plain_more(m: Plain&) -> Plain_Ref[:] { return pb_run(Plain_links, m.more); }

// Message i of more. Valid until it or m is cleared.
fn Plain_more_at(m: Plain&, i: i64) -> Plain& {
    let pb_l = pb_run(Plain_links, m.more)[i].m;
    assert(pb_l);
    return pb_l;
}

// Adds an empty message to more and returns it.
fn Plain_add_more(m: Plain&) -> Plain& {
    let pb_i: i64 = m.more.len;
    m.more = pb_resize(Plain_links, m.more, pb_i + 1);
    let pb_new .= Plain_pool.alloc_ref(Plain { .. });
    pb_run(Plain_links, m.more)[pb_i].m .= pb_new;
    return pb_new;
}

// Frees the messages of more and everything they own.
recursive fn Plain_clear_more(m: Plain&) {
    for pb_ref in pb_run(Plain_links, m.more) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        Plain_clear(pb_l);
        Plain_pool.free(Plain_pool.index_of(pb_l));
    }
    m.more = pb_resize(Plain_links, m.more, 0);
}
