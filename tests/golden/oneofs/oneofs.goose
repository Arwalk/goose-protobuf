    }
    match m.pick {
        p_mode pb_p => { n += 1 + pb_varint_size(pb_int32_to_u64(pb_p.v)); },
        _ => {},
    }
    match m.pick {
        p_string pb_p => { n += 1 + pb_bytes_size(pb_p.v); },
        _ => {},
    }
    match m.pick {
        p_bytes pb_p => { n += 1 + pb_bytes_size(pb_p.v); },
        _ => {},
    }
    match m.pick {
        p_sub pb_p => {
            let pb_l = pb_p.v.m;
            if pb_l { n += 1 + pb_len_size(Sub_size_of(pb_l)); }
        },
        _ => {},
    }
    match m.pick {
        p_dep pb_p => {
            let pb_l = pb_p.v.m;
            if pb_l { n += 1 + pb_len_size(google_protobuf::Duration_size_of(pb_l)); }
        },
        _ => {},
    }
    match m.pick {
        p_self pb_p => {
            let pb_l = pb_p.v.m;
            if pb_l { n += 1 + pb_len_size(Choice_size_of(pb_l)); }
        },
        _ => {},
    }
    match m.pick {
        type_ pb_p => { n += 2 + pb_varint_size(pb_int32_to_u64(pb_p.v)); },
        _ => {},
    }
    match m.pick {
        m pb_p => { n += 2 + pb_varint_size(pb_int32_to_u64(pb_p.v)); },
        _ => {},
    }
    match m.pick {
        v pb_p => { n += 2 + pb_varint_size(pb_int32_to_u64(pb_p.v)); },
        _ => {},
    }
    match m.second {
        s_string pb_p => { n += 2 + pb_bytes_size(pb_p.v); },
        _ => {},
    }
    match m.second {
        s_sub pb_p => {
            let pb_l = pb_p.v.m;
            if pb_l { n += 2 + pb_len_size(Sub_size_of(pb_l)); }
        },
        _ => {},
    }
    if (m.pb_has0 & 0x00000001) != 0 { n += 2 + pb_varint_size(pb_int32_to_u64(m.maybe)); }
    if m.after != 0 { n += 2 + pb_varint_size(pb_int32_to_u64(m.after)); }
    n += m.pb_unknown.len;
    return n;
}

// Frees what m owns and resets it to the empty message.
recursive fn Choice_clear(m: Choice&) {
    m.before = 0;
    m.maybe = 0;
    m.after = 0;
    Choice_clear_pick(m);
    Choice_clear_second(m);
    m.pb_has0 = 0;
    m.pb_unknown = pb_bytes_free(m.pb_unknown);
}

// Makes dst a deep copy of src, freeing what dst owned. The two share
// nothing afterwards. Neither may be a sub-message of the other.
recursive fn Choice_copy(dst: Choice&, src: Choice&) {
    if dst .== src { return; }
    Choice_clear(dst);
    dst.before = src.before;
    dst.maybe = src.maybe;
    dst.after = src.after;
    match src.pick {
        p_int32 pb_p => { dst.pick = Choice_pick.p_int32 { v: pb_p.v }; },
        p_sint64 pb_p => { dst.pick = Choice_pick.p_sint64 { v: pb_p.v }; },
        p_uint64 pb_p => { dst.pick = Choice_pick.p_uint64 { v: pb_p.v }; },
        p_fixed32 pb_p => { dst.pick = Choice_pick.p_fixed32 { v: pb_p.v }; },
        p_sfixed64 pb_p => { dst.pick = Choice_pick.p_sfixed64 { v: pb_p.v }; },
        p_float pb_p => { dst.pick = Choice_pick.p_float { v: pb_p.v }; },
        p_double pb_p => { dst.pick = Choice_pick.p_double { v: pb_p.v }; },
        p_bool pb_p => { dst.pick = Choice_pick.p_bool { v: pb_p.v }; },
        p_mode pb_p => { dst.pick = Choice_pick.p_mode { v: pb_p.v }; },
        p_string pb_p => { dst.pick = Choice_pick.p_string { v: pb_bytes_copy(pb_p.v) }; },
        p_bytes pb_p => { dst.pick = Choice_pick.p_bytes { v: pb_bytes_copy(pb_p.v) }; },
        p_sub pb_p => {
            let pb_l = pb_p.v.m;
            if pb_l { Sub_copy(Choice_mutable_p_sub(dst), pb_l); }
        },
        p_dep pb_p => {
            let pb_l = pb_p.v.m;
            if pb_l { google_protobuf::Duration_copy(Choice_mutable_p_dep(dst), pb_l); }
        },
        p_self pb_p => {
            let pb_l = pb_p.v.m;
            if pb_l { Choice_copy(Choice_mutable_p_self(dst), pb_l); }
        },
        type_ pb_p => { dst.pick = Choice_pick.type_ { v: pb_p.v }; },
        m pb_p => { dst.pick = Choice_pick.m { v: pb_p.v }; },
        v pb_p => { dst.pick = Choice_pick.v { v: pb_p.v }; },
        _ => {},
    }
    match src.second {
        s_string pb_p => { dst.second = Choice_second.s_string { v: pb_bytes_copy(pb_p.v) }; },
        s_sub pb_p => {
            let pb_l = pb_p.v.m;
            if pb_l { Sub_copy(Choice_mutable_s_sub(dst), pb_l); }
        },
        _ => {},
    }
    dst.pb_has0 = src.pb_has0;
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
}

// Frees what oneof pick holds, and sets no member.
recursive fn Choice_clear_pick(m: Choice&) {
    match m.pick {
        p_string pb_p => { pb_bytes_free(pb_p.v); },
        p_bytes pb_p => { pb_bytes_free(pb_p.v); },
        p_sub pb_p => {
            let pb_sub = pb_p.v.m;
            if pb_sub {
                Sub_clear(pb_sub);
                Sub_pool.free(Sub_pool.index_of(pb_sub));
            }
        },
        p_dep pb_p => {
            let pb_sub = pb_p.v.m;
            if pb_sub {
                google_protobuf::Duration_clear(pb_sub);
                google_protobuf::Duration_pool.free(google_protobuf::Duration_pool.index_of(pb_sub));
            }
        },
        p_self pb_p => {
            let pb_sub = pb_p.v.m;
            if pb_sub {
                Choice_clear(pb_sub);
                Choice_pool.free(Choice_pool.index_of(pb_sub));
            }
        },
        _ => {},
    }
    m.pick = Choice_pick.pb_none;
}

// Frees what oneof second holds, and sets no member.
recursive fn Choice_clear_second(m: Choice&) {
    match m.second {
        s_string pb_p => { pb_bytes_free(pb_p.v); },
        s_sub pb_p => {
            let pb_sub = pb_p.v.m;
            if pb_sub {
                Sub_clear(pb_sub);
                Sub_pool.free(Sub_pool.index_of(pb_sub));
            }
        },
        _ => {},
    }
    m.second = Choice_second.pb_none;
}

