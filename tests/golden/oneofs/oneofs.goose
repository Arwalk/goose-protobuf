    m.pb_has0 |= 0x00000001;
}

fn Choice_has_maybe(m: Choice&) -> bool { return (m.pb_has0 & 0x00000001) != 0; }

fn Choice_clear_maybe(m: Choice&) {
    m.maybe = 0;
    m.pb_has0 &= 0xfffffffe;
}
