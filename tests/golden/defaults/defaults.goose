// message def.Pick
enum Pick_pick {
    pb_none,
    p_int { v: i32 },
    p_string { v: pb_Span },
    p_bytes { v: pb_Span },
    p_named { v: i32 },
    p_first { v: i32 },
    p_nan { v: f64 },
    p_bool { v: bool },
}

struct Pick {
    pick: Pick_pick = Pick_pick.pb_none,
    pb_unknown: pb_Span,   // unknown fields: raw wire bytes in pb_bytes
}

// A link to a Pick in Pick_pool, for sub-message fields.
struct Pick_Ref { m: Pick&<u32 in Pick_pool>? }
reusable var Pick_pool: Pick[>..] = [];
reusable[] var Pick_links: Pick_Ref[>..] = [];

// Merges the fields in r's window into m; on failure r.err is set.
// Fields it does not know, or with another wire type, are kept as
// unknown fields.
fn Pick_decode_from(r: pb_Reader&, m: Pick&) {
    var unknown_len: i64 = m.pb_unknown.len;
    let unknown_had: i64 = unknown_len;
    while r.pos < r.end {
        let start = r.pos;
        let tag = pb_read_tag(r);
        if r.err != PB_OK { break; }
        if tag == 8 {
            let pb_v = pb_u64_to_int32(pb_read_varint(r));
            if r.err != PB_OK { break; }
            Pick_clear_pick(m);
            m.pick = Pick_pick.p_int { v: pb_v };
        } else if tag == 18 {
            let pb_v = pb_read_bytes(r, pb_Span { at: 0, len: 0 });
            if r.err != PB_OK { break; }
            Pick_clear_pick(m);
            m.pick = Pick_pick.p_string { v: pb_v };
        } else if tag == 26 {
            let pb_v = pb_read_bytes(r, pb_Span { at: 0, len: 0 });
            if r.err != PB_OK { break; }
            Pick_clear_pick(m);
            m.pick = Pick_pick.p_bytes { v: pb_v };
        } else if tag == 32 {
            let pb_v = pb_u64_to_int32(pb_read_varint(r));
            if r.err != PB_OK { break; }
            if !(pb_v == 1 || pb_v == 3 || pb_v == 5) {
                pb_unknown_keep(r, start, m.pb_unknown, unknown_len, unknown_had);
                continue;
            }
            Pick_clear_pick(m);
            m.pick = Pick_pick.p_named { v: pb_v };
        } else if tag == 40 {
            let pb_v = pb_u64_to_int32(pb_read_varint(r));
            if r.err != PB_OK { break; }
            if !(pb_v == 1 || pb_v == 3 || pb_v == 5) {
                pb_unknown_keep(r, start, m.pb_unknown, unknown_len, unknown_had);
                continue;
            }
            Pick_clear_pick(m);
            m.pick = Pick_pick.p_first { v: pb_v };
        } else if tag == 49 {
            let pb_v = pb_read_double(r);
            if r.err != PB_OK { break; }
            Pick_clear_pick(m);
            m.pick = Pick_pick.p_nan { v: pb_v };
        } else if tag == 56 {
            let pb_v = pb_read_varint(r) != 0;
            if r.err != PB_OK { break; }
            Pick_clear_pick(m);
            m.pick = Pick_pick.p_bool { v: pb_v };
        } else {
            pb_unknown_append(r, start, tag, m.pb_unknown, unknown_len, unknown_had);
        }
    }
    m.pb_unknown = pb_bytes_trim(m.pb_unknown, unknown_len);
}

// Merges buf into m. 0 on success, else a PB_ERR_* code; m then holds a
// partial message, which the caller clears.
fn Pick_decode(buf: const u8[:], m: Pick&) -> i32 {
    var r = pb_reader(buf);
    Pick_decode_from(r, m);
    return r.err;
}

// Appends m's wire encoding, Pick_size_of(m) bytes, to out.
fn Pick_encode(m: Pick&, out: u8[>..]&) {
    match m.pick {
        p_int pb_p => {
            pb_write_varint(out, 8);
            pb_write_varint(out, pb_int32_to_u64(pb_p.v));
        },
        _ => {},
    }
    match m.pick {
        p_string pb_p => {
            pb_write_varint(out, 18);
            pb_write_bytes(out, pb_p.v);
        },
        _ => {},
    }
    match m.pick {
        p_bytes pb_p => {
            pb_write_varint(out, 26);
            pb_write_bytes(out, pb_p.v);
        },
        _ => {},
    }
    match m.pick {
        p_named pb_p => {
            pb_write_varint(out, 32);
            pb_write_varint(out, pb_int32_to_u64(pb_p.v));
        },
        _ => {},
    }
    match m.pick {
        p_first pb_p => {
            pb_write_varint(out, 40);
            pb_write_varint(out, pb_int32_to_u64(pb_p.v));
        },
        _ => {},
    }
    match m.pick {
        p_nan pb_p => {
            pb_write_varint(out, 49);
            pb_write_double(out, pb_p.v);
        },
        _ => {},
    }
    match m.pick {
        p_bool pb_p => {
            pb_write_varint(out, 56);
            pb_write_varint(out, pb_bool_to_u64(pb_p.v));
        },
        _ => {},
    }
    out.append(pb_run(pb_bytes, m.pb_unknown));
}

// The size of m's wire encoding, in bytes.
fn Pick_size_of(m: Pick&) -> i64 {
    var n: i64 = 0;
    match m.pick {
        p_int pb_p => { n += 1 + pb_varint_size(pb_int32_to_u64(pb_p.v)); },
        _ => {},
    }
    match m.pick {
        p_string pb_p => { n += 1 + pb_bytes_size(pb_p.v); },
        _ => {},
    }
    match m.pick {
        p_bytes pb_p => { n += 1 + pb_bytes_size(pb_p.v); },
        _ => {},
    }
    match m.pick {
        p_named pb_p => { n += 1 + pb_varint_size(pb_int32_to_u64(pb_p.v)); },
        _ => {},
    }
    match m.pick {
        p_first pb_p => { n += 1 + pb_varint_size(pb_int32_to_u64(pb_p.v)); },
        _ => {},
    }
    match m.pick {
        p_nan => { n += 9; },
        _ => {},
    }
    match m.pick {
        p_bool => { n += 2; },
        _ => {},
    }
    n += m.pb_unknown.len;
    return n;
}

// Frees what m owns and resets it to the empty message.
fn Pick_clear(m: Pick&) {
    Pick_clear_pick(m);
    m.pb_unknown = pb_bytes_free(m.pb_unknown);
}

// Makes dst a deep copy of src, freeing what dst owned. The two share
// nothing afterwards. Neither may be a sub-message of the other.
fn Pick_copy(dst: Pick&, src: Pick&) {
    if dst .== src { return; }
    Pick_clear(dst);
    match src.pick {
        p_int pb_p => { dst.pick = Pick_pick.p_int { v: pb_p.v }; },
        p_string pb_p => { dst.pick = Pick_pick.p_string { v: pb_bytes_copy(pb_p.v) }; },
        p_bytes pb_p => { dst.pick = Pick_pick.p_bytes { v: pb_bytes_copy(pb_p.v) }; },
        p_named pb_p => { dst.pick = Pick_pick.p_named { v: pb_p.v }; },
        p_first pb_p => { dst.pick = Pick_pick.p_first { v: pb_p.v }; },
        p_nan pb_p => { dst.pick = Pick_pick.p_nan { v: pb_p.v }; },
        p_bool pb_p => { dst.pick = Pick_pick.p_bool { v: pb_p.v }; },
        _ => {},
    }
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
}

// Frees what oneof pick holds, and sets no member.
fn Pick_clear_pick(m: Pick&) {
    match m.pick {
        p_string pb_p => { pb_bytes_free(pb_p.v); },
        p_bytes pb_p => { pb_bytes_free(pb_p.v); },
        _ => {},
    }
    m.pick = Pick_pick.pb_none;
}

// The value of p_int, the default if it is not the member set.
fn Pick_p_int(m: Pick&) -> i32 {
    match m.pick {
        p_int pb_p => { return pb_p.v; },
        _ => {},
    }
    return 3;
}

// Makes p_int the member set, with value v: it is encoded even when 0.
fn Pick_set_p_int(m: Pick&, v: i32) {
    Pick_clear_pick(m);
    m.pick = Pick_pick.p_int { v: v };
}

fn Pick_has_p_int(m: Pick&) -> bool { return match m.pick { p_int => true, _ => false }; }

// Clears oneof pick if p_int is the member set.
fn Pick_clear_p_int(m: Pick&) { if Pick_has_p_int(m) { Pick_clear_pick(m); } }

let Pick_p_string_default: u8[1] = [120];

// The contents of p_string in pb_bytes, Pick_p_string_default if it is not the member set:
// valid until oneof pick changes or m is cleared.
fn Pick_p_string(m: Pick&) -> const u8[:] {
    match m.pick {
        p_string pb_p => { return pb_run(pb_bytes, pb_p.v); },
        _ => {},
    }
    return Pick_p_string_default;
}

// Makes p_string the member set, with a copy of v, which may be its own contents.
fn Pick_set_p_string(m: Pick&, v: const u8[:]) {
    let pb_t = pb_bytes_set(pb_Span { at: 0, len: 0 }, v);
    Pick_clear_pick(m);
    m.pick = Pick_pick.p_string { v: pb_t };
}

fn Pick_has_p_string(m: Pick&) -> bool { return match m.pick { p_string => true, _ => false }; }

// Clears oneof pick if p_string is the member set.
fn Pick_clear_p_string(m: Pick&) { if Pick_has_p_string(m) { Pick_clear_pick(m); } }

let Pick_p_bytes_default: u8[1] = [255];

// The contents of p_bytes in pb_bytes, Pick_p_bytes_default if it is not the member set:
// valid until oneof pick changes or m is cleared.
fn Pick_p_bytes(m: Pick&) -> const u8[:] {
    match m.pick {
        p_bytes pb_p => { return pb_run(pb_bytes, pb_p.v); },
        _ => {},
    }
    return Pick_p_bytes_default;
}

// Makes p_bytes the member set, with a copy of v, which may be its own contents.
fn Pick_set_p_bytes(m: Pick&, v: const u8[:]) {
    let pb_t = pb_bytes_set(pb_Span { at: 0, len: 0 }, v);
    Pick_clear_pick(m);
    m.pick = Pick_pick.p_bytes { v: pb_t };
}

fn Pick_has_p_bytes(m: Pick&) -> bool { return match m.pick { p_bytes => true, _ => false }; }

// Clears oneof pick if p_bytes is the member set.
fn Pick_clear_p_bytes(m: Pick&) { if Pick_has_p_bytes(m) { Pick_clear_pick(m); } }

// The value of p_named, the default if it is not the member set.
fn Pick_p_named(m: Pick&) -> i32 {
    match m.pick {
        p_named pb_p => { return pb_p.v; },
        _ => {},
    }
    return 5;
}

// Makes p_named the member set, with value v: it is encoded even when 0.
fn Pick_set_p_named(m: Pick&, v: i32) {
    Pick_clear_pick(m);
    m.pick = Pick_pick.p_named { v: v };
}

fn Pick_has_p_named(m: Pick&) -> bool { return match m.pick { p_named => true, _ => false }; }

// Clears oneof pick if p_named is the member set.
fn Pick_clear_p_named(m: Pick&) { if Pick_has_p_named(m) { Pick_clear_pick(m); } }

// The value of p_first, the default if it is not the member set.
fn Pick_p_first(m: Pick&) -> i32 {
    match m.pick {
        p_first pb_p => { return pb_p.v; },
        _ => {},
    }
    return 3;
}

// Makes p_first the member set, with value v: it is encoded even when 0.
fn Pick_set_p_first(m: Pick&, v: i32) {
    Pick_clear_pick(m);
    m.pick = Pick_pick.p_first { v: v };
}

fn Pick_has_p_first(m: Pick&) -> bool { return match m.pick { p_first => true, _ => false }; }

// Clears oneof pick if p_first is the member set.
fn Pick_clear_p_first(m: Pick&) { if Pick_has_p_first(m) { Pick_clear_pick(m); } }

// The value of p_nan, the default if it is not the member set.
fn Pick_p_nan(m: Pick&) -> f64 {
    match m.pick {
        p_nan pb_p => { return pb_p.v; },
        _ => {},
    }
    return pb_f64_from_bits(0x7ff8000000000000);
}

// Makes p_nan the member set, with value v: it is encoded even when 0.0.
fn Pick_set_p_nan(m: Pick&, v: f64) {
    Pick_clear_pick(m);
    m.pick = Pick_pick.p_nan { v: v };
}

fn Pick_has_p_nan(m: Pick&) -> bool { return match m.pick { p_nan => true, _ => false }; }

// Clears oneof pick if p_nan is the member set.
fn Pick_clear_p_nan(m: Pick&) { if Pick_has_p_nan(m) { Pick_clear_pick(m); } }

// The value of p_bool, the default if it is not the member set.
fn Pick_p_bool(m: Pick&) -> bool {
    match m.pick {
        p_bool pb_p => { return pb_p.v; },
        _ => {},
    }
    return true;
}

// Makes p_bool the member set, with value v: it is encoded even when false.
fn Pick_set_p_bool(m: Pick&, v: bool) {
    Pick_clear_pick(m);
    m.pick = Pick_pick.p_bool { v: v };
}

fn Pick_has_p_bool(m: Pick&) -> bool { return match m.pick { p_bool => true, _ => false }; }

// Clears oneof pick if p_bool is the member set.
fn Pick_clear_p_bool(m: Pick&) { if Pick_has_p_bool(m) { Pick_clear_pick(m); } }

// message def.Req
struct Req {
    r: i32 = 7,
    pb_has0: u32,   // has-bits of fields with presence
    pb_unknown: pb_Span,   // unknown fields: raw wire bytes in pb_bytes
}

// A link to a Req in Req_pool, for sub-message fields.
struct Req_Ref { m: Req&<u32 in Req_pool>? }
reusable var Req_pool: Req[>..] = [];
reusable[] var Req_links: Req_Ref[>..] = [];

// Merges the fields in r's window into m; on failure r.err is set.
// Fields it does not know, or with another wire type, are kept as
// unknown fields.
fn Req_decode_from(r: pb_Reader&, m: Req&) {
    var unknown_len: i64 = m.pb_unknown.len;
    let unknown_had: i64 = unknown_len;
    while r.pos < r.end {
        let start = r.pos;
        let tag = pb_read_tag(r);
        if r.err != PB_OK { break; }
        if tag == 8 {
            m.r = pb_u64_to_int32(pb_read_varint(r));
            m.pb_has0 |= 0x00000001;
        } else {
            pb_unknown_append(r, start, tag, m.pb_unknown, unknown_len, unknown_had);
        }
    }
    m.pb_unknown = pb_bytes_trim(m.pb_unknown, unknown_len);
}

// Merges buf into m. 0 on success, else a PB_ERR_* code; m then holds a
// partial message, which the caller clears.
fn Req_decode(buf: const u8[:], m: Req&) -> i32 {
    var r = pb_reader(buf);
    Req_decode_from(r, m);
    if r.err == PB_OK && !Req_is_initialized(m) { return PB_ERR_REQUIRED; }
    return r.err;
}

// Appends m's wire encoding, Req_size_of(m) bytes, to out.
fn Req_encode(m: Req&, out: u8[>..]&) {
    if (m.pb_has0 & 0x00000001) != 0 {
        pb_write_varint(out, 8);
        pb_write_varint(out, pb_int32_to_u64(m.r));
    }
    out.append(pb_run(pb_bytes, m.pb_unknown));
}

// The size of m's wire encoding, in bytes.
fn Req_size_of(m: Req&) -> i64 {
    var n: i64 = 0;
    if (m.pb_has0 & 0x00000001) != 0 { n += 1 + pb_varint_size(pb_int32_to_u64(m.r)); }
    n += m.pb_unknown.len;
    return n;
}

// Frees what m owns and resets it to the empty message.
fn Req_clear(m: Req&) {
    m.r = 7;
    m.pb_has0 = 0;
    m.pb_unknown = pb_bytes_free(m.pb_unknown);
}

// Makes dst a deep copy of src, freeing what dst owned. The two share
// nothing afterwards. Neither may be a sub-message of the other.
fn Req_copy(dst: Req&, src: Req&) {
    if dst .== src { return; }
    Req_clear(dst);
    dst.r = src.r;
    dst.pb_has0 = src.pb_has0;
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
}

// True if every required field is set, in m and in the messages it holds.
fn Req_is_initialized(m: Req&) -> bool {
    if (m.pb_has0 & 0x00000001) != 0x00000001 { return false; }
    return true;
}

// Sets r and marks it present:
// it is encoded even when 0.
fn Req_set_r(m: Req&, v: i32) {
    m.r = v;
    m.pb_has0 |= 0x00000001;
}

fn Req_has_r(m: Req&) -> bool { return (m.pb_has0 & 0x00000001) != 0; }

fn Req_clear_r(m: Req&) {
    m.r = 7;
    m.pb_has0 &= 0xfffffffe;
}

// message def.Holder
struct Holder {
    one: All_Ref,
    many: pb_Span,
    pb_unknown: pb_Span,   // unknown fields: raw wire bytes in pb_bytes
}

// A link to a Holder in Holder_pool, for sub-message fields.
struct Holder_Ref { m: Holder&<u32 in Holder_pool>? }
reusable var Holder_pool: Holder[>..] = [];
reusable[] var Holder_links: Holder_Ref[>..] = [];

// Merges the fields in r's window into m; on failure r.err is set.
// Fields it does not know, or with another wire type, are kept as
// unknown fields.
fn Holder_decode_from(r: pb_Reader&, m: Holder&) {
    var unknown_len: i64 = m.pb_unknown.len;
    let unknown_had: i64 = unknown_len;
    let pb_had2: i64 = m.many.len;
    var pb_len2: i64 = pb_had2;
    while r.pos < r.end {
        let start = r.pos;
        let tag = pb_read_tag(r);
        if r.err != PB_OK { break; }
        if tag == 10 {
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            if r.depth >= PB_MAX_DEPTH { pb_fail(r, PB_ERR_DEPTH); break; }
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            r.depth++;
            All_decode_from(r, Holder_mutable_one(m));
            if r.err != PB_OK { break; }
            r.depth--;
            r.end = pb_outer;
        } else if tag == 18 {
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            if r.depth >= PB_MAX_DEPTH { pb_fail(r, PB_ERR_DEPTH); break; }
            pb_reserve(All_links, m.many, pb_len2, pb_had2);
            let pb_sub .= All_pool.alloc_ref(All { .. });
            pb_run(All_links, m.many)[pb_len2].m .= pb_sub;
            pb_len2++;
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            r.depth++;
            All_decode_from(r, pb_sub);
            if r.err != PB_OK { break; }
            r.depth--;
            r.end = pb_outer;
        } else {
            pb_unknown_append(r, start, tag, m.pb_unknown, unknown_len, unknown_had);
        }
    }
    m.many = pb_trim(All_links, m.many, pb_len2);
    m.pb_unknown = pb_bytes_trim(m.pb_unknown, unknown_len);
}

// Merges buf into m. 0 on success, else a PB_ERR_* code; m then holds a
// partial message, which the caller clears.
fn Holder_decode(buf: const u8[:], m: Holder&) -> i32 {
    var r = pb_reader(buf);
    Holder_decode_from(r, m);
    return r.err;
}

// Appends m's wire encoding, Holder_size_of(m) bytes, to out.
fn Holder_encode(m: Holder&, out: u8[>..]&) {
    let pb_f1 = m.one.m;
    if pb_f1 {
        pb_write_varint(out, 10);
        pb_write_varint(out, All_size_of(pb_f1) as! u64);
        All_encode(pb_f1, out);
    }
    for pb_ref in pb_run(All_links, m.many) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        pb_write_varint(out, 18);
        pb_write_varint(out, All_size_of(pb_l) as! u64);
        All_encode(pb_l, out);
    }
    out.append(pb_run(pb_bytes, m.pb_unknown));
}

// The size of m's wire encoding, in bytes.
fn Holder_size_of(m: Holder&) -> i64 {
    var n: i64 = 0;
    let pb_f1 = m.one.m;
    if pb_f1 { n += 1 + pb_len_size(All_size_of(pb_f1)); }
    for pb_ref in pb_run(All_links, m.many) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        n += 1 + pb_len_size(All_size_of(pb_l));
    }
    n += m.pb_unknown.len;
    return n;
}

// Frees what m owns and resets it to the empty message.
fn Holder_clear(m: Holder&) {
    Holder_clear_one(m);
    Holder_clear_many(m);
    m.pb_unknown = pb_bytes_free(m.pb_unknown);
}

// Makes dst a deep copy of src, freeing what dst owned. The two share
// nothing afterwards. Neither may be a sub-message of the other.
fn Holder_copy(dst: Holder&, src: Holder&) {
    if dst .== src { return; }
    Holder_clear(dst);
    let pb_f1 = src.one.m;
    if pb_f1 { All_copy(Holder_mutable_one(dst), pb_f1); }
    dst.many = pb_resize(All_links, dst.many, src.many.len);
    for pb_i in src.many.len {
        let pb_l = pb_run(All_links, src.many)[pb_i].m;
        guard pb_l else { continue; }
        let pb_c .= All_pool.alloc_ref(All { .. });
        pb_run(All_links, dst.many)[pb_i].m .= pb_c;
        All_copy(pb_c, pb_l);
    }
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
}

// The sub-message one, or null if it is not set. Valid until it or m is
// cleared.
fn Holder_one(m: Holder&) -> All&? { return m.one.m; }

// The sub-message one, set to an empty one first if it is not set.
fn Holder_mutable_one(m: Holder&) -> All& {
    let pb_sub = m.one.m;
    if pb_sub { return pb_sub; }
    let pb_new .= All_pool.alloc_ref(All { .. });
    m.one.m .= pb_new;
    return pb_new;
}

fn Holder_has_one(m: Holder&) -> bool { return m.one.m != null; }

// Frees the sub-message one and everything it owns.
fn Holder_clear_one(m: Holder&) {
    let pb_sub = m.one.m;
    guard pb_sub else { return; }
    All_clear(pb_sub);
    All_pool.free(All_pool.index_of(pb_sub));
    m.one.m .= null;
}

// The links of many, in All_links: its .len is the number of messages.
fn Holder_many(m: Holder&) -> All_Ref[:] { return pb_run(All_links, m.many); }

// Message i of many. Valid until it or m is cleared.
fn Holder_many_at(m: Holder&, i: i64) -> All& {
    let pb_l = pb_run(All_links, m.many)[i].m;
    assert(pb_l);
    return pb_l;
}

// Adds an empty message to many and returns it.
fn Holder_add_many(m: Holder&) -> All& {
    let pb_i: i64 = m.many.len;
    m.many = pb_resize(All_links, m.many, pb_i + 1);
    let pb_new .= All_pool.alloc_ref(All { .. });
    pb_run(All_links, m.many)[pb_i].m .= pb_new;
    return pb_new;
}

// Frees the messages of many and everything they own.
fn Holder_clear_many(m: Holder&) {
    for pb_ref in pb_run(All_links, m.many) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        All_clear(pb_l);
        All_pool.free(All_pool.index_of(pb_l));
    }
    m.many = pb_resize(All_links, m.many, 0);
}
