let All_v_string_default: u8[11] = [104, 195, 169, 108, 108, 111, 32, 34, 113, 34, 10];

// The contents of v_string, in pb_bytes, or All_v_string_default if it is not set: valid
// until it is next set or m is cleared.
fn All_v_string(m: All&) -> const u8[:] {
    if (m.pb_has0 & 0x00010000) == 0 { return All_v_string_default; }
    return pb_run(pb_bytes, m.v_string);
}

// Sets v_string to a copy of v and marks it present:
// it is encoded even when empty.
fn All_set_v_string(m: All&, v: const u8[:]) {
    m.v_string = pb_bytes_set(m.v_string, v);
    m.pb_has0 |= 0x00010000;
}

fn All_has_v_string(m: All&) -> bool { return (m.pb_has0 & 0x00010000) != 0; }

fn All_clear_v_string(m: All&) {
    m.v_string = pb_bytes_free(m.v_string);
    m.pb_has0 &= 0xfffeffff;
}

