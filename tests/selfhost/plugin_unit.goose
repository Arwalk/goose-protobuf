// generator-goose/generate.goose: from a request to a response, in bytes.
// Run by scripts/selfhost_tests.sh, which also checks the built plugin's exit status.
import pb_wire;
import google.protobuf.compiler.plugin;
import google.protobuf.descriptor;
import emit;
import generate;
import unit_support;

type Req = google_protobuf_compiler::CodeGeneratorRequest;
type Res = google_protobuf_compiler::CodeGeneratorResponse;

// What a test asks for, and what the plugin answers: a run of the plugin decodes
// the one into `request`, and these are read back from bytes as protoc does.
var req = Req { .. };
var res = Res { .. };

fn new_request() {
    google_protobuf_compiler::CodeGeneratorRequest_clear(req);
}

fn generate_for(name: const u8[:]) {
    google_protobuf_compiler::CodeGeneratorRequest_add_file_to_generate(req, name);
}

fn add_request_file(name: const u8[:], package: const u8[:]) -> FileDesc& {
    let file .= google_protobuf_compiler::CodeGeneratorRequest_add_proto_file(req);
    google_protobuf::FileDescriptorProto_set_name(file, name);
    if package.len > 0 { google_protobuf::FileDescriptorProto_set_package(file, package); }
    return file;
}

// The plugin's answer to `req`, in `res`.
fn run_on_request() {
    reset_generator();
    google_protobuf_compiler::CodeGeneratorResponse_clear(response);
    var bytes: u8[>..] = [];
    google_protobuf_compiler::CodeGeneratorRequest_encode(req, bytes);
    var out: u8[>..] = [];
    let err = run_plugin(bytes, out);
    if err != PB_OK { abort(str("runPlugin: ", err)); }
    google_protobuf_compiler::CodeGeneratorResponse_clear(res);
    let back = google_protobuf_compiler::CodeGeneratorResponse_decode(out, res);
    if back != PB_OK { abort(str("the response does not decode: ", back)); }
}

fn file_count() -> i64 { return google_protobuf_compiler::CodeGeneratorResponse_file_len(res); }

fn expect_error(want: const u8[:]) {
    expect_str(google_protobuf_compiler::CodeGeneratorResponse_error(res), want);
    expect(file_count() == 0, "no files with an error");
}

fn expect_no_error() {
    if google_protobuf_compiler::CodeGeneratorResponse_has_error(res) {
        abort(str("unexpected error: ", google_protobuf_compiler::CodeGeneratorResponse_error(res)));
    }
}

fn nothing_to_generate() {
    new_request();
    reset_generator();
    google_protobuf_compiler::CodeGeneratorResponse_clear(response);
    var out: u8[>..] = [];
    let empty: u8[0] = [];
    expect(run_plugin(empty[..], out) == PB_OK, "an empty request decodes");
    // supported_features 3, minimum_edition 998, maximum_edition 1000.
    let want: u8[8] = [0x10, 0x03, 0x18, 0xe6, 0x07, 0x20, 0xe8, 0x07];
    expect(out == want[..], "the exact bytes of an empty response");
}

fn a_truncated_request_is_an_error() {
    reset_generator();
    google_protobuf_compiler::CodeGeneratorResponse_clear(response);
    var out: u8[>..] = [];
    // field 1 (file_to_generate), length 5, but only 1 byte follows.
    let cut: u8[3] = [0x0a, 0x05, 'a'];
    expect(run_plugin(cut[..], out) == PB_ERR_TRUNCATED, "truncated");
    expect(out.len == 0, "nothing written");
}

fn one_goose_file_per_file_to_generate() {
    new_request();
    generate_for("dir/a.proto");
    add_request_file("dep.proto", "");
    add_message(add_request_file("dir/a.proto", "pkg.sub"), "M");
    run_on_request();
    expect_no_error();
    expect(file_count() == 1, "one file");
    let f .= google_protobuf_compiler::CodeGeneratorResponse_file_at(res, 0);
    expect_str(google_protobuf_compiler::CodeGeneratorResponse_File_name(f), "dir/a.goose");
    let content = google_protobuf_compiler::CodeGeneratorResponse_File_content(f);
    let start = "// Code generated by protoc-gen-goose. DO NOT EDIT.\n// source: dir/a.proto\n";
    expect_str(content[..start.len], start);
    expect_has(content, "namespace pkg_sub;\n\nimport pb_wire;\n");
    expect_has(content, "let pb_version_check_dir_2a = pb_plugin_and_runtime_versions_differ_abi_1;\n\n// message pkg.sub.M\nstruct M {\n    pb_unknown: pb_Span,   // unknown fields: raw wire bytes in pb_bytes\n}\n");
}

fn a_file_not_in_proto_file_is_an_error() {
    new_request();
    generate_for("x");
    run_on_request();
    expect_error("x: not in proto_file");
}

fn a_name_collision_is_an_error_with_no_files() {
    new_request();
    generate_for("ok.proto");
    generate_for("bad.proto");
    add_request_file("ok.proto", "");
    let bad .= add_request_file("bad.proto", "");
    let e .= google_protobuf::FileDescriptorProto_add_enum_type(bad);
    google_protobuf::EnumDescriptorProto_set_name(e, "E");
    add_enum_value(e, "X", 0);
    add_message(bad, "E_X");
    run_on_request();
    expect_error("bad.proto: E.X and E_X both map to the Goose name E_X");
}

fn two_protos_with_one_output_file_are_an_error() {
    new_request();
    generate_for("a.b.proto");
    generate_for("c.proto");
    generate_for("a-b.proto");
    add_request_file("a.b.proto", "");
    add_request_file("c.proto", "");
    add_request_file("a-b.proto", "");
    run_on_request();
    expect_error("a.b.proto and a-b.proto both map to the Goose file a_b.goose");
}

fn a_well_known_file_writes_nothing_unless_asked() {
    new_request();
    generate_for("google/protobuf/empty.proto");
    add_request_file("google/protobuf/empty.proto", "google.protobuf");
    run_on_request();
    expect_no_error();
    expect(file_count() == 0, "no file by default");
    google_protobuf_compiler::CodeGeneratorRequest_set_parameter(req, "wkt");
    run_on_request();
    expect_no_error();
    expect(file_count() == 1, "a file with wkt");
    expect_str(google_protobuf_compiler::CodeGeneratorResponse_File_name(google_protobuf_compiler::CodeGeneratorResponse_file_at(res, 0)), "wkt/empty.goose");
}

fn the_parameters_are_checked() {
    new_request();
    google_protobuf_compiler::CodeGeneratorRequest_set_parameter(req, "wkt");
    generate_for("a.proto");
    add_request_file("a.proto", "");
    run_on_request();
    expect_error("a.proto: not a well-known type");
    google_protobuf_compiler::CodeGeneratorRequest_set_parameter(req, "nope");
    run_on_request();
    expect_error("unknown parameter: nope");
}

fn main() {
    nothing_to_generate();
    a_truncated_request_is_an_error();
    one_goose_file_per_file_to_generate();
    a_file_not_in_proto_file_is_an_error();
    a_name_collision_is_an_error_with_no_files();
    two_protos_with_one_output_file_are_an_error();
    a_well_known_file_writes_nothing_unless_asked();
    the_parameters_are_checked();
}
