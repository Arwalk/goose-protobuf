// Frees what m owns and resets it to the empty message.
fn StringValue_clear(m: StringValue&) {
    m.value = pb_bytes_free(m.value);
    m.pb_unknown = pb_bytes_free(m.pb_unknown);
}

// Makes dst a deep copy of src, freeing what dst owned. The two share
// nothing afterwards. Neither may be a sub-message of the other.
fn StringValue_copy(dst: StringValue&, src: StringValue&) {
    if dst .== src { return; }
    StringValue_clear(dst);
    dst.value = pb_bytes_copy(src.value);
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
}

// The contents of value, in pb_bytes: valid until it is next set or m
// is cleared.
fn StringValue_value(m: StringValue&) -> u8[:] { return pb_run(pb_bytes, m.value); }

// Sets value to a copy of v.
fn StringValue_set_value(m: StringValue&, v: const u8[:]) {
    m.value = pb_bytes_set(m.value, v);
}

// message google.protobuf.BytesValue
struct BytesValue {
    value: pb_Span,
    pb_unknown: pb_Span,   // unknown fields: raw wire bytes in pb_bytes
}

// A link to a BytesValue in BytesValue_pool, for sub-message fields.
struct BytesValue_Ref { m: BytesValue&<u32 in BytesValue_pool>? }
reusable var BytesValue_pool: BytesValue[>..] = [];
reusable[] var BytesValue_links: BytesValue_Ref[>..] = [];

// Merges the fields in r's window into m; on failure r.err is set.
// Fields it does not know, or with another wire type, are kept as
// unknown fields.
fn BytesValue_decode_from(r: pb_Reader&, m: BytesValue&) {
    var unknown_len: i64 = m.pb_unknown.len;
    let unknown_had: i64 = unknown_len;
    while r.pos < r.end {
        let start = r.pos;
        let tag = pb_read_tag(r);
        if r.err != PB_OK { break; }
        if tag == 10 {
            m.value = pb_read_bytes(r, m.value);
        } else {
            pb_unknown_append(r, start, tag, m.pb_unknown, unknown_len, unknown_had);
        }
    }
    m.pb_unknown = pb_bytes_trim(m.pb_unknown, unknown_len);
}

// Merges buf into m. 0 on success, else a PB_ERR_* code; m then holds a
// partial message, which the caller clears.
fn BytesValue_decode(buf: const u8[:], m: BytesValue&) -> i32 {
    var r = pb_reader(buf);
    BytesValue_decode_from(r, m);
    return r.err;
}

// Appends m's wire encoding, BytesValue_size_of(m) bytes, to out.
fn BytesValue_encode(m: BytesValue&, out: u8[>..]&) {
    if m.value.len > 0 {
        pb_write_varint(out, 10);
        pb_write_bytes(out, m.value);
    }
    out.append(pb_run(pb_bytes, m.pb_unknown));
}

// The size of m's wire encoding, in bytes.
fn BytesValue_size_of(m: BytesValue&) -> i64 {
    var n: i64 = 0;
    if m.value.len > 0 { n += 1 + pb_bytes_size(m.value); }
    n += m.pb_unknown.len;
    return n;
}

// Frees what m owns and resets it to the empty message.
fn BytesValue_clear(m: BytesValue&) {
    m.value = pb_bytes_free(m.value);
    m.pb_unknown = pb_bytes_free(m.pb_unknown);
}

// Makes dst a deep copy of src, freeing what dst owned. The two share
// nothing afterwards. Neither may be a sub-message of the other.
fn BytesValue_copy(dst: BytesValue&, src: BytesValue&) {
    if dst .== src { return; }
    BytesValue_clear(dst);
    dst.value = pb_bytes_copy(src.value);
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
}

// The contents of value, in pb_bytes: valid until it is next set or m
// is cleared.
fn BytesValue_value(m: BytesValue&) -> u8[:] { return pb_run(pb_bytes, m.value); }

// Sets value to a copy of v.
fn BytesValue_set_value(m: BytesValue&, v: const u8[:]) {
    m.value = pb_bytes_set(m.value, v);
}
