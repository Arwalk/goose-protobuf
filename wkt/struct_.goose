// A link to a ListValue in ListValue_pool, for sub-message fields.
struct ListValue_Ref { m: ListValue&<u32 in ListValue_pool>? }
reusable var ListValue_pool: ListValue[>..] = [];
reusable[] var ListValue_links: ListValue_Ref[>..] = [];

// Merges the fields in r's window into m; on failure r.err is set.
// Fields it does not know, or with another wire type, are kept as
// unknown fields.
recursive fn ListValue_decode_from(r: pb_Reader&, m: ListValue&) {
    var unknown_len: i64 = m.pb_unknown.len;
    var pb_len1: i64 = m.values.len;
    while r.pos < r.end {
        let start = r.pos;
        let tag = pb_read_tag(r);
        if r.err != PB_OK { break; }
        if tag == 10 {
            let pb_n = pb_read_len(r);
            if r.err != PB_OK { break; }
            if r.depth >= PB_MAX_DEPTH { pb_fail(r, PB_ERR_DEPTH); break; }
            pb_reserve(Value_links, m.values, pb_len1);
            let pb_sub .= Value_pool.alloc_ref(Value { .. });
            pb_run(Value_links, m.values)[pb_len1].m .= pb_sub;
            pb_len1++;
            let pb_outer = r.end;
            r.end = r.pos + pb_n;
            r.depth++;
            Value_decode_from(r, pb_sub);
            if r.err != PB_OK { break; }
            r.depth--;
            r.end = pb_outer;
        } else {
            pb_unknown_append(r, start, tag, m.pb_unknown, unknown_len);
        }
    }
    m.values = pb_trim(Value_links, m.values, pb_len1);
    m.pb_unknown = pb_bytes_trim(m.pb_unknown, unknown_len);
}

// Merges buf into m. 0 on success, else a PB_ERR_* code; m then holds a
// partial message, which the caller clears.
fn ListValue_decode(buf: const u8[:], m: ListValue&) -> i32 {
    var r = pb_reader(buf);
    ListValue_decode_from(r, m);
    return r.err;
}

// Appends m's wire encoding, ListValue_size_of(m) bytes, to out.
recursive fn ListValue_encode(m: ListValue&, out: u8[>..]&) {
    for pb_ref in pb_run(Value_links, m.values) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        pb_write_varint(out, 10);
        pb_write_varint(out, Value_size_of(pb_l) as! u64);
        Value_encode(pb_l, out);
    }
    out.append(pb_run(pb_bytes, m.pb_unknown));
}

// The size of m's wire encoding, in bytes.
recursive fn ListValue_size_of(m: ListValue&) -> i64 {
    var n: i64 = 0;
    for pb_ref in pb_run(Value_links, m.values) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        n += 1 + pb_len_size(Value_size_of(pb_l));
    }
    n += m.pb_unknown.len;
    return n;
}

// Frees what m owns and resets it to the empty message.
recursive fn ListValue_clear(m: ListValue&) {
    ListValue_clear_values(m);
    m.pb_unknown = pb_bytes_free(m.pb_unknown);
}

// Makes dst a deep copy of src, freeing what dst owned. The two share
// nothing afterwards. Neither may be a sub-message of the other.
recursive fn ListValue_copy(dst: ListValue&, src: ListValue&) {
    if dst .== src { return; }
    ListValue_clear(dst);
    dst.values = pb_resize(Value_links, dst.values, src.values.len);
    for pb_i in src.values.len {
        let pb_l = pb_run(Value_links, src.values)[pb_i].m;
        guard pb_l else { continue; }
        let pb_c .= Value_pool.alloc_ref(Value { .. });
        pb_run(Value_links, dst.values)[pb_i].m .= pb_c;
        Value_copy(pb_c, pb_l);
    }
    dst.pb_unknown = pb_bytes_copy(src.pb_unknown);
}

// The links of values, in Value_links: its .len is the number of messages.
fn ListValue_values(m: ListValue&) -> Value_Ref[:] { return pb_run(Value_links, m.values); }

// Message i of values. Valid until it or m is cleared.
fn ListValue_values_at(m: ListValue&, i: i64) -> Value& {
    let pb_l = pb_run(Value_links, m.values)[i].m;
    assert(pb_l);
    return pb_l;
}

// Adds an empty message to values and returns it.
fn ListValue_add_values(m: ListValue&) -> Value& {
    let pb_i: i64 = m.values.len;
    m.values = pb_resize(Value_links, m.values, pb_i + 1);
    let pb_new .= Value_pool.alloc_ref(Value { .. });
    pb_run(Value_links, m.values)[pb_i].m .= pb_new;
    return pb_new;
}

// Frees the messages of values and everything they own.
recursive fn ListValue_clear_values(m: ListValue&) {
    for pb_ref in pb_run(Value_links, m.values) {
        let pb_l = pb_ref.m;
        guard pb_l else { continue; }
        Value_clear(pb_l);
        Value_pool.free(Value_pool.index_of(pb_l));
    }
    m.values = pb_resize(Value_links, m.values, 0);
}
